<Window x:Class="NPEduTools.UiPrototype.WorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NPEduTools · 工作台交互原型" Width="1100" Height="740" MinWidth="760" MinHeight="520"
 WindowStartupLocation="CenterScreen" Background="#F5F7F5" Foreground="#24342D" FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/CommonControls.xaml"/><ResourceDictionary Source="Resources/RecordingControls.xaml"/></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="Accent" Color="#147D68"/>
   <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#6C7B72"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
   <Style TargetType="Button">
    <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#294537"/><Setter Property="BorderBrush" Value="#DCE6E0"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#202E35"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Style>
   <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
   <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="10,12"/><Style.Triggers><Trigger Property="Tag" Value="active"><Setter Property="Background" Value="#DCECE4"/><Setter Property="Foreground" Value="#116A58"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
   <Style x:Key="Section" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E1E8E3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/></Style>
   <Style TargetType="ComboBox" BasedOn="{StaticResource RecordingChoice}"/>
   <Style TargetType="CheckBox" BasedOn="{StaticResource RecordingCheck}"/>
   <Style TargetType="TextBox"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#DCE6E0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Input" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#147D68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Background="#F5F7F5">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#FFF5DB" Padding="16,7"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="演示场景" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/><ComboBox x:Name="Scene" MinHeight="30" FontSize="12" Width="150" SelectionChanged="SceneChanged"><ComboBoxItem Content="待开始"/><ComboBoxItem Content="学校自习进行中"/><ComboBoxItem Content="学校时间失效"/><ComboBoxItem Content="当前操作状态"/></ComboBox></StackPanel>
   <TextBlock Text="交互原型 · 模拟数据 · 不连接学校或采集设备" FontSize="12" Foreground="#765B26" VerticalAlignment="Center" Margin="0,0,12,0"/>
  </DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#EDF2EF" BorderBrush="#DEE6DF" BorderThickness="0,0,1,0" Padding="12,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Image Source="Resources/logo.png" Width="32" Height="32" HorizontalAlignment="Left" Margin="9,0,0,12"/><TextBlock x:Name="BrandText" Text="NPEduTools" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="17" Margin="9,0,0,24"/></StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="HomeNav" Tag="active" Style="{StaticResource Nav}" Click="HomeClicked" ToolTip="主页"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"/><TextBlock x:Name="HomeLabel" Text="主页" Margin="12,0,0,0"/></StackPanel></Button>
     <Button x:Name="StudyNav" Style="{StaticResource Nav}" Click="StudyClicked" ToolTip="自习"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"/><TextBlock x:Name="StudyLabel" Text="自习" Margin="12,0,0,0"/></StackPanel></Button>
     <Button x:Name="DevicesNav" Style="{StaticResource Nav}" Click="DevicesClicked" ToolTip="设备与连接"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"/><TextBlock x:Name="DevicesLabel" Text="设备与连接" Margin="12,0,0,0"/></StackPanel></Button>
     <TextBlock x:Name="ScopeLabel" Text="本轮预览：主页、自习与校准流程。其他功能沿用现有版本。" Style="{StaticResource Muted}" Margin="10,26,10,0"/>
    </StackPanel>
    <Button Grid.Row="2" x:Name="FoldNav" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource Quiet}" Click="FoldClicked" ToolTip="折叠或展开导航"/>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="26,20,26,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="主页" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="今天需要做什么，一眼看清。" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="示例班级&#x0a;日常模式" TextAlignment="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="1" x:Name="Feedback" Background="#EDF4EF" CornerRadius="7" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="FeedbackText" FontSize="13"/></Border>
    <Grid Grid.Row="2">
     <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Border Style="{StaticResource Section}" BorderBrush="#BDD2C6" Padding="22"><StackPanel><TextBlock x:Name="HomeTaskLabel" Text="当前任务" Style="{StaticResource Muted}"/><TextBlock x:Name="HomeTask" Text="当前没有自习任务" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock x:Name="HomeTaskHint" Style="{StaticResource Muted}"/><Button x:Name="HomePrimary" Content="开始手动自习" Style="{StaticResource Primary}" Click="HomePrimaryClicked" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Section}" Margin="0,14,0,0"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="查看安排  →" Style="{StaticResource Quiet}" Click="SchoolClicked"/><StackPanel><TextBlock Text="下一次学校自习" Style="{StaticResource Muted}"/><TextBlock x:Name="HomeNext" Text="今天 19:15–21:30" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></DockPanel><TextBlock x:Name="HomeNextHint" Text="日常模式 · ClassIsland 学校时间 · 提前五分钟打开展示" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
      <TextBlock Text="设备准备" FontWeight="SemiBold" Margin="0,20,0,8"/><Border Style="{StaticResource Section}" Padding="16"><DockPanel><Button DockPanel.Dock="Right" Content="设备与校准" Click="DevicesClicked"/><StackPanel Margin="0,0,12,0"><TextBlock x:Name="HomeReadiness" Text="麦克风已选择 · 摄像头策略关闭"/><TextBlock x:Name="HomeReference" Text="快速校准 · dBFS" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
     </StackPanel></ScrollViewer>
     <Grid x:Name="StudyPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,12"><Button x:Name="ManualTab" Content="手动自习" Click="ManualClicked" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button x:Name="SchoolTab" Content="学校定时自习" Click="SchoolClicked"/><Button x:Name="ReportsTab" Content="报告" Click="ReportsClicked" Style="{StaticResource Quiet}" Margin="8,0,0,0"/></WrapPanel>
      <ScrollViewer Grid.Row="1" x:Name="StudyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
       <StackPanel x:Name="ManualPane"><Border Style="{StaticResource Section}"><StackPanel>
        <TextBlock x:Name="ManualHeading" Text="开始一节手动自习" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ManualExplanation" Text="使用已选择的设备，最多三小时。" Style="{StaticResource Muted}" Margin="0,6,0,16"/>
        <StackPanel x:Name="ManualForm"><TextBlock Text="什么时候开始" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,12"><RadioButton x:Name="Immediate" Content="立即开始" IsChecked="True" GroupName="StartMode" Checked="ManualOptionsChanged" Margin="0,0,20,0" VerticalAlignment="Center"/><RadioButton x:Name="Scheduled" Content="指定时间" GroupName="StartMode" Checked="ManualOptionsChanged" VerticalAlignment="Center"/></WrapPanel>
         <Grid x:Name="StartFields" Visibility="Collapsed" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><DatePicker x:Name="StartDate"/><TextBox x:Name="StartTime" Grid.Column="1" Text="19:00" Margin="10,0,0,0" AutomationProperties.Name="开始时间 HH:mm"/></Grid>
         <TextBlock Text="什么时候结束" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="EndChoice" SelectionChanged="ManualOptionsChanged"><ComboBoxItem Content="主动结束，最多三小时"/><ComboBoxItem Content="指定结束时间"/></ComboBox>
         <Grid x:Name="EndFields" Visibility="Collapsed" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><DatePicker x:Name="EndDate"/><TextBox x:Name="EndTime" Grid.Column="1" Text="21:30" Margin="10,0,0,0" AutomationProperties.Name="结束时间 HH:mm"/></Grid>
         <Expander Header="临时使用电脑后返回" Margin="0,16,0,0"><StackPanel Margin="0,12,0,0"><WrapPanel><TextBlock Text="无操作" VerticalAlignment="Center"/><TextBox x:Name="IdleMinutes" Text="10" Width="60" Margin="10,0" AutomationProperties.Name="无操作返回分钟"/><TextBlock Text="分钟后返回展示" VerticalAlignment="Center"/></WrapPanel><CheckBox x:Name="NoReturn" Content="不自动返回" Margin="0,12,0,0" Checked="ReturnChanged" Unchecked="ReturnChanged"/><TextBlock Text="后台监测继续；操作其他软件也会重新计时。" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Expander>
        </StackPanel>
        <StackPanel x:Name="ManualRunning" Visibility="Collapsed"><TextBlock x:Name="ManualTimeSummary" FontSize="18"/><TextBlock x:Name="ManualLive" Margin="0,12,0,0"/><TextBlock Text="本页控制会话；全屏展示继续沿用现有设计。" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
       </StackPanel></Border><TextBlock x:Name="ManualPriorityHint" Text="学校定时自习开始后，手动会话结束并保留报告。" Style="{StaticResource Muted}" Margin="2,12,2,0"/></StackPanel>
       <StackPanel x:Name="SchoolPane" Visibility="Collapsed"><Border Style="{StaticResource Section}"><StackPanel><TextBlock x:Name="SchoolHeading" Text="等待学校自习" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SchoolWhen" Text="今天 19:15–21:30" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="学校安排已应用 · 日常模式 · ClassIsland 学校时间" Style="{StaticResource Muted}"/><Separator Margin="0,16" Background="#E7EDE9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="噪音采集" Style="{StaticResource Muted}"/><TextBlock x:Name="SchoolCapture" Text="到开始时间才采集" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="全屏展示" Style="{StaticResource Muted}"/><TextBlock x:Name="SchoolDisplay" Text="19:10 自动打开" Margin="0,6,0,0"/></StackPanel></Grid></StackPanel></Border>
        <Border x:Name="SchoolTimeline" Style="{StaticResource Section}" Margin="0,12,0,0" Padding="16"><StackPanel><TextBlock Text="本次安排" FontWeight="SemiBold"/><TextBlock Text="19:10  展示自习座位表&#x0a;19:13  准备自习提醒&#x0a;19:15  开始采集&#x0a;19:17  返回正常展示&#x0a;21:30  结束自习，随后显示报告" Style="{StaticResource Muted}" Margin="0,10,0,0"/><TextBlock Text="时间、日期、适用班级和例外日由学校后台配置。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
       </StackPanel>
       <StackPanel x:Name="ReportPane" Visibility="Collapsed"><Border Style="{StaticResource Section}"><StackPanel><TextBlock Text="本次自习报告" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ReportSummary" Text="还没有完成的自习。结束后可以在这里查看概况。" Margin="0,14,0,0"/><TextBlock Text="单位、有效覆盖率和超限时长分别显示；照片与退出验证记录仍只由学校后台管理。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel>
      </Grid></ScrollViewer>
      <Border Grid.Row="2" BorderBrush="#DFE7E1" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StudyFooter" Text="已选择教室麦克风" Style="{StaticResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StudySecondary" Content="设备与校准" Click="StudySecondaryClicked" Margin="0,0,8,0"/><Button x:Name="StudyPrimary" Content="开始自习" Click="StudyPrimaryClicked" Style="{StaticResource Primary}"/></StackPanel></Grid></Border>
     </Grid>
     <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Border Style="{StaticResource Section}"><StackPanel><TextBlock Text="共享设备" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="手动自习和学校定时自习使用同一组设备与校准。" Style="{StaticResource Muted}" Margin="0,6,0,14"/><TextBlock Text="麦克风" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="Microphone" SelectionChanged="InputChanged"><ComboBoxItem Content="教室麦克风（演示）"/><ComboBoxItem Content="备用麦克风（演示）"/></ComboBox><TextBlock Text="摄像头：已选择示例摄像头 · 捕获策略关闭" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Section}" Margin="0,12,0,0"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="联机校准 (Beta)  →" Click="CalibrationClicked" Style="{StaticResource Primary}"/><StackPanel Margin="0,0,12,0"><TextBlock Text="噪音校准" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReferenceStatus" Text="当前使用 dBFS · 尚无估算 dB(A) 参考" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel><TextBlock Text="快速校准与手动声级计参考入口在正式整合时保留。此原型先验证联机校准路径。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Section}" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" x:Name="ClockRetry" Content="重新检查" Click="ClockRetryClicked"/><StackPanel Margin="0,0,12,0"><TextBlock Text="ClassIsland 学校时间" FontWeight="SemiBold"/><TextBlock x:Name="ClockStatus" Text="学校时间已确认（演示）" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
     </StackPanel></ScrollViewer>
     <Grid x:Name="CalibrationPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="CalibrationSteps" Text="① 连接验证　　② 同期采样　　③ 确认结果" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid>
       <StackPanel x:Name="CalibrationSetup"><Border Style="{StaticResource Section}"><StackPanel><TextBlock Text="连接并验证声级计" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="插入 DLY-2202，关闭 SoundLab2，确认 A 加权和非 MAX 模式。" Style="{StaticResource Muted}" Margin="0,8,0,18"/>
        <StackPanel x:Name="CredentialsPanel"><TextBlock Text="学校管理口令" FontWeight="SemiBold"/><PasswordBox x:Name="Password" Margin="0,8,0,8"/><TextBlock Text="原型口令为 123456。请勿输入真实学校口令。" Style="{StaticResource Muted}"/><Button x:Name="VerifyMeter" Content="验证并查找仪表" Click="VerifyClicked" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MeterStatus" Text="尚未验证" VerticalAlignment="Center"/><Button x:Name="ResetVerification" Grid.Column="1" Content="重新验证" Click="ResetVerificationClicked" Style="{StaticResource Quiet}" Visibility="Collapsed"/></Grid>
        <StackPanel x:Name="MeterPreferences" Visibility="Collapsed"><ComboBox x:Name="Meter" IsEnabled="False" Margin="0,10,0,0"><ComboBoxItem Content="DLY-2202（演示设备）"/></ComboBox><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="校准方式" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="CalibrationMode" Grid.Column="1"><ComboBoxItem Content="现场校准 · 普通教室"/><ComboBoxItem Content="严格校准 · 较稳定测试环境"/></ComboBox></Grid></StackPanel>
       </StackPanel></Border></StackPanel>
       <StackPanel x:Name="CalibrationSampling" Visibility="Collapsed"><Border Style="{StaticResource Section}"><StackPanel><TextBlock x:Name="SamplingTitle" Text="第一段同期采样" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SamplingDescription" Text="不要求全班停止活动，保持仪表与麦克风输入设置不变。" Style="{StaticResource Muted}" Margin="0,8,0,18"/><ProgressBar x:Name="SamplingProgress" Height="8" Minimum="0" Maximum="6" Value="0" Foreground="#147D68"/><TextBlock x:Name="SamplingTime" Text="准备采样" FontSize="18" Margin="0,18,0,8"/><TextBlock Text="演示进度已加速，不读取仪表或麦克风。" Style="{StaticResource Muted}"/><Button Content="模拟 USB 断线" Click="DisconnectClicked" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
       <StackPanel x:Name="CalibrationResult" Visibility="Collapsed"><Border Style="{StaticResource Section}"><StackPanel><TextBlock Text="复核通过，可以确认保存" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="两段偏移一致，复核差 0.3 dB（示例结果）。" Margin="0,12,0,0"/><TextBlock Text="保存后手动与定时自习共用参考；设备或输入设置变化后需重新校准。" Style="{StaticResource Muted}" Margin="0,10,0,0"/><Expander Header="查看采样与复核详情" Margin="0,18,0,0"><TextBlock x:Name="ResultDetails" Text="参考偏移 +102.0 dB&#x0a;独立复核偏移 +102.3 dB&#x0a;单位：估算 dB(A)" Style="{StaticResource Muted}" Margin="0,10,0,0"/></Expander><CheckBox x:Name="ConfirmReference" Content="我已核对示例结果，确认保存演示参考" Margin="0,18,0,0" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"/></StackPanel></Border></StackPanel>
      </Grid></ScrollViewer>
      <Border Grid.Row="2" BorderBrush="#DFE7E1" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CalibrationFooter" Text="步骤 1 / 3" Style="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CalibrationBack" Content="返回设备" Click="CalibrationBackClicked" Margin="0,0,8,0"/><Button x:Name="CalibrationPrimary" Content="下一步：同期采样" IsEnabled="False" Style="{StaticResource Primary}" Click="CalibrationPrimaryClicked"/></StackPanel></Grid></Border>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
