<Window x:Class="NPEduTools.UiPrototype.RecordingWorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NPEduTools · 录课工作区原型" Width="1120" Height="780" MinWidth="640" MinHeight="480"
 WindowStartupLocation="CenterScreen" Background="#F6F8F7" Foreground="#243B30" FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/CommonControls.xaml"/><ResourceDictionary Source="Resources/RecordingControls.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#6D8075"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="20"/></Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5E0D9"/><Setter Property="Foreground" Value="#315342"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#147D68"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#147D68"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#147D68"/><Setter Property="BorderBrush" Value="#147D68"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="10,12"/><Style.Triggers><Trigger Property="Tag" Value="active"><Setter Property="Background" Value="#DFEDE5"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource RecordingChoice}"/>
  <Style TargetType="CheckBox" BasedOn="{StaticResource RecordingCheck}"/>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D5E0D9"/><Setter Property="Background" Value="White"/></Style>
  <Style x:Key="Line" TargetType="Border"><Setter Property="BorderBrush" Value="#E1E8E3"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="0,16"/></Style>
 </ResourceDictionary></Window.Resources>
 <Grid Background="#F6F8F7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Border Background="#FFF4DC" Padding="14,7"><TextBlock Text="录课交互原型 · 示例课表与设备 · 不进行录制或访问学校服务" FontSize="12" Foreground="#846335"/></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavWidth" Width="148"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#EDF2EF" BorderBrush="#DFE7E1" BorderThickness="0,0,1,0" Padding="12,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Image Source="Resources/logo.png" Width="34" Height="34" HorizontalAlignment="Left" Margin="8,0,0,12"/><TextBlock x:Name="Brand" Text="NPEduTools" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="8,0,0,28"/></StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="HomeNav" Style="{StaticResource Nav}" Click="HomeClicked" ToolTip="主页"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"/><TextBlock x:Name="HomeLabel" Text="主页" Margin="12,0,0,0"/></StackPanel></Button>
     <Button x:Name="RecordingNav" Style="{StaticResource Nav}" Click="RecordingClicked" ToolTip="录课"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"/><TextBlock x:Name="RecordingLabel" Text="录课" Margin="12,0,0,0"/></StackPanel></Button>
     <TextBlock x:Name="NavNote" Text="本轮只预览录课。&#x0a;自习等功能保持现有设计。" Style="{StaticResource Muted}" Margin="8,24,0,0"/>
    </StackPanel><Button x:Name="FoldNav" Grid.Row="2" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource Quiet}" ToolTip="展开或折叠导航" Click="FoldClicked"/>
   </Grid></Border>
   <Grid x:Name="ContentArea" Grid.Column="1" Margin="24,20,24,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="PageTitle" Text="录课" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageHint" Text="今天的课，提前安排好。" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SchoolTime" Text="07:25 · 学校时间" FontSize="14" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock x:Name="ClockLabel" Text="ClassIsland 已校时（演示）" Style="{StaticResource Muted}" TextAlignment="Right"/></StackPanel>
    </Grid>
    <Border x:Name="Feedback" Grid.Row="1" Background="#EAF3EC" CornerRadius="5" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed"><TextBlock x:Name="FeedbackText" FontSize="13"/></Border>
    <Grid Grid.Row="2">
     <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="今天的课堂" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="当前录制与下一节安排放在前面，设置需要时再打开。" Style="{StaticResource Muted}"/>
      <Border Style="{StaticResource Line}" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="HomeState" Text="当前没有录制" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="HomeSummary" Style="{StaticResource Muted}" Margin="0,8,0,14"/><Button x:Name="HomePrimary" Content="立即录课" Click="HomePrimaryClicked" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Line}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="下一节自动录课" Style="{StaticResource Muted}"/><TextBlock x:Name="HomeNext" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock x:Name="HomeAuto" Style="{StaticResource Muted}"/></StackPanel><Button x:Name="HomePlan" Grid.Column="1" Content="查看安排" Click="PlanClicked" VerticalAlignment="Center"/></Grid></Border>
      <Border Style="{StaticResource Line}"><StackPanel><TextBlock Text="需要处理" FontWeight="SemiBold"/><TextBlock Text="昨天一节录课未完成，片段仍保留。" Style="{StaticResource Muted}" Margin="0,6,0,12"/><Button x:Name="HomeRecords" Content="查看未完成记录" Click="NeedsAttentionClicked" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,8"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
     <Grid x:Name="RecordingPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,12"><Button x:Name="ManualTab" Content="立即录制" Click="ManualClicked" Margin="0,0,8,6"/><Button x:Name="PlanTab" Content="自动安排" Click="PlanClicked" Margin="0,0,8,6"/><Button x:Name="RecordsTab" Content="录制记录" Click="RecordsClicked" Margin="0,0,0,6"/></WrapPanel>
      <Grid Grid.Row="1">
       <Grid x:Name="ManualPane"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="ManualScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
         <TextBlock x:Name="ManualHeading" Text="立即录一节课" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock x:Name="ManualHint" Text="使用已保存的录制设置。" Style="{StaticResource Muted}"/>
         <Border x:Name="IdleSummary" Style="{StaticResource Line}" Margin="0,12,0,0"><StackPanel><TextBlock Text="画面与声音" Style="{StaticResource Muted}"/><TextBlock x:Name="InputSummary" FontSize="17" Margin="0,7,0,7"/><TextBlock x:Name="FolderSummary" Style="{StaticResource Muted}"/><Button x:Name="OpenSettings" Content="修改录制设置" Click="SettingsClicked" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,8" Margin="0,10,0,0"/></StackPanel></Border>
         <StackPanel x:Name="LiveSummary" Visibility="Collapsed" Margin="0,24,0,0"><TextBlock x:Name="Duration" Text="00:00:00" FontFamily="Consolas" FontSize="54" FontWeight="SemiBold"/><TextBlock x:Name="ActiveSource" FontSize="16" Margin="0,6,0,0"/><Border x:Name="AudioPanel" Background="#EAF3EC" CornerRadius="5" Padding="14" Margin="0,20,0,0"><TextBlock x:Name="AudioStatus"/></Border><TextBlock Text="录制信息" Style="{StaticResource Muted}" Margin="0,20,0,6"/><TextBlock x:Name="LiveSettings" TextWrapping="Wrap"/><TextBlock Text="切到其他页面不会结束这次演示录制。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel>
         <Expander x:Name="DemoTools" Header="演示异常与时点" Margin="0,20,0,0"><WrapPanel Margin="0,10,0,0"><Button x:Name="AudioGap" Content="音频等待恢复" Click="AudioGapClicked" Margin="0,0,8,8"/><Button x:Name="AudioRecovered" Content="演示恢复" Click="AudioRecoveredClicked" Margin="0,0,8,8"/><Button x:Name="FailCapture" Content="演示中断" Click="FailClicked" Margin="0,0,0,8"/></WrapPanel></Expander>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#DFE7E1" BorderThickness="0,1,0,0" Padding="0,14,0,0"><WrapPanel><Button x:Name="StartManual" Content="开始录制" Style="{StaticResource Primary}" Click="StartClicked" Margin="0,0,8,6"/><Button x:Name="Pause" Content="暂停" Click="PauseClicked" Margin="0,0,8,6" Visibility="Collapsed"/><Button x:Name="StopManual" Content="停止并保存" Style="{StaticResource Primary}" Click="StopClicked" Margin="0,0,8,6" Visibility="Collapsed"/><Button x:Name="ViewLastRecord" Content="查看记录" Click="RecordsClicked" Visibility="Collapsed" Margin="0,0,0,6"/></WrapPanel></Border>
       </Grid>
       <Grid x:Name="PlanPane" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="LessonScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <StackPanel>
         <Grid Margin="0,4,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock x:Name="AutoStatus" Text="自动录课未开启" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AutoNext" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button x:Name="ToggleAutomatic" Grid.Column="1" Content="开启自动录课" Click="ToggleAutomaticClicked" VerticalAlignment="Center"/></Grid>
         <WrapPanel Margin="0,0,0,12"><Button x:Name="PreviousDate" Content="‹" Click="PreviousClicked" ToolTip="前一天" Margin="0,0,6,6"/><DatePicker x:Name="PlanDate" Width="156" SelectedDateChanged="DateChanged" Margin="0,0,6,6"/><Button x:Name="NextDate" Content="›" Click="NextClicked" ToolTip="后一天" Margin="0,0,12,6"/><Button x:Name="WeeklyEditor" Content="修改每周安排" Click="WeeklyClicked" Style="{StaticResource Quiet}" Margin="0,0,0,6"/></WrapPanel>
         <TextBlock x:Name="DraftHint" Text="按每周安排生成；当天改动需要保存。" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
        </StackPanel>
        <ItemsControl x:Name="Lessons"><ItemsControl.ItemTemplate><DataTemplate>
         <Border Style="{StaticResource Line}" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="124"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="14"/><TextBlock Text="{Binding Status}" Foreground="#627B6A" FontSize="12" Margin="0,7,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{Binding Subject}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Capture}" Foreground="#506D5B" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="{Binding Reason}" Foreground="#809084" FontSize="11" Margin="0,5,0,0"/></StackPanel>
          <Button Grid.Column="2" Content="{Binding Action}" Tag="{Binding Number}" Click="CourseClicked" VerticalAlignment="Center" MinWidth="82"/>
         </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#DFE7E1" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel><WrapPanel><Button x:Name="SavePlan" Content="保存安排" Style="{StaticResource Primary}" Click="SavePlanClicked" Margin="0,0,8,6"/><Button x:Name="DiscardPlan" Content="撤回未保存改动" Click="DiscardPlanClicked" Margin="0,0,8,6"/><Button x:Name="SkipNext" Content="跳过下一节" Click="SkipNextClicked" Margin="0,0,8,6"/><Button x:Name="Advance" Content="演示到下一课" Click="AdvanceClicked" Style="{StaticResource Quiet}" Margin="0,0,0,6"/></WrapPanel><TextBlock x:Name="PlanFooterHint" Text="跳过下一节不会停止当前手动录制；保存安排与开启自动录课是两个操作。" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
       </Grid>
       <Grid x:Name="RecordsPane" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="录制结果与保留片段" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,6"/><TextBlock Text="这里先演示自动执行记录；本次手动操作生成的记录也是模拟数据。" Style="{StaticResource Muted}"/><ComboBox x:Name="RecordFilter" SelectionChanged="RecordFilterChanged" Margin="0,12,0,12" Width="190" HorizontalAlignment="Left"><ComboBoxItem Content="全部记录"/><ComboBoxItem Content="需要处理"/><ComboBoxItem Content="已保存"/></ComboBox></StackPanel>
        <ScrollViewer x:Name="RecordScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="RecordItems"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Line}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding Subject}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" Margin="0,6,0,0"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,0,8"/><Button Content="查看位置与详情" Tag="{Binding}" Click="RecordDetailsClicked"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Border x:Name="RecordDetail" Grid.Row="2" Background="#EAF3EC" CornerRadius="5" Padding="12" Margin="0,12,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="RecordDetailHeading" FontWeight="SemiBold"/><TextBlock x:Name="RecordPath" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="原型展示位置，不打开或改动真实文件。" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
       </Grid>
      </Grid>
     </Grid>
     <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="620" HorizontalAlignment="Left">
      <TextBlock Text="画面" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,12"/><TextBlock Text="录制屏幕" Style="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="DisplayChoice"><ComboBoxItem Content="教室大屏（演示）"/><ComboBoxItem Content="备用屏幕（演示）"/></ComboBox>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="画质" Style="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="Quality"><ComboBoxItem Content="1080p · 清晰课件"/><ComboBoxItem Content="720p · 更小文件"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="帧率" Style="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="Fps"><ComboBoxItem Content="8 fps · 课件与板书"/><ComboBoxItem Content="15 fps · 更多画面变化"/></ComboBox></StackPanel></Grid>
      <Border Style="{StaticResource Line}"><StackPanel><TextBlock Text="声音" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="Mic" Content="录制麦克风" IsChecked="True"/><ComboBox x:Name="MicChoice" Margin="0,7,0,14"><ComboBoxItem Content="教室麦克风（演示）"/><ComboBoxItem Content="备用麦克风（演示）"/></ComboBox><CheckBox x:Name="Speaker" Content="录制系统声音" IsChecked="True"/><ComboBox x:Name="SpeakerChoice" Margin="0,7,0,0"><ComboBoxItem Content="教室扬声器（演示）"/></ComboBox><TextBlock Text="这些是录课音源，与自习监测的设备配置分别管理。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
      <TextBlock Text="保存位置" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,10"/><TextBox x:Name="Folder" Text="D:\课堂录像"/><TextBlock Text="这里只修改内存中的演示设置，不访问该目录。" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
     </StackPanel></ScrollViewer><WrapPanel Grid.Row="1" Margin="0,14,0,0"><Button x:Name="SaveSettings" Content="保存录制设置" Click="SaveSettingsClicked" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button x:Name="BackSettings" Content="返回录课" Click="BackSettingsClicked"/></WrapPanel></Grid>
     <Grid x:Name="WeeklyPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="每周跟随课表" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="改动先进入草稿；保存安排后生效，自动录课总开关保持原状态。" Style="{StaticResource Muted}"/>
      <TextBlock Text="星期" FontWeight="SemiBold" Margin="0,22,0,10"/><WrapPanel x:Name="Weekdays"/>
      <TextBlock Text="课前、课后余量" FontWeight="SemiBold" Margin="0,22,0,10"/><WrapPanel><TextBlock Text="提前" VerticalAlignment="Center"/><TextBox x:Name="Before" Width="62" Text="2" Margin="8,0"/><TextBlock Text="分钟；结束后最多" VerticalAlignment="Center"/><TextBox x:Name="After" Width="62" Text="5" Margin="8,0"/><TextBlock Text="分钟" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="余量遇到相邻正式课程会自动缩短，不跨进另一节课。" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
      <CheckBox x:Name="DefaultExclusions" Content="使用默认不录科目" IsChecked="True" Margin="0,22,0,8"/><TextBlock x:Name="ExclusionsSummary" Style="{StaticResource Muted}"/>
      <TextBlock Text="其他已有安排" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock Text="固定时段、指定日期和试运行的入口设计留到正式接入时完善；本原型不改变这些功能。" Style="{StaticResource Muted}"/>
     </StackPanel></ScrollViewer><WrapPanel Grid.Row="1" Margin="0,14,0,0"><Button x:Name="ApplyWeekly" Content="应用到安排草稿" Click="ApplyWeeklyClicked" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button x:Name="BackWeekly" Content="返回当天安排" Click="PlanClicked"/></WrapPanel></Grid>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
