<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NPEduTools.ClassIsland.Bridge.Contracts/NPEduTools.ClassIsland.Bridge.Contracts.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <ProjectReference Include="../../src/NPEduTools.Contracts/NPEduTools.Contracts.csproj" />
    <ProjectReference Include="../../src/NPEduTools.ClassIsland.Admin/NPEduTools.ClassIsland.Admin.csproj" />
    <ProjectReference Include="../../src/NPEduTools.Host/NPEduTools.Host.csproj" />
    <ProjectReference Include="../../src/NPEduTools.PowerPoint.Diagnostics/NPEduTools.PowerPoint.Diagnostics.csproj" />
    <ProjectReference Include="../../src/NPEduTools.Cli/NPEduTools.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../NPEduTools.ClassIsland.TestPeer/NPEduTools.ClassIsland.TestPeer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../NPEduTools.GuardFixture/NPEduTools.GuardFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/NPEduTools.Guard/NPEduTools.Guard.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0-windows" />
  </ItemGroup>
  <Target Name="CopyGuardTestBundles" AfterTargets="Build">
    <MSBuild Projects="../NPEduTools.GuardFixture/NPEduTools.GuardFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net10.0">
      <Output TaskParameter="TargetOutputs" ItemName="GuardFixtureTarget" />
    </MSBuild>
    <MSBuild Projects="../../src/NPEduTools.Guard/NPEduTools.Guard.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows">
      <Output TaskParameter="TargetOutputs" ItemName="GuardExecutableTarget" />
    </MSBuild>
    <ItemGroup>
      <GuardFixtureBundle Include="$([System.IO.Path]::GetDirectoryName('%(GuardFixtureTarget.Identity)'))/**/*" />
      <GuardExecutableBundle Include="$([System.IO.Path]::GetDirectoryName('%(GuardExecutableTarget.Identity)'))/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(GuardFixtureBundle)" DestinationFiles="@(GuardFixtureBundle->'$(OutDir)GuardFixture/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(GuardExecutableBundle)" DestinationFiles="@(GuardExecutableBundle->'$(OutDir)GuardExecutable/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <ItemGroup><Using Include="Xunit" /></ItemGroup>
  <ItemGroup>
    <None Include="../../docs/npep/noise-schedule-cases.json" Link="Fixtures/noise-schedule-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/npep/noise-schedule-wire-cases.json" Link="Fixtures/noise-schedule-wire-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/NPEduTools.App/StartupPreferences.cs" Link="App/StartupPreferences.cs" />
    <Compile Include="../../src/NPEduTools.App/ClassroomModePresentation.cs" Link="App/ClassroomModePresentation.cs" />
    <Compile Include="../../src/NPEduTools.App/ClassroomSetupCheck.cs" Link="App/ClassroomSetupCheck.cs" />
    <Compile Include="../../src/NPEduTools.App/OnboardingState.cs" Link="App/OnboardingState.cs" />
    <Compile Include="../../src/NPEduTools.App/AgreementAcceptance.cs" Link="App/AgreementAcceptance.cs" />
    <EmbeddedResource Include="../../docs/legal/*-AGREEMENT.md" LogicalName="NPEduTools.Legal.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="NPEduTools.Legal.GPL-3.0.txt" />
    <Compile Include="../../src/NPEduTools.App/NpepConnectionSession.cs" Link="App/NpepConnectionSession.cs" />
    <Compile Include="../../src/NPEduTools.App/LoginStartup.cs" Link="App/LoginStartup.cs" />
    <Compile Include="../../src/NPEduTools.App/AppLaunchOptions.cs" Link="App/AppLaunchOptions.cs" />
    <Compile Include="../../src/NPEduTools.App/ShortcutCatalog.cs" Link="App/ShortcutCatalog.cs" />
  </ItemGroup>
</Project>
