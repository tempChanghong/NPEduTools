<Window x:Class="NPEduTools.App.ClassroomModeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="课堂模式 · NPEduTools" Width="800" Height="740" MinWidth="520" MinHeight="440" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource TeacherPageBrush}" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="{DynamicResource TeacherFont}" Icon="/Assets/npedutools.ico" UseLayoutRounding="True">
 <ScrollViewer x:Name="ModeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" SizeChanged="ModeSizeChanged"
               AutomationProperties.Name="课堂模式切换与核实">
  <StackPanel Margin="18,12,18,18">
   <!-- 页眉：同窗返回入口与标题同行 -->
   <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
    <Button x:Name="ModeBackButton" Visibility="Collapsed" Click="ModeBackClicked" Style="{StaticResource TeacherQuiet}"
            Padding="8,4" Margin="0,0,10,0" AutomationProperties.AutomationId="ClassroomModeBack" AutomationProperties.Name="返回">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <TextBlock Text="课堂模式" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.HeadingLevel="Level1"/>
    <TextBlock Text="先看切换影响，再核实实际结果。" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
   </WrapPanel>

   <!-- 一、状态、实际结果与恢复置顶卡（警告与重试／恢复／核实按钮常驻首屏） -->
   <Border x:Name="StatusCard" Style="{StaticResource SettingsGroupSurface}" Padding="16,10" Margin="0,0,0,10">
    <StackPanel>
     <Border x:Name="ModeBadge" HorizontalAlignment="Left" Padding="8,2" CornerRadius="6" Margin="0,0,0,6"
             Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1">
      <TextBlock x:Name="ModeTitle" Text="正在连接…" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TeacherTextBrush}"
                 TextWrapping="Wrap" AutomationProperties.AutomationId="ClassroomModeTitle" AutomationProperties.LiveSetting="Polite"/>
     </Border>
     <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="14" AutomationProperties.AutomationId="ClassroomModeStatus" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="OperationFeedbackText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                Foreground="{DynamicResource TeacherWarningBrush}" Margin="0,6,0,0"
                AutomationProperties.AutomationId="ClassroomOperationFeedback" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="PauseText" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>

     <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="0,8,0,6"/>

     <!-- 自启动登记与当前运行／恢复进度分开呈现 -->
     <WrapPanel Margin="0,0,0,4">
      <TextBlock x:Name="ActualClassIslandText" TextWrapping="Wrap" FontSize="13" Margin="0,0,16,2" AutomationProperties.AutomationId="ClassroomActualClassIsland"/>
      <TextBlock x:Name="ActualExamAwareText" TextWrapping="Wrap" FontSize="13" Margin="0,0,16,2" AutomationProperties.AutomationId="ClassroomActualExamAware"/>
      <TextBlock x:Name="ActualCheckedAtText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" VerticalAlignment="Center" Margin="0,0,0,2"
                 AutomationProperties.AutomationId="ClassroomActualCheckedAt"/>
     </WrapPanel>
     <TextBlock x:Name="RuntimeProgressText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TeacherTextBrush}" Margin="0,2,0,2"
                AutomationProperties.AutomationId="ClassroomRuntimeProgress" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="RecoveryText" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="0,2,0,0"/>

     <WrapPanel Margin="0,10,0,0">
      <Button x:Name="RetryButton" Content="重试即时切换" Style="{StaticResource TeacherButton}" Click="RetryClicked" Visibility="Collapsed"
              Margin="0,0,8,4" AutomationProperties.AutomationId="ClassroomRetry"/>
      <Button x:Name="RestoreButton" Content="恢复切换前设置" Style="{StaticResource TeacherButton}" Click="RestoreClicked" IsEnabled="False"
              Margin="0,0,8,4" AutomationProperties.AutomationId="ClassroomRestore"/>
      <Button x:Name="RefreshButton" Content="核实实际设置" Style="{StaticResource TeacherQuiet}" Click="RefreshClicked"
              Margin="0,0,0,4" AutomationProperties.AutomationId="ClassroomRefresh"/>
     </WrapPanel>

     <Expander Header="核实详情与切换说明" Style="{DynamicResource TeacherExpander}" IsExpanded="False"
               AutomationProperties.Name="核实详情与切换说明" Margin="0,6,0,0">
      <StackPanel Margin="0,2,0,0">
       <TextBlock x:Name="ActualText" Text="尚未核实" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,8" AutomationProperties.AutomationId="ClassroomActual"/>
       <TextBlock Text="实际结果只代表核实时刻。自启动登记与当前软件是否运行分别核实。未勾选即时切换时，当前软件不会自动退出；为设置自启动，可能打开 ExamAware2。自动录制正常收尾，手动录制继续。遇到编辑器、放映或弹窗阻止退出时，请处理后重试，不会强制结束进程。手动自习始终使用 Windows 时间。"
                  TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" LineHeight="20"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </Border>

   <!-- 二、即时切换开关贴近双模式影响对比区（宽窗并列，窄窗由 ModeSizeChanged 纵向单列） -->
   <CheckBox x:Name="SwitchRunning" Content="同时切换当前运行的软件" Style="{StaticResource Switch}" IsChecked="False"
             Checked="SwitchOptionsChanged" Unchecked="SwitchOptionsChanged" Margin="2,0,2,8"
             AutomationProperties.AutomationId="ClassroomSwitchRunning"/>

   <Grid x:Name="ModeChoices" Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border x:Name="DailyCard" Style="{StaticResource SettingsGroupSurface}" Padding="16,14" Margin="0,0,12,0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="日常模式" FontSize="17" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
      <StackPanel Grid.Row="1" Margin="0,8,0,8" TextElement.FontSize="13">
       <WrapPanel Margin="0,0,0,3">
        <TextBlock Text="ClassIsland 自启动：开启" Margin="0,0,14,0"/>
        <TextBlock Text="ExamAware2 自启动：关闭"/>
       </WrapPanel>
       <TextBlock Text="自动录课：按原计划判断&#10;学校自习：日常排程 · ClassIsland 时间" TextWrapping="Wrap" LineHeight="20"/>
      </StackPanel>
      <TextBlock Grid.Row="2" x:Name="DailyRuntimePreview" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="DailyRuntimePreview"/>
      <Button Grid.Row="3" x:Name="DailyButton" Content="切换到日常模式" Click="DailyClicked" Style="{StaticResource TeacherButton}"
              HorizontalAlignment="Left" AutomationProperties.AutomationId="ClassroomDaily" IsEnabled="False"/>
     </Grid>
    </Border>

    <Border x:Name="ExamCard" Grid.Column="1" Style="{StaticResource SettingsGroupSurface}" Padding="16,14">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="考试模式" FontSize="17" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
      <StackPanel Grid.Row="1" Margin="0,8,0,8" TextElement.FontSize="13">
       <WrapPanel Margin="0,0,0,3">
        <TextBlock Text="ClassIsland 自启动：暂停" Margin="0,0,14,0"/>
        <TextBlock Text="ExamAware2 自启动：开启"/>
       </WrapPanel>
       <TextBlock Text="自动录课：暂停，保留原计划&#10;学校自习：考试排程 · Windows 时间" TextWrapping="Wrap" LineHeight="20"/>
      </StackPanel>
      <TextBlock Grid.Row="2" x:Name="ExamRuntimePreview" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="ExamRuntimePreview"/>
      <Button Grid.Row="3" x:Name="ExamButton" Content="切换到考试模式" Click="ExamClicked" Style="{StaticResource TeacherButton}"
              HorizontalAlignment="Left" AutomationProperties.AutomationId="ClassroomExam" IsEnabled="False"/>
     </Grid>
    </Border>
   </Grid>

   <!-- 三、低频切换前配置检查（独立细线分隔，可展开） -->
   <Border x:Name="SetupCard" Background="Transparent" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="2,10,2,0">
    <StackPanel>
     <DockPanel>
      <Button x:Name="SetupRefresh" DockPanel.Dock="Right" Content="重新检查" Style="{StaticResource TeacherQuiet}" Click="SetupRefreshClicked"
              AutomationProperties.AutomationId="ClassroomSetupRefresh"/>
      <TextBlock Text="切换前配置检查" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
     </DockPanel>
     <TextBlock x:Name="SetupSummary" Text="打开页面后自动检查。" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}"
                Margin="0,4,0,6" AutomationProperties.AutomationId="ClassroomSetupSummary"/>
     <Expander x:Name="SetupDetails" Header="逐项结果与配置入口" Style="{DynamicResource TeacherExpander}"
               AutomationProperties.AutomationId="ClassroomSetupDetails" AutomationProperties.Name="逐项结果与配置入口">
      <StackPanel Margin="0,6,0,0">
       <TextBlock Text="只读取状态，不启动软件、不修改自启动。结果只代表检查时刻，切换时再次核实。" TextWrapping="Wrap"
                  Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="0,0,0,8"/>
       <ItemsControl x:Name="SetupItems" AutomationProperties.AutomationId="ClassroomSetupItems">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
           <StackPanel>
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
           </StackPanel>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <WrapPanel Margin="0,10,0,0">
        <Button x:Name="SetupClassIslandButton" Style="{StaticResource TeacherButton}" Content="ClassIsland 程序位置" Click="SetupClassIslandClicked" Margin="0,0,8,6" AutomationProperties.AutomationId="ClassroomSetupClassIsland"/>
        <Button x:Name="SetupAdminButton" Style="{StaticResource TeacherButton}" Content="管理员自启动设置" Click="SetupAdminClicked" Margin="0,0,8,6" AutomationProperties.AutomationId="ClassroomSetupAdmin"/>
        <Button x:Name="SetupExamAwareButton" Style="{StaticResource TeacherButton}" Content="考试看板与桥接" Click="SetupExamAwareClicked" Margin="0,0,0,6" AutomationProperties.AutomationId="ClassroomSetupExamAware"/>
       </WrapPanel>
      </StackPanel>
     </Expander>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</Window>
