<Window x:Class="NPEduTools.App.ShortcutEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/npedutools.ico" Title="编辑快捷启动" Width="550" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F5F7F9" Foreground="#202E35" FontFamily="Microsoft YaHei UI" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/RecordingControls.xaml" /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel Margin="28">
    <TextBlock x:Name="Heading" Text="添加快捷启动" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="把常用内容放到屏幕侧边。" FontSize="13" Foreground="#718089" Margin="0,8,0,22" />
    <TextBlock Text="类型" FontSize="13" Margin="0,0,0,8" />
    <ComboBox x:Name="KindBox" Style="{StaticResource RecordingChoice}" SelectedIndex="0" MinHeight="44" FontSize="15" Padding="10" SelectionChanged="KindChanged" AutomationProperties.AutomationId="ShortcutKind">
      <ComboBoxItem Content="应用" Tag="app" />
      <ComboBoxItem Content="文件" Tag="file" />
      <ComboBoxItem Content="网址" Tag="url" />
    </ComboBox>
    <TextBlock Text="名称" FontSize="13" Margin="0,18,0,8" />
    <TextBox x:Name="NameBox" MaxLength="40" AutomationProperties.AutomationId="ShortcutName" AutomationProperties.Name="快捷启动名称" />
    <TextBlock x:Name="TargetLabel" Text="程序位置" FontSize="13" Margin="0,18,0,8" />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="TargetBox" MaxLength="2048" AutomationProperties.AutomationId="ShortcutTarget" AutomationProperties.Name="路径或网址" />
      <Button x:Name="BrowseButton" Grid.Column="1" Content="选择…" Click="BrowseClicked" Margin="8,0,0,0" AutomationProperties.AutomationId="ShortcutBrowse" />
    </Grid>
    <TextBlock x:Name="Hint" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
    <TextBlock x:Name="ErrorText" Foreground="#AD5039" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="ShortcutEditorError" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="取消" IsCancel="True" Margin="0,0,8,0" AutomationProperties.AutomationId="ShortcutCancel" />
      <Button Content="保存" IsDefault="True" Style="{StaticResource Primary}" Click="SaveClicked" AutomationProperties.AutomationId="ShortcutSave" />
    </StackPanel>
  </StackPanel>
</Window>
