<Window x:Class="NPEduTools.App.AgreementsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NPEduTools · 服务与隐私" Icon="/NPEduTools.App;component/Assets/npedutools.ico" Width="980" Height="790" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#F6F8F7" Foreground="#203D32" FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" AutomationProperties.AutomationId="AgreementsWindow">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/RecordingControls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="服务与隐私" FontSize="26" FontWeight="SemiBold" />
      <TextBlock x:Name="Introduction" Text="请阅读并分别确认三份协议。勾选不会自动开启学校互联、录制、麦克风或登录自启动。" TextWrapping="Wrap" Foreground="#657C70" Margin="0,10,0,0" LineHeight="24" />
    </StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Button Content="NPEduTools服务协议" Tag="npedutools-service" Click="ReadClicked" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.AutomationId="ReadAppAgreement" />
        <Button Content="NPEP计划服务协议" Tag="npep-service" Click="ReadClicked" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.AutomationId="ReadNpepService" />
        <Button Content="NPEP计划隐私协议" Tag="npep-privacy" Click="ReadClicked" HorizontalContentAlignment="Left" Margin="0,0,0,16" AutomationProperties.AutomationId="ReadNpepPrivacy" />
        <Button Content="开源许可证 · GPL v3" Tag="gpl-3.0" Click="ReadClicked" HorizontalContentAlignment="Left" Margin="0,0,0,16" AutomationProperties.AutomationId="ReadGplLicense" />
        <TextBlock x:Name="DocumentVersion" Text="协议版本 1.0&#10;生效：2026年10月4日" Foreground="#657C70" TextWrapping="Wrap" LineHeight="24" />
        <TextBlock Text="正文随应用提供，离线也可阅读。学校管理授权不能代替对受影响师生的隐私告知及依法需要的个人或监护人同意。" TextWrapping="Wrap" LineHeight="24" Foreground="#657C70" Margin="0,14,0,12" />
        <Button Content="星火动力官网 ↗" Click="WebsiteClicked" Style="{StaticResource Quiet}" HorizontalAlignment="Left" />
        <TextBlock x:Name="AcceptanceStatus" TextWrapping="Wrap" Foreground="#147D68" LineHeight="22" Margin="0,12,0,0" AutomationProperties.AutomationId="AgreementStatus" />
      </StackPanel></ScrollViewer>
      <Border Grid.Column="2" Background="White" BorderBrush="#E0E8DF" BorderThickness="1" CornerRadius="14" Padding="16">
        <FlowDocumentScrollViewer x:Name="DocumentViewer" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="AgreementDocument" />
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,16,0,12">
      <CheckBox x:Name="AcceptApp" Content="我已阅读并同意《NPEduTools服务协议》" Style="{StaticResource RecordingCheck}" Checked="AcceptanceChanged" Unchecked="AcceptanceChanged" AutomationProperties.AutomationId="AcceptAppAgreement" />
      <CheckBox x:Name="AcceptService" Content="我已阅读并同意《NOVARK POWER EDUCATION PLUS计划服务协议》" Style="{StaticResource RecordingCheck}" Checked="AcceptanceChanged" Unchecked="AcceptanceChanged" AutomationProperties.AutomationId="AcceptNpepService" />
      <CheckBox x:Name="AcceptPrivacy" Content="我已阅读并同意《NOVARK POWER EDUCATION PLUS计划隐私协议》" Style="{StaticResource RecordingCheck}" Checked="AcceptanceChanged" Unchecked="AcceptanceChanged" AutomationProperties.AutomationId="AcceptNpepPrivacy" />
      <TextBlock x:Name="ErrorText" Foreground="#9A422C" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="AgreementError" />
    </StackPanel>
    <DockPanel Grid.Row="3">
      <Button x:Name="ContinueButton" Content="同意并继续设置" Click="ContinueClicked" IsEnabled="False" Style="{StaticResource Primary}" DockPanel.Dock="Right" AutomationProperties.AutomationId="AcceptAgreements" />
      <Button x:Name="DeclineButton" Content="不同意并退出" Click="DeclineClicked" HorizontalAlignment="Left" Style="{StaticResource Quiet}" AutomationProperties.AutomationId="DeclineAgreements" />
    </DockPanel>
  </Grid>
</Window>
