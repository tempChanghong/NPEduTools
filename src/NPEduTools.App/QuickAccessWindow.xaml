<Window x:Class="NPEduTools.App.QuickAccessWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/npedutools.ico" Title="NPEduTools 快捷工具" Width="80" Height="340" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" FontFamily="{DynamicResource TeacherFont}" Foreground="{DynamicResource TeacherTextBrush}" UseLayoutRounding="True" AutomationProperties.AutomationId="QuickAccessWindow">
  <Window.Resources>
    <DataTemplate x:Key="QuickShortcutContent">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource TeacherPageBrush}" Width="28" Height="30" CornerRadius="6" Margin="0,0,7,0" VerticalAlignment="Top">
          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TeacherMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding KindLabel}" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,2,0,0" />
          <TextBlock Text="{Binding Target}" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource TeacherQuiet}">
      <Setter Property="Width" Value="52" /><Setter Property="Height" Value="52" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TeacherMutedBrush}" /><Setter Property="Margin" Value="0,2" />
      <Style.Triggers><Trigger Property="Tag" Value="active"><Setter Property="Background" Value="{DynamicResource TeacherSelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TeacherAccentBrush}" /></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="6">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="0" /><ColumnDefinition x:Name="RightColumn" Width="68" /></Grid.ColumnDefinitions>
    <Border x:Name="Rail" Grid.Column="1" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1" CornerRadius="10" Padding="7,10" VerticalAlignment="Bottom">
      <StackPanel>
        <Button x:Name="EdgeHandle" Style="{StaticResource RailButton}" Background="{DynamicResource TeacherPageBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" Click="HandleClicked" ToolTip="展开快捷面板" AutomationProperties.AutomationId="EdgeHandle" AutomationProperties.Name="展开快捷面板">
          <Grid Width="50" Height="50">
            <TextBlock x:Name="HandleDirection" Text="‹" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TeacherAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,1,0,0" IsHitTestVisible="False" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Image Source="{StaticResource BrandLogoSmall}" Width="24" Height="24" />
              <TextBlock x:Name="RailModeText" Text="未知" FontSize="10" Foreground="{DynamicResource TeacherMutedBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" AutomationProperties.AutomationId="RailClassroomMode" />
            </StackPanel>
          </Grid>
        </Button>
        <Button x:Name="RailFold" Width="52" Height="52" Padding="0" Margin="0,2" Content="缩成把手" FontSize="11" Style="{DynamicResource TeacherQuiet}" Click="FoldClicked" ToolTip="缩成把手" AutomationProperties.AutomationId="CompactQuickAccess" />
        <Button x:Name="RailTools" Style="{StaticResource RailButton}" Click="RailToolsClicked" ToolTip="课堂工具" AutomationProperties.AutomationId="RailTools" AutomationProperties.Name="打开课堂工具">
          <StackPanel><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" /><TextBlock Text="课堂" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
        </Button>
        <Button x:Name="RailShortcuts" Style="{StaticResource RailButton}" Click="RailShortcutsClicked" ToolTip="我的快捷" AutomationProperties.AutomationId="RailShortcuts" AutomationProperties.Name="打开我的快捷"><StackPanel><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" /><TextBlock Text="快捷" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel></Button>
        <Button x:Name="RailSecRandom" Style="{StaticResource RailButton}" Click="RailSecRandomClicked" ToolTip="SecRandom 闪抽一人；未配置时打开配置页" AutomationProperties.AutomationId="RailSecRandomQuickDraw" AutomationProperties.Name="SecRandom 闪抽一人，未配置时打开配置页">
          <StackPanel><TextBlock x:Name="RailSecRandomGlyph" Text="抽" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="闪抽" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
        </Button>
        <Border x:Name="RailSeparator" Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="10,8" />
        <Button x:Name="RailSettings" Style="{StaticResource RailButton}" Click="SettingsClicked" ToolTip="管理与设置" AutomationProperties.AutomationId="RailSettings" AutomationProperties.Name="打开管理与设置"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" /><TextBlock Text="设置" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel></Button>
      </StackPanel>
    </Border>
    <Border x:Name="PanelSurface" Visibility="Collapsed" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="课堂快捷" Foreground="{DynamicResource TeacherTextBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="LayoutButton" Grid.Column="1" Content="布局" FontSize="13" Padding="10,6" Margin="0,0,4,0" Style="{DynamicResource TeacherQuiet}" Click="LayoutClicked" AutomationProperties.AutomationId="QuickLayout" AutomationProperties.Name="布局与位置选项" />
            <Button x:Name="CollapseButton" Grid.Column="2" Content="›" FontSize="25" Width="44" Padding="0" Style="{DynamicResource TeacherQuiet}" Click="CollapseClicked" ToolTip="收起快捷面板" AutomationProperties.AutomationId="CollapseQuick" AutomationProperties.Name="收起快捷面板" />
          </Grid>
          <Border x:Name="LayoutOptions" Visibility="Collapsed" Background="{DynamicResource TeacherPageBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,8,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Button x:Name="LayoutShape" Style="{DynamicResource TeacherButton}" Content="缩成把手" Padding="8,7" Margin="0,0,3,0" Click="LayoutShapeClicked" AutomationProperties.AutomationId="QuickLayoutShape" />
              <Button x:Name="LayoutMove" Grid.Column="1" Style="{DynamicResource TeacherButton}" Content="调整位置" Padding="8,7" Margin="3,0,0,0" Click="LayoutMoveClicked" AutomationProperties.AutomationId="QuickLayoutMove" />
            </Grid>
          </Border>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource TeacherPageBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button x:Name="ToolsTab" Style="{DynamicResource TeacherTab}" Content="课堂工具" Padding="8" Click="ToolsTabClicked" AutomationProperties.AutomationId="QuickToolsTab" Margin="0,0,3,0" />
          <Button x:Name="ShortcutsTab" Style="{DynamicResource TeacherTab}" Grid.Column="1" Content="我的快捷" Padding="8" Click="ShortcutsTabClicked" AutomationProperties.AutomationId="QuickShortcutsTab" Margin="3,0,0,0" />
        </Grid></Border>
        <ScrollViewer x:Name="ToolsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel>
          <Button x:Name="OnboardingEntry" Content="初始设置待完成 · 继续设置  →" Visibility="Collapsed" Click="OnboardingClicked" Style="{DynamicResource TeacherButton}" Margin="0,0,0,12" AutomationProperties.AutomationId="QuickOnboarding" />
          <StackPanel x:Name="TaskStack">
            <Border x:Name="StudyCard" Style="{DynamicResource SettingsGroupSurface}" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <DockPanel><Button x:Name="StudyButton" Style="{DynamicResource TeacherButton}" DockPanel.Dock="Right" Content="查看自习" Padding="10,8" Margin="8,0,0,0" Click="StudyClicked" AutomationProperties.AutomationId="QuickOpenStudy" /><TextBlock x:Name="StudyTitle" Text="自习状态待确认" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                <TextBlock x:Name="StudyStatus" Text="尚未收到后台状态，不能据此判断监测已经停止" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickStudyStatus" />
                <TextBlock x:Name="StudyNext" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border x:Name="RecordingCard" Style="{DynamicResource SettingsGroupSurface}" Padding="12" Margin="0,0,0,8"><StackPanel>
              <DockPanel><Button x:Name="RecordingButton" Style="{DynamicResource TeacherButton}" DockPanel.Dock="Right" Content="录制" Padding="10,8" Margin="8,0,0,0" Click="RecordingClicked" AutomationProperties.AutomationId="QuickOpenRecording" /><TextBlock Text="录课" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
              <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="QuickRecordingPhaseMark" FontSize="13" VerticalAlignment="Top" Margin="0,0,5,0" />
                <TextBlock x:Name="RecordingStatus" Text="录课状态待确认" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}"
                 TextWrapping="Wrap" AutomationProperties.AutomationId="QuickRecordingStatus" />
              </DockPanel>
              <WrapPanel x:Name="RecordingControls" Visibility="Collapsed" Margin="0,8,0,0"><Button x:Name="RecordingPause" MinWidth="98" Style="{DynamicResource TeacherButton}" Content="暂停" Padding="12,8" Click="RecordingPauseClicked" AutomationProperties.AutomationId="QuickRecordingPause" Margin="0,0,6,0" /><Button x:Name="RecordingStop" Style="{DynamicResource TeacherButton}" Content="停止并保存" Padding="12,8" Click="RecordingStopClicked" AutomationProperties.AutomationId="QuickRecordingStop" /></WrapPanel>
              <TextBlock x:Name="AutomaticStatus" Text="自动录制状态待确认" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickAutomaticStatus" />
              <Button x:Name="AutomaticSkipDay" Style="{DynamicResource TeacherButton}" Content="今天不再自动录制" Click="AutomaticSkipDayClicked" Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickAutoSkipDay" />
              <Button Content="自动录课计划  →" Click="RecordingPlanClicked" Style="{DynamicResource TeacherQuiet}" HorizontalAlignment="Left" Padding="8,6" AutomationProperties.AutomationId="QuickRecordingPlan" />
            </StackPanel></Border>
          </StackPanel>
          <TextBlock Text="课堂工具" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,10,0,8" />
          <Button Style="{DynamicResource TeacherButton}" Click="ClassroomModeClicked" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="QuickClassroomMode">
            <StackPanel><TextBlock x:Name="ClassroomModeTitle" Text="课堂模式 · 正在连接…" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickClassroomModeTitle" />
              <TextBlock x:Name="ClassroomModeDetail" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,4,0,0" AutomationProperties.AutomationId="QuickClassroomModeDetail" /></StackPanel>
          </Button>
          <Border Style="{DynamicResource SettingsGroupSurface}" Padding="12" Margin="0,0,0,8"><StackPanel>
            <DockPanel><Button x:Name="PowerButton" Style="{DynamicResource TeacherButton}" DockPanel.Dock="Right" Content="开启辅助" Padding="10,8" Margin="8,0,0,0" Click="PowerClicked" AutomationProperties.AutomationId="QuickTouchPower" /><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="RailStatusDot" Fill="#A5B3AB" Width="6" Height="6" Margin="0,0,6,0" /><TextBlock Text="PPT 触摸翻页" FontSize="14" FontWeight="SemiBold" /></StackPanel></DockPanel>
            <TextBlock x:Name="StatusText" Text="正在连接后台…" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickTouchStatus" />
            <Button x:Name="PauseButton" Style="{DynamicResource TeacherButton}" Content="暂停辅助" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,8" Click="PauseClicked" AutomationProperties.AutomationId="QuickTouchPause" />
          </StackPanel></Border>
          <Button Style="{DynamicResource TeacherButton}" Content="考试看板 · ExamAware2  →" HorizontalContentAlignment="Left" Click="ExamAwareClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="QuickExamAware" />
          <Button Style="{DynamicResource TeacherButton}" Content="点名页面 · SecRandom  →" HorizontalContentAlignment="Left" Click="SecRandomClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="QuickSecRandom" />
          <Border Style="{DynamicResource SettingsGroupSurface}" Padding="12"><StackPanel>
            <DockPanel><Button x:Name="ClassIslandButton" Style="{DynamicResource TeacherButton}" DockPanel.Dock="Right" Content="启动" Padding="10,8" Margin="8,0,0,0" Click="ClassIslandClicked" AutomationProperties.AutomationId="QuickStartClassIsland" /><TextBlock Text="ClassIsland" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            <TextBlock x:Name="ClassIslandStatus" Text="正在连接…" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="ShortcutsPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel>
          <StackPanel x:Name="ShortcutsEmpty" Margin="0,12">
            <TextBlock Text="暂无快捷项" Style="{DynamicResource SettingsLabel}" />
            <TextBlock Text="添加教学软件、课件或网站。" Style="{DynamicResource SettingsHint}" Margin="0,4,0,10" />
            <Button Content="添加快捷启动" Style="{DynamicResource TeacherPrimary}" HorizontalAlignment="Left"
             Click="ManageShortcutsClicked" AutomationProperties.AutomationId="QuickAddShortcut" />
          </StackPanel>
          <ItemsControl x:Name="ShortcutItems">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid x:Name="ShortcutGrid" Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" ContentTemplate="{StaticResource QuickShortcutContent}" HorizontalContentAlignment="Stretch" Style="{DynamicResource TeacherButton}" Padding="8,8" Margin="0,0,4,6" MinHeight="68" ToolTip="{Binding Tip}" Click="ShortcutClicked" AutomationProperties.AutomationId="{Binding OpenId}" AutomationProperties.Name="{Binding Name}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ShortcutStatus" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="QuickShortcutMessage" />
          <Button x:Name="ShortcutRepair" Style="{DynamicResource TeacherButton}" Content="编辑此项" Click="RepairShortcutClicked" Visibility="Collapsed" Margin="0,10,0,0" AutomationProperties.AutomationId="QuickRepairShortcut" />
        </StackPanel></ScrollViewer>
        <Button x:Name="SettingsFooter" Grid.Row="3" Content="管理与设置  →" Margin="0,14,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource TeacherQuiet}" Click="SettingsClicked" AutomationProperties.AutomationId="QuickOpenSettings" />
        <Button x:Name="ShortcutsFooter" Grid.Row="3" Content="管理快捷启动  →" Visibility="Collapsed" Margin="0,14,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource TeacherQuiet}" Click="ManageShortcutsClicked" AutomationProperties.AutomationId="QuickManageShortcuts" />
      </Grid>
    </Border>
    <Border x:Name="MoveHint" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,8,0" MaxHeight="82" VerticalAlignment="Bottom" IsHitTestVisible="False">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="拖动把手，抬手保存" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="轻点把手或 Esc 取消" FontSize="11" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
