<Window x:Class="NPEduTools.App.QuickAccessWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/npedutools.ico" Title="NPEduTools 快捷工具" Width="80" Height="340" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" FontFamily="Microsoft YaHei UI" Foreground="#202E35" UseLayoutRounding="True" AutomationProperties.AutomationId="QuickAccessWindow">
  <Window.Resources>
    <DataTemplate x:Key="QuickShortcutContent">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Background="{Binding Tint}" Width="28" Height="32" CornerRadius="8" Margin="0,0,6,0" VerticalAlignment="Top"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="#718089" Margin="0,3,0,0" /></StackPanel>
      </Grid>
    </DataTemplate>
    <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="52" /><Setter Property="Height" Value="52" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#688174" /><Setter Property="Margin" Value="0,2" />
      <Style.Triggers><Trigger Property="Tag" Value="active"><Setter Property="Background" Value="#E3F0E7" /><Setter Property="Foreground" Value="#1C6C54" /></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="6">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="0" /><ColumnDefinition x:Name="RightColumn" Width="68" /></Grid.ColumnDefinitions>
    <Border x:Name="Rail" Grid.Column="1" Background="#FAFCFA" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="20" Padding="7,10" VerticalAlignment="Bottom">
      <StackPanel>
        <Button x:Name="EdgeHandle" Style="{StaticResource RailButton}" Background="#147D68" Foreground="White" Click="HandleClicked" ToolTip="点击展开或收起；拖动调整位置" AutomationProperties.AutomationId="EdgeHandle" AutomationProperties.Name="展开快捷工具，可上下拖动">
          <StackPanel><Image Source="{StaticResource BrandLogoLight}" Width="30" Height="30" /><TextBlock x:Name="RailModeText" Text="未知" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0" AutomationProperties.AutomationId="RailClassroomMode" /></StackPanel>
        </Button>
        <Button x:Name="RailFold" Width="52" Height="28" Padding="0" Margin="0,2" Content="收起" FontSize="11" Style="{StaticResource Quiet}" Click="FoldClicked" ToolTip="折叠为快捷把手" AutomationProperties.AutomationId="CompactQuickAccess" AutomationProperties.Name="折叠或恢复快捷侧栏" />
        <Button x:Name="RailTools" Style="{StaticResource RailButton}" Click="RailToolsClicked" ToolTip="课堂工具" AutomationProperties.AutomationId="RailTools" AutomationProperties.Name="打开课堂工具">
          <StackPanel><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" /><TextBlock Text="课堂" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
        </Button>
        <Button x:Name="RailShortcuts" Style="{StaticResource RailButton}" Click="RailShortcutsClicked" ToolTip="我的快捷" AutomationProperties.AutomationId="RailShortcuts" AutomationProperties.Name="打开我的快捷"><StackPanel><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" /><TextBlock Text="快捷" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel></Button>
        <Button x:Name="RailSecRandom" Style="{StaticResource RailButton}" Click="RailSecRandomClicked" ToolTip="SecRandom 闪抽一人；未配置时打开配置页" AutomationProperties.AutomationId="RailSecRandomQuickDraw" AutomationProperties.Name="SecRandom 闪抽一人，未配置时打开配置页">
          <StackPanel><TextBlock x:Name="RailSecRandomGlyph" Text="抽" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="闪抽" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
        </Button>
        <Border x:Name="RailSeparator" Height="1" Background="#E2E9E4" Margin="10,8" />
        <Button x:Name="RailSettings" Style="{StaticResource RailButton}" Click="SettingsClicked" ToolTip="管理与设置" AutomationProperties.AutomationId="RailSettings" AutomationProperties.Name="打开管理与设置"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" /><TextBlock Text="设置" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel></Button>
      </StackPanel>
    </Border>
    <Border x:Name="PanelSurface" Visibility="Collapsed" Background="#FAFCFA" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="20" Padding="20" Margin="0,0,8,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="课堂快捷" Foreground="#2E4F3D" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="CollapseButton" Grid.Column="1" Content="›" FontSize="25" Width="44" Padding="0" Style="{StaticResource Quiet}" Click="CollapseClicked" AutomationProperties.AutomationId="CollapseQuick" AutomationProperties.Name="收起快捷工具" />
        </Grid>
        <Border Grid.Row="1" Background="#EDF2EE" CornerRadius="12" Padding="4" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button x:Name="ToolsTab" Content="课堂工具" Padding="8" Click="ToolsTabClicked" AutomationProperties.AutomationId="QuickToolsTab" Margin="0,0,3,0" />
          <Button x:Name="ShortcutsTab" Grid.Column="1" Content="我的快捷" Padding="8" Click="ShortcutsTabClicked" AutomationProperties.AutomationId="QuickShortcutsTab" Margin="3,0,0,0" />
        </Grid></Border>
        <ScrollViewer x:Name="ToolsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel>
          <Button x:Name="OnboardingEntry" Content="初始设置待完成 · 继续设置  →" Visibility="Collapsed" Click="OnboardingClicked" Background="#E5F0E5" Foreground="#276B51" Margin="0,0,0,12" AutomationProperties.AutomationId="QuickOnboarding" />
          <StackPanel x:Name="TaskStack">
            <Border x:Name="StudyCard" Background="#EDF5F0" CornerRadius="12" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <DockPanel><Button x:Name="StudyButton" DockPanel.Dock="Right" Content="查看自习" Padding="10,8" Margin="8,0,0,0" Click="StudyClicked" AutomationProperties.AutomationId="QuickOpenStudy" /><TextBlock x:Name="StudyTitle" Text="自习状态待确认" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                <TextBlock x:Name="StudyStatus" Text="尚未收到后台状态，不能据此判断监测已经停止" FontSize="12" Foreground="#718089" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickStudyStatus" />
                <TextBlock x:Name="StudyNext" FontSize="12" Foreground="#718089" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border x:Name="RecordingCard" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8"><StackPanel>
              <DockPanel><Button x:Name="RecordingButton" DockPanel.Dock="Right" Content="录制" Padding="10,8" Margin="8,0,0,0" Click="RecordingClicked" AutomationProperties.AutomationId="QuickOpenRecording" /><TextBlock Text="录课" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
              <TextBlock x:Name="RecordingStatus" Text="录课状态待确认" FontSize="12" Foreground="#718089" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickRecordingStatus" />
              <WrapPanel x:Name="RecordingControls" Visibility="Collapsed" Margin="0,8,0,0"><Button x:Name="RecordingPause" Content="暂停" Padding="12,8" Click="RecordingPauseClicked" AutomationProperties.AutomationId="QuickRecordingPause" Margin="0,0,6,0" /><Button x:Name="RecordingStop" Content="停止并保存" Padding="12,8" Click="RecordingStopClicked" AutomationProperties.AutomationId="QuickRecordingStop" /></WrapPanel>
              <TextBlock x:Name="AutomaticStatus" Text="自动录制状态待确认" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickAutomaticStatus" />
              <Button x:Name="AutomaticSkipDay" Content="今天不再自动录制" Click="AutomaticSkipDayClicked" Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickAutoSkipDay" />
              <Button Content="自动录课计划  →" Click="RecordingPlanClicked" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,6" AutomationProperties.AutomationId="QuickRecordingPlan" />
            </StackPanel></Border>
          </StackPanel>
          <TextBlock Text="课堂工具" FontSize="12" Foreground="#718089" Margin="0,10,0,8" />
          <Button Click="ClassroomModeClicked" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="QuickClassroomMode">
            <StackPanel><TextBlock x:Name="ClassroomModeTitle" Text="课堂模式 · 正在连接…" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickClassroomModeTitle" />
              <TextBlock x:Name="ClassroomModeDetail" TextWrapping="Wrap" FontSize="12" Foreground="#718089" Margin="0,4,0,0" AutomationProperties.AutomationId="QuickClassroomModeDetail" /></StackPanel>
          </Button>
          <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8"><StackPanel>
            <DockPanel><Button x:Name="PowerButton" DockPanel.Dock="Right" Content="开启辅助" Padding="10,8" Margin="8,0,0,0" Click="PowerClicked" AutomationProperties.AutomationId="QuickTouchPower" /><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="RailStatusDot" Fill="#A5B3AB" Width="6" Height="6" Margin="0,0,6,0" /><TextBlock Text="PPT 触摸翻页" FontSize="14" FontWeight="SemiBold" /></StackPanel></DockPanel>
            <TextBlock x:Name="StatusText" Text="正在连接后台…" FontSize="12" Foreground="#718089" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickTouchStatus" />
            <Button x:Name="PauseButton" Content="暂停辅助" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,8" Click="PauseClicked" AutomationProperties.AutomationId="QuickTouchPause" />
          </StackPanel></Border>
          <Button Content="考试看板 · ExamAware2  →" HorizontalContentAlignment="Left" Click="ExamAwareClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="QuickExamAware" />
          <Button Content="点名页面 · SecRandom  →" HorizontalContentAlignment="Left" Click="SecRandomClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="QuickSecRandom" />
          <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel>
            <DockPanel><Button x:Name="ClassIslandButton" DockPanel.Dock="Right" Content="启动" Padding="10,8" Margin="8,0,0,0" Click="ClassIslandClicked" AutomationProperties.AutomationId="QuickStartClassIsland" /><TextBlock Text="ClassIsland" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            <TextBlock x:Name="ClassIslandStatus" Text="正在连接…" FontSize="12" Foreground="#718089" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="ShortcutsPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel>
          <StackPanel x:Name="ShortcutsEmpty" Margin="4,24">
            <Border Width="54" Height="54" CornerRadius="16" Background="#E9F1EA" HorizontalAlignment="Left"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#649576" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="把常用内容放到这里" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,0" />
            <TextBlock Text="应用、课件、教学网站。&#x0A;整理一次，上课时随手打开。" FontSize="13" Foreground="#718089" TextWrapping="Wrap" Margin="0,12,0,20" />
            <Button Content="添加快捷启动" Style="{StaticResource Primary}" Click="ManageShortcutsClicked" AutomationProperties.AutomationId="QuickAddShortcut" />
          </StackPanel>
          <ItemsControl x:Name="ShortcutItems">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid x:Name="ShortcutGrid" Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" ContentTemplate="{StaticResource QuickShortcutContent}" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#E5EBE7" Padding="8,10" Margin="0,0,4,6" MinHeight="68" ToolTip="{Binding Tip}" Click="ShortcutClicked" AutomationProperties.AutomationId="{Binding OpenId}" AutomationProperties.Name="{Binding Name}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ShortcutStatus" FontSize="12" Foreground="#718089" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="QuickShortcutMessage" />
          <Button x:Name="ShortcutRepair" Content="编辑此项" Click="RepairShortcutClicked" Visibility="Collapsed" Margin="0,10,0,0" AutomationProperties.AutomationId="QuickRepairShortcut" />
        </StackPanel></ScrollViewer>
        <Button x:Name="SettingsFooter" Grid.Row="3" Content="管理与设置  →" Margin="0,14,0,0" HorizontalAlignment="Stretch" Style="{StaticResource Quiet}" Click="SettingsClicked" AutomationProperties.AutomationId="QuickOpenSettings" />
        <Button x:Name="ShortcutsFooter" Grid.Row="3" Content="管理快捷启动  →" Visibility="Collapsed" Margin="0,14,0,0" HorizontalAlignment="Stretch" Style="{StaticResource Quiet}" Click="ManageShortcutsClicked" AutomationProperties.AutomationId="QuickManageShortcuts" />
      </Grid>
    </Border>
  </Grid>
</Window>
