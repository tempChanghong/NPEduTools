<Window x:Class="NPEduTools.App.QuickAccessWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/npedutools.ico" Title="NPEduTools 快捷工具" Width="80" Height="340" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" FontFamily="{DynamicResource TeacherFont}" Foreground="{DynamicResource TeacherTextBrush}" UseLayoutRounding="True" AutomationProperties.AutomationId="QuickAccessWindow">
  <Window.Resources>
    <Style x:Key="QuickScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuickScrollThumb" TargetType="Thumb">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="Transparent" Padding="0,2">
              <Border x:Name="Pill" HorizontalAlignment="Center" Width="6" CornerRadius="4"
                      Background="{DynamicResource TeacherMutedBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Width" Value="9" />
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource TeacherAccentBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Pill" Property="Width" Value="9" />
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource TeacherAccentHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <!-- Keep the full system slot for hit testing and the fixed PPT card's reserved gutter. -->
          <Setter Property="Width" Value="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent" SnapsToDevicePixels="True">
                  <Border x:Name="Groove" Width="6" HorizontalAlignment="Center" CornerRadius="4" Margin="0,2"
                          Background="{DynamicResource TeacherPageBrush}" IsHitTestVisible="False" />
                  <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource QuickScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource QuickScrollThumb}" /></Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource QuickScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                    <Setter TargetName="Groove" Property="Width" Value="11" />
                    <Setter TargetName="Groove" Property="BorderBrush" Value="{DynamicResource TeacherLineBrush}" />
                    <Setter TargetName="Groove" Property="BorderThickness" Value="1" />
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="QuickShortcutContent">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource TeacherPageBrush}" Width="28" Height="28" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TeacherMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding CompactTarget}" FontSize="11.5" Foreground="{DynamicResource TeacherMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource TeacherQuiet}">
      <Setter Property="Width" Value="52" /><Setter Property="Height" Value="52" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TeacherMutedBrush}" /><Setter Property="Margin" Value="0,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <Border x:Name="ActiveBar" Width="3" Height="20" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0"
                      Background="{DynamicResource TeacherSelectedTextBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
              <Border x:Name="FocusRing" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2" CornerRadius="9" Margin="1"
                      Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TeacherHoverBrush}" />
              </Trigger>
              <Trigger Property="Tag" Value="active-left">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TeacherSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TeacherSelectedTextBrush}" />
                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="ActiveBar" Property="HorizontalAlignment" Value="Left" />
              </Trigger>
              <Trigger Property="Tag" Value="active-right">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TeacherSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TeacherSelectedTextBrush}" />
                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="ActiveBar" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TeacherSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TeacherSelectedTextBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RailIcon" TargetType="Path">
      <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="StrokeThickness" Value="1.5" /><Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="RailCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
  </Window.Resources>
  <Grid Margin="6">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="0" /><ColumnDefinition x:Name="RightColumn" Width="68" /></Grid.ColumnDefinitions>
    <Border x:Name="Rail" Grid.Column="1" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1" CornerRadius="14" Padding="6,8" VerticalAlignment="Bottom">
      <StackPanel>
        <Button x:Name="EdgeHandle" Style="{StaticResource RailButton}" Background="{DynamicResource TeacherPageBrush}" Click="HandleClicked" ToolTip="展开快捷面板" AutomationProperties.AutomationId="EdgeHandle" AutomationProperties.Name="展开快捷面板">
          <Grid Width="50" Height="50">
            <TextBlock x:Name="HandleDirection" Text="‹" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TeacherAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Image Source="{StaticResource BrandLogoSmall}" Width="24" Height="24" />
              <TextBlock x:Name="RailModeText" Text="未知" FontSize="11" Foreground="{DynamicResource TeacherMutedBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" AutomationProperties.AutomationId="RailClassroomMode" />
            </StackPanel>
          </Grid>
        </Button>
        <Button x:Name="RailTools" Style="{StaticResource RailButton}" Click="RailToolsClicked" ToolTip="课堂工具" AutomationProperties.AutomationId="RailTools" AutomationProperties.Name="打开课堂工具">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M2,3.5 H16 V12.5 H2 Z M6,15.5 H12 M9,12.5 V15.5" />
            <TextBlock Text="课堂" Style="{StaticResource RailCaption}" />
          </StackPanel>
        </Button>
        <Button x:Name="RailShortcuts" Style="{StaticResource RailButton}" Click="RailShortcutsClicked" ToolTip="我的快捷" AutomationProperties.AutomationId="RailShortcuts" AutomationProperties.Name="打开我的快捷">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M10.5,3 H15 V7.5 M15,3 L8.5,9.5 M14,10 V14.5 H3.5 V4 H8" />
            <TextBlock Text="快捷" Style="{StaticResource RailCaption}" />
          </StackPanel>
        </Button>
        <Button x:Name="RailSecRandom" Style="{StaticResource RailButton}" Click="RailSecRandomClicked" ToolTip="闪抽一人" AutomationProperties.AutomationId="RailSecRandomQuickDraw" AutomationProperties.Name="闪抽一人">
          <StackPanel Width="44">
            <Grid Width="18" Height="18" HorizontalAlignment="Center">
              <Path x:Name="RailSecRandomIcon" Style="{StaticResource RailIcon}" Data="M5,6 H13 Q15,6 15,8 V14 Q15,16 13,16 H5 Q3,16 3,14 V8 Q3,6 5,6 Z M5.5,3 H13 Q17,3 17,7 V12 M6,10 H12 M6,13 H10" />
              <Path x:Name="RailSecRandomPendingIcon" Style="{StaticResource RailIcon}" Stroke="{DynamicResource TeacherWarningBrush}" Visibility="Collapsed" Data="M9,2.5 L15.5,14.5 H2.5 Z M9,7 V10.2 M9,12.5 H9.01" />
            </Grid>
            <TextBlock x:Name="RailSecRandomLabel" Text="闪抽" Style="{StaticResource RailCaption}" />
          </StackPanel>
        </Button>
        <Border x:Name="RailSeparator" Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="10,6" />
        <Button x:Name="RailSettings" Style="{StaticResource RailButton}" Click="SettingsClicked" ToolTip="管理与设置" AutomationProperties.AutomationId="RailSettings" AutomationProperties.Name="打开管理与设置">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M7.5,2 H10.5 L11.1,4.2 L12.4,4.8 L14.5,3.7 L16.4,5.6 L15.3,7.7 L15.8,8.9 L18,9.5 V12.3 L15.8,12.8 L15.2,14.2 L16.3,16.2 L14.3,18 L12.3,16.9 L11,17.4 L10.5,19.6 H7.5 L7,17.4 L5.7,16.9 L3.7,18 L1.7,16.2 L2.8,14.2 L2.2,12.8 L0,12.3 V9.5 L2.2,8.9 L2.7,7.7 L1.6,5.6 L3.5,3.7 L5.6,4.8 L6.9,4.2 Z M9,8 A2.8,2.8 0 1 0 9,13.6 A2.8,2.8 0 1 0 9,8 Z" />
            <TextBlock Text="设置" Style="{StaticResource RailCaption}" />
          </StackPanel>
        </Button>
        <Button x:Name="RailFold" Style="{StaticResource RailButton}" Click="FoldClicked" ToolTip="缩成把手" AutomationProperties.AutomationId="CompactQuickAccess" AutomationProperties.Name="缩成把手">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M3,4 V14 M15,4 V14 M3,9 H7 M5,7 L7,9 L5,11 M15,9 H11 M13,7 L11,9 L13,11" />
            <TextBlock Text="把手" Style="{StaticResource RailCaption}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <Border x:Name="PanelSurface" Visibility="Collapsed" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
      <Grid><Grid x:Name="QuickPanelContent">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="课堂快捷" Foreground="{DynamicResource TeacherTextBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="LayoutButton" Grid.Column="1" Content="布局" FontSize="13" Padding="10,6" Margin="0,0,4,0" Style="{DynamicResource TeacherQuiet}" Click="LayoutClicked" AutomationProperties.AutomationId="QuickLayout" AutomationProperties.Name="布局与位置选项" />
            <Button x:Name="CollapseButton" Grid.Column="2" Content="›" FontSize="25" Width="44" Padding="0" Style="{DynamicResource TeacherQuiet}" Click="CollapseClicked" ToolTip="收起快捷面板" AutomationProperties.AutomationId="CollapseQuick" AutomationProperties.Name="收起快捷面板" />
          </Grid>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource TeacherPageBrush}" CornerRadius="8" Padding="3" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button x:Name="ToolsTab" Style="{DynamicResource TeacherTab}" Content="课堂工具" Padding="8" Click="ToolsTabClicked" AutomationProperties.AutomationId="QuickToolsTab" Margin="0,0,3,0" />
          <Button x:Name="ShortcutsTab" Style="{DynamicResource TeacherTab}" Grid.Column="1" Content="我的快捷" Padding="8" Click="ShortcutsTabClicked" AutomationProperties.AutomationId="QuickShortcutsTab" Margin="3,0,0,0" />
        </Grid></Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="PptQuickStrip" Style="{DynamicResource SettingsGroupSurface}" Padding="10,8" Margin="0,0,6,8"
                  AutomationProperties.AutomationId="QuickPptStrip">
            <Grid x:Name="PptStripLayout">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PptInlineActionColumn" Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid x:Name="PptHeaderLayout" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="PptTitleColumn" Width="*" />
                  <ColumnDefinition x:Name="PptStatusColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse x:Name="RailStatusDot" Fill="#A5B3AB" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="PPT 触摸翻页" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="正在连接后台…" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}"
                           TextTrimming="CharacterEllipsis" TextAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0"
                           AutomationProperties.AutomationId="QuickTouchStatus" />
              </Grid>
              <Grid x:Name="PptActionLayout" Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="PptActionPrimaryColumn" Width="0" />
                  <ColumnDefinition x:Name="PptActionGapColumn" Width="0" />
                  <ColumnDefinition x:Name="PptActionSecondaryColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button x:Name="PauseButton" Style="{DynamicResource TeacherPrimary}" Content="暂停辅助" Padding="10,0"
                        Visibility="Collapsed" IsEnabled="False" Click="PauseClicked" AutomationProperties.AutomationId="QuickTouchPause" />
                <Button x:Name="PowerButton" Grid.Column="2" Style="{DynamicResource TeacherButton}" Content="开启辅助" Padding="12,0"
                        IsEnabled="False" Click="PowerClicked" AutomationProperties.AutomationId="QuickTouchPower" />
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="1" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" IsHitTestVisible="False" />
        </Grid>
        <ScrollViewer x:Name="ToolsPage" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
          <Button x:Name="OnboardingEntry" Content="初始设置待完成 · 继续设置  →" Visibility="Collapsed" Click="OnboardingClicked" Style="{DynamicResource TeacherButton}" Margin="0,0,0,8" AutomationProperties.AutomationId="QuickOnboarding" />
          <StackPanel x:Name="TaskStack">
            <Border x:Name="StudyCard" Style="{DynamicResource SettingsGroupSurface}" Padding="10,8" Margin="0,0,0,8">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="StudyButton" Style="{DynamicResource TeacherButton}" DockPanel.Dock="Right" Content="查看自习" Padding="10,6"
                          Margin="8,0,0,0" Click="StudyClicked" AutomationProperties.AutomationId="QuickOpenStudy" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StudyTitle" Text="自习状态待确认" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StudyStatus" Text="等待连接后台" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}"
                               TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="QuickStudyStatus" />
                  </StackPanel>
                </DockPanel>
                <TextBlock x:Name="StudyNext" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <Border x:Name="RecordingCard" Style="{DynamicResource SettingsGroupSurface}" Padding="10,8" Margin="0,0,0,8"><StackPanel>
              <DockPanel>
                <Button x:Name="RecordingButton" Style="{DynamicResource TeacherButton}" DockPanel.Dock="Right" Content="录制" Padding="10,6"
                        Margin="8,0,0,0" Click="RecordingClicked" AutomationProperties.AutomationId="QuickOpenRecording" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="录课" FontSize="14" FontWeight="SemiBold" />
                  <DockPanel>
                    <TextBlock x:Name="QuickRecordingPhaseMark" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Grid>
                      <TextBlock x:Name="RecordingStatus" Text="录课状态待确认" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}"
                                 TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="QuickRecordingStatus" />
                      <TextBlock x:Name="RecordingConfirmationText" Text="结束本场？" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TeacherWarningBrush}" TextTrimming="CharacterEllipsis"
                                 Visibility="Collapsed" AutomationProperties.AutomationId="QuickRecordingConfirmationText" />
                    </Grid>
                  </DockPanel>
                </StackPanel>
              </DockPanel>
              <Grid>
                <WrapPanel x:Name="RecordingControls" Visibility="Collapsed" Margin="0,8,0,0">
                  <Button x:Name="RecordingPause" Width="104" MinHeight="55" Content="暂停" Padding="10,6" Margin="0,0,12,0"
                          Style="{DynamicResource TeacherButton}" Click="RecordingPauseClicked" AutomationProperties.AutomationId="QuickRecordingPause" />
                  <Button x:Name="RecordingStop" Width="120" MinHeight="55" Content="停止并保存" Padding="10,6"
                          Style="{DynamicResource TeacherButton}" Click="RecordingStopClicked" AutomationProperties.AutomationId="QuickRecordingStop" />
                </WrapPanel>
                <WrapPanel x:Name="RecordingStopConfirmation" Visibility="Collapsed" Margin="0,8,0,0"
                           AutomationProperties.AutomationId="QuickRecordingStopConfirmation">
                  <Button x:Name="RecordingConfirmStop" Width="104" MinHeight="55" Content="确认停止" Padding="10,6" Margin="0,0,12,0"
                          Style="{DynamicResource TeacherButton}" BorderBrush="{DynamicResource TeacherErrorBrush}"
                          Foreground="{DynamicResource TeacherErrorBrush}" Click="RecordingConfirmStopClicked"
                          AutomationProperties.AutomationId="QuickRecordingConfirmStop" />
                  <Button x:Name="RecordingCancelStop" Width="120" MinHeight="55" Content="返回" Padding="10,6"
                          Style="{DynamicResource TeacherButton}" Click="RecordingCancelStopClicked" AutomationProperties.AutomationId="QuickRecordingCancelStop" />
                </WrapPanel>
              </Grid>
              <Expander x:Name="AutomaticRecordingDetails" Style="{DynamicResource TeacherExpander}" IsExpanded="False"
                        Margin="0,6,0,0" Header="自动录课与计划" AutomationProperties.AutomationId="QuickAutomaticRecordingDetails">
                <StackPanel>
                  <TextBlock x:Name="AutomaticStatus" Text="自动录制状态待确认" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.AutomationId="QuickAutomaticStatus" />
                  <Button x:Name="AutomaticSkipDay" Style="{DynamicResource TeacherButton}" Content="今天不再自动录制" Click="AutomaticSkipDayClicked" Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.AutomationId="QuickAutoSkipDay" />
                  <Button Content="自动录课计划  →" Click="RecordingPlanClicked" Style="{DynamicResource TeacherQuiet}" HorizontalAlignment="Left" Padding="8,6" AutomationProperties.AutomationId="QuickRecordingPlan" />
                </StackPanel>
              </Expander>
            </StackPanel></Border>
          </StackPanel>
          <TextBlock Text="课堂工具" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,10,0,8" />
          <Button Style="{DynamicResource TeacherButton}" Click="ClassroomModeClicked" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="QuickClassroomMode">
            <StackPanel><TextBlock x:Name="ClassroomModeTitle" Text="课堂模式 · 正在连接…" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickClassroomModeTitle" />
              <TextBlock x:Name="ClassroomModeDetail" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,4,0,0" AutomationProperties.AutomationId="QuickClassroomModeDetail" /></StackPanel>
          </Button>
          <Button Style="{DynamicResource TeacherButton}" Content="考试看板 · ExamAware2  →" HorizontalContentAlignment="Left" Click="ExamAwareClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="QuickExamAware" />
          <Button Style="{DynamicResource TeacherButton}" Content="点名页面 · SecRandom  →" HorizontalContentAlignment="Left" Click="SecRandomClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="QuickSecRandom" />
          <Border Style="{DynamicResource SettingsGroupSurface}" Padding="12"><StackPanel>
            <DockPanel><Button x:Name="ClassIslandButton" Style="{DynamicResource TeacherButton}" DockPanel.Dock="Right" Content="启动" Padding="10,8" Margin="8,0,0,0" Click="ClassIslandClicked" AutomationProperties.AutomationId="QuickStartClassIsland" /><TextBlock Text="ClassIsland" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            <TextBlock x:Name="ClassIslandStatus" Text="正在连接…" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel></Border>
          <Button x:Name="SettingsFooter" Content="管理与设置  →" Margin="0,10,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource TeacherQuiet}" Click="SettingsClicked" AutomationProperties.AutomationId="QuickOpenSettings" />
        </StackPanel>
          <Border Grid.Column="1" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" IsHitTestVisible="False">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=ToolsPage}" Value="Visible">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
        </Grid></ScrollViewer>
        <ScrollViewer x:Name="ShortcutsPage" Grid.Row="3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel>
          <StackPanel x:Name="ShortcutsEmpty" Margin="0,10">
            <TextBlock Text="暂无快捷项" Style="{DynamicResource SettingsLabel}" Margin="0,0,0,8" />
            <Button Content="添加快捷项" Style="{DynamicResource TeacherPrimary}" HorizontalAlignment="Left" MinHeight="55"
             Click="ManageShortcutsClicked" AutomationProperties.AutomationId="QuickAddShortcut" />
          </StackPanel>
          <ItemsControl x:Name="ShortcutItems">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid x:Name="ShortcutGrid" Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Content="{Binding}" ContentTemplate="{StaticResource QuickShortcutContent}" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Center" Style="{DynamicResource TeacherButton}" Padding="8,6" Margin="0,0,4,5" MinHeight="56"
                      ToolTip="{Binding Tip}" Click="ShortcutClicked" AutomationProperties.AutomationId="{Binding OpenId}"
                      AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding CompactTarget}" />
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel></ScrollViewer>
        <Grid x:Name="ShortcutsPanelFooter" Grid.Row="4" Visibility="Collapsed" Height="56" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="ShortcutStatus" FontSize="12.5" LineHeight="17" MaxHeight="36"
                     Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Visibility="Hidden" AutomationProperties.AutomationId="QuickShortcutMessage" />
          <Button x:Name="ShortcutRepair" Grid.Column="1" Style="{DynamicResource TeacherButton}" Content="编辑此项"
                  Click="RepairShortcutClicked" Visibility="Collapsed" MinHeight="55" Padding="8,5" Margin="6,0,0,0"
                  VerticalAlignment="Center" AutomationProperties.AutomationId="QuickRepairShortcut" />
          <Button x:Name="ShortcutsFooter" Grid.ColumnSpan="3" Content="管理快捷启动  →" MinHeight="55" MinWidth="55" Padding="6,5"
                  Style="{DynamicResource TeacherQuiet}" Click="ManageShortcutsClicked" ToolTip="管理快捷启动"
                  AutomationProperties.Name="管理快捷启动" AutomationProperties.AutomationId="QuickManageShortcuts" />
        </Grid>
      </Grid>
        <Grid x:Name="LayoutOptions" Visibility="Collapsed" AutomationProperties.AutomationId="QuickLayoutPanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="LayoutBack" Style="{DynamicResource TeacherQuiet}" Content="‹ 返回" FontSize="14"
                    MinWidth="76" MinHeight="55" Padding="12,0" Margin="0,0,8,0"
                    Click="LayoutBackClicked" AutomationProperties.AutomationId="QuickLayoutBack"
                    AutomationProperties.Name="返回课堂快捷" />
            <TextBlock Grid.Column="1" Text="侧栏布局" Foreground="{DynamicResource TeacherTextBrush}"
                       FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel>
              <Border Style="{DynamicResource SettingsGroupSurface}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="停靠位置" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,0,0,8" />
                  <Border Background="{DynamicResource TeacherPageBrush}" CornerRadius="8" Padding="4">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <Button x:Name="LayoutLeft" Style="{DynamicResource TeacherTab}" Content="靠左"
                              MinHeight="55" Padding="12,8" Margin="0,0,4,0" Click="LayoutSideClicked"
                              AutomationProperties.AutomationId="QuickLayoutLeft" AutomationProperties.Name="停靠到左侧" />
                      <Button x:Name="LayoutRight" Grid.Column="1" Style="{DynamicResource TeacherTab}" Content="靠右"
                              MinHeight="55" Padding="12,8" Margin="4,0,0,0" Click="LayoutSideClicked"
                              AutomationProperties.AutomationId="QuickLayoutRight" AutomationProperties.Name="停靠到右侧" />
                    </Grid>
                  </Border>
                  <TextBlock x:Name="LayoutSaveError" Text="未能保存侧栏位置，请重试。" Visibility="Collapsed" TextWrapping="Wrap"
                             Margin="0,8,0,0" Foreground="{DynamicResource TeacherErrorBrush}"
                             AutomationProperties.AutomationId="QuickLayoutSaveError" />
                </StackPanel>
              </Border>
              <Border Style="{DynamicResource SettingsGroupSurface}" Padding="12">
                <StackPanel>
                  <TextBlock Text="形态与微调" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,0,0,8" />
                  <Button x:Name="LayoutShape" Style="{DynamicResource TeacherButton}" Content="缩成把手"
                          MinHeight="55" Padding="12,8" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                          Click="LayoutShapeClicked" AutomationProperties.AutomationId="QuickLayoutShape" />
                  <Button x:Name="LayoutMove" Style="{DynamicResource TeacherButton}" Content="拖动微调"
                          MinHeight="55" Padding="12,8" HorizontalAlignment="Stretch"
                          Click="LayoutMoveClicked" AutomationProperties.AutomationId="QuickLayoutMove" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="MoveHint" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,8,0" MaxHeight="82" VerticalAlignment="Bottom" IsHitTestVisible="False">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="拖动把手，抬手保存" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="轻点把手或 Esc 取消" FontSize="11" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
    </Border>
    <Border x:Name="DrawReceiptCard" Grid.Column="0" Visibility="Collapsed" MaxWidth="255"
            Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1"
            CornerRadius="10" Padding="14" Margin="0,0,8,0" VerticalAlignment="Bottom" AutomationProperties.AutomationId="QuickDrawReceipt">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="DrawReceiptTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TeacherTextBrush}"
                     TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="DrawReceiptDismiss" Grid.Column="1" Content="×" FontSize="18" Width="52" Height="52" Padding="0"
                  Style="{DynamicResource TeacherQuiet}" VerticalAlignment="Top" Click="DrawReceiptDismissClicked" ToolTip="关闭回执"
                  AutomationProperties.AutomationId="QuickDrawReceiptDismiss" AutomationProperties.Name="关闭闪抽回执" />
        </Grid>
        <TextBlock x:Name="DrawReceiptDetail" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <Button x:Name="DrawReceiptAction" Style="{DynamicResource TeacherButton}" MinHeight="52" Padding="12,8" Margin="0,12,0,0"
                HorizontalAlignment="Stretch" Click="DrawReceiptActionClicked" AutomationProperties.AutomationId="QuickDrawReceiptAction" />
        <Button x:Name="DrawNext" Style="{DynamicResource TeacherQuiet}" Content="重试闪抽" MinHeight="52" Padding="12,8" Margin="0,6,0,0"
                HorizontalAlignment="Stretch" Visibility="Collapsed" Click="DrawNextClicked" AutomationProperties.AutomationId="QuickDrawNext" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
