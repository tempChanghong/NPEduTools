<Window x:Class="NPEduTools.App.ExamAwareWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="考试看板 · ExamAware2" Width="780" Height="680" MinWidth="650" MinHeight="540" WindowStartupLocation="CenterScreen"
        Background="#F6F8F7" Foreground="#202E35" FontFamily="Microsoft YaHei UI" Icon="/Assets/npedutools.ico" UseLayoutRounding="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28">
      <TextBlock Text="考试看板" FontSize="27" FontWeight="SemiBold" />
      <TextBlock Text="打开 ExamAware2，查看连接与登录自启动登记状态。" Foreground="#718089" Margin="0,8,0,22" TextWrapping="Wrap" />
      <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="程序位置" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="选择安装目录中的 ExamAware.exe。本阶段适配 Windows 正式版 1.5.2。" Foreground="#718089" TextWrapping="Wrap" Margin="0,8,0,12" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="Executable" MinHeight="38" VerticalContentAlignment="Center" Padding="8" AutomationProperties.AutomationId="ExamAwarePath" />
            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseClicked" AutomationProperties.AutomationId="ExamAwareBrowse" />
          </Grid>
          <WrapPanel x:Name="Actions" Margin="0,12,0,0">
            <Button Content="保存位置" Click="SaveClicked" AutomationProperties.AutomationId="ExamAwareSave" Margin="0,0,8,8" />
            <Button Content="打开考试看板" Style="{StaticResource Primary}" Click="StartClicked" AutomationProperties.AutomationId="ExamAwareStart" Margin="0,0,8,8" />
            <Button Content="软件设置" Click="SettingsClicked" AutomationProperties.AutomationId="ExamAwareSettings" Margin="0,0,0,8" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="本机连接" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="Connection" Text="正在读取…" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.AutomationId="ExamAwareConnection" />
          <TextBlock x:Name="VersionText" Text="版本：未知" Foreground="#718089" Margin="0,0,0,8" />
          <TextBlock x:Name="AutoStartText" Text="登录自启动登记：未知" AutomationProperties.AutomationId="ExamAwareAutoStart" />
          <TextBlock Text="这里只读取软件登记的状态；Windows 任务管理器仍可能禁用该启动项。" Foreground="#718089" TextWrapping="Wrap" Margin="0,8,0,16" />
          <TextBlock Text="首次连接：安装桥接插件 → 导出配对文件 → 在 ExamAware 主页面点击“连接 NPEduTools”并导入。" TextWrapping="Wrap" Foreground="#536A60" Margin="0,0,0,12" />
          <WrapPanel x:Name="PairingActions">
            <Button Content="打开插件设置" Click="PluginsClicked" AutomationProperties.AutomationId="ExamAwarePlugins" Margin="0,0,8,8" />
            <Button Content="导出配对文件" Click="ExportClicked" AutomationProperties.AutomationId="ExamAwareExport" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#147D68" AutomationProperties.AutomationId="ExamAwareMessage" />
    </StackPanel>
  </ScrollViewer>
</Window>
