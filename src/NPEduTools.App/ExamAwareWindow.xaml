<Window x:Class="NPEduTools.App.ExamAwareWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="考试看板 · ExamAware2" Width="780" Height="680" MinWidth="520" MinHeight="440" WindowStartupLocation="CenterScreen" SizeChanged="WindowSizeChanged"
 Background="{DynamicResource TeacherPageBrush}" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="{DynamicResource TeacherFont}" Icon="/Assets/npedutools.ico" UseLayoutRounding="True">
 <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" AutomationProperties.Name="考试看板与 ExamAware2 配置">
  <StackPanel x:Name="PageStack" Margin="18,14,18,18">
   <!-- 页眉：标题与桥接状态徽标 -->
   <DockPanel Margin="0,0,0,4">
    <Border x:Name="BridgeBadge" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Padding="10,4" CornerRadius="6"
            Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1">
     <TextBlock x:Name="BridgeStateLabel" Text="连接核实中" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TeacherMutedBrush}"
                AutomationProperties.AutomationId="ExamAwareBridgeState" AutomationProperties.LiveSetting="Polite"/>
    </Border>
    <TextBlock x:Name="PageTitle" Text="考试看板" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
   </DockPanel>
   <TextBlock x:Name="PageSubtitle" Text="连接 ExamAware2，校验并放映考试方案。"
              Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,2,0,10" TextWrapping="Wrap"/>

   <!-- 首屏总览卡：程序/版本、桥接状态、安装注册下一步、看板主动作 -->
   <Border x:Name="OverviewCard" Style="{StaticResource SettingsGroupSurface}" Padding="16,12" Margin="0,0,0,10">
    <StackPanel>
     <WrapPanel Margin="0,0,0,4">
      <TextBlock x:Name="ProgramSummaryText" Text="程序：等待读取" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TeacherTextBrush}"
                 Margin="0,0,12,2" TextWrapping="Wrap" AutomationProperties.AutomationId="ExamAwareProgramSummary"/>
      <TextBlock x:Name="VersionText" Text="版本：未知（未连接桥接）" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}"
                 Margin="0,0,0,2" TextWrapping="Wrap" AutomationProperties.AutomationId="ExamAwareVersion"/>
     </WrapPanel>
     <TextBlock x:Name="Connection" Text="正在读取…" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap"
                AutomationProperties.AutomationId="ExamAwareConnection" AutomationProperties.LiveSetting="Polite"/>

     <Border x:Name="NextActionSurface" Background="{DynamicResource TeacherPageBrush}" BorderBrush="{DynamicResource TeacherLineBrush}"
             BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,10">
      <StackPanel>
       <TextBlock Text="下一步" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TeacherMutedBrush}"/>
       <TextBlock x:Name="NextActionText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherTextBrush}" Margin="0,2,0,0"
                  AutomationProperties.AutomationId="ExamAwareNextAction" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Border>

     <WrapPanel x:Name="RuntimeActions">
      <Button x:Name="StartButton" Content="打开考试看板" Style="{StaticResource TeacherPrimary}" Click="StartClicked" AutomationProperties.AutomationId="ExamAwareStart" Margin="0,0,8,6"/>
      <Button x:Name="SettingsButton" Style="{StaticResource TeacherButton}" Content="软件设置" Click="SettingsClicked" AutomationProperties.AutomationId="ExamAwareSettings" Margin="0,0,8,6"/>
      <Button Style="{StaticResource TeacherButton}" x:Name="QuitButton" Content="正常退出" Click="QuitClicked" IsEnabled="False" AutomationProperties.AutomationId="ExamAwareQuit" Margin="0,0,8,6"/>
      <Button x:Name="ConfigureButton" Content="连接配置" Click="ConfigureClicked" Style="{StaticResource TeacherQuiet}" Margin="0,0,0,6" AutomationProperties.AutomationId="ExamAwareConfigure"/>
     </WrapPanel>

     <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,8,0,0">
      <StackPanel>
       <TextBlock x:Name="PlayerStateText" Text="放映状态：未知" FontSize="13" TextWrapping="Wrap"
                  AutomationProperties.AutomationId="ExamAwarePlayerState" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherAccentBrush}" Margin="0,5,0,0"
                  AutomationProperties.AutomationId="ExamAwareMessage" AutomationProperties.LiveSetting="Polite">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <TextBlock x:Name="QuitStatus" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,5,0,0"
                  AutomationProperties.AutomationId="ExamAwareQuitStatus"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Border>

   <!-- 任务组 1：本地考试方案与放映（可折叠） -->
   <Border x:Name="PlanCard" Style="{StaticResource SettingsGroupSurface}" Padding="16,12" Margin="0,0,0,10">
    <StackPanel>
     <TextBlock Text="考试方案与放映" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
     <TextBlock x:Name="PlanReadinessHint" Text="先校验编辑器导出的方案，核对摘要后开始放映。已有放映不会被替换。"
                TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,4,0,6"/>
     <Expander x:Name="PlanConfiguration" Header="本地方案校验与手动放映" Style="{DynamicResource TeacherExpander}" IsExpanded="True"
               AutomationProperties.AutomationId="ExamAwarePlanSection" AutomationProperties.Name="本地方案校验与手动放映">
      <StackPanel Margin="0,4,0,2">
       <WrapPanel>
        <Button Style="{StaticResource TeacherButton}" x:Name="PreparePlanButton" Content="选择并校验方案…" Click="PreparePlanClicked" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="ExamAwarePreparePlan"/>
        <Button x:Name="PresentPlanButton" Content="开始放映" Style="{StaticResource TeacherPrimary}" Click="PresentPlanClicked" IsEnabled="False" Margin="0,0,0,8" AutomationProperties.AutomationId="ExamAwarePresentPlan"/>
       </WrapPanel>
       <TextBlock x:Name="PlanFileText" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,0,0,6">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <Border Background="{DynamicResource TeacherPageBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
        <TextBlock x:Name="PlanSummaryText" TextWrapping="Wrap" FontSize="13" AutomationProperties.AutomationId="ExamAwarePlanSummary"/>
       </Border>
       <TextBlock x:Name="PlanOperationText" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0" Foreground="{DynamicResource TeacherMutedBrush}"
                  AutomationProperties.AutomationId="ExamAwarePlanOperation" AutomationProperties.LiveSetting="Polite"/>
       <Expander Header="方案识别、格式与退出说明" Style="{DynamicResource TeacherExpander}" AutomationProperties.Name="方案识别、格式与退出说明" Margin="0,8,0,0">
        <StackPanel>
         <TextBlock x:Name="PlanIdentityText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,4,0,0" AutomationProperties.AutomationId="ExamAwarePlanIdentity">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <TextBlock Text="方案使用 UTF-8 JSON，最多 24 KiB、32 场考试。文件变化后需重新校验。" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,6,0,6"/>
         <TextBlock Text="退出前请保存并关闭编辑器，再结束放映。退出遵循学校管理策略，不会强制结束进程。" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </Expander>
    </StackPanel>
   </Border>

   <!-- 任务组 2：路径、配对与启动（可折叠） -->
   <Border x:Name="SetupCard" Style="{StaticResource SettingsGroupSurface}" Padding="16,12">
    <StackPanel>
     <TextBlock Text="路径、配对与启动" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
     <TextBlock Text="登记 ExamAware.exe 位置、安装并配对桥接插件，以及管理当前用户登录自启动。"
                TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,4,0,6"/>

     <Expander x:Name="ConnectionConfiguration" Header="程序位置与桥接配对" Style="{DynamicResource TeacherExpander}" IsExpanded="True"
               AutomationProperties.AutomationId="ExamAwareConfiguration" AutomationProperties.Name="程序位置与桥接配对">
      <StackPanel Margin="0,4,0,4">
       <TextBlock Text="1. 程序位置" FontSize="14" FontWeight="SemiBold"/>
       <TextBlock Text="选择安装目录中的 ExamAware.exe，核对后保存。适配 Windows 正式版 1.5.2 及以上 1.x（低于 2.0.0）。"
                  Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,3,0,8"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource TeacherInput}" x:Name="Executable" MinHeight="44" VerticalContentAlignment="Center" Padding="8"
                 AutomationProperties.AutomationId="ExamAwarePath" AutomationProperties.Name="ExamAware 程序位置"/>
        <Button Style="{StaticResource TeacherButton}" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseClicked" AutomationProperties.AutomationId="ExamAwareBrowse"/>
       </Grid>
       <WrapPanel x:Name="Actions" Margin="0,8,0,12">
        <Button Style="{StaticResource TeacherButton}" Content="保存位置" Click="SaveClicked" AutomationProperties.AutomationId="ExamAwareSave"/>
       </WrapPanel>

       <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="0,0,0,12"/>

       <TextBlock Text="2. 桥接插件与配对（v2）" FontSize="14" FontWeight="SemiBold"/>
       <TextBlock Text="首次连接：打开插件设置安装并启用 NPEduTools 桥接插件 → 导出配对文件 → 若首次启动进入快速开始向导请先退出，在 ExamAware 主页面点击“连接 NPEduTools”并导入。配对凭据仅写入导出的 JSON 文件，不在界面明文展示。"
                  TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,3,0,10"/>
       <WrapPanel x:Name="PairingActions">
        <Button Style="{StaticResource TeacherButton}" Content="打开插件设置" Click="PluginsClicked" AutomationProperties.AutomationId="ExamAwarePlugins" Margin="0,0,8,8"/>
        <Button Style="{StaticResource TeacherButton}" Content="导出配对文件" Click="ExportClicked" AutomationProperties.AutomationId="ExamAwareExport" Margin="0,0,8,8"/>
        <Button Style="{StaticResource TeacherButton}" Content="撤销当前配对" Click="ResetPairingClicked" AutomationProperties.AutomationId="ExamAwareResetPairing" Margin="0,0,0,8"/>
       </WrapPanel>
      </StackPanel>
     </Expander>

     <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="0,10,0,10"/>

     <TextBlock x:Name="AutoStartText" Text="登录自启动登记：未知" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                AutomationProperties.AutomationId="ExamAwareAutoStart" AutomationProperties.LiveSetting="Polite"/>
     <Expander x:Name="AutoStartConfiguration" Header="登录自启动设置" Style="{DynamicResource TeacherExpander}" AutomationProperties.Name="登录自启动设置" Margin="0,6,0,0">
      <StackPanel Margin="0,4,0,0">
       <TextBlock Text="针对当前 Windows 用户的启动登记；任务管理器仍可能禁用该启动项。日常／考试环境请优先通过课堂模式统一切换。"
                  Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <WrapPanel x:Name="AutoStartActions">
        <Button Style="{StaticResource TeacherButton}" x:Name="EnableAutoStartButton" Content="开启登录自启动" IsEnabled="False" Click="EnableAutoStartClicked" AutomationProperties.AutomationId="ExamAwareAutoStartEnable" Margin="0,0,8,8"/>
        <Button Style="{StaticResource TeacherButton}" x:Name="DisableAutoStartButton" Content="关闭登录自启动" IsEnabled="False" Click="DisableAutoStartClicked" AutomationProperties.AutomationId="ExamAwareAutoStartDisable" Margin="0,0,0,8"/>
       </WrapPanel>
       <TextBlock x:Name="AutoStartMessage" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13"
                  AutomationProperties.AutomationId="ExamAwareAutoStartMessage" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</Window>
