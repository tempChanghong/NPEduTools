<Window x:Class="NPEduTools.App.ExamAwareWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="考试看板 · ExamAware2" Width="780" Height="680" MinWidth="520" MinHeight="440" WindowStartupLocation="CenterScreen"
 Background="#F6F8F7" Foreground="#202E35" FontFamily="Microsoft YaHei UI" Icon="/Assets/npedutools.ico" UseLayoutRounding="True">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="20">
  <TextBlock Text="考试看板" FontSize="27" FontWeight="SemiBold"/>
  <TextBlock Text="查看连接与放映，配置 ExamAware2。" Foreground="#718089" Margin="0,6,0,16" TextWrapping="Wrap"/>
  <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel>
   <TextBlock x:Name="Connection" Text="正在读取…" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="ExamAwareConnection"/>
   <TextBlock x:Name="NextActionText" TextWrapping="Wrap" Foreground="#536A60" Margin="0,8,0,10" AutomationProperties.AutomationId="ExamAwareNextAction"/>
   <WrapPanel x:Name="RuntimeActions">
    <Button Content="打开考试看板" Style="{StaticResource Primary}" Click="StartClicked" AutomationProperties.AutomationId="ExamAwareStart" Margin="0,0,8,8"/>
    <Button Content="软件设置" Click="SettingsClicked" AutomationProperties.AutomationId="ExamAwareSettings" Margin="0,0,8,8"/>
    <Button Content="连接配置" Click="ConfigureClicked" Style="{StaticResource Quiet}" Margin="0,0,8,8" AutomationProperties.AutomationId="ExamAwareConfigure"/>
    <Button x:Name="QuitButton" Content="正常退出" Click="QuitClicked" IsEnabled="False" AutomationProperties.AutomationId="ExamAwareQuit" Margin="0,0,0,8"/>
   </WrapPanel>
   <TextBlock x:Name="PlayerStateText" Text="放映状态：未知" TextWrapping="Wrap" Margin="0,4,0,6" AutomationProperties.AutomationId="ExamAwarePlayerState"/>
   <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#147D68" AutomationProperties.AutomationId="ExamAwareMessage"/>
   <TextBlock x:Name="QuitStatus" TextWrapping="Wrap" Foreground="#536A60" FontSize="12" Margin="0,6,0,0" AutomationProperties.AutomationId="ExamAwareQuitStatus"/>
  </StackPanel></Border>
  <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel>
   <TextBlock Text="考试方案与放映" FontSize="16" FontWeight="SemiBold"/>
   <TextBlock Text="先校验编辑器导出的方案，核对摘要后开始放映。已有放映不会被替换。" TextWrapping="Wrap" Foreground="#718089" FontSize="12" Margin="0,6,0,10"/>
   <WrapPanel>
    <Button x:Name="PreparePlanButton" Content="选择并校验方案…" Click="PreparePlanClicked" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="ExamAwarePreparePlan"/>
    <Button x:Name="PresentPlanButton" Content="开始放映" Style="{StaticResource Primary}" Click="PresentPlanClicked" IsEnabled="False" Margin="0,0,0,8" AutomationProperties.AutomationId="ExamAwarePresentPlan"/>
   </WrapPanel>
   <TextBlock x:Name="PlanFileText" TextWrapping="Wrap" Foreground="#718089" FontSize="12"/>
   <TextBlock x:Name="PlanSummaryText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="ExamAwarePlanSummary"/>
   <TextBlock x:Name="PlanOperationText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#536A60" AutomationProperties.AutomationId="ExamAwarePlanOperation"/>
   <Expander Header="方案识别、格式与退出说明" Margin="0,10,0,0"><StackPanel>
    <TextBlock x:Name="PlanIdentityText" TextWrapping="Wrap" FontSize="12" Foreground="#718089" Margin="0,8,0,0" AutomationProperties.AutomationId="ExamAwarePlanIdentity"/>
    <TextBlock Text="方案使用 UTF-8 JSON，最多 24 KiB、32 场考试。文件变化后需重新校验。" TextWrapping="Wrap" FontSize="12" Foreground="#718089" Margin="0,8,0,8"/>
    <TextBlock Text="退出前请保存并关闭编辑器，再结束放映。退出遵循学校管理策略，不会强制结束进程。" TextWrapping="Wrap" FontSize="12" Foreground="#718089"/>
   </StackPanel></Expander>
  </StackPanel></Border>
  <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
   <Expander x:Name="ConnectionConfiguration" Header="程序位置与桥接配对" IsExpanded="True" AutomationProperties.AutomationId="ExamAwareConfiguration"><StackPanel Margin="0,12,0,0">
    <TextBlock Text="选择安装目录中的 ExamAware.exe，核对后保存。本阶段适配 Windows 正式版 1.5.2。" Foreground="#718089" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="Executable" MinHeight="38" VerticalContentAlignment="Center" Padding="8" AutomationProperties.AutomationId="ExamAwarePath"/>
     <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseClicked" AutomationProperties.AutomationId="ExamAwareBrowse"/>
    </Grid>
    <WrapPanel x:Name="Actions" Margin="0,10,0,12"><Button Content="保存位置" Click="SaveClicked" AutomationProperties.AutomationId="ExamAwareSave"/></WrapPanel>
    <TextBlock Text="首次连接：安装桥接插件 → 导出配对文件 → 在 ExamAware 主页面点击“连接 NPEduTools”并导入。" TextWrapping="Wrap" Foreground="#536A60" FontSize="12" Margin="0,0,0,10"/>
    <WrapPanel x:Name="PairingActions">
     <Button Content="打开插件设置" Click="PluginsClicked" AutomationProperties.AutomationId="ExamAwarePlugins" Margin="0,0,8,8"/>
     <Button Content="导出配对文件" Click="ExportClicked" AutomationProperties.AutomationId="ExamAwareExport" Margin="0,0,8,8"/>
     <Button Content="撤销当前配对" Click="ResetPairingClicked" AutomationProperties.AutomationId="ExamAwareResetPairing" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock x:Name="VersionText" Text="版本：未知" Foreground="#718089" FontSize="12" Margin="0,4,0,0"/>
   </StackPanel></Expander>
  </Border>
  <Border Background="White" CornerRadius="12" Padding="18"><StackPanel>
   <TextBlock x:Name="AutoStartText" Text="登录自启动登记：未知" TextWrapping="Wrap" AutomationProperties.AutomationId="ExamAwareAutoStart"/>
   <Expander Header="登录自启动设置" Margin="0,8,0,0"><StackPanel Margin="0,10,0,0">
    <TextBlock Text="针对当前 Windows 用户的启动登记；任务管理器仍可能禁用该启动项。日常／考试环境请优先通过课堂模式统一切换。" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <WrapPanel x:Name="AutoStartActions">
     <Button x:Name="EnableAutoStartButton" Content="开启登录自启动" IsEnabled="False" Click="EnableAutoStartClicked" AutomationProperties.AutomationId="ExamAwareAutoStartEnable" Margin="0,0,8,8"/>
     <Button x:Name="DisableAutoStartButton" Content="关闭登录自启动" IsEnabled="False" Click="DisableAutoStartClicked" AutomationProperties.AutomationId="ExamAwareAutoStartDisable" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock x:Name="AutoStartMessage" TextWrapping="Wrap" Foreground="#536A60" FontSize="12" AutomationProperties.AutomationId="ExamAwareAutoStartMessage"/>
   </StackPanel></Expander>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</Window>
