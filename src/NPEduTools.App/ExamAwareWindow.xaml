<Window x:Class="NPEduTools.App.ExamAwareWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ExamAware2 连接" Width="780" Height="680" MinWidth="520" MinHeight="440" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource TeacherPageBrush}" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="{DynamicResource TeacherFont}" Icon="/Assets/npedutools.ico" UseLayoutRounding="True">
 <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" AutomationProperties.Name="ExamAware2 连接配置">
  <StackPanel x:Name="PageStack" Margin="20,14,20,22">
   <DockPanel Margin="0,0,0,12">
    <Button x:Name="ExamAwareBackButton" Visibility="Collapsed" Click="BackClicked" Style="{StaticResource TeacherQuiet}"
            DockPanel.Dock="Left" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,14,0"
            AutomationProperties.AutomationId="ExamAwareBack" AutomationProperties.Name="返回">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <TextBlock x:Name="PageTitle" Text="ExamAware2 连接" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
   </DockPanel>

   <!-- 唯一主卡：连接总览 + 卡内四步配置 -->
   <Border x:Name="OverviewCard" Style="{StaticResource SettingsGroupSurface}" Padding="18,16" Margin="0,0,0,18">
    <StackPanel>
     <!-- 宽窗左右分列、窄窗单列（C# 调整 Grid.Row/Column） -->
     <Grid x:Name="ConnectionSummaryGrid">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel x:Name="ConnectionSummaryInfo" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
       <Border x:Name="BridgeBadge" HorizontalAlignment="Left" Padding="8,3" CornerRadius="6" Margin="0,0,0,8"
               Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1">
        <TextBlock x:Name="BridgeStateLabel" Text="连接核实中" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TeacherMutedBrush}"
                   AutomationProperties.AutomationId="ExamAwareBridgeState" AutomationProperties.LiveSetting="Polite"/>
       </Border>
       <TextBlock x:Name="VersionText" Text="版本待核对" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TeacherTextBrush}"
                  Margin="0,0,0,3" TextWrapping="Wrap" AutomationProperties.AutomationId="ExamAwareVersion"/>
       <TextBlock x:Name="ProgramSummaryText" Text="程序位置待核对" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}"
                  TextWrapping="Wrap" AutomationProperties.AutomationId="ExamAwareProgramSummary"/>
       <TextBlock x:Name="NextActionText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherTextBrush}" Margin="0,6,0,0"
                  AutomationProperties.AutomationId="ExamAwareNextAction" AutomationProperties.LiveSetting="Polite">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
         <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </StackPanel>

      <StackPanel x:Name="ConnectionSummaryActions" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
       <WrapPanel x:Name="RuntimeActions">
        <Button x:Name="StartButton" Content="打开 ExamAware2" Style="{StaticResource TeacherPrimary}" Click="StartClicked"
                AutomationProperties.AutomationId="ExamAwareStart" Margin="0,0,8,4"/>
        <Button x:Name="ConfigureButton" Content="管理连接" Style="{StaticResource TeacherButton}" Click="ConfigureClicked"
                AutomationProperties.AutomationId="ExamAwareConfigure" Margin="0,0,0,4"/>
       </WrapPanel>
      </StackPanel>
     </Grid>

     <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherAccentBrush}" Margin="0,10,0,0"
                AutomationProperties.AutomationId="ExamAwareMessage" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>

     <!-- 卡内可收合连接步骤区：已连接收合，未连通或点“管理连接”展开 -->
     <StackPanel x:Name="ConnectionSteps" Margin="0,14,0,0"
                 AutomationProperties.AutomationId="ExamAwareConfiguration" AutomationProperties.Name="连接步骤与配对">
       <!-- 步骤一：程序路径 -->
       <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="0,4">
        <StackPanel>
         <Button Click="ConnectPathStepClicked" Style="{StaticResource TeacherQuiet}" HorizontalContentAlignment="Stretch" Padding="6,4"
                 AutomationProperties.AutomationId="ExamAwareStepPath" AutomationProperties.Name="程序位置">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Path Data="M 2,4 L 7,4 L 9,6 L 14,6 L 14,13 L 2,13 Z" Stroke="{DynamicResource TeacherMutedBrush}" StrokeThickness="1.3"
                 StrokeLineJoin="Round" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
           <TextBlock Grid.Column="1" Text="程序位置" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TeacherTextBrush}"
                      VerticalAlignment="Center" TextWrapping="Wrap"/>
           <TextBlock x:Name="PathStepState" Grid.Column="2" Text="待核实" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
         </Button>
         <StackPanel x:Name="PathStepBody" Visibility="Collapsed" Margin="26,4,4,8">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBox Style="{StaticResource TeacherInput}" x:Name="Executable" MinHeight="44" VerticalContentAlignment="Center" Padding="8" TextChanged="ExecutableChanged"
                    AutomationProperties.AutomationId="ExamAwarePath" AutomationProperties.Name="ExamAware 程序位置"/>
           <Button x:Name="BrowseProgramButton" Style="{StaticResource TeacherPrimary}" Grid.Column="1" Content="选择程序…" Margin="8,0,0,0" Click="BrowseClicked" AutomationProperties.AutomationId="ExamAwareBrowse"/>
           <WrapPanel x:Name="Actions" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
            <Button x:Name="SaveProgramButton" Style="{StaticResource TeacherButton}" Content="保存位置" Click="SaveClicked" IsEnabled="False" AutomationProperties.AutomationId="ExamAwareSave"/>
           </WrapPanel>
          </Grid>
         </StackPanel>
        </StackPanel>
       </Border>

       <!-- 步骤二：安装插件 -->
       <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="0,4">
        <StackPanel>
         <Button Click="ConnectPluginStepClicked" Style="{StaticResource TeacherQuiet}" HorizontalContentAlignment="Stretch" Padding="6,4"
                 AutomationProperties.AutomationId="ExamAwareStepPlugin" AutomationProperties.Name="安装并启用桥接插件">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Path Data="M 5,3 L 5,7 M 11,3 L 11,7 M 3,7 L 13,7 L 13,9 C 13,11.5 11,13 8,13 C 5,13 3,11.5 3,9 Z M 8,13 L 8,15"
                 Stroke="{DynamicResource TeacherMutedBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                 StrokeLineJoin="Round" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
           <TextBlock Grid.Column="1" Text="安装并启用桥接插件" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TeacherTextBrush}"
                      VerticalAlignment="Center" TextWrapping="Wrap"/>
           <TextBlock x:Name="PluginStepState" Grid.Column="2" Text="待核实" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
         </Button>
         <StackPanel x:Name="PluginStepBody" Visibility="Collapsed" Margin="26,4,4,8">
          <TextBlock Text="在 ExamAware2 的插件设置中安装随 NPEduTools 提供的 .ea2x 桥接插件，再将它启用。"
                     Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"/>
          <WrapPanel>
           <Button Style="{StaticResource TeacherPrimary}" Content="打开插件设置" Click="PluginsClicked" AutomationProperties.AutomationId="ExamAwarePlugins"/>
           <Button Style="{StaticResource TeacherQuiet}" Content="继续配对" Click="ConnectPairingStepClicked" Margin="8,0,0,0"/>
          </WrapPanel>
         </StackPanel>
        </StackPanel>
       </Border>

       <!-- 步骤三：导出配对并在本体导入 -->
       <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="0,4">
        <StackPanel>
         <Button Click="ConnectPairingStepClicked" Style="{StaticResource TeacherQuiet}" HorizontalContentAlignment="Stretch" Padding="6,4"
                 AutomationProperties.AutomationId="ExamAwareStepPairing" AutomationProperties.Name="导出并导入配对文件">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Path Data="M 6,10 L 10,6 M 4,8 L 3,9 C 1.8,10.2 1.8,12 3,13.2 C 4.2,14.4 6,14.4 7.2,13.2 L 8.2,12.2 M 12,8 L 13,7 C 14.2,5.8 14.2,4 13,2.8 C 11.8,1.6 10,1.6 8.8,2.8 L 7.8,3.8"
                 Stroke="{DynamicResource TeacherMutedBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                 Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
           <TextBlock Grid.Column="1" Text="导出并导入配对文件" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TeacherTextBrush}"
                      VerticalAlignment="Center" TextWrapping="Wrap"/>
           <TextBlock x:Name="PairingStepState" Grid.Column="2" Text="待核实" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
         </Button>
         <StackPanel x:Name="PairingStepBody" Visibility="Collapsed" Margin="26,4,4,8">
          <TextBlock Text="导出后在 ExamAware2 主页选择「连接 NPEduTools」并导入文件。若仍在快速开始向导，先退出向导。"
                     Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"/>
          <WrapPanel x:Name="PairingActions">
           <Button Style="{StaticResource TeacherPrimary}" Content="导出配对文件" Click="ExportClicked" AutomationProperties.AutomationId="ExamAwareExport"/>
          </WrapPanel>
         </StackPanel>
        </StackPanel>
       </Border>

       <!-- 步骤四：核对连接 -->
       <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="0,4">
        <StackPanel>
         <Button Click="ConnectVerifyStepClicked" Style="{StaticResource TeacherQuiet}" HorizontalContentAlignment="Stretch" Padding="6,4"
                 AutomationProperties.AutomationId="ExamAwareStepVerify" AutomationProperties.Name="核对连接">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Path Data="M 8,2 L 13.5,4.2 L 13.5,8.2 C 13.5,11.4 11.2,13.6 8,14.5 C 4.8,13.6 2.5,11.4 2.5,8.2 L 2.5,4.2 Z M 5.5,8.2 L 7.3,10 L 10.8,6.5"
                 Stroke="{DynamicResource TeacherMutedBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                 StrokeLineJoin="Round" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
           <TextBlock Grid.Column="1" Text="核对连接" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TeacherTextBrush}"
                      VerticalAlignment="Center" TextWrapping="Wrap"/>
           <TextBlock x:Name="VerifyStepState" Grid.Column="2" Text="待核实" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
         </Button>
         <StackPanel x:Name="VerifyStepBody" Visibility="Collapsed" Margin="26,4,4,6">
          <TextBlock x:Name="Connection" Text="正在读取…" FontSize="13" Foreground="{DynamicResource TeacherTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                     AutomationProperties.AutomationId="ExamAwareConnection" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="导入后本页会自动核对。若一直未连接，请检查 ExamAware2 是否已打开，桥接插件是否已启用。"
                     Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" FontSize="13"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Expander x:Name="ConnectionMaintenance" Header="连接维护" Style="{DynamicResource TeacherExpander}" IsExpanded="False" Margin="0,8,0,0"
                 AutomationProperties.AutomationId="ExamAwareMaintenance">
        <StackPanel Margin="6,6,0,0">
         <WrapPanel x:Name="MaintenanceActions">
          <Button x:Name="SettingsButton" Style="{StaticResource TeacherQuiet}" Content="软件设置" Click="SettingsClicked" AutomationProperties.AutomationId="ExamAwareSettings" Margin="0,0,8,6"/>
          <Button x:Name="QuitButton" Style="{StaticResource TeacherQuiet}" Content="正常退出" Click="QuitClicked" AutomationProperties.AutomationId="ExamAwareQuit" Margin="0,0,8,6"/>
          <Button Style="{StaticResource TeacherQuiet}" Content="撤销当前配对…" Click="ResetPairingClicked" AutomationProperties.AutomationId="ExamAwareResetPairing" Margin="0,0,0,6"/>
         </WrapPanel>
         <TextBlock x:Name="QuitStatus" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13"
                    AutomationProperties.AutomationId="ExamAwareQuitStatus"/>
        </StackPanel>
       </Expander>
     </StackPanel>
    </StackPanel>
   </Border>

   <!-- 可选设置 -->
   <Border Background="Transparent" Padding="0" Margin="0,0,0,6">
    <StackPanel>
     <Expander x:Name="AutoStartConfiguration" Header="登录自启动" Style="{DynamicResource TeacherExpander}" IsExpanded="False"
               AutomationProperties.AutomationId="ExamAwareAutoStartConfiguration" AutomationProperties.Name="登录自启动设置" Margin="0,4,0,0">
      <StackPanel Margin="0,4,0,0">
       <TextBlock x:Name="AutoStartText" Text="登录自启动登记：未知" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"
                  AutomationProperties.AutomationId="ExamAwareAutoStart" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock Text="针对当前 Windows 用户的启动登记；任务管理器仍可能禁用该启动项。日常／考试环境请优先通过课堂模式统一切换。"
                  Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <WrapPanel x:Name="AutoStartActions">
        <Button Style="{StaticResource TeacherButton}" x:Name="EnableAutoStartButton" Content="开启登录自启动" IsEnabled="False" Click="EnableAutoStartClicked" AutomationProperties.AutomationId="ExamAwareAutoStartEnable" Margin="0,0,8,8"/>
        <Button Style="{StaticResource TeacherButton}" x:Name="DisableAutoStartButton" Content="关闭登录自启动" IsEnabled="False" Click="DisableAutoStartClicked" AutomationProperties.AutomationId="ExamAwareAutoStartDisable" Margin="0,0,0,8"/>
       </WrapPanel>
       <TextBlock x:Name="AutoStartMessage" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13"
                  AutomationProperties.AutomationId="ExamAwareAutoStartMessage" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </Border>

   <!-- 次要分区 2（页尾默认折叠）：本地方案校验与放映 -->
   <Border Background="Transparent">
    <Expander x:Name="PlanConfiguration" Header="本地方案校验与放映" Style="{DynamicResource TeacherExpander}" IsExpanded="False"
              AutomationProperties.AutomationId="ExamAwarePlanSection" AutomationProperties.Name="本地方案校验与放映">
     <StackPanel Margin="0,6,0,2">
      <TextBlock x:Name="PlanReadinessHint" Text="日常放映可直接打开 ExamAware2 本体；需本机校验后投递时可在此操作，已有放映不会被替换。"
                 TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,0,0,6"/>
      <TextBlock x:Name="PlayerStateText" Text="放映状态：未知" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="ExamAwarePlayerState" AutomationProperties.LiveSetting="Polite"/>
      <WrapPanel x:Name="PlanActions" Margin="0,0,0,4">
       <Button Style="{StaticResource TeacherButton}" x:Name="PreparePlanButton" Content="选择并校验方案…" Click="PreparePlanClicked" IsEnabled="False" Margin="0,0,8,6" AutomationProperties.AutomationId="ExamAwarePreparePlan"/>
       <Button Style="{StaticResource TeacherPrimary}" x:Name="PresentPlanButton" Content="开始放映" Click="PresentPlanClicked" IsEnabled="False" Margin="0,0,0,6" AutomationProperties.AutomationId="ExamAwarePresentPlan"/>
      </WrapPanel>
      <TextBlock x:Name="PlanFileText" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,2,0,6">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
      <Border Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
       <TextBlock x:Name="PlanSummaryText" TextWrapping="Wrap" FontSize="13" AutomationProperties.AutomationId="ExamAwarePlanSummary"/>
      </Border>
      <TextBlock x:Name="PlanOperationText" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0" Foreground="{DynamicResource TeacherMutedBrush}"
                 AutomationProperties.AutomationId="ExamAwarePlanOperation" AutomationProperties.LiveSetting="Polite"/>
      <Expander Header="方案识别、格式与退出说明" Style="{DynamicResource TeacherExpander}" AutomationProperties.Name="方案识别、格式与退出说明" Margin="0,8,0,0">
       <StackPanel>
        <TextBlock x:Name="PlanIdentityText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,4,0,0" AutomationProperties.AutomationId="ExamAwarePlanIdentity">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="方案使用 UTF-8 JSON，最多 24 KiB、32 场考试。文件变化后需重新校验。" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,6,0,6"/>
        <TextBlock Text="退出前请保存并关闭编辑器，再结束放映。退出遵循学校管理策略，不会强制结束进程。" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </Expander>
   </Border>
  </StackPanel>
 </ScrollViewer>
</Window>
