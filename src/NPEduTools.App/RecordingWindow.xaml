<Window x:Class="NPEduTools.App.RecordingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="录制微课 · NPEduTools" Width="600" Height="760" MinWidth="540" MinHeight="630" WindowStartupLocation="CenterScreen" Background="#F6F8F7" FontFamily="Microsoft YaHei UI" Foreground="#203D32" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="40" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="10,6" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="CheckBox"><Setter Property="MinHeight" Value="36" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="14" /></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="录制微课" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="课件、板书与讲解，录成一节课。" FontSize="12" Foreground="#718089" Margin="0,7,0,0" /></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="RecordingClock" Text="00:00:00" FontFamily="Consolas" FontSize="25" HorizontalAlignment="Right" AutomationProperties.AutomationId="RecordingClock" /><TextBlock x:Name="RecordingPhase" Text="准备录制" FontSize="11" Foreground="#718089" HorizontalAlignment="Right" Margin="0,3,0,0" /></StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
      <StackPanel>
        <StackPanel x:Name="RecordingSettings">
          <TextBlock Text="录制屏幕" FontSize="13" Margin="0,0,0,8" />
          <ComboBox x:Name="DisplayChoice" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="ChoicesChanged" AutomationProperties.AutomationId="RecordingDisplay" />
          <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="画质上限" FontSize="13" Margin="0,0,0,8" /><ComboBox x:Name="QualityChoice" SelectedIndex="0" SelectionChanged="ChoicesChanged" AutomationProperties.AutomationId="RecordingQuality"><ComboBoxItem Content="1080p · 清晰课件" Tag="1080" /><ComboBoxItem Content="720p · 更小文件" Tag="720" /></ComboBox></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="帧率" FontSize="13" Margin="0,0,0,8" /><ComboBox x:Name="FpsChoice" SelectedIndex="0" SelectionChanged="ChoicesChanged" AutomationProperties.AutomationId="RecordingFps"><ComboBoxItem Content="8 fps · 课件与板书" Tag="8" /><ComboBoxItem Content="15 fps · 更多画面变化" Tag="15" /></ComboBox></StackPanel>
          </Grid>
          <TextBlock x:Name="CaptureSummary" Text="正在检测录制设备…" TextWrapping="Wrap" Foreground="#718089" FontSize="12" Margin="0,10,0,14" />
          <CheckBox x:Name="SystemSound" Content="录制系统声音" IsChecked="True" Checked="SoundChanged" Unchecked="SoundChanged" AutomationProperties.AutomationId="RecordingSystemAudio" />
          <ComboBox x:Name="SpeakerChoice" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.AutomationId="RecordingSpeaker" />
          <CheckBox x:Name="MicrophoneSound" Content="录制麦克风" IsChecked="True" Checked="SoundChanged" Unchecked="SoundChanged" Margin="0,8,0,0" AutomationProperties.AutomationId="RecordingMicrophone" />
          <ComboBox x:Name="MicrophoneChoice" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.AutomationId="RecordingMicrophoneDevice" />
          <TextBlock Text="同时录音时，请注意扬声器声音可能再次进入麦克风。" FontSize="11" Foreground="#718089" TextWrapping="Wrap" Margin="0,8,0,16" />
          <TextBlock Text="保存位置" FontSize="13" Margin="0,0,0,8" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="OutputDirectory" AutomationProperties.AutomationId="RecordingDirectory" /><Button Grid.Column="1" Content="选择…" Margin="8,0,0,0" Click="BrowseClicked" AutomationProperties.AutomationId="RecordingBrowse" /></Grid>
          <Button Content="重新检测设备" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,8" FontSize="12" Click="RefreshClicked" AutomationProperties.AutomationId="RecordingRefresh" />
        </StackPanel>
        <Border Background="#EAF2EC" CornerRadius="12" Padding="14" Margin="0,12,0,0"><StackPanel>
          <TextBlock x:Name="RecordingMessage" Text="点击开始后录制所选屏幕。" FontSize="13" TextWrapping="Wrap" AutomationProperties.AutomationId="RecordingStatus" />
          <TextBlock x:Name="RecordingMetrics" Text="低帧率适合课件与讲解，快速视频和动画会不够流畅。" FontSize="11" Foreground="#718089" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel></Border>
        <TextBlock x:Name="RecordingError" Foreground="#AA5337" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="RecordingError" />
      </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="0,18,0,0">
      <Button x:Name="RecordStart" Content="开始录制" Style="{StaticResource Primary}" IsEnabled="False" Click="StartClicked" AutomationProperties.AutomationId="RecordingStart" Margin="0,0,8,8" />
      <Button x:Name="RecordPause" Content="暂停" Visibility="Collapsed" Click="PauseClicked" AutomationProperties.AutomationId="RecordingPause" Margin="0,0,8,8" />
      <Button x:Name="RecordStop" Content="停止并保存" Visibility="Collapsed" Click="StopClicked" AutomationProperties.AutomationId="RecordingStop" Margin="0,0,8,8" />
      <Button Content="收起窗口" Style="{StaticResource Quiet}" Click="HideClicked" AutomationProperties.AutomationId="RecordingHide" />
    </WrapPanel>
    <WrapPanel Grid.Row="3"><Button x:Name="OpenVideo" Content="打开视频" Visibility="Collapsed" Click="OpenVideoClicked" AutomationProperties.AutomationId="RecordingOpenVideo" Margin="0,0,8,0" /><Button x:Name="OpenFolder" Content="打开文件夹" Visibility="Collapsed" Click="OpenFolderClicked" AutomationProperties.AutomationId="RecordingOpenFolder" /></WrapPanel>
  </Grid>
</Window>
