<Window x:Class="NPEduTools.App.RecordingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:NPEduTools.App"
 Icon="/Assets/npedutools.ico" Title="录制微课 · NPEduTools"
 Width="600" Height="760" MinWidth="540" MinHeight="630" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource TeacherPageBrush}" Foreground="{DynamicResource TeacherTextBrush}"
 FontFamily="{DynamicResource SettingsBodyFont}" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/RecordingControls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="ComboBox" BasedOn="{StaticResource RecordingChoice}">
        <Setter Property="MinHeight" Value="44" />
      </Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource RecordingCheck}">
        <Setter Property="MinHeight" Value="44" /><Setter Property="FontSize" Value="14" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="4">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="4,0,4,12">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="RecordingHeading" Text="立即录制" FontSize="25" FontWeight="SemiBold"
       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Border Grid.Column="1" Style="{DynamicResource SettingsGroupSurface}" Padding="12,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="RecordingClock" Text="—" FontFamily="Consolas" FontSize="21"
             AutomationProperties.AutomationId="RecordingClock" />
            <TextBlock x:Name="LiveRecordingClock" Text="{Binding Text, ElementName=RecordingClock}"
             FontFamily="Consolas" FontSize="30" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="RecordingPhaseMark" Margin="0,0,6,0" VerticalAlignment="Center"
           FontSize="14" Foreground="{DynamicResource TeacherMutedBrush}" IsHitTestVisible="False" />
          <TextBlock x:Name="RecordingPhase" Text="准备录制" FontSize="13" VerticalAlignment="Center"
           Foreground="{DynamicResource TeacherMutedBrush}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>
    </Grid>
    <ScrollViewer x:Name="RecordingBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
     HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
      <StackPanel Margin="4,0,4,12">
        <StackPanel x:Name="IdleRecordingSummary">
          <Border Style="{DynamicResource SettingsGroupSurface}">
            <local:SettingsRow Style="{DynamicResource SettingsRow}" Icon="M4,4 H20 V16 H4 Z M12,16 V21 M7,21 H17">
              <local:SettingsRow.Header>
                <StackPanel>
                  <TextBlock Text="画面与声音" Style="{DynamicResource SettingsLabel}" />
                  <TextBlock x:Name="ReadySummary" Text="正在读取录制设置…" Style="{DynamicResource SettingsHint}" />
                  <TextBlock x:Name="ReadyDirectory" Style="{DynamicResource SettingsHint}" />
                </StackPanel>
              </local:SettingsRow.Header>
              <Button x:Name="EditSettings" Content="修改录制设置" Style="{DynamicResource TeacherButton}"
               Click="EditSettingsClicked" AutomationProperties.AutomationId="RecordingEditSettings" />
            </local:SettingsRow>
          </Border>
        </StackPanel>
        <StackPanel x:Name="RecordingSettings" Visibility="Collapsed">
          <Border Style="{DynamicResource SettingsGroupSurface}">
            <StackPanel>
              <local:SettingsRow Style="{DynamicResource SettingsRow}" Icon="M3,4 H21 V17 H3 Z M12,17 V21 M7,21 H17">
                <local:SettingsRow.Header><TextBlock x:Name="DisplayLabel" Text="录制屏幕" Style="{DynamicResource SettingsLabel}" /></local:SettingsRow.Header>
                <ComboBox x:Name="DisplayChoice" Width="220" DisplayMemberPath="Label" SelectedValuePath="Id"
                 SelectionChanged="ChoicesChanged" AutomationProperties.AutomationId="RecordingDisplay" AutomationProperties.LabeledBy="{Binding ElementName=DisplayLabel}" />
              </local:SettingsRow>
              <Border Height="1" Background="{DynamicResource TeacherLineBrush}" />
              <local:SettingsRow Style="{DynamicResource SettingsRow}" Icon="M4,6 H20 M4,12 H20 M4,18 H20 M7,4 V8 M15,10 V14 M9,16 V20">
                <local:SettingsRow.Header><TextBlock Text="画质与帧率" Style="{DynamicResource SettingsLabel}" /></local:SettingsRow.Header>
                <WrapPanel>
                  <ComboBox x:Name="QualityChoice" Width="150" Margin="0,0,8,4" SelectedIndex="0" SelectionChanged="ChoicesChanged"
                   AutomationProperties.AutomationId="RecordingQuality" AutomationProperties.Name="画质上限">
                    <ComboBoxItem Content="1080p · 清晰课件" Tag="1080" /><ComboBoxItem Content="720p · 更小文件" Tag="720" />
                  </ComboBox>
                  <ComboBox x:Name="FpsChoice" Width="164" Margin="0,0,0,4" SelectedIndex="0" SelectionChanged="ChoicesChanged"
                   AutomationProperties.AutomationId="RecordingFps" AutomationProperties.Name="录制帧率">
                    <ComboBoxItem Content="8 fps · 课件与板书" Tag="8" /><ComboBoxItem Content="15 fps · 更多画面变化" Tag="15" />
                  </ComboBox>
                </WrapPanel>
              </local:SettingsRow>
            </StackPanel>
          </Border>
          <Border Style="{DynamicResource SettingsGroupSurface}" Margin="0,10,0,0">
            <StackPanel>
              <local:SettingsRow Style="{DynamicResource SettingsRow}" Icon="M3,9 H7 L13,4 V20 L7,15 H3 Z M16,8 Q20,12 16,16 M18,5 Q24,12 18,19">
                <local:SettingsRow.Header>
                  <CheckBox x:Name="SystemSound" Content="录制系统声音" IsChecked="True" Checked="SoundChanged" Unchecked="SoundChanged"
                   AutomationProperties.AutomationId="RecordingSystemAudio" />
                </local:SettingsRow.Header>
                <ComboBox x:Name="SpeakerChoice" Width="220" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="ChoicesChanged"
                 AutomationProperties.AutomationId="RecordingSpeaker" AutomationProperties.Name="系统声音设备" />
              </local:SettingsRow>
              <Border Height="1" Background="{DynamicResource TeacherLineBrush}" />
              <local:SettingsRow Style="{DynamicResource SettingsRow}" Icon="M9,6 A3,3 0 0 1 15,6 V12 A3,3 0 0 1 9,12 Z M6,11 V12 A6,6 0 0 0 18,12 V11 M12,18 V22">
                <local:SettingsRow.Header>
                  <CheckBox x:Name="MicrophoneSound" Content="录制麦克风" IsChecked="True" Checked="SoundChanged" Unchecked="SoundChanged"
                   AutomationProperties.AutomationId="RecordingMicrophone" />
                </local:SettingsRow.Header>
                <ComboBox x:Name="MicrophoneChoice" Width="220" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="ChoicesChanged"
                 AutomationProperties.AutomationId="RecordingMicrophoneDevice" AutomationProperties.Name="麦克风设备" />
              </local:SettingsRow>
            </StackPanel>
          </Border>
          <TextBlock Text="扬声器播放的声音可能被麦克风再次收录。" Style="{DynamicResource SettingsHint}" Margin="0,6,0,0" />
          <Border Style="{DynamicResource SettingsGroupSurface}" Padding="16,12" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock x:Name="DirectoryLabel" Text="保存位置" Style="{DynamicResource SettingsLabel}" Margin="0,0,0,6" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="OutputDirectory" Style="{StaticResource TeacherInput}" AutomationProperties.AutomationId="RecordingDirectory"
                 AutomationProperties.LabeledBy="{Binding ElementName=DirectoryLabel}" />
                <Button Grid.Column="1" Content="选择…" Style="{DynamicResource TeacherButton}" Margin="8,0,0,0"
                 Click="BrowseClicked" AutomationProperties.AutomationId="RecordingBrowse" />
              </Grid>
            </StackPanel>
          </Border>
          <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="重新检测设备" Style="{DynamicResource TeacherQuiet}" VerticalAlignment="Center"
             Click="RefreshClicked" AutomationProperties.AutomationId="RecordingRefresh" />
            <TextBlock x:Name="CaptureSummary" Text="正在检测录制设备…" Style="{DynamicResource SettingsHint}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
        <TextBlock x:Name="RecordingPreferenceFeedback" Foreground="{DynamicResource TeacherSuccessBrush}" FontSize="13"
         TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="RecordingPreferenceFeedback" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Border Style="{DynamicResource SettingsGroupSurface}" Padding="16,12" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock x:Name="RecordingMessage" Text="点击开始后录制所选屏幕。" FontSize="14" TextWrapping="Wrap"
             AutomationProperties.AutomationId="RecordingStatus" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="RecordingMetrics" Style="{DynamicResource SettingsHint}" />
            <TextBlock x:Name="RecordingError" Foreground="{DynamicResource TeacherErrorBrush}" FontSize="13" TextWrapping="Wrap"
             Margin="0,8,0,0" AutomationProperties.AutomationId="RecordingError" AutomationProperties.LiveSetting="Polite">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
              </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border x:Name="RecordingCommandBar" Grid.Row="2" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="4,8,4,0">
      <DockPanel>
        <TextBlock x:Name="RecordingStartRefusal" DockPanel.Dock="Top" Foreground="{DynamicResource TeacherErrorBrush}"
         FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"
         AutomationProperties.AutomationId="RecordingStartRefusal">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <WrapPanel>
          <Button x:Name="RecordStart" Content="开始录制" Style="{DynamicResource TeacherPrimary}" MinHeight="57" IsEnabled="False"
           Click="StartClicked" AutomationProperties.AutomationId="RecordingStart" Margin="0,0,8,4" />
          <Button x:Name="SaveSettings" Content="保存录制设置" Style="{DynamicResource TeacherButton}" Click="SaveSettingsClicked"
           AutomationProperties.AutomationId="RecordingSaveSettings" Margin="0,0,8,4" />
          <Button x:Name="ReturnRecordingSettings" Content="返回录制" Style="{DynamicResource TeacherQuiet}" Click="EditSettingsClicked"
           AutomationProperties.AutomationId="RecordingReturnSettings" Visibility="Collapsed" Margin="0,0,8,4" />
          <Button x:Name="RecordPause" Content="暂停" Style="{DynamicResource TeacherButton}" MinWidth="108" MinHeight="57" Visibility="Collapsed"
           Click="PauseClicked" AutomationProperties.AutomationId="RecordingPause" Margin="0,0,8,4" />
          <Button x:Name="RecordStop" Content="停止并保存" Style="{DynamicResource TeacherButton}" MinHeight="57" Visibility="Collapsed"
           Click="StopClicked" AutomationProperties.AutomationId="RecordingStop" Margin="0,0,8,4" />
          <Button x:Name="OpenVideo" Content="打开视频" Style="{DynamicResource TeacherPrimary}" Visibility="Collapsed"
           Click="OpenVideoClicked" AutomationProperties.AutomationId="RecordingOpenVideo" Margin="0,0,8,4" />
          <Button x:Name="OpenFolder" Content="打开文件夹" Style="{DynamicResource TeacherQuiet}" Visibility="Collapsed"
           Click="OpenFolderClicked" AutomationProperties.AutomationId="RecordingOpenFolder" Margin="0,0,8,4" />
          <Button Content="返回主页" Style="{DynamicResource TeacherQuiet}" Click="HideClicked" AutomationProperties.AutomationId="RecordingHide" Margin="0,0,0,4" />
        </WrapPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
