<Window x:Class="NPEduTools.App.ScheduledNoiseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="定时噪音监测 · 原生备用展示" WindowStyle="None" ResizeMode="NoResize"
        Background="#F3F7F6" Foreground="#183B35" Topmost="True" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" MinWidth="760" MinHeight="500">
    <Grid Margin="56,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="定时噪音监测" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock x:Name="WindowText" FontSize="18" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="管理监测" Padding="24,12" Margin="0,0,16,0" Click="ManageClicked"/>
                <Button x:Name="ReturnButton" Padding="24,12" Click="ReturnClicked"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="实时信号电平" FontSize="22" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="LevelText" FontSize="112" FontWeight="SemiBold"/>
                <TextBlock Text="dBFS" FontSize="28" VerticalAlignment="Bottom" Margin="18,0,0,32"/>
            </StackPanel>
            <TextBlock x:Name="QualityText" FontSize="24" TextAlignment="Center"/>
            <TextBlock Text="越接近 0，输入越强；此值不是教室实际声压级，不用于班级排名。"
                       FontSize="18" Foreground="#647B76" TextAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="最近一分钟 · −100 至 0 dBFS" FontSize="16" Foreground="#647B76"/>
                <Canvas x:Name="TrendCanvas" Grid.Row="1" Margin="0,10,0,0" ClipToBounds="True" SizeChanged="TrendSizeChanged"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="MessageText" FontSize="18" TextWrapping="Wrap"/>
            <TextBlock Text="NPEduTools 原生备用展示 · 仅分析并上传统计，不保存或上传原音频。返回作业板后监测继续。"
                       FontSize="16" Foreground="#647B76" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
