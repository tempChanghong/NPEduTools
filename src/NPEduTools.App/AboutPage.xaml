<UserControl x:Class="NPEduTools.App.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="AboutPage" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="AboutBody" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="#61766B" />
      <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="AboutCard" TargetType="Border">
      <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E0E9E3" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="24" /><Setter Property="Margin" Value="0,0,0,16" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
    <StackPanel>
      <Border Style="{StaticResource AboutCard}" Background="#EAF4EF" BorderBrush="#D7E8DF" Padding="26">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="22" Width="96" Height="96" Margin="0,0,22,0" VerticalAlignment="Top">
              <Image Source="{StaticResource BrandLogo}" Width="76" Height="76" Stretch="Uniform" AutomationProperties.Name="NPEduTools 标志" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="为教室大屏而设计" Foreground="#147D68" FontSize="12" Margin="0,0,0,7" />
              <TextBlock Text="NPEduTools" FontFamily="Segoe UI" FontSize="32" FontWeight="SemiBold" Foreground="#203D32" />
              <TextBlock Text="让课堂操作更顺手" Style="{StaticResource AboutBody}" Margin="0,6,0,0" />
            </StackPanel>
          </Grid>
          <TextBlock Text="常驻侧边栏、微课录制、课堂软件联动与学校互联，把日常教学需要的操作放在一起。" Style="{StaticResource AboutBody}" Margin="0,20,0,14" />
          <WrapPanel>
            <Border Background="#D8EBE1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8"><TextBlock x:Name="VersionBadge" Foreground="#1C604D" FontSize="12" AutomationProperties.AutomationId="AboutVersion" /></Border>
            <Border Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="Windows · WPF" Foreground="#526B5D" FontSize="12" /></Border>
            <Border Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="GPL-3.0" Foreground="#526B5D" FontSize="12" /></Border>
          </WrapPanel>
          <TextBlock x:Name="ReleaseStatus" Style="{StaticResource AboutBody}" FontSize="12" Margin="0,0,0,12" />
          <WrapPanel>
            <Button Content="星火动力官网  ↗" Tag="https://novark.ink/" Click="OpenLinkClicked" Style="{StaticResource Primary}" Margin="0,0,8,8" AutomationProperties.AutomationId="AboutWebsite" />
            <Button Content="项目源代码  ↗" Tag="https://github.com/tempChanghong/NPEduTools" Click="OpenLinkClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="AboutRepository" />
            <Button Content="版本与下载  ↗" Tag="https://github.com/tempChanghong/NPEduTools/releases" Click="OpenLinkClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="AboutReleases" />
            <Button Content="反馈问题  ↗" Tag="https://github.com/tempChanghong/NPEduTools/issues" Click="OpenLinkClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="AboutFeedback" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <UniformGrid Columns="3" Margin="0,0,0,16">
        <Border Background="White" BorderBrush="#E0E9E3" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,8,0"><StackPanel>
          <TextBlock Text="随手开启" FontSize="16" FontWeight="SemiBold" Foreground="#203D32" />
          <TextBlock Text="常驻侧栏快速打开应用、课件与教学工具。" Style="{StaticResource AboutBody}" FontSize="13" Margin="0,8,0,0" />
        </StackPanel></Border>
        <Border Background="White" BorderBrush="#E0E9E3" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,8,0"><StackPanel>
          <TextBlock Text="服务课堂" FontSize="16" FontWeight="SemiBold" Foreground="#203D32" />
          <TextBlock Text="录制微课，安排自动录课，联动日常与考试环境。" Style="{StaticResource AboutBody}" FontSize="13" Margin="0,8,0,0" />
        </StackPanel></Border>
        <Border Background="White" BorderBrush="#E0E9E3" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel>
          <TextBlock Text="连接学校" FontSize="16" FontWeight="SemiBold" Foreground="#203D32" />
          <TextBlock Text="通过 NPEP 连接 NPClassworks，接收通知与学校安排。" Style="{StaticResource AboutBody}" FontSize="13" Margin="0,8,0,0" />
        </StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource AboutCard}"><StackPanel>
        <TextBlock Text="由星火动力维护" FontSize="20" FontWeight="SemiBold" Foreground="#203D32" />
        <TextBlock Text="NOVARK POWER" FontFamily="Segoe UI" FontSize="12" Foreground="#147D68" Margin="0,6,0,14" />
        <TextBlock Text="从真实校园场景出发，把想法做成能长期使用的工具。我们重视创作者的作品归属，也重视从制作到维护的完整过程。" Style="{StaticResource AboutBody}" />
        <TextBlock Text="NPEduTools 与 NPClassworks 通过 NPEP 互补：网页负责学校与班级的协作，桌面应用提供本机设备与课堂软件能力。" Style="{StaticResource AboutBody}" Margin="0,10,0,14" />
        <WrapPanel>
          <Button Content="NPClassworks  ↗" Tag="https://github.com/tempChanghong/NPClassworks" Click="OpenLinkClicked" Style="{StaticResource Quiet}" Padding="0,8" Margin="0,0,20,0" />
          <Button Content="NPClassworksKV  ↗" Tag="https://github.com/tempChanghong/NPClassworksKV" Click="OpenLinkClicked" Style="{StaticResource Quiet}" Padding="0,8" />
        </WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource AboutCard}"><StackPanel>
        <TextBlock Text="开源与许可" FontSize="20" FontWeight="SemiBold" Foreground="#203D32" />
        <TextBlock Text="NPEduTools 依据 GNU GPL v3 开放源代码。修改和分发时，请遵守项目许可证及第三方组件各自的许可要求。" Style="{StaticResource AboutBody}" Margin="0,12,0,10" />
        <TextBlock Text="ClassIsland、ExamAware2 与 SecRandom 是独立维护的项目；本应用通过接口与它们协作。感谢上游开发者、贡献者，以及参与试用和反馈的教师与同学。" Style="{StaticResource AboutBody}" />
        <WrapPanel Margin="0,12,0,0">
          <Button Content="查看许可证  ↗" Tag="https://github.com/tempChanghong/NPEduTools/blob/main/LICENSE" Click="OpenLinkClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="AboutLicense" />
          <Button Content="第三方组件与许可  ↗" Tag="https://github.com/tempChanghong/NPEduTools/blob/main/docs/THIRD-PARTY-MATERIALS.md" Click="OpenLinkClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="AboutThirdParty" />
        </WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource AboutCard}"><StackPanel>
        <TextBlock Text="感谢这些项目" FontSize="20" FontWeight="SemiBold" Foreground="#203D32" />
        <TextBlock Text="为课堂协作、媒体录制与原生设备能力提供支持。" Style="{StaticResource AboutBody}" Margin="0,8,0,14" />
        <ItemsControl x:Name="Acknowledgements">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Tag="{Binding Url}" Click="OpenLinkClicked" Width="258" Background="#F0F6F3" Padding="14" Margin="0,0,12,12" HorizontalContentAlignment="Stretch">
              <StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#203D32" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource AboutBody}" FontSize="12" Margin="0,6,0,0" />
              </StackPanel>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel></Border>
      <Border Style="{StaticResource AboutCard}"><StackPanel>
        <DockPanel LastChildFill="True">
          <Button Content="复制版本信息" Click="CopyVersionClicked" DockPanel.Dock="Right" Padding="12,8" AutomationProperties.AutomationId="AboutCopyVersion" />
          <TextBlock Text="版本信息" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#203D32" />
        </DockPanel>
        <TextBlock Text="反馈问题时可附上版本信息；请勿公开学校配对码、账号密码或设备令牌。" Style="{StaticResource AboutBody}" FontSize="12" Margin="0,12,0,12" />
        <Expander Header="查看构建信息">
          <TextBox x:Name="BuildInformation" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="4,10" FontFamily="Consolas" FontSize="12" AutomationProperties.AutomationId="AboutBuildInformation" />
        </Expander>
        <TextBlock x:Name="ActionMessage" Foreground="#147D68" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="AboutActionMessage" />
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
