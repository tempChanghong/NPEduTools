<Window x:Class="NPEduTools.App.StudyReportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="自习报告" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
 Background="#02080D" Foreground="White" Topmost="True" ShowInTaskbar="False"
 FontFamily="MiSans, Microsoft YaHei UI" FontWeight="330">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#BBC0C4"/>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="#040E15"/><Setter Property="BorderBrush" Value="#18242D"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/>
  </Style>
  <Style x:Key="Number" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="/NPEduTools.App;component/Assets/Study/Fonts/#TCloudNumber"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="HeroNumber" TargetType="TextBlock" BasedOn="{StaticResource Number}">
   <Setter Property="FontSize" Value="146"/>
   <!-- Only the two large numbers carry a static, glyph-sized clock glow. -->
   <Setter Property="Effect"><Setter.Value>
    <DropShadowEffect Color="White" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.3" RenderingBias="Performance"/>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="Tool" TargetType="Button">
   <Setter Property="Foreground" Value="#D6D9DB"/><Setter Property="FontSize" Value="23"/>
   <Setter Property="Background" Value="#040E15"/><Setter Property="BorderBrush" Value="#334047"/>
   <Setter Property="BorderThickness" Value="2"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="#697784"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="White"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Ellipse Width="1660" Height="500" VerticalAlignment="Top" Margin="0,-200,0,0" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#353758FF" Offset="0"/><GradientStop Color="#003758FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Viewbox Stretch="Uniform">
   <Canvas Width="1920" Height="1080">
    <TextBlock Canvas.Left="40" Canvas.Top="38" Text="NPEduTools" FontSize="27" FontWeight="SemiBold"/>
    <TextBlock Canvas.Left="40" Canvas.Top="89" Text="本次自习报告" FontSize="42" FontWeight="Bold"/>
    <TextBlock x:Name="SessionTime" Canvas.Left="40" Canvas.Top="152" FontSize="20" Foreground="{StaticResource Muted}"/>
    <Border Canvas.Left="1430" Canvas.Top="84" Width="450" Height="96" Style="{StaticResource Panel}">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="Remaining" Style="{StaticResource Number}" FontSize="52" VerticalAlignment="Center"/>
      <TextBlock Text="后关闭展示" FontSize="23" Foreground="{StaticResource Muted}" Margin="20,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
    <TextBlock x:Name="Completion" Canvas.Left="1430" Canvas.Top="191" Width="450" TextAlignment="Right" FontSize="17" Foreground="{StaticResource Muted}"/>
    <Border Canvas.Left="40" Canvas.Top="222" Width="1110" Height="268" Style="{StaticResource Panel}">
     <Grid Margin="34,22,34,20">
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
      <TextBlock x:Name="OverviewTitle" FontSize="26" Foreground="{StaticResource Muted}"/>
      <Grid Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBlock x:Name="PrimaryMean" Style="{StaticResource HeroNumber}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#243039" Margin="0,12"/>
       <TextBlock x:Name="PrimaryMaximum" Grid.Column="2" Style="{StaticResource HeroNumber}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBlock Text="能量均值" FontSize="23" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
       <TextBlock x:Name="MaximumCaption" Grid.Column="1" FontSize="23" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
      </Grid>
     </Grid>
    </Border>
    <Grid Canvas.Left="40" Canvas.Top="500" Width="1110" Height="30">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal"><TextBlock Text="采集覆盖" FontSize="18" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="Coverage" FontSize="24" Style="{StaticResource Number}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="有效采集" FontSize="18" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="Sampled" FontSize="21" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="纪律提醒触发" FontSize="18" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="ReminderCount" FontSize="24" Style="{StaticResource Number}" Margin="14,0,6,0" VerticalAlignment="Center"/><TextBlock Text="次" FontSize="18" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
    </Grid>
    <Border Canvas.Left="40" Canvas.Top="548" Width="1110" Height="384" Style="{StaticResource Panel}">
     <Canvas>
      <TextBlock x:Name="TrendTitle" Canvas.Left="32" Canvas.Top="23" FontSize="29" FontWeight="SemiBold"/>
      <TextBlock Text="每分钟能量均值 · 缺失时段留空" Canvas.Left="32" Canvas.Top="65" FontSize="18" Foreground="{StaticResource Muted}"/>
      <Canvas x:Name="Chart" Canvas.Left="32" Canvas.Top="107" Width="1046" Height="226" ClipToBounds="True"/>
      <TextBlock x:Name="ChartStart" Canvas.Left="88" Canvas.Top="340" FontSize="20" Foreground="{StaticResource Muted}" Style="{StaticResource Number}"/>
      <TextBlock x:Name="ChartEnd" Canvas.Right="34" Canvas.Top="340" FontSize="20" Foreground="{StaticResource Muted}" Style="{StaticResource Number}"/>
     </Canvas>
    </Border>
    <Border x:Name="StatisticsPanel" Canvas.Left="1190" Canvas.Top="222" Width="690" Height="710" Style="{StaticResource Panel}">
     <StackPanel x:Name="StatisticsContent" Margin="34,26">
      <TextBlock Text="数字信号 · dBFS" FontSize="26" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="RawValues" FontSize="50" Style="{StaticResource Number}" Margin="0,10,0,0"/>
      <TextBlock Text="能量均值 / 数字信号峰值" Foreground="{StaticResource Muted}" FontSize="19" Margin="0,6,0,16"/>
      <TextBlock x:Name="RawThresholds" FontSize="23" TextWrapping="Wrap" LineHeight="33"/>
      <TextBlock x:Name="RawQuality" Foreground="{StaticResource Muted}" FontSize="18" Margin="0,12,0,0" TextWrapping="Wrap"/>
      <Border Height="1" Background="#243039" Margin="0,22,0,22"/>
      <TextBlock Text="外部参考 · 估算 dB(A)" FontSize="26" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="EstimatedValues" FontSize="50" Style="{StaticResource Number}" Margin="0,10,0,0"/>
      <TextBlock Text="能量均值 / 采样最大值" Foreground="{StaticResource Muted}" FontSize="19" Margin="0,6,0,16"/>
      <TextBlock x:Name="EstimatedThresholds" FontSize="23" TextWrapping="Wrap" LineHeight="33"/>
      <TextBlock x:Name="EstimatedQuality" Foreground="{StaticResource Muted}" FontSize="18" Margin="0,12,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Button Canvas.Left="40" Canvas.Top="970" Width="180" Height="77" Style="{StaticResource Tool}" Content="关闭报告" Click="CloseReportClicked"/>
    <ScrollViewer Canvas.Left="250" Canvas.Top="962" Width="1630" Height="85" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <TextBlock x:Name="Notes" FontSize="18" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="27"/>
    </ScrollViewer>
    <TextBlock Text="本机统计 · 上传状态以后台回执为准 · 提醒触发次数不代表声音播放成功 · 不用于班级评分或排名"
      Canvas.Left="40" Canvas.Top="1056" FontSize="15" Foreground="{StaticResource Muted}"/>
   </Canvas>
  </Viewbox>
 </Grid>
</Window>
