<UserControl x:Class="NPEduTools.App.NpepConnectionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    <Style x:Key="OptionalText" TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding Stage}" Foreground="#147D68" FontSize="12" Margin="0,0,0,8" AutomationProperties.AutomationId="NpepPairingStage" />
    <DockPanel>
      <Button Content="刷新" Click="RefreshClicked" DockPanel.Dock="Right" Style="{StaticResource Quiet}" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="NpepRefresh" />
      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="NpepStatusTitle" />
    </DockPanel>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#64776D" Margin="0,8,0,0" AutomationProperties.AutomationId="NpepMessage" />
    <TextBlock Text="{Binding Receipt}" Style="{StaticResource OptionalText}" TextWrapping="Wrap" Foreground="#64776D" FontSize="12" Margin="0,4,0,0" />
    <TextBlock Text="{Binding Error}" Style="{StaticResource OptionalText}" TextWrapping="Wrap" Foreground="#A14334" FontSize="12" Margin="0,4,0,0" AutomationProperties.AutomationId="NpepError" />
    <StackPanel Margin="0,14,0,0">
      <TextBlock Text="服务提供商 · 学校服务地址" FontWeight="SemiBold" />
      <TextBlock Text="请向管理员索取服务地址，网页地址不一定是服务地址。支持 HTTP / HTTPS；HTTP 不加密，正式使用优先选择 HTTPS。" TextWrapping="Wrap" FontSize="12" Foreground="#64776D" Margin="0,4,0,8" />
      <TextBox Text="{Binding Origin, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowAddressEditor, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding CanEdit}" MaxLength="2048" AutomationProperties.AutomationId="NpepOrigin" AutomationProperties.Name="学校服务地址" />
      <TextBox Text="{Binding BoundOrigin, Mode=OneWay}" Visibility="{Binding ShowCurrentAddress, Converter={StaticResource VisibleWhenTrue}}" IsReadOnly="True" AutomationProperties.AutomationId="NpepCurrentOrigin" AutomationProperties.Name="当前服务提供商地址" />
      <TextBlock Text="{Binding ProviderHint}" TextWrapping="Wrap" Foreground="#64776D" FontSize="12" Margin="0,6,0,0" />
      <Button Content="更换服务提供商…" Click="ChangeProviderClicked" Visibility="{Binding ShowChangeProvider, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding CanUnpair}" Style="{StaticResource Quiet}" HorizontalAlignment="Left" AutomationProperties.AutomationId="NpepChangeProvider" />
    </StackPanel>
    <StackPanel Visibility="{Binding ShowCreate, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
      <TextBlock Text="设备名称（便于管理员辨认）" Margin="0,12,0,8" />
      <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="64" AutomationProperties.AutomationId="NpepDeviceName" />
      <Button Content="检查服务" Click="InspectClicked" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="{Binding CanInspect}" AutomationProperties.AutomationId="NpepInspect" />
      <StackPanel Visibility="{Binding ShowServer, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
        <TextBlock Text="{Binding ServerIdentity}" TextWrapping="Wrap" Foreground="#64776D" FontSize="12" AutomationProperties.AutomationId="NpepServerIdentity" />
        <CheckBox IsChecked="{Binding ServerConfirmed}" IsEnabled="{Binding CanEdit}" Style="{StaticResource Switch}" Margin="0,8,0,8" AutomationProperties.AutomationId="NpepServerConfirmed"><TextBlock Text="我已与管理员核对这是学校的服务" TextWrapping="Wrap" /></CheckBox>
        <TextBlock Text="推荐：学校预先开放后，在对应班级大屏的 NPClassworks → 课堂工具 → 连接 NPEduTools 生成配对码，输入下面。无需管理员再次现场批准。" TextWrapping="Wrap" Foreground="#64776D" FontSize="12" Margin="0,8,0,8" />
        <TextBox Text="{Binding UserCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="16" AutomationProperties.Name="网页生成的8位配对码" AutomationProperties.AutomationId="NpepWebPairingCode" />
        <Button Content="使用网页配对码" Click="ClaimClicked" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="{Binding CanClaim}" AutomationProperties.AutomationId="NpepClaim" />
        <Expander Header="其他方式：由管理员逐次批准" Margin="0,12,0,0"><Button Content="创建配对码，等待管理员批准" HorizontalAlignment="Left" Click="PairClicked" IsEnabled="{Binding CanPair}" AutomationProperties.AutomationId="NpepPair" /></Expander>
      </StackPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding ShowCode, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
      <TextBlock Text="请学校管理员在 NPClassworks 的 NPEP 设备互联页面输入此码，并指定学校、班级和大屏。" TextWrapping="Wrap" Foreground="#64776D" />
      <WrapPanel Margin="0,8,0,4"><TextBlock Text="{Binding PairingCode}" FontSize="30" FontWeight="SemiBold" Foreground="#147D68" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.AutomationId="NpepPairingCode" /><Button Content="复制配对码" Click="CopyCodeClicked" Style="{StaticResource Quiet}" AutomationProperties.AutomationId="NpepCopyCode" /></WrapPanel>
      <TextBlock Text="{Binding Expiry}" FontSize="12" Foreground="#64776D" TextWrapping="Wrap" />
      <TextBlock Text="仅向本校管理员提供此码。等待批准时可以稍后继续，申请会由后台保留；过期后先取消旧申请，再重新创建。" FontSize="12" Foreground="#64776D" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
    <StackPanel Visibility="{Binding ShowBinding, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
      <TextBlock Text="学校授权的连接归属" FontWeight="SemiBold" />
      <Border Background="#EAF6F2" CornerRadius="10" Padding="14" Margin="0,8,0,0"><TextBlock Text="{Binding Binding}" TextWrapping="Wrap" LineHeight="24" AutomationProperties.AutomationId="NpepBinding" /></Border>
      <TextBlock Text="{Binding BoundOrigin}" FontSize="12" Foreground="#64776D" TextWrapping="Wrap" Margin="0,6,0,0" />
      <Expander Header="归属核对编号" FontSize="12" Margin="0,8,0,0"><TextBlock Text="{Binding BindingIdentity}" TextWrapping="Wrap" Foreground="#64776D" Margin="0,8,0,0" /></Expander>
      <StackPanel Visibility="{Binding ShowConfirm, Converter={StaticResource VisibleWhenTrue}}">
        <TextBlock Text="确认连接后，学校可接收设备状态、投递通知、切换考试 / 日常模式（含 Windows 登录自启动）及投递考试方案；配对的大屏网页可启停噪音监测，学校也可下发定时排程。监测只上传统计，不上传原音频。" TextWrapping="Wrap" Foreground="#526A60" FontSize="12" Margin="0,12,0,8" />
        <CheckBox IsChecked="{Binding BindingConfirmed}" IsEnabled="{Binding CanReviewBinding}" Style="{StaticResource Switch}" Margin="0,4,0,10" AutomationProperties.AutomationId="NpepBindingConfirmed"><TextBlock Text="学校、班级和大屏归属正确，同意上述连接功能" TextWrapping="Wrap" /></CheckBox>
        <Button Content="确认连接" Click="ConfirmClicked" HorizontalAlignment="Left" Style="{StaticResource Primary}" IsEnabled="{Binding CanConfirm}" AutomationProperties.AutomationId="NpepConfirm" />
      </StackPanel>
    </StackPanel>
    <TextBlock Visibility="{Binding ShowActive, Converter={StaticResource VisibleWhenTrue}}" Text="已配对与当前在线是两种状态。暂停或断网时保留归属；重新连接后继续。需要更换归属时先解除原绑定，再创建申请。" TextWrapping="Wrap" Foreground="#64776D" FontSize="12" Margin="0,12,0,0" />
    <WrapPanel Margin="0,12,0,0">
      <Button Content="{Binding RecoverLabel}" Click="RecoverClicked" Visibility="{Binding ShowRecover, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding CanRecover}" Margin="0,0,8,8" AutomationProperties.AutomationId="NpepRecover" />
      <Button Content="{Binding PauseLabel}" Click="PauseClicked" Visibility="{Binding ShowActive, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding CanPause}" Margin="0,0,8,8" AutomationProperties.AutomationId="NpepPause" />
      <Button Content="{Binding UnpairLabel}" Click="UnpairClicked" Visibility="{Binding ShowUnpair, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding CanUnpair}" Style="{StaticResource Quiet}" Margin="0,0,0,8" AutomationProperties.AutomationId="NpepUnpair" />
    </WrapPanel>
    <TextBlock x:Name="LocalMessage" Style="{StaticResource OptionalText}" TextWrapping="Wrap" FontSize="12" Foreground="#64776D" />
  </StackPanel>
</UserControl>
