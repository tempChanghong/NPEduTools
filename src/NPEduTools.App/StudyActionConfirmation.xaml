<Window x:Class="NPEduTools.App.StudyActionConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TeacherPageBrush}" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="{DynamicResource TeacherFont}">
  <StackPanel Margin="22">
    <TextBlock x:Name="EffectText" TextWrapping="Wrap" FontSize="15" LineHeight="23"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CancelAction" Content="取消" Style="{StaticResource TeacherButton}" IsCancel="True" IsDefault="True" Padding="14,7" Margin="0,0,8,0"/>
      <Button x:Name="ConfirmAction" Style="{StaticResource TeacherButton}" Click="ConfirmClicked" Padding="14,7"/>
    </StackPanel>
  </StackPanel>
</Window>
