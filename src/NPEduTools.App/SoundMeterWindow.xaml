<Window x:Class="NPEduTools.App.SoundMeterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="联机校准 (Beta) · NPEduTools" Width="820" Height="620" MinWidth="620" MinHeight="440"
 WindowStartupLocation="CenterOwner" Background="#F6F8F7" Foreground="#202E35" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
 <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="24,20">
  <TextBlock Text="联机校准 (Beta)" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock Text="连接与验证　→　同期采样　→　复核并保存" Foreground="#61786B" Margin="0,6,0,16"/>
  <Border Background="White" CornerRadius="12" BorderBrush="#E5EBE7" BorderThickness="1" Padding="18"><StackPanel>
   <TextBlock Text="连接 DLY-2202" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="插入 USB 数据线，关闭 SoundLab2；仪表使用 A 加权、关闭 MAX。" TextWrapping="Wrap" Foreground="#61786B" Margin="0,6,0,14"/>
   <StackPanel x:Name="CredentialsPanel"><TextBlock x:Name="ManagementLabel" Text="管理口令"/>
   <WrapPanel Margin="0,6,0,0">
    <PasswordBox x:Name="ManagementSecret" Width="240" MaxLength="128" Margin="0,0,10,6" AutomationProperties.AutomationId="MeterSecret"/>
    <Button x:Name="ListDevices" Content="验证口令并查找仪表" Click="ListClicked" Padding="12,7" Margin="0,0,10,6" AutomationProperties.AutomationId="MeterList"/>
    <Button x:Name="ConfigureManagement" Content="设置管理口令" Click="ManagementClicked" Padding="12,7" Margin="0,0,0,6"/>
   </WrapPanel>
   <TextBlock x:Name="ManagementHint" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,12" Foreground="#61786B"/>
   </StackPanel><Button x:Name="ResetVerification" Content="重新验证口令" Click="ResetVerificationClicked" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,12"/>
   <TextBlock Text="声级计"/>
   <ComboBox x:Name="Devices" DisplayMemberPath="Name" Margin="0,6,0,12" SelectionChanged="DeviceSelected" AutomationProperties.AutomationId="MeterDevices"/>

  </StackPanel></Border>
  <TextBlock x:Name="Message" Text="输入管理口令后查找仪表，再选择设备进入同期采样。此页不会自动采样。" TextWrapping="Wrap" Foreground="#61786B" Margin="0,12,0,14" AutomationProperties.AutomationId="MeterMessage"/>
  <Expander x:Name="DiagnosticDetails" Header="连接诊断：读取一次" HorizontalContentAlignment="Stretch">
   <StackPanel Margin="0,10,0,0">
    <Button x:Name="ReadMeter" Content="连接并读取一次" Click="ReadClicked" IsEnabled="False" HorizontalAlignment="Left" Padding="12,7" AutomationProperties.AutomationId="MeterRead"/>
    <TextBlock x:Name="Reading" Text="尚未读取" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,6" AutomationProperties.AutomationId="MeterReading"/>
    <TextBlock x:Name="Mode" TextWrapping="Wrap" Foreground="#61786B"/>
    <TextBlock Text="诊断读数不用于校准。每次读取后释放连接，三秒后撤下读数；正式校准需同期采样。" TextWrapping="Wrap" Foreground="#61786B" FontSize="12" Margin="0,8,0,0"/>
   </StackPanel>
  </Expander>
 </StackPanel></ScrollViewer><Border Grid.Row="1" BorderBrush="#DFE7E1" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel HorizontalAlignment="Right"><Button x:Name="OpenReference" Content="下一步：同期采样 (Beta)" Style="{StaticResource Primary}" Click="ReferenceClicked" IsEnabled="False" HorizontalAlignment="Left" Padding="14,8" AutomationProperties.AutomationId="MeterReference"/></StackPanel></Border></Grid>
</Window>
