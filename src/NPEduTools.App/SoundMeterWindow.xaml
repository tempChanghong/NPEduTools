<Window x:Class="NPEduTools.App.SoundMeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="联机校准 (Beta) · NPEduTools" Width="820" Height="620" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource TeacherPageBrush}"
        Foreground="{DynamicResource TeacherTextBrush}"
        FontFamily="{DynamicResource TeacherFont}"
        UseLayoutRounding="True">
 <Grid x:Name="MeterRoot" SizeChanged="MeterLayoutChanged">
  <Grid.Resources>
   <Style x:Key="MeterCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsGroupSurface}">
    <Setter Property="Padding" Value="16,14"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding Tag, ElementName=MeterRoot}" Value="UsbWorkspace">
      <Setter Property="Padding" Value="14,12"/>
     </DataTrigger>
    </Style.Triggers>
   </Style>
  </Grid.Resources>
  <ScrollViewer x:Name="MeterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
   <StackPanel>
    <StackPanel.Style>
     <Style TargetType="StackPanel">
      <Setter Property="Margin" Value="20,16"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding Tag, ElementName=MeterRoot}" Value="UsbWorkspace">
        <Setter Property="Margin" Value="16,10,16,12"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </StackPanel.Style>
    <StackPanel x:Name="MeterHeadingBlock" Margin="0,0,0,12">
     <TextBlock Text="联机校准 (Beta)" FontSize="24" FontWeight="SemiBold"/>
     <TextBlock Text="连接与验证　→　同期采样　→　复核并保存" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid x:Name="MeterLayout">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="0"/>
     </Grid.ColumnDefinitions>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Border x:Name="MeterConnectionPane" Grid.Row="0" Grid.Column="0" Style="{StaticResource MeterCardStyle}" VerticalAlignment="Top">
      <StackPanel>
       <DockPanel Margin="0,0,0,4">
        <Button Style="{StaticResource TeacherQuiet}" x:Name="ResetVerification" DockPanel.Dock="Right" Content="重新验证口令" Click="ResetVerificationClicked" Visibility="Collapsed" MinHeight="32" Padding="10,4" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <TextBlock Text="连接 DLY-2202" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="插入 USB 数据线，关闭 SoundLab2；仪表使用 A 加权、关闭 MAX。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,0,0,10"/>
       <StackPanel x:Name="CredentialsPanel">
        <TextBlock x:Name="ManagementLabel" Text="管理口令" FontSize="13"/>
        <WrapPanel Margin="0,4,0,0">
         <PasswordBox Style="{StaticResource TeacherInput}" x:Name="ManagementSecret" Width="220" MinHeight="38" MaxLength="128" Margin="0,0,8,6" AutomationProperties.AutomationId="MeterSecret"/>
         <Button Style="{StaticResource TeacherButton}" x:Name="ListDevices" Content="验证口令并查找仪表" Click="ListClicked" MinHeight="38" Padding="12,5" Margin="0,0,8,6" AutomationProperties.AutomationId="MeterList"/>
         <Button Style="{StaticResource TeacherButton}" x:Name="ConfigureManagement" Content="设置管理口令" Click="ManagementClicked" MinHeight="38" Padding="12,5" Margin="0,0,0,6"/>
        </WrapPanel>
        <TextBlock x:Name="ManagementHint" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,10" Foreground="{DynamicResource TeacherMutedBrush}"/>
       </StackPanel>
       <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="0,0,0,10"/>
       <TextBlock Text="声级计" FontSize="13" FontWeight="SemiBold"/>
       <ComboBox Style="{DynamicResource SettingsChoice}" x:Name="Devices" DisplayMemberPath="Name" MinHeight="40" Margin="0,4,0,10" SelectionChanged="DeviceSelected" AutomationProperties.AutomationId="MeterDevices"/>
       <WrapPanel VerticalAlignment="Center">
        <Button x:Name="OpenReference" Content="下一步：同期采样 (Beta)" Style="{StaticResource TeacherPrimary}" Click="ReferenceClicked" IsEnabled="False" MinHeight="40" Padding="16,6" HorizontalAlignment="Left" AutomationProperties.AutomationId="MeterReference"/>
        <Button Content="重新查找仪表" Style="{StaticResource TeacherQuiet}" Click="ListClicked"
                Margin="8,0,0,0" Visibility="{Binding Visibility, ElementName=ResetVerification}"
                IsEnabled="{Binding IsEnabled, ElementName=ListDevices}"/>
       </WrapPanel>
       <TextBlock x:Name="Message" Text="输入管理口令后查找仪表，再选择设备进入同期采样。此页不会自动采样。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,10,0,0" AutomationProperties.AutomationId="MeterMessage"/>
      </StackPanel>
     </Border>
     <Border x:Name="MeterDiagnosticPane" Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Top">
      <Expander x:Name="DiagnosticDetails" Header="连接诊断：读取一次" IsExpanded="False" Style="{StaticResource TeacherExpander}" Expanded="MeterDiagnosticsChanged" Collapsed="MeterDiagnosticsChanged" AutomationProperties.Name="连接诊断：读取一次">
       <Border Style="{StaticResource MeterCardStyle}" Margin="0,6,0,0">
        <StackPanel>
         <Button Style="{StaticResource TeacherButton}" x:Name="ReadMeter" Content="连接并读取一次" Click="ReadClicked" IsEnabled="False" HorizontalAlignment="Left" MinHeight="38" Padding="12,5" AutomationProperties.AutomationId="MeterRead"/>
         <TextBlock x:Name="Reading" Text="尚未读取" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4" AutomationProperties.AutomationId="MeterReading"/>
         <TextBlock x:Name="Mode" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}"/>
         <TextBlock Text="诊断读数不用于校准。每次读取后释放连接，三秒后撤下读数；正式校准需同期采样。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12.5" Margin="0,8,0,0"/>
        </StackPanel>
       </Border>
      </Expander>
     </Border>
    </Grid>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
