<Window x:Class="NPEduTools.App.NoiseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动自习 · NPEduTools" Width="820" Height="760" MinWidth="650" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TeacherPageBrush}" Foreground="{DynamicResource TeacherTextBrush}"
        FontFamily="{DynamicResource TeacherFont}" Icon="/Assets/npedutools.ico" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary Source="Resources/ManualStudyControls.xaml" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

    <ScrollViewer x:Name="ManualPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                  AutomationProperties.Name="手动自习管理">
      <ScrollViewer.Resources><Style TargetType="ScrollBar" /></ScrollViewer.Resources>
      <StackPanel Margin="4,0,4,12">
        <Border Style="{StaticResource ManualStudyCard}">
          <StackPanel>
            <TextBlock x:Name="ManualHeading" Text="开始一节手动自习" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ManualHeading" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="ManualStatus" Text="正在确认手动会话状态…" Style="{StaticResource ManualStudyHint}"
                       Foreground="{DynamicResource TeacherTextBrush}" FontSize="15" Margin="0,7,0,0"
                       AutomationProperties.AutomationId="ManualStatus" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="StateText" Text="正在连接后台…" Style="{StaticResource ManualStudyHint}" Margin="0,5,0,0"
                       AutomationProperties.AutomationId="ManualConnectionStatus" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="StateHintText" Style="{StaticResource ManualStudyHint}" Visibility="Collapsed" Margin="0,4,0,0" />

            <StackPanel x:Name="ManualConfiguration" Margin="0,12,0,0">
              <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                <StackPanel>
                  <WrapPanel>
                    <TextBlock Text="开始时间" Width="104" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource ManualStudyChoices}">
                      <WrapPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                        <RadioButton Content="立即开始" GroupName="ManualStudyStart" IsChecked="True" Style="{DynamicResource SettingsSegment}" MinWidth="88"
                                     AutomationProperties.AutomationId="ManualStartNow" />
                        <RadioButton x:Name="UseStart" Content="预约开始" GroupName="ManualStudyStart" Style="{DynamicResource SettingsSegment}" MinWidth="88"
                                     Checked="ManualOptionsChanged" Unchecked="ManualOptionsChanged" AutomationProperties.AutomationId="UseStart" />
                      </WrapPanel>
                    </Border>
                  </WrapPanel>
                  <WrapPanel x:Name="StartFields" Visibility="Collapsed" Margin="0,8,0,0">
                    <DatePicker x:Name="ManualStartDate" Width="166" Style="{StaticResource ManualStudyDate}" Margin="0,0,8,4"
                                AutomationProperties.Name="手动开始日期" AutomationProperties.AutomationId="ManualStartDate" />
                    <TextBox x:Name="ManualStartTime" Text="19:00" Width="94" Style="{DynamicResource TeacherInput}" Margin="0,0,0,4"
                             AutomationProperties.Name="手动开始时间 HH:mm" AutomationProperties.AutomationId="ManualStartTime" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                <StackPanel>
                  <WrapPanel>
                    <TextBlock Text="结束时间" Width="104" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource ManualStudyChoices}">
                      <WrapPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                        <RadioButton Content="手动结束" GroupName="ManualStudyEnd" IsChecked="True" Style="{DynamicResource SettingsSegment}" MinWidth="88"
                                     AutomationProperties.AutomationId="ManualEndManually" />
                        <RadioButton x:Name="UseEnd" Content="指定时间" GroupName="ManualStudyEnd" Style="{DynamicResource SettingsSegment}" MinWidth="88"
                                     Checked="ManualOptionsChanged" Unchecked="ManualOptionsChanged" AutomationProperties.AutomationId="UseEnd" />
                      </WrapPanel>
                    </Border>
                  </WrapPanel>
                  <WrapPanel x:Name="EndFields" Visibility="Collapsed" Margin="0,8,0,0">
                    <DatePicker x:Name="ManualEndDate" Width="166" Style="{StaticResource ManualStudyDate}" Margin="0,0,8,4"
                                AutomationProperties.Name="手动结束日期" AutomationProperties.AutomationId="ManualEndDate" />
                    <TextBox x:Name="ManualEndTime" Text="21:30" Width="94" Style="{DynamicResource TeacherInput}" Margin="0,0,0,4"
                             AutomationProperties.Name="手动结束时间 HH:mm" AutomationProperties.AutomationId="ManualEndTime" />
                  </WrapPanel>
                  <TextBlock Margin="0,6,0,2">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource ManualStudyHint}">
                        <Setter Property="Text" Value="手动结束模式最长三小时。学校定时自习优先。" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsChecked, ElementName=UseEnd}" Value="True">
                            <Setter Property="Text" Value="学校定时自习优先。" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
              <Expander Header="临时使用电脑后返回" Style="{DynamicResource TeacherExpander}" Margin="0,4,0,0"
                        AutomationProperties.AutomationId="ManualReturnSettings">
                <StackPanel>
                  <WrapPanel>
                    <TextBlock Text="无操作返回（分钟）" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox x:Name="ManualHideMinutes" Text="10" Width="65" Style="{DynamicResource TeacherInput}" Margin="0,0,12,4"
                             AutomationProperties.Name="无操作返回时长（分钟）" />
                    <CheckBox x:Name="NoManualReturn" Content="不自动返回" Style="{DynamicResource RecordingCheck}" MinHeight="44"
                              Checked="ManualOptionsChanged" Unchecked="ManualOptionsChanged" VerticalAlignment="Center" />
                  </WrapPanel>
                  <TextBlock Text="后台监测继续。操作其他软件也会重新计时。" Style="{StaticResource ManualStudyHint}" Margin="0,4,0,0" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource ManualStudyCard}" Padding="18,12">
          <StackPanel>
            <WrapPanel>
              <TextBlock Text="实时信号" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="LevelText" Text="—" FontSize="22" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="ManualSignalLevel" />
                <TextBlock Text="dBFS" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource TeacherMutedBrush}" />
              </StackPanel>
              <TextBlock x:Name="QualityText" Text="等待采样" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                         AutomationProperties.AutomationId="ManualSampleQuality" />
              <ProgressBar x:Name="LevelBar" Minimum="-100" Maximum="0" Value="-100" Height="6" Width="104" VerticalAlignment="Center"
                           Foreground="{DynamicResource TeacherAccentBrush}" Background="{DynamicResource TeacherLineBrush}"
                           AutomationProperties.Name="实时输入电平 dBFS">
                <ProgressBar.Template>
                  <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                      <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3" /></Grid>
                    </Border>
                  </ControlTemplate>
                </ProgressBar.Template>
              </ProgressBar>
            </WrapPanel>
            <Expander Header="趋势与采样详情" Style="{DynamicResource TeacherExpander}" Margin="0,5,0,0"
                      AutomationProperties.AutomationId="ManualSignalDetails">
              <StackPanel>
                <TextBlock x:Name="LevelHintText" Style="{StaticResource ManualStudyHint}" Foreground="{DynamicResource TeacherWarningBrush}" />
                <TextBlock x:Name="CalibrationStatus" Text="校准状态待确认" Style="{StaticResource ManualStudyHint}"
                           AutomationProperties.AutomationId="ManualCalibrationStatus" />
                <TextBlock x:Name="EstimateText" TextWrapping="Wrap" FontSize="15" Margin="0,6,0,0" />
                <Border Background="{DynamicResource TeacherPageBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="1"
                        CornerRadius="6" Margin="0,12,0,6" Padding="8">
                  <Canvas x:Name="TrendCanvas" Height="95" ClipToBounds="True" SizeChanged="TrendSizeChanged" AutomationProperties.Name="最近一分钟信号趋势" />
                </Border>
                <TextBlock Text="最近一分钟 · 固定刻度 −100 至 0 dBFS。缺样和无效区间留空。" Style="{StaticResource ManualStudyHint}" />
                <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="0,10" />
                <TextBlock x:Name="SummaryTitle" Text="监测统计" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SummaryText" Text="开始后显示有效采样、覆盖率与能量平均电平。" TextWrapping="Wrap" Margin="0,7,0,0" />
                <TextBlock x:Name="SummaryHint" Text="本页展示本机采样统计。学校历史报告和上传状态可在 NPClassworks 后台查看。"
                           Style="{StaticResource ManualStudyHint}" Margin="0,6,0,0" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource ManualStudyCard}" Padding="12,2,12,4">
          <Expander x:Name="ManualDeviceSettings" Header="麦克风与校准" Style="{DynamicResource TeacherExpander}"
                    AutomationProperties.AutomationId="ManualDeviceSettings">
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="手动与学校定时自习共用麦克风和校准，学校设备锁定规则继续生效。"
                         Style="{StaticResource ManualStudyHint}" Margin="0,0,0,10" />
              <TextBlock Text="监测麦克风" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5" />
              <ComboBox x:Name="Microphone" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{DynamicResource SettingsChoice}"
                        MinHeight="44" AutomationProperties.Name="监测麦克风" AutomationProperties.AutomationId="ManualMicrophone" />
              <WrapPanel Margin="0,8,0,4">
                <Button x:Name="RefreshButton" Content="刷新设备" Click="RefreshClicked" Style="{DynamicResource TeacherButton}" Margin="0,0,8,4" />
                <Button x:Name="SaveDeviceButton" Content="保存麦克风" Click="SaveDeviceClicked" Style="{DynamicResource TeacherButton}" Margin="0,0,8,4" />
                <Button x:Name="ManualDeviceLink" Content="设备与校准" Click="ManualDevicesClicked" Style="{DynamicResource TeacherQuiet}"
                        Visibility="Collapsed" Margin="0,0,8,4" AutomationProperties.AutomationId="ManualDeviceLink" />
                <Button x:Name="ManualCalibrationLink" Content="联机校准 (Beta)" Click="ManualCalibrationClicked" Style="{DynamicResource TeacherQuiet}"
                        Visibility="Collapsed" Margin="0,0,0,4" AutomationProperties.AutomationId="ManualCalibrationLink" />
              </WrapPanel>
            </StackPanel>
          </Expander>
        </Border>

        <Border Style="{StaticResource ManualStudyCard}" Padding="12,2,12,4">
          <Expander Header="管理与诊断" Style="{DynamicResource TeacherExpander}" AutomationProperties.AutomationId="ManualManagementDetails">
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="定时监测保护" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="学校定时监测需验证管理权限才能停止或退出后台。连接 NPEP 后使用学校管理口令，本机口令不再用于学校监测。离线行为以后台权限状态为准。手动自习不受此限制。"
                         Style="{StaticResource ManualStudyHint}" Margin="0,7,0,10" />
              <Button Content="设置／修改本机管理口令" Click="ManagementClicked" Style="{DynamicResource TeacherButton}" HorizontalAlignment="Left" />
              <TextBlock x:Name="DisplayStatusText" Text="定时监测展示：等待后台状态。" Style="{StaticResource ManualStudyHint}" Margin="0,12,0,0" />
              <TextBlock x:Name="GuardStatusText" Text="定时监测守护：等待状态。" Style="{StaticResource ManualStudyHint}" Margin="0,6,0,0" />
            </StackPanel>
          </Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{DynamicResource TeacherPageBrush}" BorderBrush="{DynamicResource TeacherLineBrush}"
            BorderThickness="0,1,0,0" Padding="4,8,4,0" AutomationProperties.Name="手动自习操作">
      <StackPanel>
        <TextBlock x:Name="ManualActionHint" Style="{StaticResource ManualStudyHint}" Margin="0,0,0,5"
                   AutomationProperties.AutomationId="ManualActionHint" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="MessageText" Style="{StaticResource ManualStudyHint}" Foreground="{DynamicResource TeacherWarningBrush}" Margin="0,0,0,5"
                   AutomationProperties.AutomationId="ManualCommandFeedback" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="ManualChooseDevice" Content="选择麦克风" Click="ChooseManualDeviceClicked" Style="{DynamicResource TeacherButton}"
                  Visibility="Collapsed" Margin="0,0,8,4" AutomationProperties.AutomationId="ManualChooseDevice" />
          <Button x:Name="ManualReportButton" Content="查看最近手动报告" Click="ManualReportClicked" Style="{DynamicResource TeacherButton}"
                  Visibility="Collapsed" Margin="0,0,8,4" AutomationProperties.AutomationId="ManualReportButton" />
          <Button x:Name="ReturnStudyButton" Content="回到自习展示" Click="ReturnStudyClicked" Style="{DynamicResource TeacherPrimary}"
                  Visibility="Collapsed" IsEnabled="False" Margin="0,0,8,4" AutomationProperties.AutomationId="ReturnManualStudy" />
          <Button x:Name="StartButton" Content="开始自习" Click="StartClicked" Style="{DynamicResource TeacherPrimary}"
                  IsEnabled="False" Margin="0,0,0,4" AutomationProperties.AutomationId="NoiseStart" />
          <Button x:Name="StopButton" Content="结束自习" Click="StopClicked" Visibility="Collapsed"
                  IsEnabled="False" Margin="0,0,0,4" AutomationProperties.AutomationId="NoiseStop">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TeacherButton}">
                <Setter Property="Foreground" Value="{DynamicResource TeacherErrorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TeacherErrorBrush}" />
              </Style>
            </Button.Style>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
