<Window x:Class="NPEduTools.App.NoiseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="噪音监测 · NPEduTools" Width="820" Height="760" MinWidth="650" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="#F6F8F7" Foreground="#202E35" FontFamily="Microsoft YaHei UI" Icon="/Assets/npedutools.ico" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/RecordingControls.xaml" /></ResourceDictionary.MergedDictionaries>
      <Style x:Key="NoiseCard" TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="24" /><Setter Property="Margin" Value="0,0,0,16" /></Style>
    </ResourceDictionary>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28">
      <TextBlock Text="噪音监测" FontSize="30" FontWeight="Bold" />
      <TextBlock Text="本机分析，不保存录音。连接学校后上传统计报告，可从班级大屏网页开始或停止。" Foreground="#64776D" TextWrapping="Wrap" Margin="0,8,0,22" />
      <Border Style="{StaticResource NoiseCard}"><StackPanel>
        <TextBlock Text="监测麦克风" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ComboBox x:Name="Microphone" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource RecordingChoice}" AutomationProperties.Name="监测麦克风" />
          <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新设备" Click="RefreshClicked" Margin="12,0,0,0" />
        </Grid>
        <WrapPanel Margin="0,16,0,0">
          <Button x:Name="SaveDeviceButton" Content="保存麦克风" Click="SaveDeviceClicked" Margin="0,0,12,0" />
          <Button x:Name="StartButton" Content="开始监测" Click="StartClicked" Background="#147D68" Foreground="White" IsEnabled="False" Margin="0,0,12,0" AutomationProperties.AutomationId="NoiseStart" />
          <Button x:Name="StopButton" Content="停止监测" Click="StopClicked" IsEnabled="False" AutomationProperties.AutomationId="NoiseStop" />
        </WrapPanel>
        <TextBlock x:Name="StateText" Text="正在连接后台…" TextWrapping="Wrap" Margin="0,16,0,0" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#64776D" Margin="0,6,0,0" />
      </StackPanel></Border>
      <Border Style="{StaticResource NoiseCard}"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="实时信号电平" Foreground="#64776D" /><StackPanel Orientation="Horizontal"><TextBlock x:Name="LevelText" Text="—" FontSize="44" FontWeight="SemiBold" /><TextBlock Text="dBFS" VerticalAlignment="Bottom" Margin="10,0,0,10" Foreground="#64776D" /></StackPanel></StackPanel>
          <TextBlock x:Name="QualityText" Grid.Column="1" Text="等待采样" VerticalAlignment="Center" FontSize="16" />
        </Grid>
        <TextBlock x:Name="LevelHintText" TextWrapping="Wrap" Foreground="#8A5A15" FontSize="12" Margin="0,8,0,0" />
        <ProgressBar x:Name="LevelBar" Minimum="-100" Maximum="0" Value="-100" Height="8" Foreground="#147D68" Background="#EDF2EF" Margin="0,12,0,8">
          <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="4">
              <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4" /></Grid>
            </Border>
          </ControlTemplate></ProgressBar.Template>
        </ProgressBar>
        <TextBlock Text="越接近 0，输入越强；这不是教室实际声压级，也不用于班级排名。" TextWrapping="Wrap" FontSize="12" Foreground="#64776D" />
        <Border Background="#F4F8F5" CornerRadius="8" Margin="0,18,0,8" Padding="8"><Canvas x:Name="TrendCanvas" Height="95" ClipToBounds="True" SizeChanged="TrendSizeChanged" AutomationProperties.Name="最近一分钟信号趋势" /></Border>
        <TextBlock Text="最近一分钟 · 固定刻度 −100 至 0 dBFS；缺样和无效区间留空" Foreground="#64776D" FontSize="12" TextWrapping="Wrap" />
      </StackPanel></Border>
      <Border Style="{StaticResource NoiseCard}"><StackPanel>
        <TextBlock Text="本次统计" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="SummaryText" Text="开始后显示有效采样、覆盖率与能量平均电平。" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="27" />
      </StackPanel></Border>
      <Border Style="{StaticResource NoiseCard}"><StackPanel>
        <TextBlock Text="定时监测保护" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="学校定时监测需验证管理权限才能停止或退出后台。提前设置本机管理口令，可在断网时维护；网页使用学校 PIN。手动监测不受此限制。" TextWrapping="Wrap" Margin="0,12,0,12" Foreground="#64776D" />
        <Button Content="设置／修改本机管理口令" Click="ManagementClicked" HorizontalAlignment="Left" />
        <TextBlock x:Name="DisplayStatusText" Text="定时监测展示：等待后台状态。" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#64776D" />
        <TextBlock x:Name="GuardStatusText" Text="定时监测守护：等待状态。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#64776D" />
      </StackPanel></Border>
      <TextBlock Text="关闭此窗口后继续监测，手动监测最长三小时。本机实时摘要保留至下次开始；连接学校后，结束报告会暂存并上传，断网恢复后补传。" TextWrapping="Wrap" Foreground="#64776D" FontSize="12" />
    </StackPanel>
  </ScrollViewer>
</Window>
