<Window x:Class="NPEduTools.App.NoiseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动自习 · NPEduTools" Width="820" Height="760" MinWidth="650" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="#F6F8F7" Foreground="#202E35" FontFamily="Microsoft YaHei UI" Icon="/Assets/npedutools.ico" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/RecordingControls.xaml" /></ResourceDictionary.MergedDictionaries>
      <Style x:Key="NoiseCard" TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="24" /><Setter Property="Margin" Value="0,0,0,16" /></Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="ManualPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="4,0,4,12">
    <Border Style="{StaticResource NoiseCard}" Padding="20"><StackPanel>
      <TextBlock x:Name="ManualHeading" Text="开始一节手动自习" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="可选开始与结束时间，实际采集最多三小时。学校定时自习优先。" Foreground="#64776D" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <StackPanel x:Name="ManualConfiguration">
        <TextBlock Text="什么时候开始" FontWeight="SemiBold"/>
        <CheckBox x:Name="UseStart" Content="指定日期与时间（默认立即开始）" Checked="ManualOptionsChanged" Unchecked="ManualOptionsChanged" Margin="0,10,0,0"/>
        <Grid x:Name="StartFields" Visibility="Collapsed" Margin="0,10,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><DatePicker x:Name="ManualStartDate"/><TextBox x:Name="ManualStartTime" Grid.Column="1" Text="19:00" Margin="10,0,0,0" AutomationProperties.Name="手动开始时间 HH:mm"/></Grid>
        <TextBlock Text="什么时候结束" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <CheckBox x:Name="UseEnd" Content="指定日期与时间（默认主动结束，最多三小时）" Checked="ManualOptionsChanged" Unchecked="ManualOptionsChanged" Margin="0,10,0,0"/>
        <Grid x:Name="EndFields" Visibility="Collapsed" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><DatePicker x:Name="ManualEndDate"/><TextBox x:Name="ManualEndTime" Grid.Column="1" Text="21:30" Margin="10,0,0,0" AutomationProperties.Name="手动结束时间 HH:mm"/></Grid>
        <Expander Header="临时使用电脑后返回" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0"><WrapPanel><TextBlock Text="无操作返回（分钟）" VerticalAlignment="Center"/><TextBox x:Name="ManualHideMinutes" Text="10" Width="62" Margin="10,0"/><CheckBox x:Name="NoManualReturn" Content="不自动返回" Checked="ManualOptionsChanged" Unchecked="ManualOptionsChanged" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="后台监测继续；操作其他软件也会重新计时。" FontSize="12" Foreground="#64776D" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Expander>
      </StackPanel>
      <TextBlock x:Name="ManualStatus" Text="正在确认手动会话状态…" TextWrapping="Wrap" Margin="0,14,0,0"/>
      <TextBlock x:Name="StateText" Text="正在连接后台…" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock x:Name="StateHintText" Foreground="#64776D" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/>
      <TextBlock x:Name="MessageText" Foreground="#A55337" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel></Border>
    <Expander Header="麦克风与输入设备" HorizontalContentAlignment="Stretch" Margin="0,0,0,14"><StackPanel Margin="0,10,0,0"><TextBlock Text="手动与学校定时自习共用输入设备和校准；学校设备锁定规则继续生效。" Foreground="#64776D" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Microphone" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource RecordingChoice}" AutomationProperties.Name="监测麦克风"/><Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Click="RefreshClicked" Margin="10,0,0,0"/></Grid><Button x:Name="SaveDeviceButton" Content="保存麦克风" Click="SaveDeviceClicked" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
      <Border Style="{StaticResource NoiseCard}"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="实时信号电平" Foreground="#64776D" /><StackPanel Orientation="Horizontal"><TextBlock x:Name="LevelText" Text="—" FontSize="44" FontWeight="SemiBold" /><TextBlock Text="dBFS" VerticalAlignment="Bottom" Margin="10,0,0,10" Foreground="#64776D" /></StackPanel></StackPanel>
          <TextBlock x:Name="QualityText" Grid.Column="1" Text="等待采样" VerticalAlignment="Center" FontSize="16" />
        </Grid>
        <TextBlock x:Name="LevelHintText" TextWrapping="Wrap" Foreground="#8A5A15" FontSize="12" Margin="0,8,0,0" />
        <TextBlock x:Name="CalibrationStatus" Text="校准状态待确认" TextWrapping="Wrap" FontSize="13" Foreground="#61786B" Margin="0,8,0,0" AutomationProperties.AutomationId="ManualCalibrationStatus"/>
        <TextBlock x:Name="EstimateText" TextWrapping="Wrap" FontSize="16" Margin="0,8,0,0" />
        <ProgressBar x:Name="LevelBar" Minimum="-100" Maximum="0" Value="-100" Height="8" Foreground="#147D68" Background="#EDF2EF" Margin="0,12,0,8">
          <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="4">
              <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4" /></Grid>
            </Border>
          </ControlTemplate></ProgressBar.Template>
        </ProgressBar>
        <TextBlock Text="越接近 0，输入越强；这不是教室实际声压级，也不用于班级排名。" TextWrapping="Wrap" FontSize="12" Foreground="#64776D" />
        <Border Background="#F4F8F5" CornerRadius="8" Margin="0,18,0,8" Padding="8"><Canvas x:Name="TrendCanvas" Height="95" ClipToBounds="True" SizeChanged="TrendSizeChanged" AutomationProperties.Name="最近一分钟信号趋势" /></Border>
        <TextBlock Text="最近一分钟 · 固定刻度 −100 至 0 dBFS；缺样和无效区间留空" Foreground="#64776D" FontSize="12" TextWrapping="Wrap" />
      </StackPanel></Border>
      <Border Style="{StaticResource NoiseCard}"><StackPanel>
        <TextBlock x:Name="SummaryTitle" Text="监测统计" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="SummaryText" Text="开始后显示有效采样、覆盖率与能量平均电平。" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="27" />
        <TextBlock x:Name="SummaryHint" Text="这里只展示本机统计，不代表报告已上传。学校端是否收到，请到 NPClassworks 核对。" TextWrapping="Wrap" Foreground="#64776D" FontSize="12" Margin="0,12,0,0" />
      </StackPanel></Border>
    <Expander Header="管理与运行诊断" HorizontalContentAlignment="Stretch">      <Border Style="{StaticResource NoiseCard}"><StackPanel>
        <TextBlock Text="定时监测保护" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="学校定时监测需验证管理权限才能停止或退出后台。连接 NPEP 后使用学校管理口令，本机口令不再用于学校监测；离线行为以后台权限状态为准。手动自习不受此限制。" TextWrapping="Wrap" Margin="0,12,0,12" Foreground="#64776D" />
        <Button Content="设置／修改本机管理口令" Click="ManagementClicked" HorizontalAlignment="Left" />
        <TextBlock x:Name="DisplayStatusText" Text="定时监测展示：等待后台状态。" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#64776D" />
        <TextBlock x:Name="GuardStatusText" Text="定时监测守护：等待状态。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#64776D" />
      </StackPanel></Border>
</Expander>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="1" BorderBrush="#DFE7E1" BorderThickness="0,1,0,0" Padding="0,12,0,0"><WrapPanel HorizontalAlignment="Right">
    <Button x:Name="StartButton" Content="开始自习" Click="StartClicked" Style="{StaticResource Primary}" IsEnabled="False" AutomationProperties.AutomationId="NoiseStart"/>
    <Button x:Name="StopButton" Content="结束自习" Click="StopClicked" Style="{StaticResource Primary}" Visibility="Collapsed" IsEnabled="False" AutomationProperties.AutomationId="NoiseStop"/>
  </WrapPanel></Border>
  </Grid>
</Window>
