<UserControl x:Class="NPEduTools.App.StudySurface"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="MiSans, Microsoft YaHei UI" FontWeight="330" Foreground="White" Background="#02080D">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Muted" Color="#BBC0C4"/>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="#040E15"/><Setter Property="BorderBrush" Value="#18242D"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/>
  </Style>
  <Style x:Key="Tool" TargetType="Button">
   <Setter Property="Foreground" Value="#D6D9DB"/><Setter Property="FontFamily" Value="MiSans, Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="21"/><Setter Property="Background" Value="#040E15"/>
   <Setter Property="BorderBrush" Value="#334047"/><Setter Property="BorderThickness" Value="2"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="#697784"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="White"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="outline" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Ellipse Width="1660" Height="500" VerticalAlignment="Top" Margin="0,-200,0,0" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#353758FF" Offset="0"/><GradientStop Color="#003758FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Viewbox x:Name="Viewport" Stretch="Uniform">
   <Canvas x:Name="LayoutCanvas" Width="1920" Height="1080">
    <TextBlock Canvas.Left="40" Canvas.Top="38" Text="NPEduTools" FontSize="27" FontWeight="SemiBold"/>
    <TextBlock x:Name="ClassTitle" Canvas.Left="40" Canvas.Top="89" Text="学校自习" FontSize="42" FontWeight="Bold"/>
    <TextBlock x:Name="DateSource" Canvas.Left="40" Canvas.Top="152" FontSize="20" Foreground="{StaticResource Muted}"/>
    <Border Canvas.Left="1430" Canvas.Top="84" Width="450" Height="96" Style="{StaticResource Panel}">
     <TextBlock x:Name="PhaseText" Text="等待有效学校时间" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Border Canvas.Left="40" Canvas.Top="222" Width="1110" Height="268" Style="{StaticResource Panel}">
     <Grid><TextBlock x:Name="Clock" Text="--:--:--" FontFamily="/NPEduTools.App;component/Assets/Study/Fonts/#TCloudNumber" FontSize="245" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    </Border>
    <Grid x:Name="SessionCard" Canvas.Left="1190" Canvas.Top="222" Width="690" Height="268">
     <Border Style="{StaticResource Panel}"/>
     <!-- One closed outline starts at twelve o'clock. Dash lengths use the actual rounded perimeter. -->
     <Path x:Name="ProgressTrack" Data="M345,2 L670,2 A18,18 0 0 1 688,20 L688,248 A18,18 0 0 1 670,266 L20,266 A18,18 0 0 1 2,248 L2,20 A18,18 0 0 1 20,2 L345,2 Z"
      Stroke="#263640" StrokeThickness="3" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Path x:Name="ProgressFill" Data="{Binding Data, ElementName=ProgressTrack}" Stroke="#789EAE" StrokeThickness="3"
      StrokeDashCap="Round" Visibility="Collapsed" IsHitTestVisible="False"/>
     <StackPanel Margin="34,26,30,20">
      <Grid Margin="0,0,0,22">
       <TextBlock Text="本次自习" FontSize="26" Foreground="{StaticResource Muted}"/>
       <StackPanel x:Name="ProgressInfo" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="ProgressCaption" Text="已完成" FontSize="18" Foreground="#91A0A9" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock x:Name="ProgressPercent" FontSize="22" Foreground="#B4C5CE" FontWeight="Medium" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
       </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal"><TextBlock Text="自习时段" FontSize="29" Foreground="{StaticResource Muted}" Width="155"/><TextBlock x:Name="WindowText" FontSize="33"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,23,0,0"><TextBlock x:Name="RemainingLabel" Text="剩余时间" FontSize="29" Foreground="{StaticResource Muted}" Width="155"/><TextBlock x:Name="Remaining" Text="—" FontSize="37" FontFamily="/NPEduTools.App;component/Assets/Study/Fonts/#TCloudNumber"/></StackPanel>
      <TextBlock x:Name="SessionNote" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,17,0,0"/>
     </StackPanel>
    </Grid>
    <Border Canvas.Left="40" Canvas.Top="530" Width="1840" Height="402" Style="{StaticResource Panel}">
     <Grid Margin="32,23,32,26">
      <Grid.RowDefinitions><RowDefinition Height="51"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="今日作业" FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="WorkUpdateLabel" FontSize="18" Foreground="{StaticResource Muted}" Margin="22,9,0,0"/></StackPanel>
       <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="RotationLabel" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,7,22,0"/><Button x:Name="Previous" Content="‹" Width="36" Height="35" FontSize="24" Style="{StaticResource Tool}" /><TextBlock x:Name="PageLabel" FontSize="21" Foreground="{StaticResource Muted}" Margin="15,5"/><Button x:Name="Next" Content="›" Width="36" Height="35" FontSize="24" Style="{StaticResource Tool}" /></StackPanel>
      </Grid>
      <Grid x:Name="HomeworkGrid" Grid.Row="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
     </Grid>
    </Border>
    <Button x:Name="EndButton" Canvas.Left="40" Canvas.Top="970" Width="204" Height="77" Style="{StaticResource Tool}" Visibility="Collapsed"
     PreviewMouseLeftButtonDown="EndMouseDown" PreviewMouseLeftButtonUp="EndMouseUp" LostMouseCapture="HoldLost" LostKeyboardFocus="HoldLost"
     PreviewTouchDown="EndTouchDown" PreviewTouchUp="EndTouchUp" LostTouchCapture="HoldLost" PreviewKeyDown="EndKeyDown" PreviewKeyUp="HoldKeyUp">
     <StackPanel><TextBlock Text="结束自习" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="长按 2 秒 · 提前结束" FontSize="15" HorizontalAlignment="Center"/></StackPanel>
    </Button>
    <Button x:Name="HoldButton" Canvas.Left="40" Canvas.Top="970" Width="204" Height="77" Style="{StaticResource Tool}" IsEnabled="False"
     PreviewMouseLeftButtonDown="HoldMouseDown" PreviewMouseLeftButtonUp="HoldMouseUp" LostMouseCapture="HoldLost" LostKeyboardFocus="HoldLost"
     PreviewTouchDown="HoldTouchDown" PreviewTouchUp="HoldTouchUp" LostTouchCapture="HoldLost" PreviewKeyDown="HoldKeyDown" PreviewKeyUp="HoldKeyUp">
     <StackPanel><TextBlock x:Name="HoldText" Text="临时使用电脑" FontSize="23" HorizontalAlignment="Center"/><TextBlock x:Name="HoldHint" Text="长按 2 秒 · 闲置 10 分钟" FontSize="15" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/></StackPanel>
    </Button>
    <Button x:Name="ManageButton" Canvas.Left="266" Canvas.Top="970" Width="144" Height="77" Style="{StaticResource Tool}" Click="ManageClicked" Content="监测管理"/>
    <Button x:Name="SeatingButton" Canvas.Left="432" Canvas.Top="970" Width="210" Height="77" Style="{StaticResource Tool}" Content="查看自习座位表" IsEnabled="False" Click="OpenSeatingClicked"/>
    <TextBlock x:Name="SeatingStatus" Canvas.Left="665" Canvas.Top="991" Width="255" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
    <Border x:Name="CameraIndicator" Canvas.Left="944" Canvas.Top="994" Width="32" Height="25" BorderBrush="#64717D" BorderThickness="2" CornerRadius="4" ToolTip="摄像头状态待确认">
     <Ellipse Width="11" Height="11" Stroke="#64717D" StrokeThickness="2"/>
    </Border>
    <Grid Canvas.Left="1000" Canvas.Top="975" Width="880" Height="67">
     <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NoiseStatus" Text="监测状态待确认" FontSize="24"/><TextBlock x:Name="NoiseDetail" Text="dBFS · 数字信号电平" FontSize="16" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
     <Canvas x:Name="TrendCanvas" Grid.Column="1" Height="48" Width="360" VerticalAlignment="Center"><Polyline x:Name="Trend" Stroke="#83AAB5" StrokeThickness="2"/></Canvas>
     <TextBlock x:Name="Dbfs" Grid.Column="2" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
    <Border x:Name="SeatingOverlay" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Background="#050C11" Visibility="Collapsed">
     <Grid Margin="40">
      <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition/></Grid.RowDefinitions>
      <Grid><TextBlock Text="自习座位表" FontSize="36" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding Text, ElementName=Clock}" FontSize="44" FontFamily="{Binding FontFamily, ElementName=Clock}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="SeatingUpdate" FontSize="20" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,30,0"/>
        <Button x:Name="UploadSeating" Content="上传／更换" Width="150" Height="64" Style="{StaticResource Tool}" Click="UploadSeatingClicked" Margin="0,0,20,0"/>
        <Button x:Name="SeatingZoom" Content="放大" Width="110" Height="64" Style="{StaticResource Tool}" Click="ZoomSeatingClicked" Margin="0,0,20,0"/>
        <Button x:Name="CloseSeating" Content="关闭自习座位表" Width="190" Height="64" Style="{StaticResource Tool}" Click="CloseSeatingClicked"/>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
       <ScrollViewer x:Name="SeatingScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="SeatingImage" Stretch="Uniform" Width="1840" Height="900"/></ScrollViewer>
       <TextBlock x:Name="SeatingEmpty" Text="暂无可查看的自习座位表 · 可上传到本机绑定班级" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
      </Grid>
     </Grid>
    </Border>
    <Grid x:Name="NoiseEdge" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Visibility="Collapsed" IsHitTestVisible="False">
     <Rectangle Height="170" VerticalAlignment="Top"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#DCE52B3A" Offset="0"/><GradientStop Color="#40D52334" Offset="0.4"/><GradientStop Color="#00D52334" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill></Rectangle>
     <Rectangle Height="170" VerticalAlignment="Bottom"><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
      <GradientStop Color="#DCE52B3A" Offset="0"/><GradientStop Color="#40D52334" Offset="0.4"/><GradientStop Color="#00D52334" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill></Rectangle>
     <Rectangle Width="180" HorizontalAlignment="Left"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#DCE52B3A" Offset="0"/><GradientStop Color="#40D52334" Offset="0.4"/><GradientStop Color="#00D52334" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill></Rectangle>
     <Rectangle Width="180" HorizontalAlignment="Right"><Rectangle.Fill><LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
      <GradientStop Color="#DCE52B3A" Offset="0"/><GradientStop Color="#40D52334" Offset="0.4"/><GradientStop Color="#00D52334" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill></Rectangle>
    </Grid>
    <Border x:Name="StageNotice" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Visibility="Collapsed" Background="#E02ECC71" IsHitTestVisible="False">
     <!-- Effects cover glyph bounds only; no fullscreen blur or permanently animated surface. -->
     <StackPanel x:Name="NoticeCopy" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <StackPanel.RenderTransform><ScaleTransform x:Name="NoticeScale"/></StackPanel.RenderTransform>
      <Grid>
       <TextBlock Text="{Binding Text, ElementName=NoticeTitle}" FontSize="142" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
        <TextBlock.Effect><DropShadowEffect Color="White" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.55" RenderingBias="Performance"/></TextBlock.Effect>
       </TextBlock>
       <TextBlock x:Name="NoticeTitle" FontSize="142" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
        <TextBlock.Effect><DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.45" RenderingBias="Performance"/></TextBlock.Effect>
       </TextBlock>
      </Grid>
      <Grid Margin="0,45,0,0">
       <TextBlock Text="{Binding Text, ElementName=NoticeTime}" FontFamily="{Binding FontFamily, ElementName=NoticeTime}" FontSize="76" Foreground="White" HorizontalAlignment="Center">
        <TextBlock.Effect><DropShadowEffect Color="White" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.55" RenderingBias="Performance"/></TextBlock.Effect>
       </TextBlock>
       <TextBlock x:Name="NoticeTime" FontFamily="/NPEduTools.App;component/Assets/Study/Fonts/#TCloudNumber" FontSize="76" Foreground="White" HorizontalAlignment="Center">
        <TextBlock.Effect><DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.45" RenderingBias="Performance"/></TextBlock.Effect>
       </TextBlock>
      </Grid>
     </StackPanel>
    </Border>
   </Canvas>
  </Viewbox>
 </Grid>
</UserControl>
