<UserControl x:Class="NPEduTools.App.StudySurface"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:NPEduTools.App"
 PreviewKeyDown="StudyReaderKeyDown"
 FontFamily="MiSans, Microsoft YaHei UI" FontWeight="330" Foreground="White" Background="#02080D">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Muted" Color="#BBC0C4"/>
  <SolidColorBrush x:Key="StudyToolHoverBorder" Color="#697784"/>
  <SolidColorBrush x:Key="StudyToolPressed" Color="#20343E"/>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="#040E15"/><Setter Property="BorderBrush" Value="#18242D"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/>
  </Style>
  <Style x:Key="Tool" TargetType="Button">
   <Setter Property="Foreground" Value="#D6D9DB"/><Setter Property="FontFamily" Value="MiSans, Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="21"/><Setter Property="Background" Value="#040E15"/>
   <Setter Property="BorderBrush" Value="#334047"/><Setter Property="BorderThickness" Value="2"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource StudyToolHoverBorder}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="outline" Property="Background" Value="{DynamicResource StudyToolPressed}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="White"/><Setter TargetName="outline" Property="BorderThickness" Value="3"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="outline" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="StudyAction" TargetType="Button" BasedOn="{StaticResource Tool}">
   <Setter Property="MinHeight" Value="{Binding ActionTarget, RelativeSource={RelativeSource AncestorType=local:StudySurface}}"/>
   <Setter Property="MinWidth" Value="{Binding ActionTarget, RelativeSource={RelativeSource AncestorType=local:StudySurface}}"/>
  </Style>
  <Style x:Key="ReaderAction" TargetType="Button" BasedOn="{StaticResource StudyAction}">
   <Setter Property="Foreground" Value="#B8C6BC"/>
   <Setter Property="Background" Value="#17211B"/>
   <Setter Property="BorderBrush" Value="#425448"/>
  </Style>
  <Style x:Key="ReaderMode" TargetType="RadioButton">
   <Setter Property="MinHeight" Value="{Binding ActionTarget, RelativeSource={RelativeSource AncestorType=local:StudySurface}}"/>
   <Setter Property="Width" Value="172"/>
   <Setter Property="Foreground" Value="#B8C6BC"/>
   <Setter Property="FontSize" Value="24"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="ModeBorder" Background="#17211B" BorderBrush="Transparent" BorderThickness="2" CornerRadius="11">
       <Grid>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border x:Name="SelectedLine" Background="#9EDFBD" Width="34" Height="4" CornerRadius="2"
         VerticalAlignment="Bottom" Margin="0,0,0,10" Visibility="Collapsed"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeBorder" Property="Background" Value="#22332A"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="ModeBorder" Property="Background" Value="#2B4135"/>
        <Setter TargetName="SelectedLine" Property="Visibility" Value="Visible"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F2F5F2"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="ModeBorder" Property="Background" Value="#354F40"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeBorder" Property="BorderBrush" Value="White"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeBorder" Property="Opacity" Value="0.55"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Ellipse Width="1660" Height="500" VerticalAlignment="Top" Margin="0,-200,0,0" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#353758FF" Offset="0"/><GradientStop Color="#003758FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Viewbox x:Name="Viewport" Stretch="Uniform" SizeChanged="StudyViewportSizeChanged">
   <Canvas x:Name="LayoutCanvas" Width="1920" Height="1080">
    <Canvas x:Name="StudyOverview" Width="1920" Height="1080">
    <TextBlock Canvas.Left="40" Canvas.Top="38" Text="NPEduTools" FontSize="27" FontWeight="SemiBold"/>
    <TextBlock x:Name="ClassTitle" Canvas.Left="40" Canvas.Top="89" Text="学校自习" FontSize="42" FontWeight="Bold"/>
    <TextBlock x:Name="DateSource" Canvas.Left="40" Canvas.Top="152" FontSize="20" Foreground="{StaticResource Muted}"/>
    <Grid x:Name="SchoolSync" Canvas.Left="1430" Canvas.Top="39" Width="450" Height="30">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Ellipse x:Name="SyncDot" Width="7" Height="7" Fill="#697883" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBlock x:Name="SyncText" Text="学校互联待确认" FontSize="19" Foreground="#93A0A9" VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
    <Border Canvas.Left="1430" Canvas.Top="84" Width="450" Height="96" Style="{StaticResource Panel}">
     <TextBlock x:Name="PhaseText" Text="等待有效学校时间" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Border Canvas.Left="40" Canvas.Top="222" Width="1110" Height="268" Style="{StaticResource Panel}">
     <Grid><TextBlock x:Name="Clock" Text="--:--:--" FontFamily="/NPEduTools.App;component/Assets/Study/Fonts/#TCloudNumber" FontSize="245" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    </Border>
    <Grid x:Name="SessionCard" Canvas.Left="1190" Canvas.Top="222" Width="690" Height="268">
     <Border Style="{StaticResource Panel}"/>
     <!-- One closed outline starts at twelve o'clock. Dash lengths use the actual rounded perimeter. -->
     <Path x:Name="ProgressTrack" Data="M345,2 L670,2 A18,18 0 0 1 688,20 L688,248 A18,18 0 0 1 670,266 L20,266 A18,18 0 0 1 2,248 L2,20 A18,18 0 0 1 20,2 L345,2 Z"
      Stroke="#263640" StrokeThickness="3" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Path x:Name="ProgressFill" Data="{Binding Data, ElementName=ProgressTrack}" Stroke="#789EAE" StrokeThickness="3"
      StrokeDashCap="Round" Visibility="Collapsed" IsHitTestVisible="False"/>
     <StackPanel Margin="34,26,30,20">
      <Grid Margin="0,0,0,22">
       <TextBlock Text="本次自习" FontSize="26" Foreground="{StaticResource Muted}"/>
       <StackPanel x:Name="ProgressInfo" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="ProgressCaption" Text="已完成" FontSize="18" Foreground="#91A0A9" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock x:Name="ProgressPercent" FontSize="22" Foreground="#B4C5CE" FontWeight="Medium" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
       </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal"><TextBlock Text="自习时段" FontSize="29" Foreground="{StaticResource Muted}" Width="155"/><TextBlock x:Name="WindowText" FontSize="33"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,23,0,0"><TextBlock x:Name="RemainingLabel" Text="剩余时间" FontSize="29" Foreground="{StaticResource Muted}" Width="155"/><TextBlock x:Name="Remaining" Text="—" FontSize="37" FontFamily="/NPEduTools.App;component/Assets/Study/Fonts/#TCloudNumber"/></StackPanel>
      <TextBlock x:Name="SessionNote" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,17,0,0"/>
     </StackPanel>
    </Grid>
     <Border Canvas.Left="40" Canvas.Top="508" Width="1840" Height="424" Style="{StaticResource Panel}">
     <Grid Margin="32,23,32,26">
       <Grid.RowDefinitions><RowDefinition Height="73"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="今日作业" FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="WorkUpdateLabel" FontSize="18" Foreground="{StaticResource Muted}" Margin="22,0,0,0" VerticalAlignment="Center"/></StackPanel>
        <Canvas>
         <StackPanel Canvas.Right="0" Canvas.Bottom="0" Orientation="Horizontal">
          <TextBlock x:Name="RotationLabel" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,0,22,0" VerticalAlignment="Center"/>
          <Button x:Name="Previous" Content="‹" Width="72" FontSize="38" Style="{StaticResource StudyAction}" Visibility="Collapsed" AutomationProperties.Name="上一页作业"/>
          <TextBlock x:Name="PageLabel" FontSize="21" Foreground="{StaticResource Muted}" Margin="15,0" VerticalAlignment="Center"/>
          <Button x:Name="Next" Content="›" Width="72" FontSize="38" Style="{StaticResource StudyAction}" Visibility="Collapsed" AutomationProperties.Name="下一页作业"/>
          <Button x:Name="OpenHomeworkReader" Width="202" Style="{StaticResource StudyAction}" Margin="16,0,0,0"
           IsEnabled="False" Click="OpenHomeworkReaderClicked" AutomationProperties.Name="放大作业">
           <StackPanel Orientation="Horizontal">
            <Path Width="22" Height="22" Stretch="Uniform" Stroke="#D6D9DB" StrokeThickness="2" Data="M7,1 H1 V7 M15,1 H21 V7 M21,15 V21 H15 M7,21 H1 V15" Margin="0,0,12,0"/>
            <TextBlock Text="放大作业" FontSize="24"/>
           </StackPanel>
          </Button>
         </StackPanel>
        </Canvas>
      </Grid>
      <Grid x:Name="HomeworkGrid" Grid.Row="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
     </Grid>
    </Border>
     <Button x:Name="EndButton" Canvas.Left="40" Canvas.Bottom="33" Width="204" Height="77" Style="{StaticResource StudyAction}" BorderBrush="#77565A" Visibility="Collapsed"
      AutomationProperties.Name="结束自习" AutomationProperties.HelpText="长按 2 秒"
     PreviewMouseLeftButtonDown="EndMouseDown" PreviewMouseLeftButtonUp="EndMouseUp" LostMouseCapture="HoldLost" LostKeyboardFocus="HoldLost"
     PreviewTouchDown="EndTouchDown" PreviewTouchUp="EndTouchUp" LostTouchCapture="HoldLost" PreviewKeyDown="EndKeyDown" PreviewKeyUp="HoldKeyUp">
      <StackPanel><TextBlock x:Name="EndText" Text="结束自习" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="长按 2 秒 · 提前结束" FontSize="15" HorizontalAlignment="Center"/></StackPanel>
    </Button>
     <Button x:Name="HoldButton" Canvas.Left="40" Canvas.Bottom="33" Width="204" Height="77" Style="{StaticResource StudyAction}" IsEnabled="False"
      AutomationProperties.Name="临时使用电脑" AutomationProperties.HelpText="长按 2 秒"
     PreviewMouseLeftButtonDown="HoldMouseDown" PreviewMouseLeftButtonUp="HoldMouseUp" LostMouseCapture="HoldLost" LostKeyboardFocus="HoldLost"
     PreviewTouchDown="HoldTouchDown" PreviewTouchUp="HoldTouchUp" LostTouchCapture="HoldLost" PreviewKeyDown="HoldKeyDown" PreviewKeyUp="HoldKeyUp">
     <StackPanel><TextBlock x:Name="HoldText" Text="临时使用电脑" FontSize="23" HorizontalAlignment="Center"/><TextBlock x:Name="HoldHint" Text="长按 2 秒 · 闲置 10 分钟" FontSize="15" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/></StackPanel>
    </Button>
     <Button x:Name="ManageButton" Canvas.Left="266" Canvas.Bottom="33" Width="144" Height="77" Style="{StaticResource StudyAction}" Click="ManageClicked" AutomationProperties.Name="监测管理">
      <StackPanel Orientation="Horizontal"><Path Width="21" Height="19" Stretch="Uniform" Stroke="#D6D9DB" StrokeThickness="2"
       Data="M1,12 H5 L8,5 L12,17 L16,8 L19,12 H23" Margin="0,0,8,0"/><TextBlock Text="监测管理"/></StackPanel>
     </Button>
     <Button x:Name="SeatingButton" Canvas.Left="432" Canvas.Bottom="33" Width="210" Height="77" Style="{StaticResource StudyAction}" IsEnabled="False" Click="OpenSeatingClicked" AutomationProperties.Name="查看自习座位表">
      <StackPanel Orientation="Horizontal"><Path Width="20" Height="20" Stretch="Uniform" Stroke="#D6D9DB" StrokeThickness="2"
       Data="M1,1 H21 V21 H1 Z M1,8 H21 M1,15 H21 M8,1 V21 M15,1 V21" Margin="0,0,9,0"/><TextBlock Text="查看自习座位表"/></StackPanel>
     </Button>
     <Rectangle x:Name="EndHoldProgress" Canvas.Left="54" Canvas.Bottom="40" Height="4" RadiusX="2" RadiusY="2"
      Fill="#CE8388" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Rectangle x:Name="TemporaryHoldProgress" Canvas.Left="54" Canvas.Bottom="40" Height="4" RadiusX="2" RadiusY="2"
      Fill="#94C2A3" Visibility="Collapsed" IsHitTestVisible="False"/>
    <TextBlock x:Name="SeatingStatus" Canvas.Left="665" Canvas.Top="991" Width="255" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
    <Border x:Name="CameraIndicator" Canvas.Left="944" Canvas.Top="994" Width="32" Height="25" BorderBrush="#64717D" BorderThickness="2" CornerRadius="4" ToolTip="摄像头状态待确认">
     <Ellipse Width="11" Height="11" Stroke="#64717D" StrokeThickness="2"/>
    </Border>
    <Border x:Name="CalibrationBadge" Canvas.Left="1000" Canvas.Top="941" Background="#0E1921" CornerRadius="5" Padding="8,3">
     <TextBlock x:Name="CalibrationText" Text="校准状态待确认" FontSize="16" Foreground="{StaticResource Muted}" AutomationProperties.AutomationId="StudyCalibrationStatus"/>
    </Border>
    <Grid Canvas.Left="1000" Canvas.Top="975" Width="880" Height="67">
     <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NoiseStatus" Text="监测状态待确认" FontSize="24"/><TextBlock x:Name="NoiseDetail" Text="dBFS · 数字信号电平" FontSize="16" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
     <Canvas x:Name="TrendCanvas" Grid.Column="1" Height="48" Width="360" VerticalAlignment="Center"><Polyline x:Name="Trend" Stroke="#83AAB5" StrokeThickness="2"/></Canvas>
     <TextBlock x:Name="Dbfs" Grid.Column="2" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
    </Canvas>
    <Border x:Name="HomeworkReader" Width="1920" Height="1080" Background="#101614" Visibility="Collapsed">
     <Border.Resources>
      <SolidColorBrush x:Key="StudyToolHoverBorder" Color="#7B9B88"/>
      <SolidColorBrush x:Key="StudyToolPressed" Color="#2B4135"/>
      <ControlTemplate x:Key="ReaderScrollPage" TargetType="RepeatButton">
       <Border Background="Transparent"/>
      </ControlTemplate>
      <Style TargetType="ScrollBar">
       <Setter Property="Width" Value="20"/>
       <Setter Property="Template">
        <Setter.Value>
         <ControlTemplate TargetType="ScrollBar">
          <Border Background="#17211B" CornerRadius="7" Padding="3">
           <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
             <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Template="{StaticResource ReaderScrollPage}"/>
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
             <Thumb>
              <Thumb.Template>
               <ControlTemplate TargetType="Thumb">
                <Border x:Name="Grip" Background="#425448" CornerRadius="5"/>
                <ControlTemplate.Triggers>
                 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#7B9B88"/></Trigger>
                 <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#9EDFBD"/></Trigger>
                </ControlTemplate.Triggers>
               </ControlTemplate>
              </Thumb.Template>
             </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
             <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Template="{StaticResource ReaderScrollPage}"/>
            </Track.IncreaseRepeatButton>
           </Track>
          </Border>
         </ControlTemplate>
        </Setter.Value>
       </Setter>
      </Style>
     </Border.Resources>
     <Grid>
      <Grid x:Name="ReadingInput" KeyboardNavigation.TabNavigation="Cycle">
       <Grid x:Name="ReadingControls" Margin="72,34,72,24">
        <Grid.RowDefinitions><RowDefinition Height="141"/><RowDefinition/><RowDefinition Height="167"/></Grid.RowDefinitions>
        <Grid>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Image Source="/NPEduTools.App;component/Assets/Study/npclassworks-64.png" Width="58" Height="58"
           AutomationProperties.Name="NPClassworks 标识"/>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
           <TextBlock Text="NPClassworks" FontSize="28" FontWeight="SemiBold" Foreground="#F2B56B"/>
           <TextBlock Text="今日作业" FontSize="23" Foreground="#B8C6BC" Margin="0,2,0,0"/>
          </StackPanel>
         </StackPanel>
         <Border Background="#17211B" BorderBrush="#425448" BorderThickness="1" CornerRadius="14"
          Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel x:Name="ReaderModes" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once">
           <RadioButton x:Name="ReaderOnePage" Content="一页布局" GroupName="HomeworkReadingLayout" Style="{StaticResource ReaderMode}" Click="ReaderModeClicked" IsTabStop="False"/>
           <RadioButton x:Name="ReaderFit" Content="合适布局" GroupName="HomeworkReadingLayout" Style="{StaticResource ReaderMode}" Click="ReaderModeClicked" IsChecked="True"/>
           <RadioButton x:Name="ReaderEachItem" Content="每项布局" GroupName="HomeworkReadingLayout" Style="{StaticResource ReaderMode}" Click="ReaderModeClicked" IsTabStop="False"/>
          </StackPanel>
         </Border>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding Text, ElementName=Clock}" FontFamily="{Binding FontFamily, ElementName=Clock}"
           Foreground="{Binding Foreground, ElementName=Clock}" VerticalAlignment="Center" FontSize="38" Margin="0,0,28,0"/>
          <Button x:Name="ReturnFromReader" Content="返回自习" Width="176" Style="{StaticResource ReaderAction}" Click="ReturnFromReaderClicked"/>
         </StackPanel>
        </Grid>
        <local:HomeworkReaderView x:Name="ReaderBody" Grid.Row="1" Focusable="True" AutomationProperties.Name="作业正文"/>
        <Grid Grid.Row="2">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Button x:Name="PickHomework" Content="选择作业" Width="170" Style="{StaticResource ReaderAction}" Click="PickHomeworkClicked"/>
          <TextBlock x:Name="ReaderStatus" FontSize="21" Foreground="#B8C6BC" Margin="20,0,0,0" VerticalAlignment="Center" MaxWidth="620" TextWrapping="Wrap"
           AutomationProperties.LiveSetting="Polite"/>
          <Button x:Name="ReaderUpdate" Content="查看新版" Width="140" Style="{StaticResource ReaderAction}" Margin="16,0,0,0"
           Click="ReaderUpdateClicked" Visibility="Collapsed"/>
         </StackPanel>
         <StackPanel x:Name="ReaderPageNavigation" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
          Visibility="Collapsed">
          <Button x:Name="ReaderPrevious" Width="148" Style="{StaticResource ReaderAction}" Click="ReaderPreviousClicked"/>
          <TextBlock x:Name="ReaderPageLabel" FontSize="23" Foreground="#B8C6BC" MinWidth="104" TextAlignment="Center"
           VerticalAlignment="Center" Margin="12,0" AutomationProperties.LiveSetting="Polite"/>
          <Button x:Name="ReaderNext" Width="148" Style="{StaticResource ReaderAction}" Click="ReaderNextClicked"/>
         </StackPanel>
        </Grid>
       </Grid>
       <Grid x:Name="HomeworkPicker" Background="#CC0B100D" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Border Width="1040" MaxHeight="760" Padding="28" CornerRadius="20" BorderThickness="2" BorderBrush="#425448"
         Background="#17211B" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="106"/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="选择作业" FontSize="36" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button x:Name="CloseHomeworkPicker" Content="关闭列表" Width="158" Style="{StaticResource ReaderAction}"
           Click="CloseHomeworkPickerClicked" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <ListBox x:Name="HomeworkChoices" Grid.Row="1" Background="#101614" Foreground="#F2F5F2" BorderThickness="0"
           ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="VerticalOnly"
           VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="可选作业"
           PreviewMouseLeftButtonUp="HomeworkChoiceMouseUp">
           <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
             <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
             <Setter Property="MinHeight" Value="{Binding ActionTarget, RelativeSource={RelativeSource AncestorType=local:StudySurface}}"/>
             <Setter Property="Padding" Value="16,6"/>
             <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
             <Setter Property="Template">
              <Setter.Value>
               <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ChoiceSurface" BorderBrush="#425448" BorderThickness="1" Background="#101614"
                 Padding="{TemplateBinding Padding}" CornerRadius="7">
                 <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#22332A"/></Trigger>
                 <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ChoiceSurface" Property="Background" Value="#2B4135"/>
                  <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="#9EDFBD"/>
                 </Trigger>
                 <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="White"/></Trigger>
                </ControlTemplate.Triggers>
               </ControlTemplate>
              </Setter.Value>
             </Setter>
            </Style>
           </ListBox.ItemContainerStyle>
           <ListBox.ItemTemplate>
            <DataTemplate>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition/><ColumnDefinition Width="242"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Subject}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="23" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <TextBlock Grid.Column="2" Text="{Binding Sources}" FontSize="21" Foreground="#B8C6BC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Sources}"/>
             </Grid>
            </DataTemplate>
           </ListBox.ItemTemplate>
          </ListBox>
         </Grid>
        </Border>
       </Grid>
      </Grid>
      <Border x:Name="ReaderInputShield" Background="Transparent" Visibility="Collapsed"/>
     </Grid>
    </Border>
     <Border x:Name="SeatingOverlay" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Background="#050C11" Visibility="Collapsed"
      IsVisibleChanged="ReaderCoverageChanged">
     <Grid Margin="40">
      <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition/></Grid.RowDefinitions>
      <Grid><StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
       <TextBlock Text="自习座位表" FontSize="36" FontWeight="SemiBold"/>
       <StackPanel x:Name="SeatingSync" Orientation="Horizontal" Margin="0,7,0,0" ToolTip="{Binding ToolTip, ElementName=SchoolSync}">
        <Ellipse Width="7" Height="7" Fill="{Binding Fill, ElementName=SyncDot}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Text="{Binding Text, ElementName=SyncText}" FontSize="17" Foreground="{Binding Foreground, ElementName=SyncText}"/>
       </StackPanel>
      </StackPanel>
       <TextBlock Text="{Binding Text, ElementName=Clock}" FontSize="44" FontFamily="{Binding FontFamily, ElementName=Clock}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="SeatingUpdate" FontSize="20" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,30,0"/>
        <Button x:Name="UploadSeating" Content="上传／更换" Width="150" Height="64" Style="{StaticResource Tool}" Click="UploadSeatingClicked" Margin="0,0,20,0"/>
        <Button x:Name="SeatingZoom" Content="放大" Width="110" Height="64" Style="{StaticResource Tool}" Click="ZoomSeatingClicked" Margin="0,0,20,0"/>
        <Button x:Name="CloseSeating" Content="关闭自习座位表" Width="190" Height="64" Style="{StaticResource Tool}" Click="CloseSeatingClicked"/>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
       <ScrollViewer x:Name="SeatingScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="SeatingImage" Stretch="Uniform" Width="1840" Height="900"/></ScrollViewer>
       <TextBlock x:Name="SeatingEmpty" Text="暂无可查看的自习座位表 · 可上传到本机绑定班级" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
      </Grid>
     </Grid>
    </Border>
    <Grid x:Name="NoiseEdge" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Visibility="Collapsed" IsHitTestVisible="False">
     <Rectangle Height="170" VerticalAlignment="Top"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#DCE52B3A" Offset="0"/><GradientStop Color="#40D52334" Offset="0.4"/><GradientStop Color="#00D52334" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill></Rectangle>
     <Rectangle Height="170" VerticalAlignment="Bottom"><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
      <GradientStop Color="#DCE52B3A" Offset="0"/><GradientStop Color="#40D52334" Offset="0.4"/><GradientStop Color="#00D52334" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill></Rectangle>
     <Rectangle Width="180" HorizontalAlignment="Left"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#DCE52B3A" Offset="0"/><GradientStop Color="#40D52334" Offset="0.4"/><GradientStop Color="#00D52334" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill></Rectangle>
     <Rectangle Width="180" HorizontalAlignment="Right"><Rectangle.Fill><LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
      <GradientStop Color="#DCE52B3A" Offset="0"/><GradientStop Color="#40D52334" Offset="0.4"/><GradientStop Color="#00D52334" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill></Rectangle>
    </Grid>
     <Border x:Name="StageNotice" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Visibility="Collapsed" Background="#E02ECC71" IsHitTestVisible="False"
      IsVisibleChanged="ReaderCoverageChanged">
     <!-- Effects cover glyph bounds only; no fullscreen blur or permanently animated surface. -->
     <StackPanel x:Name="NoticeCopy" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <StackPanel.RenderTransform><ScaleTransform x:Name="NoticeScale"/></StackPanel.RenderTransform>
      <Grid>
       <TextBlock Text="{Binding Text, ElementName=NoticeTitle}" FontSize="142" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
        <TextBlock.Effect><DropShadowEffect Color="White" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.55" RenderingBias="Performance"/></TextBlock.Effect>
       </TextBlock>
       <TextBlock x:Name="NoticeTitle" FontSize="142" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
        <TextBlock.Effect><DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.45" RenderingBias="Performance"/></TextBlock.Effect>
       </TextBlock>
      </Grid>
      <Grid Margin="0,45,0,0">
       <TextBlock Text="{Binding Text, ElementName=NoticeTime}" FontFamily="{Binding FontFamily, ElementName=NoticeTime}" FontSize="76" Foreground="White" HorizontalAlignment="Center">
        <TextBlock.Effect><DropShadowEffect Color="White" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.55" RenderingBias="Performance"/></TextBlock.Effect>
       </TextBlock>
       <TextBlock x:Name="NoticeTime" FontFamily="/NPEduTools.App;component/Assets/Study/Fonts/#TCloudNumber" FontSize="76" Foreground="White" HorizontalAlignment="Center">
        <TextBlock.Effect><DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.45" RenderingBias="Performance"/></TextBlock.Effect>
       </TextBlock>
      </Grid>
     </StackPanel>
    </Border>
   </Canvas>
  </Viewbox>
 </Grid>
</UserControl>
