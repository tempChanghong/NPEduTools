<UserControl x:Class="NPEduTools.App.RemoteExamHistoryView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="以下为执行时的历史回执，不代表软件当前仍在运行。最后步骤不等于前面的步骤都已完成。"
      TextWrapping="Wrap" Foreground="#64776D" Margin="0,0,0,10" />
    <TextBlock x:Name="EmptyHistory" Text="暂无记录。" Foreground="#526A60" />
    <ItemsControl x:Name="HistoryItems" AutomationProperties.AutomationId="RemoteExamHistory">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="#F5F8F6" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Step}" Foreground="#526A60" TextWrapping="Wrap" Margin="0,6,0,0" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <TextBlock Text="{Binding NextAction}" Foreground="#526A60" TextWrapping="Wrap" Margin="0,6,0,0" />
              <TextBlock Text="{Binding LocallyEnded}" Foreground="#526A60" TextWrapping="Wrap" Margin="0,6,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                  <DataTrigger Binding="{Binding LocallyEnded}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <Expander Header="技术详情（请求编号与错误码）" Margin="0,8,0,0">
                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                  Background="Transparent" BorderThickness="0" FontSize="12" Padding="0,6"
                  AutomationProperties.AutomationId="RemoteExamHistoryDetails" />
              </Expander>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
