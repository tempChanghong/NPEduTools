              </StackPanel></Expander>
            </Border>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
                <TextBlock Grid.Row="3" x:Name="StartupPreferencesMessage" Foreground="#147D68" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="StartupPreferencesMessage" />
