                      <RadioButton x:Name="DockLeft" Content="屏幕左侧" GroupName="EntrySide" Style="{DynamicResource SettingsSegment}" IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                   Checked="DockLeftClicked" AutomationProperties.AutomationId="DockLeft" />
                      <RadioButton x:Name="DockRight" Content="屏幕右侧" GroupName="EntrySide" Style="{DynamicResource SettingsSegment}" IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                   Checked="DockRightClicked" AutomationProperties.AutomationId="DockRight" />
                    </UniformGrid>
                  </Border>
                </local:SettingsRow>
              </StackPanel></Border>
              <TextBlock Text="更改即时生效，入口位置会在下次启动时保留。" Style="{StaticResource SettingsHint}" Margin="1,6,0,16" />
