                    <TextBlock Text="{Binding Subject}" FontSize="20" Margin="0,5,0,8" AutomationProperties.AutomationId="Subject" />
                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="Detail" />
                    <TextBlock Text="{Binding LessonPlan}" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Updated}" Foreground="{DynamicResource TeacherMutedBrush}" />
                    <TextBlock Text="{Binding Events}" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel></Expander>
              </StackPanel>
            </Border>

