<Window x:Class="NPEduTools.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NPEduTools" Width="760" Height="640" MinWidth="560" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#F3F6F3" Foreground="#203831" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="#DFE7DF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="#203831" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" CornerRadius="8" Padding="22,12" Margin="0,0,8,12" Background="Transparent">
              <ContentPresenter x:Name="TabLabel" ContentSource="Header" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                <Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="#286B51" />
                <Setter TargetName="TabLabel" Property="TextElement.FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="4,0,4,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="NPEduTools" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="课堂常用工具，随用随开。" Foreground="#63776B" FontSize="13" Margin="0,5,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="#E5EEE7" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
        <TextBlock Text="N" Foreground="#286B51" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
    <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
      <TabItem Header="常用" AutomationProperties.AutomationId="HomeTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,2,0,0">
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="PowerPoint 触摸翻页" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="轻点放映画面，推进动画或下一页。" FontSize="14" Foreground="#63776B" Margin="0,8,0,0" />
                <TextBlock x:Name="TouchStatusText" Text="正在连接后台…" FontSize="17" Foreground="#286B51" Margin="0,24,0,20" TextWrapping="Wrap" AutomationProperties.AutomationId="TouchStatus" />
                <WrapPanel>
                  <Button x:Name="TouchPowerButton" Content="开启辅助" Background="#286B51" Foreground="White" BorderBrush="#286B51" MinWidth="152" MinHeight="52" Click="TouchPowerClicked" Margin="0,0,12,4" IsEnabled="False" AutomationProperties.AutomationId="TouchPower" />
                  <Button x:Name="TouchPauseButton" Content="暂停辅助" Click="TouchPauseClicked" MinHeight="52" Visibility="Collapsed" Margin="0,0,0,4" AutomationProperties.AutomationId="TouchPause" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="ClassIsland" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Connection}" Foreground="#63776B" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="Connection" />
                </StackPanel>
                <Button x:Name="StartButton" Grid.Column="1" Content="启动 ClassIsland" Click="StartClicked" VerticalAlignment="Center" AutomationProperties.AutomationId="StartClassIsland" />
              </Grid>
            </Border>
            <TextBlock x:Name="HomeMessage" Foreground="#63776B" FontSize="13" TextWrapping="Wrap" Margin="4,0,4,8">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
              </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="SettingsTab" Header="设置" AutomationProperties.AutomationId="SettingsTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,2,0,0">
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="触摸翻页" FontSize="18" FontWeight="SemiBold" />
                <CheckBox x:Name="TouchCompatibility" Content="兼容未标记的触摸" FontSize="15" Margin="0,18,0,10" MinHeight="32" VerticalContentAlignment="Center" Checked="TouchCompatibilityChanged" Unchecked="TouchCompatibilityChanged" AutomationProperties.AutomationId="TouchCompatibility" />
                <TextBlock Text="开启后也会响应普通鼠标。默认关闭，仅对本次后台运行生效。" Foreground="#63776B" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="ClassIsland 程序" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBox x:Name="ExecutablePathBox" FontSize="14" Padding="10" MinHeight="46" VerticalContentAlignment="Center" AutomationProperties.AutomationId="ExecutablePath" AutomationProperties.Name="ClassIsland 程序路径" />
                <WrapPanel Margin="0,12,0,4">
                  <Button Content="选择文件…" Click="BrowseClicked" Margin="0,0,10,8" AutomationProperties.AutomationId="BrowseExecutable" />
                  <Button Content="保存路径" Click="SavePathClicked" Margin="0,0,10,8" AutomationProperties.AutomationId="SaveExecutable" />
                  <Button Content="重新读取" Click="ReloadClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="ReloadConfiguration" />
                </WrapPanel>
                <TextBlock x:Name="ConfigurationMessage" Text="正在读取路径配置…" Foreground="#63776B" FontSize="13" TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigurationMessage" />
                <Expander Header="启动记录与连接详情" FontSize="14" Margin="0,20,0,0" AutomationProperties.AutomationId="ClassIslandDetails">
                  <StackPanel Margin="0,12,0,0">
                    <TextBlock x:Name="LaunchResultText" Text="暂无启动记录" TextWrapping="Wrap" AutomationProperties.AutomationId="LaunchResult" />
                    <TextBlock x:Name="LaunchTimeText" Foreground="#63776B" FontSize="12" Margin="0,5,0,14" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding State}" AutomationProperties.AutomationId="LessonState" />
                    <TextBlock Text="{Binding Subject}" FontSize="20" Margin="0,5,0,8" AutomationProperties.AutomationId="Subject" />
                    <TextBlock Text="{Binding Detail}" Foreground="#63776B" TextWrapping="Wrap" AutomationProperties.AutomationId="Detail" />
                    <TextBlock Text="{Binding LessonPlan}" Foreground="#63776B" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Updated}" Foreground="#63776B" />
                    <TextBlock Text="{Binding Events}" Foreground="#63776B" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="收起到托盘" HorizontalAlignment="Left" Click="CloseClicked" AutomationProperties.AutomationId="CloseWindow" />
      <Button x:Name="ExitButton" Grid.Column="1" Content="停止后台并退出" Click="StopClicked" AutomationProperties.AutomationId="StopHost" />
    </Grid>
  </Grid>
</Window>
