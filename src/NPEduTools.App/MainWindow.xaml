                           TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="12,6,0,8" />
              </Expander>
              <Expander x:Name="RemoteExamSettings" Header="远程考试模式" Style="{DynamicResource TeacherExpander}"
                        Visibility="{Binding DataContext.ShowCompanionTools, ElementName=SettingsSchoolConnection, Converter={StaticResource SchoolToolsVisibility}, FallbackValue=Visible}"
                        AutomationProperties.Name="远程考试模式" Margin="0,0,0,16">
                <StackPanel Margin="12,0,12,12">
                  <TextBlock x:Name="RemoteExamBinding" Text="正在读取当前学校绑定…" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,8,0,12" />
                  <TextBlock Text="学校配对即授权考试控制：切换考试／日常模式（含登录自启动）、投递方案及明确请求开始放映。" TextWrapping="Wrap" />
