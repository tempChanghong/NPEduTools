<Window x:Class="NPEduTools.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NPEduTools" Width="1040" Height="760" MinWidth="840" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#F6F8F7" Foreground="#202E35" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="PositionChoice" TargetType="RadioButton">
      <Setter Property="MinHeight" Value="52" /><Setter Property="FontSize" Value="14" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Choice" Background="#F5F7F9" BorderBrush="#E2E8EA" BorderThickness="1" CornerRadius="10" Padding="16,12">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#8B999F" Margin="0,0,10,0">
              <Ellipse x:Name="Mark" Width="8" Height="8" Fill="#147D68" Visibility="Hidden" />
            </Border>
            <ContentPresenter VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Choice" Property="Background" Value="#EAF6F2" /><Setter TargetName="Choice" Property="BorderBrush" Value="#147D68" />
            <Setter TargetName="Ring" Property="BorderBrush" Value="#147D68" /><Setter TargetName="Mark" Property="Visibility" Value="Visible" /><Setter Property="Foreground" Value="#147D68" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#202E35" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderBrush" Value="#E5EBE7" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="22" /><Setter Property="Margin" Value="0,0,0,18" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Background="#EDF2EF" BorderBrush="#E0E7E2" BorderThickness="0,0,1,0">
      <Grid Margin="16,24,16,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,0">
          <Border Background="#1C6C54" CornerRadius="13" Width="42" Height="42" HorizontalAlignment="Left">
            <TextBlock Text="n" Foreground="#E4F7EB" FontFamily="Segoe UI" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-5,0,0" />
          </Border>
          <TextBlock Text="NPEduTools" Foreground="#203D32" FontFamily="Segoe UI" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,4" />
          <TextBlock Text="让课堂操作更顺手" Foreground="#6E8178" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,36,0,0">
          <TextBlock Text="工作空间" Foreground="#8A9891" FontSize="11" Margin="16,0,0,12" />
          <Button x:Name="HomeNav" Tag="active" Style="{StaticResource Navigation}" Click="HomeNavClicked" AutomationProperties.AutomationId="HomeTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="概览" /></StackPanel>
          </Button>
          <Button x:Name="ShortcutNav" Style="{StaticResource Navigation}" Click="ShortcutNavClicked" AutomationProperties.AutomationId="ShortcutsTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="快捷启动" /></StackPanel>
          </Button>
          <Button x:Name="SettingsNav" Style="{StaticResource Navigation}" Click="SettingsNavClicked" AutomationProperties.AutomationId="SettingsTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="偏好设置" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border Background="#E3EBE5" CornerRadius="12" Padding="14" Margin="2,0,2,14">
            <StackPanel><TextBlock Text="工具，就在屏幕边缘" FontSize="12" Foreground="#486557" FontWeight="SemiBold" /><TextBlock Text="拖动 n 标记调整位置" FontSize="11" Foreground="#73867A" Margin="0,6,0,0" /></StackPanel>
          </Border>
          <Button Content="展开侧边栏  ↗" Style="{StaticResource Navigation}" Click="OpenQuickClicked" AutomationProperties.AutomationId="OpenQuick" />
          <Border Height="1" Background="#DCE5DE" Margin="12,10" />
          <Button x:Name="ExitButton" Content="退出 NPEduTools" Style="{StaticResource Navigation}" FontSize="12" Click="StopClicked" AutomationProperties.AutomationId="StopHost" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition /></Grid.RowDefinitions>
      <Grid Margin="28,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="工作空间" Foreground="#8C9992" FontSize="12" /><TextBlock Text="／" Foreground="#BBC5BF" FontSize="12" Margin="9,0" /><TextBlock x:Name="PageBreadcrumb" Text="概览" Foreground="#4C6357" FontSize="12" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="−" ToolTip="收起到侧边栏" Style="{StaticResource Quiet}" Width="44" MinHeight="40" Padding="0" FontSize="20" Click="MinimizeClicked" AutomationProperties.AutomationId="MinimizeWindow" AutomationProperties.Name="收起到侧边栏" />
          <Button Content="×" ToolTip="关闭窗口，保留侧边栏" Style="{StaticResource Quiet}" Width="44" MinHeight="40" Padding="0" FontSize="22" Click="CloseClicked" AutomationProperties.AutomationId="CloseWindow" AutomationProperties.Name="关闭主窗口" />
        </StackPanel>
      </Grid>
      <Grid x:Name="Pages" Grid.Row="1" Margin="28,12,28,22">
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel>
            <DockPanel Margin="0,0,0,16">
              <TextBlock x:Name="TodayText" DockPanel.Dock="Right" Foreground="#78887F" FontSize="12" VerticalAlignment="Bottom" Margin="12,0,0,5" />
              <StackPanel><TextBlock Text="课堂工作台" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="管理常用工具，随时从侧边栏开始。" Foreground="#74847B" FontSize="13" Margin="0,8,0,0" /></StackPanel>
            </DockPanel>
            <Border CornerRadius="16" Padding="24,18" Margin="0,0,0,18" BorderBrush="#D7E8DB" BorderThickness="1">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E5F0E5" Offset="0" /><GradientStop Color="#F1F5E9" Offset="1" /></LinearGradientBrush></Border.Background>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="少找一步，多一点从容" Foreground="#2E5742" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="课堂操作留在手边，应用与课件一处收纳。" Foreground="#688271" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,16" />
                  <WrapPanel><Button Content="展开侧边栏  ↗" Style="{StaticResource Primary}" Click="OpenQuickClicked" AutomationProperties.AutomationId="PreviewSidebar" Margin="0,0,8,0" /><Button Content="管理快捷启动" Background="#F8FBF6" Click="ShortcutNavClicked" AutomationProperties.AutomationId="HeroManageShortcuts" /></WrapPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#FCFFFA" BorderBrush="#D4E3D5" BorderThickness="1" CornerRadius="15" Padding="9" Width="54" VerticalAlignment="Center" IsHitTestVisible="False">
                  <StackPanel>
                    <Border Background="#276B51" CornerRadius="9" Height="32"><TextBlock Text="n" Foreground="White" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-5,0,0" /></Border>
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="#69937B" FontSize="17" HorizontalAlignment="Center" Margin="0,12,0,10" /><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#8CA293" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,3" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <TextBlock Text="课堂工具" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Surface}" Padding="18">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#FFF0E8" CornerRadius="12" Width="42" Height="42" Margin="0,0,12,0"><TextBlock Text="P" Foreground="#BC633E" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="触摸翻页" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="PowerPoint" Foreground="#8B9890" FontFamily="Segoe UI" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                  </Grid>
                  <TextBlock Grid.Row="1" Text="轻点屏幕，推进动画与幻灯片。" TextWrapping="Wrap" Foreground="#75857C" FontSize="12" Margin="0,16,0,12" />
                  <Grid Grid.Row="2" MinHeight="28" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Ellipse x:Name="TouchStatusDot" Fill="#9BA8AD" Width="6" Height="6" Margin="0,6,8,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="TouchStatusText" Grid.Column="1" Text="正在连接后台…" Foreground="#5C6E78" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="TouchStatus" />
                  </Grid>
                  <WrapPanel Grid.Row="3"><Button x:Name="TouchPowerButton" Content="开启辅助" Style="{StaticResource Primary}" Padding="14,10" Margin="0,0,6,0" IsEnabled="False" Click="TouchPowerClicked" AutomationProperties.AutomationId="TouchPower" /><Button x:Name="TouchPauseButton" Content="暂停辅助" Padding="12,10" Click="TouchPauseClicked" Visibility="Collapsed" AutomationProperties.AutomationId="TouchPause" /></WrapPanel>
                </Grid>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="18">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EFEDFB" CornerRadius="12" Width="42" Height="42" Margin="0,0,12,0"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#7C71AB" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="ClassIsland" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="课表与课堂信息" Foreground="#8B9890" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                  </Grid>
                  <TextBlock Grid.Row="1" Text="连接课堂，查看运行与启动状态。" TextWrapping="Wrap" Foreground="#75857C" FontSize="12" Margin="0,16,0,12" />
                  <TextBlock Grid.Row="2" Text="{Binding Connection}" Foreground="#5C6E78" FontSize="12" Margin="0,0,0,10" MinHeight="28" TextWrapping="Wrap" AutomationProperties.AutomationId="Connection" />
                  <WrapPanel Grid.Row="3"><Button x:Name="StartButton" Content="启动" MinWidth="76" Padding="14,10" Click="StartClicked" AutomationProperties.AutomationId="StartClassIsland" Margin="0,0,6,0" /><Button Content="自启动" Style="{StaticResource Quiet}" Click="AdminPanelClicked" AutomationProperties.AutomationId="OpenAdminStartup" Padding="12,10" /></WrapPanel>
                </Grid>
              </Border>
            </Grid>
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="管理  →" Style="{StaticResource Quiet}" Click="ShortcutNavClicked" Padding="10,6" AutomationProperties.AutomationId="ManageHomeShortcuts" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="我的快捷" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="HomeShortcutCount" Foreground="#8A9891" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
            </DockPanel>
            <Border x:Name="HomeShortcutEmpty" Style="{StaticResource Surface}" Padding="20">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="＋ 添加快捷" Background="#EAF3ED" Foreground="#276B51" IsEnabled="{Binding IsEnabled, ElementName=AddShortcutButton}" Click="AddShortcutClicked" AutomationProperties.AutomationId="HomeAddShortcut" Margin="12,0,0,0" />
                <StackPanel VerticalAlignment="Center"><TextBlock Text="把下一节课要用的，放在这里" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="支持应用、课件和网址，保存后同步到侧边栏。" FontSize="12" Foreground="#7B8991" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel>
              </DockPanel>
            </Border>
            <ItemsControl x:Name="HomeShortcutItems">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding}" ContentTemplate="{StaticResource ShortcutTileContent}" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#E5EBE7" Margin="0,0,8,8" Padding="12,16" MinHeight="112" ToolTip="{Binding Tip}" Click="OpenShortcutClicked" AutomationProperties.AutomationId="{Binding OpenId}" AutomationProperties.Name="{Binding Name}" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="HomeShortcutMessage" FontSize="12" Foreground="#718089" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeShortcutMessage" />
            <TextBlock x:Name="HomeMessage" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="4,10,4,10">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ShortcutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel>
            <TextBlock Text="快捷启动" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="常用软件、课件与网站，放在顺手的位置。" Foreground="#7B8991" FontSize="13" Margin="0,8,0,24" TextWrapping="Wrap" />
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="AddShortcutButton" DockPanel.Dock="Right" Content="＋ 添加" Style="{StaticResource Primary}" Click="AddShortcutClicked" AutomationProperties.AutomationId="AddShortcut" />
              <TextBlock x:Name="ShortcutCount" FontSize="12" Foreground="#718089" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Surface}" Padding="16">
              <StackPanel>
                <StackPanel x:Name="ShortcutEmpty" Margin="12,24">
                  <TextBlock Text="从一个常用入口开始" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="添加教学软件、当天课件或教学平台网址。保存后会同步到主页面和贴边面板。" FontSize="13" Foreground="#718089" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
                <ListBox x:Name="ShortcutList" BorderThickness="0" Background="Transparent" SelectionChanged="ShortcutSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ShortcutList">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="SelectionSurface" Background="#F7F9FA" CornerRadius="10" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionSurface" Property="Background" Value="#EAF6F2" /><Setter TargetName="SelectionSurface" Property="BorderBrush" Value="#147D68" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectionSurface" Property="BorderBrush" Value="#147D68" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                  </Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ShortcutContent}" HorizontalContentAlignment="Stretch" />
                        <TextBlock Text="{Binding Target}" FontSize="11" Foreground="#7B8991" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" Margin="46,6,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="打开" Padding="12,8" Click="OpenShortcutClicked" AutomationProperties.AutomationId="{Binding OpenId}" AutomationProperties.Name="{Binding Name}" />
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="EditShortcutButton" Content="编辑" Click="EditShortcutClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="EditShortcut" />
                  <Button x:Name="MoveShortcutUp" Content="上移" Click="MoveShortcutClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="MoveShortcutUp" />
                  <Button x:Name="MoveShortcutDown" Content="下移" Click="MoveShortcutClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="MoveShortcutDown" />
                  <Button x:Name="RemoveShortcutButton" Content="移除" Style="{StaticResource Quiet}" Click="RemoveShortcutClicked" AutomationProperties.AutomationId="RemoveShortcut" />
                </WrapPanel>
                <TextBlock Text="先选中一项，再编辑或调整顺序。移除入口会保留原文件。" FontSize="11" Foreground="#7B8991" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ShortcutMessage" FontSize="13" Foreground="#147D68" TextWrapping="Wrap" AutomationProperties.AutomationId="ShortcutMessage" />
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="RepairShortcutButton" Content="编辑此项" Click="RepairShortcutClicked" Visibility="Collapsed" AutomationProperties.AutomationId="RepairShortcut" Margin="0,0,8,0" />
              <Button x:Name="UndoShortcutDelete" Content="撤销移除" Click="UndoShortcutClicked" Visibility="Collapsed" AutomationProperties.AutomationId="UndoShortcutDelete" Margin="0,0,8,0" />
              <Button Content="重新读取" Style="{StaticResource Quiet}" Click="ReloadShortcutsClicked" AutomationProperties.AutomationId="ReloadShortcuts" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel>
            <TextBlock Text="偏好设置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="按你的课堂习惯调整。" Foreground="#7B8991" FontSize="13" Margin="0,8,0,26" />
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="启动与就绪" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox x:Name="LoginStartupToggle" Style="{StaticResource Switch}" Content="登录 Windows 时启动" Checked="LoginStartupChanged" Unchecked="LoginStartupChanged" AutomationProperties.AutomationId="LoginStartup" />
                <TextBlock x:Name="LoginStartupMessage" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.AutomationId="LoginStartupMessage" />
                <Button Content="Windows 启动应用 ↗" Style="{StaticResource Quiet}" HorizontalAlignment="Left" FontSize="12" MinHeight="36" Padding="0,6" Click="OpenWindowsStartupClicked" />
                <Border Height="1" Background="#EEF2F3" Margin="0,12,0,16" />
                <CheckBox x:Name="EdgeOnlyAtLogin" Style="{StaticResource Switch}" Content="自启动时仅显示贴边入口" Checked="StartupPreferenceChanged" Unchecked="StartupPreferenceChanged" AutomationProperties.AutomationId="EdgeOnlyAtLogin" />
                <TextBlock Text="手动打开程序时，仍会显示主窗口。" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16" />
                <CheckBox x:Name="AutoTouchAtLaunch" Style="{StaticResource Switch}" Content="启动时开启触摸翻页" Checked="StartupPreferenceChanged" Unchecked="StartupPreferenceChanged" AutomationProperties.AutomationId="AutoTouchAtLaunch" />
                <TextBlock Text="后台就绪后开启 PowerPoint 辅助，可随时从贴边入口暂停或停止。" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="StartupPreferencesMessage" Foreground="#147D68" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="StartupPreferencesMessage" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="快捷入口" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="选择顺手的一侧，拖动侧边栏顶部的 n 标记调整高度。" TextWrapping="Wrap" Foreground="#7B8991" FontSize="12" Margin="0,6,0,16" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="DockLeft" Content="屏幕左侧" GroupName="EntrySide" Style="{StaticResource PositionChoice}" Checked="DockLeftClicked" Margin="0,0,6,0" AutomationProperties.AutomationId="DockLeft" />
                  <RadioButton x:Name="DockRight" Content="屏幕右侧" GroupName="EntrySide" Style="{StaticResource PositionChoice}" Checked="DockRightClicked" Grid.Column="1" Margin="6,0,0,0" AutomationProperties.AutomationId="DockRight" />
                </Grid>
                <TextBlock Text="更改即时生效，位置会在下次启动时保留。" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <CheckBox x:Name="TouchCompatibility" Style="{StaticResource Switch}" Content="兼容未标记的触摸" Checked="TouchCompatibilityChanged" Unchecked="TouchCompatibilityChanged" AutomationProperties.AutomationId="TouchCompatibility" />
                <TextBlock Text="仅在轻点无效时尝试。开启后也会响应普通鼠标。" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="ClassIsland 程序" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBox x:Name="ExecutablePathBox" AutomationProperties.AutomationId="ExecutablePath" AutomationProperties.Name="ClassIsland 程序路径" />
                <WrapPanel Margin="0,12,0,6">
                  <Button Content="选择文件" Click="BrowseClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="BrowseExecutable" />
                  <Button Content="保存" Style="{StaticResource Primary}" Click="SavePathClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="SaveExecutable" />
                  <Button Content="重新读取" Style="{StaticResource Quiet}" Click="ReloadClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="ReloadConfiguration" />
                </WrapPanel>
                <TextBlock x:Name="ConfigurationMessage" Text="正在读取路径配置…" Foreground="#718089" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigurationMessage" />
                <Expander Header="启动记录与连接详情" FontSize="13" Margin="0,20,0,0" AutomationProperties.AutomationId="ClassIslandDetails">
                  <StackPanel Margin="0,12,0,0">
                    <TextBlock x:Name="LaunchResultText" Text="暂无启动记录" TextWrapping="Wrap" AutomationProperties.AutomationId="LaunchResult" />
                    <TextBlock x:Name="LaunchTimeText" Foreground="#718089" FontSize="12" Margin="0,5,0,14" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding State}" AutomationProperties.AutomationId="LessonState" />
                    <TextBlock Text="{Binding Subject}" FontSize="20" Margin="0,5,0,8" AutomationProperties.AutomationId="Subject" />
                    <TextBlock Text="{Binding Detail}" Foreground="#718089" TextWrapping="Wrap" AutomationProperties.AutomationId="Detail" />
                    <TextBlock Text="{Binding LessonPlan}" Foreground="#718089" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Updated}" Foreground="#718089" />
                    <TextBlock Text="{Binding Events}" Foreground="#718089" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <Border x:Name="AdminSection" Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="ClassIsland 管理员自启动" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="当前用户登录 Windows 时，以管理员身份启动已保存的 ClassIsland。" FontSize="12" Foreground="#7B8991" TextWrapping="Wrap" Margin="0,6,0,16" />
                <TextBlock x:Name="AdminTaskStatus" Text="等待检查计划任务" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminTaskStatus" />
                <TextBlock x:Name="AdminProcessStatus" Text="运行权限尚未检查" FontSize="12" Foreground="#718089" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminProcessStatus" />
                <WrapPanel Margin="0,16,0,0">
                  <Button x:Name="AdminCreate" Content="启用管理员自启动" Style="{StaticResource Primary}" Click="AdminCreateClicked" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="AdminCreate" />
                  <Button x:Name="AdminDelete" Content="删除自启动任务" Click="AdminDeleteClicked" IsEnabled="False" Margin="0,0,0,8" AutomationProperties.AutomationId="AdminDelete" />
                </WrapPanel>
                <WrapPanel>
                  <Button x:Name="AdminElevate" Content="管理员启动／重启" Click="AdminElevateClicked" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="AdminElevate" />
                  <Button x:Name="AdminRefresh" Content="刷新" Style="{StaticResource Quiet}" Click="AdminRefreshClicked" Margin="0,0,4,8" AutomationProperties.AutomationId="AdminRefresh" />
                  <Button x:Name="AdminInspect" Content="管理员检查" Style="{StaticResource Quiet}" Click="AdminInspectClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="AdminInspect" />
                </WrapPanel>
                <TextBlock x:Name="AdminMessage" FontSize="12" Foreground="#147D68" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.AutomationId="AdminMessage" />
                <TextBlock x:Name="AdminPluginStatus" Text="兼容 StartUpAsAdmin 的计划任务。" FontSize="11" Foreground="#7B8991" TextWrapping="Wrap" />
                <TextBlock Text="需要时由 Windows 请求管理员授权。删除任务不会关闭当前程序；管理员重启会先请求原实例正常退出。" FontSize="11" Foreground="#7B8991" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
