                <Button x:Name="MoveShortcutDown" Content="下移" Style="{DynamicResource TeacherQuiet}" Click="MoveShortcutClicked" Margin="0,0,8,4" AutomationProperties.AutomationId="MoveShortcutDown" />
                <Button x:Name="RemoveShortcutButton" Content="移除入口" Style="{DynamicResource TeacherQuiet}" Click="RemoveShortcutClicked" Margin="0,0,8,4" AutomationProperties.AutomationId="RemoveShortcut" />
                <Button x:Name="RepairShortcutButton" Content="编辑此项" Style="{DynamicResource TeacherButton}" Click="RepairShortcutClicked" Visibility="Collapsed" AutomationProperties.AutomationId="RepairShortcut" Margin="0,0,8,4" />
                <Button x:Name="UndoShortcutDelete" Content="撤销移除" Style="{DynamicResource TeacherButton}" Click="UndoShortcutClicked" Visibility="Collapsed" AutomationProperties.AutomationId="UndoShortcutDelete" Margin="0,0,8,4" />
                <Button x:Name="ReloadShortcutsButton" Content="重新读取" Style="{DynamicResource TeacherQuiet}" Click="ReloadShortcutsClicked" AutomationProperties.AutomationId="ReloadShortcuts" Margin="0,0,0,4" />
              </WrapPanel>
              <TextBlock x:Name="ShortcutMessage" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap"
               AutomationProperties.AutomationId="ShortcutMessage" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Grid>
          <local:ShortcutEditorView x:Name="ShortcutEditor" Grid.Column="1" Visibility="Collapsed" />
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
