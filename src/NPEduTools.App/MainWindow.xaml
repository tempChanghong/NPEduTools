                  <TextBlock Text="学校也可远程返回日常：恢复日常自启动，正常退出 ExamAware2，等待 ClassIsland 就绪后解除远程录课暂停。放映或编辑器阻止退出时保留暂停并报告原因。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,0,0,8" />
                  <TextBlock x:Name="RemoteExamPolicyMessage" Text="正在读取 N3 通道状态…" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" />
                  <TextBlock x:Name="RemoteExamRuntimeMessage" Text="正在读取本地考试状态…" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,0" />
                  <TextBlock Text="此项仅表示当前远程录课暂停，不代表 ExamAware2 或 ClassIsland 的运行状态；历史回执另列在下方。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,6,0,0" />
                  <Expander x:Name="RemoteExamRuntimeDetailsPanel" Header="当前暂停详情" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBox x:Name="RemoteExamRuntimeDetails" Style="{StaticResource TeacherInput}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="12" AutomationProperties.AutomationId="RemoteExamRuntimeDetails" />
                  </Expander>
                  <TextBlock Text="检查后台权限、程序位置、录制状态和软件连接。仅检查当前环境，不会启动或退出软件，也不会修改 Windows 自启动。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,8,0,12" />
                  <Button x:Name="RemoteExamCheckButton" Content="检查考试环境" Click="RemoteExamCheckClicked" HorizontalAlignment="Left" AutomationProperties.AutomationId="RemoteExamPreflight" />
                  <TextBlock x:Name="RemoteExamCheckMessage" Text="本机检查不代表已授权学校远程控制。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,10,0,0" />
                  <Expander x:Name="RemoteExamCheckDetailsPanel" Header="技术详情（请求编号与后台说明）" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBox x:Name="RemoteExamCheckDetails" Style="{StaticResource TeacherInput}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="12" AutomationProperties.AutomationId="RemoteExamCheckDetails" />
