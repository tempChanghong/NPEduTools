<Window x:Class="NPEduTools.App.MainWindow" xmlns:local="clr-namespace:NPEduTools.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/npedutools.ico" Title="NPEduTools" Width="1040" Height="760" MinWidth="840" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource TeacherPageBrush}" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="{DynamicResource SettingsBodyFont}" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="SchoolToolsVisibility" />
    <Style x:Key="SidebarNavigation" TargetType="Button" BasedOn="{StaticResource TeacherNavigation}">
      <Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="14" /><Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}" /></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="Handle"><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="#B7C6BE" CornerRadius="3" Margin="{TemplateBinding Padding}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#718C7E" /></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#147D68" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}" /></Track.IncreaseRepeatButton>
        </Track>
        <ControlTemplate.Triggers>
          <Trigger Property="Orientation" Value="Vertical">
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
            <Setter TargetName="Decrease" Property="Command" Value="{x:Static ScrollBar.PageUpCommand}" />
            <Setter TargetName="Increase" Property="Command" Value="{x:Static ScrollBar.PageDownCommand}" />
            <Setter TargetName="Handle" Property="MinHeight" Value="28" />
            <Setter TargetName="Handle" Property="Padding" Value="4,0" />
          </Trigger>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter TargetName="Handle" Property="MinWidth" Value="28" />
            <Setter TargetName="Handle" Property="Padding" Value="0,4" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="14" /></Trigger>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="14" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderBrush" Value="#E5EBE7" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="22" /><Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style x:Key="HomeTaskSurface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource TeacherSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TeacherShellLineBrush}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,14" /><Setter Property="Margin" Value="0,0,12,8" />
    </Style>
    <Style x:Key="HomeAction" TargetType="Button" BasedOn="{StaticResource TeacherQuiet}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,6" /><Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style x:Key="HomeIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="16" />
      <Setter Property="Margin" Value="0,0,10,0" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="HomeSection" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TeacherTextBrush}" /><Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="WorkspaceNavColumn" Width="164" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border x:Name="WorkspaceSidebarSurface" Background="{DynamicResource TeacherShellNavigationBrush}"
            BorderBrush="{DynamicResource TeacherShellLineBrush}" BorderThickness="0,0,1,0">
      <Grid x:Name="WorkspaceSidebar" Margin="12,13,12,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="WorkspaceBrand" Orientation="Horizontal" Margin="8,0,0,0">
          <Image Source="{StaticResource BrandLogoSmall}" Width="24" Height="24" HorizontalAlignment="Left" AutomationProperties.Name="NPEduTools 标志" />
          <TextBlock Text="NPEduTools" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,8"><StackPanel>
          <Button x:Name="HomeNav" Tag="active" Style="{StaticResource SidebarNavigation}" Click="HomeNavClicked" AutomationProperties.AutomationId="HomeTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="主页" /></StackPanel>
          </Button>
          <Button x:Name="ShortcutNav" Style="{StaticResource SidebarNavigation}" Click="ShortcutNavClicked" AutomationProperties.AutomationId="ShortcutsTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="快捷启动" /></StackPanel>
          </Button>
          <Button x:Name="StudyNav" Style="{StaticResource SidebarNavigation}" Click="StudyNavClicked" AutomationProperties.AutomationId="StudyTab"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="自习"/></StackPanel></Button>
          <Button x:Name="RecordingNav" Content="录课" Style="{StaticResource SidebarNavigation}" Click="RecordingNavClicked" AutomationProperties.AutomationId="RecordingNav" />
          <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="10,8" />
          <Button x:Name="NpepSettingsTab" Style="{StaticResource SidebarNavigation}" Click="NpepSettingsClicked" AutomationProperties.AutomationId="NpepSettingsTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="学校互联" /></StackPanel>
          </Button>
          <Button x:Name="SettingsNav" Style="{StaticResource SidebarNavigation}" Click="SettingsNavClicked" AutomationProperties.AutomationId="SettingsTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="设备与连接" /></StackPanel>
          </Button>
          <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="10,8" />
          <Button x:Name="ExamAwareNav" Content="ExamAware2" ToolTip="ExamAware2 连接" Style="{StaticResource SidebarNavigation}" Click="OpenExamAwareClicked" AutomationProperties.AutomationId="OpenExamAware" />
          <Button x:Name="SecRandomNav" Content="课堂点名" ToolTip="SecRandom 连接与闪抽" Style="{StaticResource SidebarNavigation}" Click="OpenSecRandomClicked" AutomationProperties.AutomationId="OpenSecRandom" />
          <Button x:Name="ClassroomModeNav" Content="课堂模式" Style="{StaticResource SidebarNavigation}" Click="OpenClassroomModeClicked" AutomationProperties.AutomationId="OpenClassroomMode" />
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2">
          <Button x:Name="AboutNav" Style="{StaticResource SidebarNavigation}" Click="AboutNavClicked" AutomationProperties.AutomationId="AboutTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="关于" /></StackPanel>
          </Button>
          <Button Content="展开侧边栏" Style="{StaticResource SidebarNavigation}" Click="OpenQuickClicked" AutomationProperties.AutomationId="OpenQuick" />
          <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="12,8" />
          <Button x:Name="ExitButton" Content="退出后台" Style="{StaticResource SidebarNavigation}" FontSize="12" Click="StopClicked" AutomationProperties.AutomationId="StopHost" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceContentSurface" Grid.Column="1" Background="{DynamicResource TeacherShellContentBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
      <Grid x:Name="WorkspaceCaption" Height="46" Margin="20,0,6,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="&#xE700;" FontFamily="Segoe MDL2 Assets" ToolTip="展开或折叠导航" Click="FoldWorkspaceSidebarClicked" Style="{DynamicResource TeacherQuiet}" Width="44" Height="44" MinHeight="44" Padding="0" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.AutomationId="FoldWorkspaceSidebar" AutomationProperties.Name="展开或折叠导航"/>
          <TextBlock x:Name="PageBreadcrumb" Text="主页" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{DynamicResource TeacherQuiet}" Height="44" MinHeight="44" MinWidth="44" Padding="10,0" Click="CollapseToSideRailClicked" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="收起到侧边栏" AutomationProperties.AutomationId="CollapseToSideRail" AutomationProperties.Name="收起到侧边栏">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="收起到侧边栏" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Height="18" Background="{DynamicResource TeacherLineBrush}" Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="最小化窗口" Style="{DynamicResource TeacherQuiet}" Width="44" Height="44" MinHeight="44" Padding="0" Click="MinimizeClicked" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.AutomationId="MinimizeWindow" AutomationProperties.Name="最小化窗口" />
          <Button x:Name="MaximizeRestoreButton" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="44" Height="44" MinHeight="44" Padding="0" Click="MaximizeRestoreClicked" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.AutomationId="MaximizeRestoreWindow">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TeacherQuiet}">
                <Setter Property="Content" Value="&#xE922;" />
                <Setter Property="ToolTip" Value="最大化窗口" />
                <Setter Property="AutomationProperties.Name" Value="最大化窗口" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;" />
                    <Setter Property="ToolTip" Value="还原窗口" />
                    <Setter Property="AutomationProperties.Name" Value="还原窗口" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="关闭窗口，保留侧边栏" Style="{DynamicResource TeacherQuiet}" Width="44" Height="44" MinHeight="44" Padding="0" Click="CloseClicked" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.AutomationId="CloseWindow" AutomationProperties.Name="关闭主窗口" />
        </StackPanel>
      </Grid>
      <Grid x:Name="Pages" Grid.Row="1" Margin="28,12,28,22">
        <ContentControl x:Name="ExamAwareWorkspaceHost" Visibility="Collapsed" AutomationProperties.AutomationId="ExamAwareWorkspace" />
        <ContentControl x:Name="SecRandomWorkspaceHost" Visibility="Collapsed" AutomationProperties.AutomationId="SecRandomWorkspace" />
        <ContentControl x:Name="ClassroomModeWorkspaceHost" Visibility="Collapsed" AutomationProperties.AutomationId="ClassroomModeWorkspace" />
        <Grid x:Name="RecordingWorkspace" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12">
            <Button x:Name="RecordingManualTab" Content="立即录制" Style="{DynamicResource TeacherTab}" Click="RecordingManualTabClicked" AutomationProperties.AutomationId="RecordingManualTab" Margin="0,0,8,0"/>
            <Button x:Name="RecordingPlanTab" Content="自动安排" Style="{DynamicResource TeacherTab}" Click="RecordingPlanTabClicked" AutomationProperties.AutomationId="RecordingPlanTab" Margin="0,0,8,0"/>
            <Button x:Name="RecordingRecordsTab" Content="录制记录" Style="{DynamicResource TeacherTab}" Click="RecordingRecordsTabClicked" AutomationProperties.AutomationId="RecordingRecordsTab"/>
          </WrapPanel>
          <Grid Grid.Row="1"><ContentControl x:Name="RecordingManualHost"/><ContentControl x:Name="RecordingPlanHost" Visibility="Collapsed"/></Grid>
        </Grid>
        <Grid x:Name="StudyWorkspace" Visibility="Collapsed">
          <Grid.Resources>
            <ResourceDictionary Source="Resources/StudyWorkspaceReports.xaml" />
          </Grid.Resources>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12">
            <Button x:Name="ManualWorkspaceTab" Content="手动自习" Click="ManualWorkspaceClicked" Style="{DynamicResource TeacherTab}" AutomationProperties.AutomationId="ManualWorkspaceTab" Margin="0,0,8,4"/>
            <Button x:Name="SchoolWorkspaceTab" Content="学校定时自习" Click="SchoolWorkspaceClicked" Style="{DynamicResource TeacherTab}" AutomationProperties.AutomationId="SchoolWorkspaceTab" Margin="0,0,8,4"/>
            <Button x:Name="ReportWorkspaceTab" Content="报告" Click="ReportWorkspaceClicked" Style="{DynamicResource TeacherTab}" AutomationProperties.AutomationId="ReportWorkspaceTab" Margin="0,0,0,4"/>
          </WrapPanel>
          <Grid Grid.Row="1">
            <ContentControl x:Name="ManualWorkspaceHost" Visibility="Collapsed"/>
            <ContentControl x:Name="SchoolWorkspaceHost" Visibility="Collapsed"/>
            <DockPanel x:Name="WorkspaceReports" Visibility="Collapsed" TextElement.FontFamily="{DynamicResource TeacherFont}"
                       TextElement.Foreground="{DynamicResource TeacherTextBrush}">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button x:Name="WorkspaceRefreshReports" Content="刷新报告" Click="RefreshWorkspaceReportsClicked"
                        Style="{DynamicResource TeacherButton}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0"
                        AutomationProperties.AutomationId="WorkspaceRefreshReports" />
                <TextBlock Text="本机最近报告" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
              </DockPanel>
              <ScrollViewer x:Name="WorkspaceReportScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            PanningMode="VerticalOnly" AutomationProperties.Name="本机自习报告">
                <ScrollViewer.Resources>
                  <!-- Use the system scrollbar and its high-contrast colors. -->
                  <Style TargetType="ScrollBar" />
                </ScrollViewer.Resources>
                <StackPanel>
                  <ContentControl x:Name="WorkspaceSchoolReport" ContentTemplate="{StaticResource StudyWorkspaceReport}"
                                  AutomationProperties.AutomationId="WorkspaceSchoolReport" />
                  <ContentControl x:Name="WorkspaceManualReport" ContentTemplate="{StaticResource StudyWorkspaceReport}" Focusable="True" IsTabStop="False"
                                  AutomationProperties.Name="最近的手动自习报告"
                                  AutomationProperties.AutomationId="WorkspaceManualReport" />
                  <TextBlock Text="学校历史报告和上传状态请在 NPClassworks 后台查看。"
                             Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Grid>
          <Border x:Name="WorkspaceReportTools" Grid.Row="2" Visibility="{Binding Visibility, ElementName=WorkspaceReports}"
                  BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><WrapPanel>
            <Button Content="设备与校准" Click="WorkspaceDevicesClicked" Style="{DynamicResource TeacherQuiet}" Margin="0,0,8,0"/>
            <Button Content="联机校准 (Beta) →" Click="WorkspaceCalibrationClicked" Style="{DynamicResource TeacherQuiet}"/>
          </WrapPanel></Border>
        </Grid>
        <Grid x:Name="WorkspaceCalibration" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Button Content="← 返回自习" Click="ReturnFromCalibrationClicked" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="0,0,0,10"/><ContentControl x:Name="WorkspaceCalibrationHost" Grid.Row="1"/></Grid>
        <Grid x:Name="WorkspaceSeating" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <Button x:Name="WorkspaceSeatingBack" Content="← 返回学校定时自习" Click="ReturnFromSeatingClicked"
                  Style="{DynamicResource TeacherButton}" HorizontalAlignment="Left" Margin="0,0,0,8"
                  AutomationProperties.AutomationId="StudySeatingWorkspaceBack"/>
          <ContentControl x:Name="WorkspaceSeatingHost" Grid.Row="1"/>
        </Grid>
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel MaxWidth="1080" SizeChanged="HomeLayoutSizeChanged">
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="课堂工作台" FontSize="32" FontWeight="SemiBold"
                         AutomationProperties.HeadingLevel="Level1" />
              <TextBlock x:Name="TodayText" Grid.Column="1" ToolTip="本机日期；自动录课使用 ClassIsland 校准后的时间。"
                         Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
            <TextBlock x:Name="HomeMessage" Foreground="{DynamicResource TeacherWarningBrush}" Background="{DynamicResource TeacherPageBrush}"
                       Padding="12,8" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.AutomationId="HomeMessage">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>

            <UniformGrid x:Name="HomeCurrentTasks" Columns="2" Margin="0,0,-12,2">
              <Border Style="{StaticResource HomeTaskSurface}" Background="{DynamicResource TeacherHoverBrush}">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,12">
                    <DockPanel>
                      <TextBlock Text="&#xE7F4;" Style="{StaticResource HomeIcon}" Foreground="{DynamicResource TeacherAccentBrush}" />
                      <TextBlock x:Name="WorkspaceTaskTitle" Text="自习状态待确认" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock x:Name="StudyHomeStatus" Text="正在读取后台状态" Style="{DynamicResource SettingsHint}"
                               Margin="0,5,0,0" AutomationProperties.AutomationId="StudyHomeStatus" />
                  </StackPanel>
                  <Button x:Name="WorkspacePrimary" Grid.Row="1" Content="进入自习" Click="WorkspacePrimaryClicked"
                          Style="{DynamicResource TeacherPrimary}" MinHeight="56" MinWidth="132" HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="HomeStudyPrimary" />
                </Grid>
              </Border>
              <Border Style="{StaticResource HomeTaskSurface}">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,12">
                    <DockPanel>
                      <TextBlock Text="&#xE714;" Style="{StaticResource HomeIcon}" Foreground="{DynamicResource TeacherMutedBrush}" />
                      <TextBlock x:Name="HomeRecordingPhaseMark" Margin="0,0,5,0" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock x:Name="RecordingHomeTitle" Text="录课状态待确认" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock x:Name="RecordingHomeStatus" Text="正在读取后台状态" Style="{DynamicResource SettingsHint}"
                               Margin="0,5,0,0" AutomationProperties.AutomationId="RecordingHomeStatus" />
                  </StackPanel>
                  <Button x:Name="RecordingHomeButton" Grid.Row="1" Click="HomeRecordingPrimaryClicked"
                          Style="{DynamicResource TeacherButton}" MinHeight="56" MinWidth="132" HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="OpenRecording" AutomationProperties.Name="录课">
                    <TextBlock x:Name="RecordingHomeAction" Text="进入录课" />
                  </Button>
                </Grid>
              </Border>
            </UniformGrid>
            <WrapPanel Margin="0,0,0,12">
              <Button x:Name="HomeHomeworkButton" Style="{StaticResource HomeAction}" Click="HomeHomeworkClicked" IsEnabled="False"
                      ToolTip="自习中已收起的作业全屏可从这里恢复。" ToolTipService.ShowOnDisabled="True"
                      AutomationProperties.AutomationId="HomeHomework" AutomationProperties.Name="展示作业">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8A5;" Style="{StaticResource HomeIcon}" /><TextBlock Text="展示作业" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HomeAction}" Click="OpenSecRandomClicked"
                      AutomationProperties.AutomationId="HomeOpenSecRandom" AutomationProperties.Name="课堂点名" ToolTip="SecRandom 连接与闪抽">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8D4;" Style="{StaticResource HomeIcon}" /><TextBlock Text="课堂点名" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HomeAction}" Click="OpenExamAwareClicked"
                      AutomationProperties.AutomationId="HomeOpenExamAware" AutomationProperties.Name="ExamAware2 连接" ToolTip="ExamAware2 连接与管理">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7C3;" Style="{StaticResource HomeIcon}" /><TextBlock Text="ExamAware2 连接" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <TextBlock Text="接下来的安排" Style="{StaticResource HomeSection}" AutomationProperties.HeadingLevel="Level2" />
            <UniformGrid x:Name="HomeUpcoming" Columns="2" Margin="0,0,0,14">
              <Border BorderBrush="{DynamicResource TeacherShellLineBrush}" BorderThickness="0,1,0,0" Padding="0,3,0,0" Margin="0,0,14,0">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="查看 ›" Click="OpenStudyMonitoringClicked" Style="{StaticResource HomeAction}"
                            AutomationProperties.Name="查看学校自习安排" />
                    <TextBlock Text="学校自习" Style="{DynamicResource SettingsLabel}" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock x:Name="StudyHomeNext" Text="学校安排待确认" Style="{DynamicResource SettingsHint}"
                             AutomationProperties.AutomationId="StudyHomeNext" />
                </StackPanel>
              </Border>
              <Border BorderBrush="{DynamicResource TeacherShellLineBrush}" BorderThickness="0,1,0,0" Padding="0,3,0,0">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="查看 ›" Click="OpenRecordingPlanClicked" Style="{StaticResource HomeAction}"
                            AutomationProperties.AutomationId="HomeRecordingPlan" AutomationProperties.Name="查看自动录课安排" />
                    <TextBlock Text="下一节自动录课" Style="{DynamicResource SettingsLabel}" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock x:Name="HomeRecordingNext" Text="录课安排待确认" Style="{DynamicResource SettingsHint}"
                             AutomationProperties.AutomationId="HomeRecordingNext" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border x:Name="ClassroomModeCard" BorderBrush="{DynamicResource TeacherShellLineBrush}" BorderThickness="0,1,0,0"
                    Padding="0,4" Margin="0,0,0,2">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
