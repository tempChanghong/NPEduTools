                <local:SettingsRow Style="{StaticResource SettingsRow}" Icon="M4,4 H20 Q22,4 22,6 V15 Q22,17 20,17 H4 Q2,17 2,15 V6 Q2,4 4,4 Z M12,17 V21 M8,21 H16">
                  <local:SettingsRow.Header><StackPanel>
