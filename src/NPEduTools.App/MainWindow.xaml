<Window x:Class="NPEduTools.App.MainWindow" xmlns:local="clr-namespace:NPEduTools.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/npedutools.ico" Title="NPEduTools" Width="1040" Height="760" MinWidth="840" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#F6F8F7" Foreground="#202E35" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SidebarNavigation" TargetType="Button" BasedOn="{StaticResource Navigation}">
      <Setter Property="MinHeight" Value="42" /><Setter Property="Padding" Value="16,8" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="14" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" /></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="#B7C6BE" CornerRadius="3" Margin="4,0" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#718C7E" /></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#147D68" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" /></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PositionChoice" TargetType="RadioButton">
      <Setter Property="MinHeight" Value="52" /><Setter Property="FontSize" Value="14" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Choice" Background="#F5F7F9" BorderBrush="#E2E8EA" BorderThickness="1" CornerRadius="10" Padding="16,12">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#8B999F" Margin="0,0,10,0">
              <Ellipse x:Name="Mark" Width="8" Height="8" Fill="#147D68" Visibility="Hidden" />
            </Border>
            <ContentPresenter VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Choice" Property="Background" Value="#EAF6F2" /><Setter TargetName="Choice" Property="BorderBrush" Value="#147D68" />
            <Setter TargetName="Ring" Property="BorderBrush" Value="#147D68" /><Setter TargetName="Mark" Property="Visibility" Value="Visible" /><Setter Property="Foreground" Value="#147D68" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#202E35" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderBrush" Value="#E5EBE7" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="22" /><Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style x:Key="HomeTool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E5EBE7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="112" /><Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ToolSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToolSurface" Property="Background" Value="#F0F7F3" /><Setter TargetName="ToolSurface" Property="BorderBrush" Value="#B4D4C5" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToolSurface" Property="Background" Value="#E2F0E9" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToolSurface" Property="BorderBrush" Value="#147D68" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToolSurface" Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HomeSection" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#526A60" /><Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Background="#EDF2EF" BorderBrush="#E0E7E2" BorderThickness="0,0,1,0">
      <Grid Margin="16,24,16,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,0">
          <Image Source="{StaticResource BrandLogoSmall}" Width="40" Height="40" HorizontalAlignment="Left" AutomationProperties.Name="NPEduTools 标志" />
          <TextBlock Text="NPEduTools" Foreground="#203D32" FontFamily="Segoe UI" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,4" />
          <TextBlock Text="让课堂操作更顺手" Foreground="#6E8178" FontSize="12" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,12"><StackPanel>
          <TextBlock Text="工作空间" Foreground="#8A9891" FontSize="11" Margin="16,0,0,12" />
          <Button x:Name="HomeNav" Tag="active" Style="{StaticResource SidebarNavigation}" Click="HomeNavClicked" AutomationProperties.AutomationId="HomeTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="概览" /></StackPanel>
          </Button>
          <Button x:Name="ShortcutNav" Style="{StaticResource SidebarNavigation}" Click="ShortcutNavClicked" AutomationProperties.AutomationId="ShortcutsTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="快捷启动" /></StackPanel>
          </Button>
          <TextBlock Text="课堂工具" Foreground="#718089" FontSize="11" Margin="16,18,0,12" />
          <Button Content="录制微课" Style="{StaticResource SidebarNavigation}" Click="OpenRecordingClicked" AutomationProperties.AutomationId="RecordingNav" />
          <Button Content="自动录课计划" Style="{StaticResource SidebarNavigation}" Click="OpenRecordingPlanClicked" AutomationProperties.AutomationId="OpenRecordingPlan" />
          <Button Content="考试看板" Style="{StaticResource SidebarNavigation}" Click="OpenExamAwareClicked" AutomationProperties.AutomationId="OpenExamAware" />
          <Button Content="课堂点名" ToolTip="SecRandom 连接与闪抽" Style="{StaticResource SidebarNavigation}" Click="OpenSecRandomClicked" AutomationProperties.AutomationId="OpenSecRandom" />
          <Button Content="噪音监测" Style="{StaticResource SidebarNavigation}" Click="OpenNoiseClicked" AutomationProperties.AutomationId="OpenNoise" />
          <Button Content="课堂模式" Style="{StaticResource SidebarNavigation}" Click="OpenClassroomModeClicked" AutomationProperties.AutomationId="OpenClassroomMode" />
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2">
          <Button x:Name="SettingsNav" Style="{StaticResource SidebarNavigation}" Click="SettingsNavClicked" AutomationProperties.AutomationId="SettingsTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="设置" /></StackPanel>
          </Button>
          <Button x:Name="AboutNav" Style="{StaticResource SidebarNavigation}" Click="AboutNavClicked" AutomationProperties.AutomationId="AboutTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="关于" /></StackPanel>
          </Button>
          <Button Content="展开侧边栏  ↗" Style="{StaticResource SidebarNavigation}" Click="OpenQuickClicked" AutomationProperties.AutomationId="OpenQuick" />
          <Border Height="1" Background="#DCE5DE" Margin="12,10" />
          <Button x:Name="ExitButton" Content="退出 NPEduTools" Style="{StaticResource SidebarNavigation}" FontSize="12" Click="StopClicked" AutomationProperties.AutomationId="StopHost" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition /></Grid.RowDefinitions>
      <Grid Margin="28,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="工作空间" Foreground="#8C9992" FontSize="12" /><TextBlock Text="／" Foreground="#BBC5BF" FontSize="12" Margin="9,0" /><TextBlock x:Name="PageBreadcrumb" Text="概览" Foreground="#4C6357" FontSize="12" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="−" ToolTip="收起到侧边栏" Style="{StaticResource Quiet}" Width="44" MinHeight="40" Padding="0" FontSize="20" Click="MinimizeClicked" AutomationProperties.AutomationId="MinimizeWindow" AutomationProperties.Name="收起到侧边栏" />
          <Button Content="×" ToolTip="关闭窗口，保留侧边栏" Style="{StaticResource Quiet}" Width="44" MinHeight="40" Padding="0" FontSize="22" Click="CloseClicked" AutomationProperties.AutomationId="CloseWindow" AutomationProperties.Name="关闭主窗口" />
        </StackPanel>
      </Grid>
      <Grid x:Name="Pages" Grid.Row="1" Margin="28,12,28,22">
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel SizeChanged="HomeLayoutSizeChanged">
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="课堂工作台" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="先打开常用入口，再查看课堂状态。" Foreground="#74847B" FontSize="12" Margin="0,6,0,0" /></StackPanel>
              <TextBlock x:Name="TodayText" Grid.Column="1" ToolTip="本机日期；自动录课仍使用 ClassIsland 校准后的时间。" Foreground="#78887F" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
            <Border x:Name="ClassroomModeCard" Style="{StaticResource Surface}" Padding="16,14" Margin="0,0,0,18" Background="#EAF6F2" BorderBrush="#C8E4D9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                  <TextBlock x:Name="ClassroomModeTitle" Text="课堂模式 · 正在连接…" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeClassroomModeTitle" />
                  <TextBlock x:Name="ClassroomModeDetail" TextWrapping="Wrap" FontSize="12" Foreground="#64776D" Margin="0,6,0,0" AutomationProperties.AutomationId="HomeClassroomModeDetail" />
                </StackPanel>
                <Button Grid.Column="1" Content="管理模式" Style="{StaticResource Quiet}" Click="OpenClassroomModeClicked" Padding="12,8" VerticalAlignment="Center" AutomationProperties.AutomationId="HomeClassroomMode" />
              </Grid>
            </Border>
            <TextBlock x:Name="HomeMessage" Foreground="#7D602B" Background="#FFF5E6" Padding="12,10" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.AutomationId="HomeMessage">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="查看全部 / 管理" Style="{StaticResource Quiet}" Click="ShortcutNavClicked" Padding="10,6" MinHeight="36" AutomationProperties.AutomationId="ManageHomeShortcuts" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="我的快捷" Style="{StaticResource HomeSection}" Margin="0" /><TextBlock x:Name="HomeShortcutCount" Foreground="#8A9891" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
            </DockPanel>
            <Border x:Name="HomeShortcutEmpty" Style="{StaticResource Surface}" Padding="16">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="＋ 添加快捷" Background="#EAF6F2" Foreground="#147D68" IsEnabled="{Binding IsEnabled, ElementName=AddShortcutButton}" Click="AddShortcutClicked" AutomationProperties.AutomationId="HomeAddShortcut" Margin="12,0,0,0" />
                <StackPanel VerticalAlignment="Center"><TextBlock Text="添加常用软件、课件或网址" FontSize="14" TextWrapping="Wrap" /><TextBlock Text="保存后同步到侧边栏。" FontSize="12" Foreground="#718089" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
              </DockPanel>
            </Border>
            <ItemsControl x:Name="HomeShortcutItems" Margin="0,0,-10,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Loaded="HomeShortcutsLoaded" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding}" ContentTemplate="{StaticResource ShortcutContent}" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#E5EBE7" Margin="0,0,10,10" Padding="12" MinHeight="64" ToolTip="{Binding Tip}" Click="OpenShortcutClicked" AutomationProperties.AutomationId="{Binding OpenId}" AutomationProperties.Name="{Binding Name}" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="HomeShortcutMessage" Margin="0,0,0,14" FontSize="12" Foreground="#718089" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeShortcutMessage">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <DockPanel Margin="0,8,0,10">
              <TextBlock DockPanel.Dock="Right" Text="选择工具，打开独立窗口" Foreground="#8A9891" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0" />
              <TextBlock Text="课堂工具" Style="{StaticResource HomeSection}" Margin="0" />
            </DockPanel>
            <UniformGrid x:Name="HomeToolsGrid" Columns="2" Margin="0,0,-10,12">
              <Button x:Name="RecordingHomeButton" Style="{StaticResource HomeTool}" Click="OpenRecordingClicked" AutomationProperties.AutomationId="OpenRecording" AutomationProperties.Name="录制微课">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EAF6F2" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Foreground="#147D68" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="录制微课" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock x:Name="RecordingHomeStatus" Text="准备录制" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="RecordingHomeStatus" /><TextBlock x:Name="RecordingHomeAction" Text="配置与录制  →" Foreground="#147D68" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HomeTool}" Click="OpenRecordingPlanClicked" AutomationProperties.AutomationId="HomeRecordingPlan" AutomationProperties.Name="自动录课计划">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EAF6F2" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#147D68" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="自动录课计划" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="按课表、周期或日期安排录制" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HomeTool}" Click="OpenSecRandomClicked" AutomationProperties.AutomationId="HomeOpenSecRandom" AutomationProperties.Name="课堂点名">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EAF6F2" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="#147D68" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="课堂点名" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="SecRandom 连接与闪抽" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HomeTool}" Click="OpenNoiseClicked" AutomationProperties.AutomationId="HomeOpenNoise" AutomationProperties.Name="噪音监测">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EAF6F2" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Foreground="#147D68" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="噪音监测" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="查看信号电平与统计报告" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HomeTool}" Click="OpenExamAwareClicked" AutomationProperties.AutomationId="HomeOpenExamAware" AutomationProperties.Name="考试看板">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EAF6F2" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="#147D68" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="考试看板" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="ExamAware2 连接与管理" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HomeTool}" Click="HomeSchoolConnectionClicked" AutomationProperties.AutomationId="HomeSchoolConnection" AutomationProperties.Name="学校互联">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EAF6F2" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="#147D68" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="学校互联" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="NPEP 配对、通知与远程安排" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Button>
            </UniformGrid>
            <TextBlock Text="课堂辅助状态" Style="{StaticResource HomeSection}" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Surface}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="ClassIsland" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Foreground="#526A60" FontSize="13" Margin="0,10,0,4" TextWrapping="Wrap"><Run Text="{Binding Subject, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding State, Mode=OneWay}" /></TextBlock>
                  <TextBlock Text="{Binding Connection}" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.AutomationId="Connection" />
                  <WrapPanel><Button x:Name="StartButton" Content="启动" Padding="14,8" Click="StartClicked" AutomationProperties.AutomationId="StartClassIsland" Margin="0,0,6,0" /><Button Content="连接设置" Style="{StaticResource Quiet}" Click="ConnectionsSettingsClicked" AutomationProperties.AutomationId="OpenConnectionSettings" Padding="10,8" /></WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="触摸翻页" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="PowerPoint 动画与幻灯片" Foreground="#718089" FontSize="12" Margin="0,10,0,4" TextWrapping="Wrap" />
                  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Ellipse x:Name="TouchStatusDot" Fill="#9BA8AD" Width="6" Height="6" Margin="0,5,8,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="TouchStatusText" Grid.Column="1" Text="正在连接后台…" Foreground="#718089" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="TouchStatus" />
                  </Grid>
                  <WrapPanel><Button x:Name="TouchPowerButton" Content="开启辅助" Style="{StaticResource Primary}" Padding="14,8" Margin="0,0,6,0" IsEnabled="False" Click="TouchPowerClicked" AutomationProperties.AutomationId="TouchPower" /><Button x:Name="TouchPauseButton" Content="暂停辅助" Padding="12,8" Click="TouchPauseClicked" Visibility="Collapsed" AutomationProperties.AutomationId="TouchPause" /></WrapPanel>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ShortcutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel>
            <TextBlock Text="快捷启动" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="常用软件、课件与网站，放在顺手的位置。" Foreground="#7B8991" FontSize="13" Margin="0,8,0,24" TextWrapping="Wrap" />
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="AddShortcutButton" DockPanel.Dock="Right" Content="＋ 添加" Style="{StaticResource Primary}" Click="AddShortcutClicked" AutomationProperties.AutomationId="AddShortcut" />
              <TextBlock x:Name="ShortcutCount" FontSize="12" Foreground="#718089" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Surface}" Padding="16">
              <StackPanel>
                <StackPanel x:Name="ShortcutEmpty" Margin="12,24">
                  <TextBlock Text="从一个常用入口开始" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="添加教学软件、当天课件或教学平台网址。保存后会同步到主页面和贴边面板。" FontSize="13" Foreground="#718089" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
                <ListBox x:Name="ShortcutList" BorderThickness="0" Background="Transparent" SelectionChanged="ShortcutSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ShortcutList">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="SelectionSurface" Background="#F7F9FA" CornerRadius="10" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionSurface" Property="Background" Value="#EAF6F2" /><Setter TargetName="SelectionSurface" Property="BorderBrush" Value="#147D68" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectionSurface" Property="BorderBrush" Value="#147D68" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                  </Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ShortcutContent}" HorizontalContentAlignment="Stretch" />
                        <TextBlock Text="{Binding Target}" FontSize="11" Foreground="#7B8991" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" Margin="46,6,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="打开" Padding="12,8" Click="OpenShortcutClicked" AutomationProperties.AutomationId="{Binding OpenId}" AutomationProperties.Name="{Binding Name}" />
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="EditShortcutButton" Content="编辑" Click="EditShortcutClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="EditShortcut" />
                  <Button x:Name="MoveShortcutUp" Content="上移" Click="MoveShortcutClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="MoveShortcutUp" />
                  <Button x:Name="MoveShortcutDown" Content="下移" Click="MoveShortcutClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="MoveShortcutDown" />
                  <Button x:Name="RemoveShortcutButton" Content="移除" Style="{StaticResource Quiet}" Click="RemoveShortcutClicked" AutomationProperties.AutomationId="RemoveShortcut" />
                </WrapPanel>
                <TextBlock Text="先选中一项，再编辑或调整顺序。移除入口会保留原文件。" FontSize="11" Foreground="#7B8991" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ShortcutMessage" FontSize="13" Foreground="#147D68" TextWrapping="Wrap" AutomationProperties.AutomationId="ShortcutMessage" />
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="RepairShortcutButton" Content="编辑此项" Click="RepairShortcutClicked" Visibility="Collapsed" AutomationProperties.AutomationId="RepairShortcut" Margin="0,0,8,0" />
              <Button x:Name="UndoShortcutDelete" Content="撤销移除" Click="UndoShortcutClicked" Visibility="Collapsed" AutomationProperties.AutomationId="UndoShortcutDelete" Margin="0,0,8,0" />
              <Button Content="重新读取" Style="{StaticResource Quiet}" Click="ReloadShortcutsClicked" AutomationProperties.AutomationId="ReloadShortcuts" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,20">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="调整应用偏好，配置课堂工具与外部软件。" Foreground="#64776D" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="GeneralSettingsTab" Content="常规" Tag="active" Style="{StaticResource Navigation}" Click="GeneralSettingsClicked" AutomationProperties.AutomationId="GeneralSettingsTab" Margin="0,0,8,0" />
            <Button x:Name="TeachingSettingsTab" Content="课堂工具" Style="{StaticResource Navigation}" Click="TeachingSettingsClicked" AutomationProperties.AutomationId="TeachingSettingsTab" Margin="0,0,8,0" />
            <Button x:Name="ConnectionsSettingsTab" Content="软件连接" Style="{StaticResource Navigation}" Click="ConnectionsSettingsClicked" AutomationProperties.AutomationId="ConnectionsSettingsTab" />
            <Button x:Name="NpepSettingsTab" Content="学校互联" Style="{StaticResource Navigation}" Click="NpepSettingsClicked" AutomationProperties.AutomationId="NpepSettingsTab" Margin="8,0,0,0" />
          </StackPanel>
          <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel>
            <StackPanel x:Name="NpepSettingsPanel" Visibility="Collapsed">
              <Border Style="{StaticResource Surface}" Background="#EAF6F2"><StackPanel>
                <TextBlock Text="NPEP · 学校互联" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="连接 NPClassworks，让学校管理员了解这台大屏的课堂模式与软件连接状态。" TextWrapping="Wrap" Foreground="#526A60" Margin="0,8,0,0" />
                <TextBlock Text="配对后共享设备状态并接收学校通知，支持远程考试 / 日常模式（含登录自启动）、考试方案和噪音监测联动。监测仅上传统计，不上传原音频；不会上传屏幕、录课文件或完整课表。" TextWrapping="Wrap" Foreground="#526A60" FontSize="12" Margin="0,8,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Surface}"><local:NpepConnectionControl x:Name="SettingsSchoolConnection" /></Border>
              <Border Style="{StaticResource Surface}"><StackPanel>
                <TextBlock Text="远程考试模式" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="RemoteExamBinding" Text="正在读取当前学校绑定…" TextWrapping="Wrap" Foreground="#526A60" Margin="0,8,0,12" />
                <TextBlock Text="学校配对即授权考试控制：切换考试／日常模式（含登录自启动）、投递方案及明确请求开始放映。" TextWrapping="Wrap" />
                <TextBlock Text="解绑或学校撤销设备后停止接收新请求。" Margin="0,12,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ExamPlanPolicyMessage" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#607078" />
                <TextBlock Text="学校切入考试时优先执行：正常保存当前录制，暂时收起通知，关闭 ClassIsland 登录自启动、开启 ExamAware2 登录自启动，准备考试看板并退出 ClassIsland。重复请求会核对实际状态、补做缺失步骤，已有放映保留。" TextWrapping="Wrap" Foreground="#526A60" Margin="0,8,0,8" />
                <TextBlock Text="学校也可远程返回日常：恢复日常自启动，正常退出 ExamAware2，等待 ClassIsland 就绪后解除远程录课暂停。放映或编辑器阻止退出时保留暂停并报告原因。" TextWrapping="Wrap" Foreground="#526A60" Margin="0,0,0,8" />
                <TextBlock x:Name="RemoteExamPolicyMessage" Text="正在读取 N3 通道状态…" TextWrapping="Wrap" Foreground="#64776D" />
                <TextBlock x:Name="RemoteExamRuntimeMessage" Text="正在读取本地考试状态…" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="此项仅表示当前远程录课暂停，不代表 ExamAware2 或 ClassIsland 的运行状态；历史回执另列在下方。" TextWrapping="Wrap" Foreground="#64776D" Margin="0,6,0,0" />
                <Expander x:Name="RemoteExamRuntimeDetailsPanel" Header="当前暂停详情" Visibility="Collapsed" Margin="0,8,0,0">
                  <TextBox x:Name="RemoteExamRuntimeDetails" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontSize="12" Padding="0,6" AutomationProperties.AutomationId="RemoteExamRuntimeDetails" />
                </Expander>
                <TextBlock Text="检查后台权限、程序位置、录制状态和软件连接。仅检查当前环境，不会启动或退出软件，也不会修改 Windows 自启动。" TextWrapping="Wrap" Foreground="#526A60" Margin="0,8,0,12" />
                <Button x:Name="RemoteExamCheckButton" Content="检查考试环境" Click="RemoteExamCheckClicked" HorizontalAlignment="Left" AutomationProperties.AutomationId="RemoteExamPreflight" />
                <TextBlock x:Name="RemoteExamCheckMessage" Text="本机检查不代表已授权学校远程控制。" TextWrapping="Wrap" Foreground="#64776D" Margin="0,10,0,0" />
                <Expander x:Name="RemoteExamCheckDetailsPanel" Header="技术详情（请求编号与后台说明）" Visibility="Collapsed" Margin="0,8,0,0">
                  <TextBox x:Name="RemoteExamCheckDetails" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontSize="12" Padding="0,6" AutomationProperties.AutomationId="RemoteExamCheckDetails" />
                </Expander>
                <Button x:Name="RemoteExamEndButton" Content="解除本次远程录课暂停" Click="RemoteExamEndClicked" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.AutomationId="RemoteExamEndLocal" />
                <TextBlock Text="考试结束后，先在“课堂模式”返回日常（可同时切换软件）；失败时先恢复切换前设置。再在此核实并解除远程录课暂停，当前课时可能按原计划开始录制。" TextWrapping="Wrap" Foreground="#64776D" Margin="0,8,0,0" />
                <Expander Header="最近操作记录（历史回执）" Margin="0,12,0,0"><local:RemoteExamHistoryView x:Name="RemoteExamHistory" /></Expander>
              </StackPanel></Border>
              <Border Style="{StaticResource Surface}"><StackPanel>
                <TextBlock Text="学校通知" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="NotificationInboxMessage" Text="正在读取通知状态…" TextWrapping="Wrap" Foreground="#526A60" Margin="0,8,0,10" AutomationProperties.AutomationId="NotificationInboxMessage" />
                <ItemsControl x:Name="NotificationInboxItems"><ItemsControl.ItemTemplate><DataTemplate>
                  <Button Tag="{Binding}" Click="OpenSchoolNotificationClicked" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.Name="{Binding Title}">
                    <StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="15" /><TextBlock Text="{Binding DisplayLabel}" FontSize="12" Foreground="#64776D" Margin="0,4,0,0" /></StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button x:Name="NotificationPrevious" Content="上一页" Click="NotificationPreviousClicked" IsEnabled="False" Margin="0,0,8,0" /><Button x:Name="NotificationNext" Content="下一页" Click="NotificationNextClicked" IsEnabled="False" /></StackPanel>
                <TextBlock Text="窗口样式预览" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="纯色、大字号，保持置顶直到手动关闭。请关闭当前预览后再查看其他级别。" TextWrapping="Wrap" Foreground="#526A60" Margin="0,8,0,0" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="次要 · 绿色" Tag="Minor" Background="#087F5B" Foreground="White" Click="NotificationPreviewClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="PreviewMinorNotification" />
                  <Button Content="普通 · 蓝色" Tag="Normal" Background="#2157B8" Foreground="White" Click="NotificationPreviewClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="PreviewNormalNotification" />
                  <Button Content="重要 · 黄色" Tag="Important" Background="#947000" Foreground="White" Click="NotificationPreviewClicked" Margin="0,0,8,8" AutomationProperties.AutomationId="PreviewImportantNotification" />
                  <Button Content="紧急 · 红色" Tag="Urgent" Background="#C52B36" Foreground="White" Click="NotificationPreviewClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="PreviewUrgentNotification" />
                </WrapPanel>
                <TextBlock Text="以上四个按钮仅预览样式，不会发送学校通知或回执。真实接收情况以上方通知状态为准。" TextWrapping="Wrap" FontSize="12" Foreground="#64776D" />
              </StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="GeneralSettingsPanel">
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="NPEduTools 启动" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox x:Name="LoginStartupToggle" Style="{StaticResource Switch}" Content="登录 Windows 时启动 NPEduTools" Checked="LoginStartupChanged" Unchecked="LoginStartupChanged" AutomationProperties.AutomationId="LoginStartup" />
                <TextBlock x:Name="LoginStartupMessage" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.AutomationId="LoginStartupMessage" />
                <Button Content="Windows 启动应用 ↗" Style="{StaticResource Quiet}" HorizontalAlignment="Left" FontSize="12" MinHeight="36" Padding="0,6" Click="OpenWindowsStartupClicked" />
                <Border Height="1" Background="#EEF2F3" Margin="0,12,0,16" />
                <CheckBox x:Name="EdgeOnlyAtLogin" Style="{StaticResource Switch}" Content="自启动时仅显示贴边入口" Checked="StartupPreferenceChanged" Unchecked="StartupPreferenceChanged" AutomationProperties.AutomationId="EdgeOnlyAtLogin" />
                <TextBlock Text="手动打开程序时，仍会显示主窗口。" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16" />

              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="快捷入口" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="选择顺手的一侧，拖动侧边栏顶部的图标调整高度。" TextWrapping="Wrap" Foreground="#7B8991" FontSize="12" Margin="0,6,0,16" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="DockLeft" Content="屏幕左侧" GroupName="EntrySide" Style="{StaticResource PositionChoice}" Checked="DockLeftClicked" Margin="0,0,6,0" AutomationProperties.AutomationId="DockLeft" />
                  <RadioButton x:Name="DockRight" Content="屏幕右侧" GroupName="EntrySide" Style="{StaticResource PositionChoice}" Checked="DockRightClicked" Grid.Column="1" Margin="6,0,0,0" AutomationProperties.AutomationId="DockRight" />
                </Grid>
                <TextBlock Text="更改即时生效，位置会在下次启动时保留。" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}"><DockPanel>
              <Button Content="打开初始设置" DockPanel.Dock="Right" Click="OpenOnboardingClicked" AutomationProperties.AutomationId="OpenOnboarding" Margin="16,0,0,0" />
              <StackPanel><TextBlock Text="配置向导" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="重新检查连接、录课与快捷入口。" FontSize="12" Foreground="#64776D" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
            </DockPanel></Border>
            </StackPanel>
            <StackPanel x:Name="TeachingSettingsPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="PowerPoint 触摸翻页" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox x:Name="AutoTouchAtLaunch" Style="{StaticResource Switch}" Content="启动时开启触摸翻页" Checked="StartupPreferenceChanged" Unchecked="StartupPreferenceChanged" AutomationProperties.AutomationId="AutoTouchAtLaunch" />
                <TextBlock Text="后台就绪后开启 PowerPoint 辅助，可随时从贴边入口暂停或停止。" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Border Height="1" Background="#EEF2F3" Margin="0,16" />
                <CheckBox x:Name="TouchCompatibility" Style="{StaticResource Switch}" Content="兼容未标记的触摸" Checked="TouchCompatibilityChanged" Unchecked="TouchCompatibilityChanged" AutomationProperties.AutomationId="TouchCompatibility" />
                <TextBlock Text="仅在轻点无效时尝试。开启后也会响应普通鼠标。" Foreground="#7B8991" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}"><StackPanel>
              <TextBlock Text="微课录制" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="画质、声音与保存位置在录制窗口中设置；周期性与指定日期的安排在自动录课计划中管理。" TextWrapping="Wrap" Foreground="#64776D" FontSize="12" Margin="0,8,0,16" />
              <WrapPanel><Button Content="录制设置" Click="OpenRecordingClicked" Margin="0,0,8,8" /><Button Content="自动录课计划" Click="OpenRecordingPlanClicked" Margin="0,0,0,8" /></WrapPanel>
