<Window x:Class="NPEduTools.App.MainWindow" xmlns:local="clr-namespace:NPEduTools.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/npedutools.ico" Title="NPEduTools" Width="1040" Height="760" MinWidth="840" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource TeacherPageBrush}" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="{DynamicResource SettingsBodyFont}" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SidebarNavigation" TargetType="Button" BasedOn="{StaticResource TeacherNavigation}">
      <Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="14" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" /></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="#B7C6BE" CornerRadius="3" Margin="4,0" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#718C7E" /></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#147D68" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" /></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderBrush" Value="#E5EBE7" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="22" /><Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style x:Key="HomeTool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E5EBE7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="112" /><Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ToolSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToolSurface" Property="Background" Value="#F0F7F3" /><Setter TargetName="ToolSurface" Property="BorderBrush" Value="#B4D4C5" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToolSurface" Property="Background" Value="#E2F0E9" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToolSurface" Property="BorderBrush" Value="#147D68" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToolSurface" Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HomeSection" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TeacherTextBrush}" /><Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="WorkspaceNavColumn" Width="164" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,0,1,0">
      <Grid x:Name="WorkspaceSidebar" Margin="12,24,12,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="WorkspaceBrand" Margin="6,0,0,0">
          <Image Source="{StaticResource BrandLogoSmall}" Width="40" Height="40" HorizontalAlignment="Left" AutomationProperties.Name="NPEduTools 标志" />
          <TextBlock Text="NPEduTools" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="Segoe UI" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,4" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,12"><StackPanel>
          <TextBlock Text="工作空间" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="14,0,0,8" />
          <Button x:Name="HomeNav" Tag="active" Style="{StaticResource SidebarNavigation}" Click="HomeNavClicked" AutomationProperties.AutomationId="HomeTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="主页" /></StackPanel>
          </Button>
          <Button x:Name="ShortcutNav" Style="{StaticResource SidebarNavigation}" Click="ShortcutNavClicked" AutomationProperties.AutomationId="ShortcutsTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="快捷启动" /></StackPanel>
          </Button>
          <Button x:Name="StudyNav" Style="{StaticResource SidebarNavigation}" Click="StudyNavClicked" AutomationProperties.AutomationId="StudyTab"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="自习"/></StackPanel></Button>
          <Button x:Name="SettingsNav" Style="{StaticResource SidebarNavigation}" Click="SettingsNavClicked" AutomationProperties.AutomationId="SettingsTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="设备与连接" /></StackPanel>
          </Button>
          <TextBlock Text="课堂工具" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="14,16,0,8" />
          <Button x:Name="RecordingNav" Content="录课" Style="{StaticResource SidebarNavigation}" Click="RecordingNavClicked" AutomationProperties.AutomationId="RecordingNav" />

          <Button Content="考试看板" Style="{StaticResource SidebarNavigation}" Click="OpenExamAwareClicked" AutomationProperties.AutomationId="OpenExamAware" />
          <Button Content="课堂点名" ToolTip="SecRandom 连接与闪抽" Style="{StaticResource SidebarNavigation}" Click="OpenSecRandomClicked" AutomationProperties.AutomationId="OpenSecRandom" />

          <Button Content="课堂模式" Style="{StaticResource SidebarNavigation}" Click="OpenClassroomModeClicked" AutomationProperties.AutomationId="OpenClassroomMode" />
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2">
          <Button x:Name="AboutNav" Style="{StaticResource SidebarNavigation}" Click="AboutNavClicked" AutomationProperties.AutomationId="AboutTab">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="关于" /></StackPanel>
          </Button>
          <Button Content="展开侧边栏  ↗" Style="{StaticResource SidebarNavigation}" Click="OpenQuickClicked" AutomationProperties.AutomationId="OpenQuick" />
          <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="12,8" />
          <Button x:Name="ExitButton" Content="退出后台" Style="{StaticResource SidebarNavigation}" FontSize="12" Click="StopClicked" AutomationProperties.AutomationId="StopHost" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition /></Grid.RowDefinitions>
      <Grid Margin="28,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="&#xE700;" FontFamily="Segoe MDL2 Assets" ToolTip="展开或折叠导航" Click="FoldWorkspaceSidebarClicked" Style="{DynamicResource TeacherQuiet}" Width="44" Padding="0" Margin="0,0,10,0" AutomationProperties.AutomationId="FoldWorkspaceSidebar" AutomationProperties.Name="展开或折叠导航"/>
          <TextBlock Text="工作空间" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="／" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="8,0" VerticalAlignment="Center" /><TextBlock x:Name="PageBreadcrumb" Text="主页" Foreground="{DynamicResource TeacherTextBrush}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="−" ToolTip="收起到侧边栏" Style="{DynamicResource TeacherQuiet}" Width="44" Padding="0" FontSize="20" Click="MinimizeClicked" AutomationProperties.AutomationId="MinimizeWindow" AutomationProperties.Name="收起到侧边栏" />
          <Button Content="×" ToolTip="关闭窗口，保留侧边栏" Style="{DynamicResource TeacherQuiet}" Width="44" Padding="0" FontSize="22" Click="CloseClicked" AutomationProperties.AutomationId="CloseWindow" AutomationProperties.Name="关闭主窗口" />
        </StackPanel>
      </Grid>
      <Grid x:Name="Pages" Grid.Row="1" Margin="28,12,28,22">
        <Grid x:Name="RecordingWorkspace" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12">
            <Button x:Name="RecordingManualTab" Content="立即录制" Style="{DynamicResource TeacherTab}" Click="RecordingManualTabClicked" AutomationProperties.AutomationId="RecordingManualTab" Margin="0,0,8,0"/>
            <Button x:Name="RecordingPlanTab" Content="自动安排" Style="{DynamicResource TeacherTab}" Click="RecordingPlanTabClicked" AutomationProperties.AutomationId="RecordingPlanTab" Margin="0,0,8,0"/>
            <Button x:Name="RecordingRecordsTab" Content="录制记录" Style="{DynamicResource TeacherTab}" Click="RecordingRecordsTabClicked" AutomationProperties.AutomationId="RecordingRecordsTab"/>
          </WrapPanel>
          <Grid Grid.Row="1"><ContentControl x:Name="RecordingManualHost"/><ContentControl x:Name="RecordingPlanHost" Visibility="Collapsed"/></Grid>
        </Grid>
        <Grid x:Name="StudyWorkspace" Visibility="Collapsed">
          <Grid.Resources>
            <ResourceDictionary Source="Resources/StudyWorkspaceReports.xaml" />
          </Grid.Resources>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12">
            <Button x:Name="ManualWorkspaceTab" Content="手动自习" Click="ManualWorkspaceClicked" Style="{DynamicResource TeacherTab}" AutomationProperties.AutomationId="ManualWorkspaceTab" Margin="0,0,8,4"/>
            <Button x:Name="SchoolWorkspaceTab" Content="学校定时自习" Click="SchoolWorkspaceClicked" Style="{DynamicResource TeacherTab}" AutomationProperties.AutomationId="SchoolWorkspaceTab" Margin="0,0,8,4"/>
            <Button x:Name="ReportWorkspaceTab" Content="报告" Click="ReportWorkspaceClicked" Style="{DynamicResource TeacherTab}" AutomationProperties.AutomationId="ReportWorkspaceTab" Margin="0,0,0,4"/>
          </WrapPanel>
          <Grid Grid.Row="1">
            <ContentControl x:Name="ManualWorkspaceHost" Visibility="Collapsed"/>
            <ContentControl x:Name="SchoolWorkspaceHost" Visibility="Collapsed"/>
            <DockPanel x:Name="WorkspaceReports" Visibility="Collapsed" TextElement.FontFamily="{DynamicResource TeacherFont}"
                       TextElement.Foreground="{DynamicResource TeacherTextBrush}">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button x:Name="WorkspaceRefreshReports" Content="刷新报告" Click="RefreshWorkspaceReportsClicked"
                        Style="{DynamicResource TeacherButton}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0"
                        AutomationProperties.AutomationId="WorkspaceRefreshReports" />
                <TextBlock Text="本机最近报告" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
              </DockPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            PanningMode="VerticalOnly" AutomationProperties.Name="本机自习报告">
                <ScrollViewer.Resources>
                  <!-- Use the system scrollbar and its high-contrast colors. -->
                  <Style TargetType="ScrollBar" />
                </ScrollViewer.Resources>
                <StackPanel>
                  <ContentControl x:Name="WorkspaceSchoolReport" ContentTemplate="{StaticResource StudyWorkspaceReport}"
                                  AutomationProperties.AutomationId="WorkspaceSchoolReport" />
                  <ContentControl x:Name="WorkspaceManualReport" ContentTemplate="{StaticResource StudyWorkspaceReport}"
                                  AutomationProperties.AutomationId="WorkspaceManualReport" />
                  <TextBlock Text="学校历史报告和上传状态请在 NPClassworks 后台查看。"
                             Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Grid>
          <Border Grid.Row="2" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><WrapPanel>
            <Button Content="设备与校准" Click="WorkspaceDevicesClicked" Style="{DynamicResource TeacherQuiet}" Margin="0,0,8,0"/>
            <Button Content="联机校准 (Beta) →" Click="WorkspaceCalibrationClicked" Style="{DynamicResource TeacherQuiet}"/>
          </WrapPanel></Border>
        </Grid>
        <Grid x:Name="WorkspaceCalibration" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Button Content="← 返回自习" Click="ReturnFromCalibrationClicked" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="0,0,0,10"/><ContentControl x:Name="WorkspaceCalibrationHost" Grid.Row="1"/></Grid>
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel SizeChanged="HomeLayoutSizeChanged">
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="课堂工作台" FontSize="27" FontWeight="SemiBold" />
              <TextBlock x:Name="TodayText" Grid.Column="1" ToolTip="本机日期；自动录课使用 ClassIsland 校准后的时间。" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
            <TextBlock x:Name="HomeMessage" Foreground="#7D602B" Background="#FFF5E6" Padding="12,10" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.AutomationId="HomeMessage">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Border Style="{DynamicResource SettingsGroupSurface}" Padding="16,12" Margin="0,0,0,10"><StackPanel>
              <TextBlock Text="当前任务" Style="{StaticResource HomeSection}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource TeacherMutedBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                  <TextBlock x:Name="WorkspaceTaskTitle" Text="自习状态待确认" Style="{DynamicResource SettingsLabel}" />
                  <TextBlock x:Name="StudyHomeStatus" Text="正在读取后台状态" Style="{DynamicResource SettingsHint}" AutomationProperties.AutomationId="StudyHomeStatus" />
                </StackPanel>
                <Button x:Name="WorkspacePrimary" Grid.Column="2" Content="进入自习" Click="WorkspacePrimaryClicked" Style="{DynamicResource TeacherPrimary}" MinHeight="57" VerticalAlignment="Center" AutomationProperties.AutomationId="HomeStudyPrimary" />
              </Grid>
              <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource TeacherMutedBrush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <DockPanel>
                      <TextBlock x:Name="HomeRecordingPhaseMark" Margin="0,0,5,0" FontSize="14" VerticalAlignment="Center" />
                      <TextBlock x:Name="RecordingHomeTitle" Text="录课状态待确认" Style="{DynamicResource SettingsLabel}" />
                    </DockPanel>
                    <TextBlock x:Name="RecordingHomeStatus" Text="正在读取后台状态" Style="{DynamicResource SettingsHint}" AutomationProperties.AutomationId="RecordingHomeStatus" />
                  </StackPanel>
                  <Button x:Name="RecordingHomeButton" Grid.Column="2" Click="HomeRecordingPrimaryClicked" Style="{DynamicResource TeacherButton}" MinHeight="57" VerticalAlignment="Center" AutomationProperties.AutomationId="OpenRecording" AutomationProperties.Name="录课">
                    <TextBlock x:Name="RecordingHomeAction" Text="进入录课" />
                  </Button>
                </Grid>
              </Border>
            </StackPanel></Border>
            <Border Style="{DynamicResource SettingsGroupSurface}" Padding="16,12" Margin="0,0,0,10"><StackPanel>
              <TextBlock Text="接下来的安排" Style="{StaticResource HomeSection}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="学校自习" Style="{DynamicResource SettingsLabel}"/><TextBlock x:Name="StudyHomeNext" Text="学校安排待确认" Style="{DynamicResource SettingsHint}" AutomationProperties.AutomationId="StudyHomeNext"/></StackPanel>
                <Button Grid.Column="1" Content="查看安排" Click="OpenStudyMonitoringClicked" Style="{DynamicResource TeacherQuiet}" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="下一节自动录课" Style="{DynamicResource SettingsLabel}"/><TextBlock x:Name="HomeRecordingNext" Text="录课安排待确认" Style="{DynamicResource SettingsHint}" AutomationProperties.AutomationId="HomeRecordingNext"/></StackPanel>
                <Button Grid.Column="1" Content="查看安排" Click="OpenRecordingPlanClicked" Style="{DynamicResource TeacherQuiet}" VerticalAlignment="Center" AutomationProperties.AutomationId="HomeRecordingPlan"/>
              </Grid>
            </StackPanel></Border>
            <Border x:Name="ClassroomModeCard" Style="{DynamicResource SettingsGroupSurface}" Padding="16,8" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                  <TextBlock x:Name="ClassroomModeTitle" Text="课堂模式 · 正在连接…" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeClassroomModeTitle" />
                  <Expander x:Name="HomeClassroomModeDetails" Header="模式详情" FontSize="12"><TextBlock x:Name="ClassroomModeDetail" TextWrapping="Wrap" FontSize="12" Foreground="#64776D" AutomationProperties.AutomationId="HomeClassroomModeDetail" /></Expander>
                </StackPanel>
                <Button Grid.Column="1" Content="管理模式" Style="{DynamicResource TeacherQuiet}" Click="OpenClassroomModeClicked" VerticalAlignment="Center" AutomationProperties.AutomationId="HomeClassroomMode" />
              </Grid>
            </Border>
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="查看全部" Style="{DynamicResource TeacherQuiet}" Click="ShortcutNavClicked" AutomationProperties.AutomationId="ManageHomeShortcuts" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="我的快捷" Style="{StaticResource HomeSection}" Margin="0" /><TextBlock x:Name="HomeShortcutCount" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
            </DockPanel>
            <Border x:Name="HomeShortcutEmpty" Style="{DynamicResource SettingsGroupSurface}" Padding="16,8" Margin="0,0,0,12">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="添加快捷" Style="{DynamicResource TeacherButton}" IsEnabled="{Binding IsEnabled, ElementName=AddShortcutButton}" Click="AddShortcutClicked" AutomationProperties.AutomationId="HomeAddShortcut" Margin="12,0,0,0" />
                <TextBlock Text="添加常用软件、课件或网址" Style="{DynamicResource SettingsHint}" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ItemsControl x:Name="HomeShortcutItems" Margin="0,0,-10,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Loaded="HomeShortcutsLoaded" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding}" ContentTemplate="{StaticResource ShortcutContent}" Style="{DynamicResource TeacherButton}" HorizontalContentAlignment="Stretch" Margin="0,0,10,10" Padding="12" MinHeight="64" ToolTip="{Binding Tip}" Click="OpenShortcutClicked" AutomationProperties.AutomationId="{Binding OpenId}" AutomationProperties.Name="{Binding Name}" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="HomeShortcutMessage" Margin="0,0,0,14" FontSize="12" Foreground="#718089" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeShortcutMessage">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="课堂工具" Style="{StaticResource HomeSection}" Margin="0,8,0,10" />
            <UniformGrid x:Name="HomeToolsGrid" Columns="2" Margin="0,0,-10,12">
              <Button Style="{StaticResource HomeTool}" Click="OpenSecRandomClicked" AutomationProperties.AutomationId="HomeOpenSecRandom" AutomationProperties.Name="课堂点名">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EAF6F2" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="#147D68" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="课堂点名" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="SecRandom 连接与闪抽" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Button>

              <Button Style="{StaticResource HomeTool}" Click="OpenExamAwareClicked" AutomationProperties.AutomationId="HomeOpenExamAware" AutomationProperties.Name="考试看板">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EAF6F2" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="#147D68" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="考试看板" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="ExamAware2 连接与管理" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HomeTool}" Click="HomeSchoolConnectionClicked" AutomationProperties.AutomationId="HomeSchoolConnection" AutomationProperties.Name="学校互联">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="#EAF6F2" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="#147D68" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="学校互联" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="NPEP 配对、通知与远程安排" Foreground="#718089" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Button>
            </UniformGrid>

            <Expander Header="设备准备与课堂辅助" FontSize="14" Margin="0,8,0,0"><StackPanel>
            <Border Style="{StaticResource Surface}" Padding="16"><DockPanel>
              <Button DockPanel.Dock="Right" Content="设备与校准" Click="WorkspaceDevicesClicked" Style="{StaticResource Quiet}" Margin="12,0,0,0"/>
