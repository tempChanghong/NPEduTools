<Window x:Class="NPEduTools.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NPEduTools · 课堂状态" Width="820" Height="640" MinWidth="620" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="#F2F5F1" Foreground="#203831" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="36,8,36,24">
            <Button Content="停止后台并退出" Click="StopClicked" Margin="0,0,12,8" AutomationProperties.AutomationId="StopHost" />
            <Button Content="关闭窗口" Click="CloseClicked" Background="#286B51" Foreground="White"
                    BorderBrush="#286B51" Margin="0,0,0,8" AutomationProperties.AutomationId="CloseWindow" />
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="NPEduTools" FontSize="16" FontWeight="SemiBold" Foreground="#526B60" />
                <TextBlock Text="课堂状态" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,6" />
                <TextBlock Text="查看 ClassIsland 的当前课程与连接状态" FontSize="14" Foreground="#64786D" />
            </StackPanel>
            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="28" BorderBrush="#E0E7DF" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{Binding Accent}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding Connection}" Foreground="{Binding Accent}" FontSize="14"
                                   AutomationProperties.AutomationId="Connection" />
                    </StackPanel>
                    <TextBlock Text="{Binding State}" FontSize="18" Margin="0,28,0,6" AutomationProperties.AutomationId="LessonState" />
                    <TextBlock Text="{Binding Subject}" FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Subject" />
                    <TextBlock Text="{Binding Detail}" FontSize="14" Foreground="#64786D" Margin="0,18,0,0" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Detail" />
                    <Border Height="1" Background="#E5EBE4" Margin="0,24,0,18" />
                    <WrapPanel>
                        <TextBlock Text="{Binding LessonPlan}" FontSize="13" Foreground="#64786D" Margin="0,0,24,6" />
                        <TextBlock Text="{Binding Updated}" FontSize="13" Foreground="#64786D" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Events}" FontSize="12" Foreground="#64786D" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="2" Text="关闭窗口后，后台继续同步。重新打开即可查看最新状态。"
                       FontSize="12" Foreground="#64786D" Margin="2,18,0,20" TextWrapping="Wrap" />
        </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
