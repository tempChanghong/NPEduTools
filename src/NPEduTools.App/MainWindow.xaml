                <local:SettingsRow Style="{StaticResource SettingsRow}" Icon="M3,6 H8 M14,6 H21 M11,3 A3,3 0 1 1 10.99,3 Z M3,17 H13 M19,17 H21 M16,14 A3,3 0 1 1 15.99,14 Z">
                  <local:SettingsRow.Header><StackPanel>
                    <TextBlock Text="配置向导" Style="{StaticResource SettingsLabel}" />
                    <TextBlock Text="重新检查连接、录课与快捷入口。" Style="{StaticResource SettingsHint}" />
