                  <Button Content="打开初始设置" MinHeight="44" Style="{DynamicResource SettingsAction}" Click="OpenOnboardingClicked" AutomationProperties.AutomationId="OpenOnboarding" />
                </local:SettingsRow>
              </Border>
            </StackPanel>
            </StackPanel>
            <StackPanel x:Name="TeachingSettingsPanel" Visibility="Collapsed">
