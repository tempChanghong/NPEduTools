                  </StackPanel></local:SettingsRow.Header>
                  <ComboBox x:Name="DensityChoiceBox" Width="184" MinHeight="44" Style="{DynamicResource SettingsChoice}" DisplayMemberPath="Name" SelectedValuePath="Value"
                            SelectionChanged="DensityChanged" AutomationProperties.AutomationId="DesktopDensity" AutomationProperties.LabeledBy="{Binding ElementName=DensityLabel}" />
                </local:SettingsRow>
                <Border Height="1" Background="{DynamicResource SettingsLine}" />
                <local:SettingsRow Style="{StaticResource SettingsRow}" Icon="M4,4 H20 Q22,4 22,6 V18 Q22,20 20,20 H4 Q2,20 2,18 V6 Q2,4 4,4 Z M8,4 V20 M4.5,8 H5.5 M4.5,11 H5.5">
