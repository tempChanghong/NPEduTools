                  <Button x:Name="AdminCreate" Content="启用管理员自启动" Style="{StaticResource TeacherPrimary}" Click="AdminCreateClicked" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="AdminCreate" />
                  <Button Style="{StaticResource TeacherButton}" x:Name="AdminDelete" Content="删除自启动任务" Click="AdminDeleteClicked" IsEnabled="False" Margin="0,0,0,8" AutomationProperties.AutomationId="AdminDelete" />
                </WrapPanel>
                <WrapPanel>
                  <Button Style="{StaticResource TeacherButton}" x:Name="AdminElevate" Content="管理员启动／重启" Click="AdminElevateClicked" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="AdminElevate" />
                  <Button x:Name="AdminRefresh" Content="刷新" Style="{StaticResource TeacherQuiet}" Click="AdminRefreshClicked" Margin="0,0,4,8" AutomationProperties.AutomationId="AdminRefresh" />
                  <Button x:Name="AdminInspect" Content="管理员检查" Style="{StaticResource TeacherQuiet}" Click="AdminInspectClicked" Margin="0,0,0,8" AutomationProperties.AutomationId="AdminInspect" />
                </WrapPanel>
                <TextBlock x:Name="AdminMessage" FontSize="13" Foreground="{DynamicResource TeacherAccentBrush}" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.AutomationId="AdminMessage" />
