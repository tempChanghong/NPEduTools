                </Grid.RowDefinitions>
                <Button x:Name="NotificationReaderBack" Grid.Row="0" Content="← 返回通知列表" Style="{DynamicResource TeacherQuiet}"
                        Click="NotificationReaderBackClicked" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed"
                        AutomationProperties.AutomationId="NotificationReaderBack" />
                <Border Grid.Row="1" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}" Padding="0">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Surface}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=NotificationReaderBody}" Value="">
                          <Setter Property="VerticalAlignment" Value="Top" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <ScrollViewer x:Name="NotificationReaderScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                PanningMode="VerticalOnly" Focusable="True" Padding="18,16">
                    <StackPanel TextElement.FontFamily="{DynamicResource TeacherFont}" TextElement.Foreground="{DynamicResource TeacherTextBrush}">
                      <TextBlock x:Name="NotificationReaderStatus" Text="选择一条通知查看正文。" FontSize="14" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap"
                                 Focusable="True" KeyboardNavigation.IsTabStop="False"
                                 AutomationProperties.AutomationId="NotificationReaderStatus" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock x:Name="NotificationReaderTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                 Focusable="True" KeyboardNavigation.IsTabStop="False"
                                 AutomationProperties.AutomationId="NotificationReaderTitle" AutomationProperties.HeadingLevel="Level2">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock x:Name="NotificationReaderMeta" Text="" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="NotificationReaderMeta">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,0,0,12" />
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock x:Name="NotificationReaderBody" Text="" FontSize="15" LineHeight="24" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="NotificationReaderBody" />
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </Grid>
                <TextBlock Grid.Row="3" x:Name="StartupPreferencesMessage" Foreground="#147D68" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="StartupPreferencesMessage" />
        </Grid>
        <local:AboutPage x:Name="AboutPageView" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Grid>
</Window>
