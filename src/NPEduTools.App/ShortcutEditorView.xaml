<UserControl x:Class="NPEduTools.App.ShortcutEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="Transparent" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="{DynamicResource TeacherFont}"
 PreviewKeyDown="EditorKeyDown" KeyboardNavigation.TabNavigation="Contained" UseLayoutRounding="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/RecordingControls.xaml" /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,12">
      <Button x:Name="BackButton" Click="CancelClicked" Style="{DynamicResource TeacherQuiet}"
              Padding="8,4" Margin="0,0,10,0" AutomationProperties.AutomationId="ShortcutEditorBack" AutomationProperties.Name="返回快捷启动列表">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock Text="返回列表" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock x:Name="Heading" Text="添加快捷启动" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                 AutomationProperties.HeadingLevel="Level2" />
    </WrapPanel>

    <ScrollViewer x:Name="EditorFormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                  AutomationProperties.Name="快捷启动表单">
      <Border Style="{DynamicResource SettingsGroupSurface}" Padding="16,14" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock x:Name="KindLabel" Text="类型" Style="{DynamicResource SettingsLabel}" Margin="0,0,0,6" />
          <ComboBox x:Name="KindBox" Style="{StaticResource RecordingChoice}" SelectedIndex="0" MinHeight="44"
           SelectionChanged="KindChanged" AutomationProperties.AutomationId="ShortcutKind" AutomationProperties.LabeledBy="{Binding ElementName=KindLabel}">
            <ComboBoxItem Content="应用" Tag="app" />
            <ComboBoxItem Content="文件" Tag="file" />
            <ComboBoxItem Content="网址" Tag="url" />
          </ComboBox>

          <TextBlock x:Name="NameLabel" Text="名称" Style="{DynamicResource SettingsLabel}" Margin="0,12,0,6" />
          <TextBox x:Name="NameBox" Style="{StaticResource TeacherInput}" MaxLength="40" AutomationProperties.AutomationId="ShortcutName"
           AutomationProperties.Name="快捷启动名称" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}" />

          <TextBlock x:Name="TargetLabel" Text="程序位置" Style="{DynamicResource SettingsLabel}" Margin="0,12,0,6" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" Style="{StaticResource TeacherInput}" MaxLength="2048" AutomationProperties.AutomationId="ShortcutTarget"
             AutomationProperties.LabeledBy="{Binding ElementName=TargetLabel}" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="选择…" Style="{DynamicResource TeacherButton}"
             Click="BrowseClicked" Margin="8,0,0,0" AutomationProperties.AutomationId="ShortcutBrowse" />
          </Grid>

          <TextBlock x:Name="Hint" Style="{DynamicResource SettingsHint}" Margin="0,6,0,0" />
          <TextBlock x:Name="ErrorText" Foreground="{DynamicResource TeacherErrorBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
           AutomationProperties.AutomationId="ShortcutEditorError" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Style="{DynamicResource TeacherQuiet}" Click="CancelClicked" Margin="0,0,8,0"
                AutomationProperties.AutomationId="ShortcutCancel" />
        <Button x:Name="SaveButton" Content="保存" Style="{DynamicResource TeacherPrimary}" Click="SaveClicked"
                AutomationProperties.AutomationId="ShortcutSave" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
