<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="SettingsText" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="SettingsBackdrop" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="SettingsSecondaryText" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="SettingsSurface" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="SettingsLine" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="SettingsControlLine" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
  <SolidColorBrush x:Key="SettingsTrack" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />

  <!-- Windows supplies the selection indicator, popup, keyboard focus and disabled states. -->
  <Style x:Key="SettingsChoice" TargetType="ComboBox">
    <Setter Property="ItemContainerStyle"><Setter.Value>
      <Style TargetType="ComboBoxItem"><Setter Property="MinHeight" Value="44" /></Style>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsSegment" TargetType="RadioButton">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="SettingsAction" TargetType="Button"><Setter Property="Padding" Value="14,6" /></Style>
</ResourceDictionary>
