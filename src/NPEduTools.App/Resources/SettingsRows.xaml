<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:NPEduTools.App">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="RecordingControls.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="SettingsText" Color="#202522" />
  <SolidColorBrush x:Key="SettingsBackdrop" Color="Transparent" />
  <SolidColorBrush x:Key="SettingsSecondaryText" Color="#59675F" />
  <SolidColorBrush x:Key="SettingsSurface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SettingsLine" Color="#DCE2DE" />
  <SolidColorBrush x:Key="SettingsControlLine" Color="#B9C4BD" />
  <SolidColorBrush x:Key="SettingsTrack" Color="#F0F3F1" />
  <CornerRadius x:Key="ChoiceCornerRadius">6</CornerRadius>
  <FontFamily x:Key="SettingsBodyFont">MiSans Regular, MiSans, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="SettingsHeadingFont">MiSans Semibold, MiSans, Microsoft YaHei UI</FontFamily>

  <Style x:Key="SettingsGroupSurface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SettingsSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style x:Key="SettingsLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource SettingsHeadingFont}" />
    <Setter Property="Foreground" Value="{DynamicResource SettingsText}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SettingsHint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>
  <Style x:Key="SettingsRow" TargetType="local:SettingsRow">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:SettingsRow">
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Viewbox x:Name="Glyph" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
              <Canvas Width="24" Height="24">
                <Path Data="{TemplateBinding Icon}" Stroke="{DynamicResource SettingsSecondaryText}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <ContentPresenter x:Name="Description" Grid.Column="1" ContentSource="Header" Margin="0,0,16,0" VerticalAlignment="Center" />
            <ContentPresenter x:Name="Action" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsStacked" Value="True">
              <Setter TargetName="Glyph" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="Description" Property="Grid.ColumnSpan" Value="2" />
              <Setter TargetName="Description" Property="Margin" Value="0" />
              <Setter TargetName="Action" Property="Grid.Column" Value="1" />
              <Setter TargetName="Action" Property="Grid.ColumnSpan" Value="2" />
              <Setter TargetName="Action" Property="Grid.Row" Value="1" />
              <Setter TargetName="Action" Property="HorizontalAlignment" Value="Left" />
              <Setter TargetName="Action" Property="Margin" Value="0,10,0,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsChoice" TargetType="ComboBox" BasedOn="{StaticResource RecordingChoice}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource SettingsText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlLine}" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value><Style TargetType="ComboBoxItem" BasedOn="{StaticResource RecordingChoiceItem}"><Setter Property="MinHeight" Value="44" /></Style></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SettingsInteractive" TargetType="{x:Type ButtonBase}">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource SettingsText}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E7ECE8" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#D9E2DC" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SettingsSegment" TargetType="RadioButton" BasedOn="{StaticResource SettingsInteractive}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="SelectedSurface" CornerRadius="4" />
            <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            <Border x:Name="SelectedMark" Width="20" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}"
                    VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="SelectedSurface" Property="Background" Value="{DynamicResource SettingsSurface}" />
              <Setter Property="FontFamily" Value="{DynamicResource SettingsHeadingFont}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SettingsAction" TargetType="Button" BasedOn="{StaticResource SettingsInteractive}">
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="{DynamicResource SettingsSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlLine}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
