<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ManualStudyCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource TeacherSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeacherLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="ManualStudyHint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TeacherMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Style.Triggers>
      <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ManualStudyRowLabel" TargetType="TextBlock">
    <Setter Property="Width" Value="64" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,4" />
  </Style>
  <Style x:Key="ManualStudyChoices" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource TeacherPageBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeacherLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,4" />
  </Style>
  <!-- Preserve the shared DatePicker editor and Windows calendar behavior. Time fields
       and the surrounding form use the same system-aware teacher brushes. -->
  <Style x:Key="ManualStudyDate" TargetType="DatePicker">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="SelectedDateFormat" Value="Short" />
    <Setter Property="Foreground" Value="{DynamicResource TeacherTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource TeacherSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeacherControlLineBrush}" />
    <Setter Property="CalendarStyle">
      <Setter.Value>
        <Style TargetType="Calendar">
          <Setter Property="Background" Value="{DynamicResource TeacherSurfaceBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TeacherTextBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource TeacherControlLineBrush}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Grid x:Name="PART_Root">
            <Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="6" BorderThickness="1" />
            <Grid Margin="10,2,2,2">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
              <DatePickerTextBox x:Name="PART_TextBox" Style="{DynamicResource DateInputEditor}" Foreground="{TemplateBinding Foreground}"
                                 AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
              <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Style="{DynamicResource TeacherQuiet}" Padding="0"
                      MinHeight="0" AutomationProperties.Name="打开日历" ToolTip="打开日历">
                <Path Data="M 3,5 L 17,5 L 17,18 L 3,18 Z M 3,9 L 17,9 M 7,2 L 7,7 M 13,2 L 13,7 M 7,12 L 9,12 M 11,12 L 13,12 M 7,15 L 9,15"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
              </Button>
            </Grid>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}" StaysOpen="False"
                   AllowsTransparency="True" VerticalOffset="4" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource TeacherTextBrush}" />
              <Setter TargetName="InputSurface" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource TeacherErrorBrush}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TeacherDisabledBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
