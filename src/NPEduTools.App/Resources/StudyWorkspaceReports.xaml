<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="StudyReportMetric" TargetType="StackPanel">
    <Setter Property="Width" Value="160" />
    <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
    <Setter Property="Margin" Value="0,0,12,2" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TeacherMutedBrush}" />
      </Style>
    </Style.Resources>
  </Style>
  <Style x:Key="StudyReportMetricValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TeacherTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style x:Key="StudyReportDetailText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <Style x:Key="StudyReportDetailLabel" TargetType="TextBlock" BasedOn="{StaticResource StudyReportDetailText}">
    <Setter Property="Foreground" Value="{DynamicResource TeacherMutedBrush}" />
    <Setter Property="Margin" Value="0,0,12,5" />
  </Style>

  <DataTemplate x:Key="StudyReportChannel">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="140" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="能量均值" Style="{StaticResource StudyReportDetailLabel}" />
      <TextBlock Grid.Column="1" Text="{Binding Mean}" Style="{StaticResource StudyReportDetailText}" />
      <TextBlock Grid.Row="1" Text="最高值" Style="{StaticResource StudyReportDetailLabel}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Maximum}" Style="{StaticResource StudyReportDetailText}" />
      <TextBlock Grid.Row="2" Text="中线超限" Style="{StaticResource StudyReportDetailLabel}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MediumThreshold}" Style="{StaticResource StudyReportDetailText}" />
      <TextBlock Grid.Row="3" Text="高线超限" Style="{StaticResource StudyReportDetailLabel}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HighThreshold}" Style="{StaticResource StudyReportDetailText}" />
    </Grid>
  </DataTemplate>
  <Style x:Key="StudyReportChannelSection" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ContentTemplate" Value="{StaticResource StudyReportChannel}" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <StackPanel>
            <TextBlock Text="{TemplateBinding Header}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Margin="0,0,0,6" AutomationProperties.HeadingLevel="Level3" />
            <ContentPresenter />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
    </Style.Triggers>
  </Style>


  <DataTemplate x:Key="StudyWorkspaceReport">
    <Border x:Name="ReportCard" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}"
            BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
      <StackPanel>
        <DockPanel>
          <Button x:Name="SamplingDetailsButton" DockPanel.Dock="Right" Content="查看详情" Tag="StudyReportDetails"
                  Style="{DynamicResource TeacherQuiet}" VerticalAlignment="Center" Margin="12,0,0,0"
                  Visibility="Collapsed"
                  AutomationProperties.AutomationId="StudyReportSamplingDetails"
                  AutomationProperties.Name="{Binding Title, StringFormat='{}{0}采样详情'}" />
          <TextBlock TextWrapping="Wrap" LineHeight="24" VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite">
            <Run Text="{Binding Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" /><Run Text="　" /><Run x:Name="ReportStatus"
                 Text="{Binding Status, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" />
          </TextBlock>
        </DockPanel>
        <TextBlock x:Name="ReadFailureHint" Text="请检查本机后台连接，再点「刷新报告」。" Foreground="{DynamicResource TeacherMutedBrush}"
                   Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel x:Name="ReportData" Margin="0,3,0,0" Visibility="Collapsed">
          <TextBlock Text="{Binding WindowText}" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap"
                     FontSize="13" AutomationProperties.AutomationId="StudyReportWindowText" />
          <TextBlock x:Name="NoValidSamplesHint" Text="无有效采样" Foreground="{DynamicResource TeacherWarningBrush}"
                     AutomationProperties.AutomationId="StudyReportNoValidSamples"
                     FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
          <WrapPanel Margin="0,8,0,0">
            <StackPanel Style="{StaticResource StudyReportMetric}">
              <TextBlock Text="有效采样时长" />
              <TextBlock x:Name="SampledTimeValue" Text="{Binding SampledTime}" Style="{StaticResource StudyReportMetricValue}"
                         AutomationProperties.AutomationId="StudyReportSampledTime" />
            </StackPanel>
            <StackPanel Style="{StaticResource StudyReportMetric}">
              <TextBlock Text="覆盖率" />
              <TextBlock x:Name="CoverageValue" Text="{Binding Coverage}" Style="{StaticResource StudyReportMetricValue}"
                         AutomationProperties.AutomationId="StudyReportCoverage" />
            </StackPanel>
            <StackPanel Style="{StaticResource StudyReportMetric}" Margin="0,0,0,2">
              <TextBlock Text="提醒次数" />
              <TextBlock Text="{Binding ReminderCount}" Style="{StaticResource StudyReportMetricValue}"
                         AutomationProperties.AutomationId="StudyReportReminderCount" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasData}" Value="True">
        <Setter TargetName="ReportData" Property="Visibility" Value="Visible" />
        <Setter TargetName="SamplingDetailsButton" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HasValidSamples}" Value="False">
        <Setter TargetName="NoValidSamplesHint" Property="Visibility" Value="Visible" />
        <Setter TargetName="SampledTimeValue" Property="Foreground" Value="{DynamicResource TeacherMutedBrush}" />
        <Setter TargetName="CoverageValue" Property="Foreground" Value="{DynamicResource TeacherMutedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
        <Setter TargetName="ReportCard" Property="BorderBrush" Value="{DynamicResource TeacherSuccessBrush}" />
        <Setter TargetName="SamplingDetailsButton" Property="Content" Value="收起详情" />
        <Setter TargetName="SamplingDetailsButton" Property="AutomationProperties.Name"
                Value="{Binding Title, StringFormat='收起{0}采样详情'}" />
        <Setter TargetName="SamplingDetailsButton" Property="FontWeight" Value="SemiBold" />
        <Setter TargetName="SamplingDetailsButton" Property="Foreground" Value="{DynamicResource TeacherSuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="True">
        <Setter TargetName="ReportCard" Property="BorderBrush" Value="{DynamicResource TeacherTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Complete"><Setter TargetName="ReportStatus" Property="Foreground" Value="{DynamicResource TeacherSuccessBrush}" /></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Partial"><Setter TargetName="ReportStatus" Property="Foreground" Value="{DynamicResource TeacherWarningBrush}" /></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Failed">
        <Setter TargetName="ReportStatus" Property="Foreground" Value="{DynamicResource TeacherErrorBrush}" />
        <Setter TargetName="ReadFailureHint" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="StudyWorkspaceReportDetails">
    <Border x:Name="ReportDetailCard" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}"
            BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="收起详情" Tag="CloseStudyReportDetails" Style="{DynamicResource TeacherQuiet}"
                  Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="WorkspaceCloseReportDetails" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="StudyReportDetailsHeading">
              <Run Text="{Binding Title, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" /><Run Text=" · 采样详情" FontSize="15" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Text="{Binding WindowText, Mode=OneWay}" Foreground="{DynamicResource TeacherMutedBrush}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.AutomationId="StudyReportDetailsWindow" />
          </StackPanel>
        </DockPanel>
        <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="0,0,0,10" />
        <TextBlock x:Name="DetailNoSamples" Text="本场没有有效样本可用于电平统计。" Style="{StaticResource StudyReportDetailText}"
                   Foreground="{DynamicResource TeacherWarningBrush}" Visibility="Collapsed" />
        <HeaderedContentControl Header="原始电平 · dBFS" Content="{Binding Raw}" Style="{StaticResource StudyReportChannelSection}" />
        <HeaderedContentControl Header="估算声级 · dB(A)" Content="{Binding Estimated}" Style="{StaticResource StudyReportChannelSection}" />
        <Border x:Name="ReportDetailDivider" Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="0,0,0,8" />
        <TextBlock x:Name="ReportClipping" Style="{StaticResource StudyReportDetailText}">
          <Run Text="削波比例　" Foreground="{DynamicResource TeacherMutedBrush}" /><Run Text="{Binding Clipping, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Style="{StaticResource StudyReportDetailText}">
          <Run Text="时间来源　" Foreground="{DynamicResource TeacherMutedBrush}" /><Run Text="{Binding ClockSource, Mode=OneWay}" />
        </TextBlock>
        <TextBlock x:Name="ReportNotes" Style="{StaticResource StudyReportDetailText}" Margin="0,3,0,0"
                   AutomationProperties.AutomationId="StudyReportNotes">
          <Run Text="备注　" Foreground="{DynamicResource TeacherMutedBrush}" /><Run Text="{Binding Notes, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="True">
        <Setter TargetName="ReportDetailCard" Property="BorderBrush" Value="{DynamicResource TeacherTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HasValidSamples}" Value="False">
        <Setter TargetName="DetailNoSamples" Property="Visibility" Value="Visible" />
        <Setter TargetName="ReportDetailDivider" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="ReportClipping" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Notes}" Value=""><Setter TargetName="ReportNotes" Property="Visibility" Value="Collapsed" /></DataTrigger>
      <DataTrigger Binding="{Binding Notes}" Value="{x:Null}"><Setter TargetName="ReportNotes" Property="Visibility" Value="Collapsed" /></DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
