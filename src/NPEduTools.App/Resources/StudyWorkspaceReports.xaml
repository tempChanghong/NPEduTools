<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="StudyReportMetric" TargetType="StackPanel">
    <Setter Property="Width" Value="184" />
    <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
    <Setter Property="Margin" Value="0,0,12,10" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TeacherMutedBrush}" />
      </Style>
    </Style.Resources>
  </Style>
  <Style x:Key="StudyReportMetricValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TeacherTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>
  <Style x:Key="StudyReportDetailText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <Style x:Key="StudyReportDetailLabel" TargetType="TextBlock" BasedOn="{StaticResource StudyReportDetailText}">
    <Setter Property="Foreground" Value="{DynamicResource TeacherMutedBrush}" />
    <Setter Property="Margin" Value="0,0,12,5" />
  </Style>

  <DataTemplate x:Key="StudyReportChannel">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="140" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="能量均值" Style="{StaticResource StudyReportDetailLabel}" />
      <TextBlock Grid.Column="1" Text="{Binding Mean}" Style="{StaticResource StudyReportDetailText}" />
      <TextBlock Grid.Row="1" Text="最高值" Style="{StaticResource StudyReportDetailLabel}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Maximum}" Style="{StaticResource StudyReportDetailText}" />
      <TextBlock Grid.Row="2" Text="中线超限" Style="{StaticResource StudyReportDetailLabel}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MediumThreshold}" Style="{StaticResource StudyReportDetailText}" />
      <TextBlock Grid.Row="3" Text="高线超限" Style="{StaticResource StudyReportDetailLabel}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HighThreshold}" Style="{StaticResource StudyReportDetailText}" />
    </Grid>
  </DataTemplate>
  <Style x:Key="StudyReportChannelSection" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ContentTemplate" Value="{StaticResource StudyReportChannel}" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <StackPanel>
            <TextBlock Text="{TemplateBinding Header}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Margin="0,0,0,6" AutomationProperties.HeadingLevel="Level3" />
            <ContentPresenter />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StudyReportExpander" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource TeacherTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                          MinHeight="44" Cursor="Hand">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Frame" Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="Transparent"
                          BorderThickness="2" CornerRadius="6" Padding="10,6">
                    <DockPanel>
                      <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            VerticalAlignment="Center" Margin="0,0,12,0" />
                      <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource TeacherHoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 0,4 L 4,0 L 8,4" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TeacherTextBrush}" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="12,8,12,0" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="StudyWorkspaceReport">
    <Border Background="{DynamicResource TeacherSurfaceBrush}" BorderBrush="{DynamicResource TeacherLineBrush}"
            BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" LineHeight="28" AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite">
          <Run Text="{Binding Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" /><Run Text="　" /><Run x:Name="ReportStatus"
               Text="{Binding Status, Mode=OneWay}" FontSize="14" Foreground="{DynamicResource TeacherMutedBrush}" />
        </TextBlock>
        <TextBlock x:Name="ReadFailureHint" Text="请检查本机后台连接，再点「刷新报告」。" Foreground="{DynamicResource TeacherMutedBrush}"
                   Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel x:Name="ReportData" Margin="0,6,0,0" Visibility="Collapsed">
          <TextBlock Text="{Binding WindowText}" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap"
                     FontSize="14" AutomationProperties.AutomationId="StudyReportWindowText" />
          <WrapPanel Margin="0,12,0,0">
            <StackPanel Style="{StaticResource StudyReportMetric}">
              <TextBlock Text="有效采样时长" />
              <TextBlock Text="{Binding SampledTime}" Style="{StaticResource StudyReportMetricValue}" AutomationProperties.AutomationId="StudyReportSampledTime" />
            </StackPanel>
            <StackPanel Style="{StaticResource StudyReportMetric}">
              <TextBlock Text="覆盖率" />
              <TextBlock Text="{Binding Coverage}" Style="{StaticResource StudyReportMetricValue}" AutomationProperties.AutomationId="StudyReportCoverage" />
            </StackPanel>
            <StackPanel Style="{StaticResource StudyReportMetric}" Margin="0,0,0,10">
              <TextBlock Text="提醒次数" />
              <TextBlock Text="{Binding ReminderCount}" Style="{StaticResource StudyReportMetricValue}" AutomationProperties.AutomationId="StudyReportReminderCount" />
            </StackPanel>
          </WrapPanel>
          <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="0,2,0,2" />
          <Expander Header="采样详情" Style="{StaticResource StudyReportExpander}"
                    AutomationProperties.AutomationId="StudyReportSamplingDetails"
                    AutomationProperties.Name="{Binding Title, StringFormat='{}{0}采样详情'}">
            <StackPanel>
              <HeaderedContentControl Header="原始电平 · dBFS" Content="{Binding Raw}" Style="{StaticResource StudyReportChannelSection}" />
              <HeaderedContentControl Header="估算声级 · dB(A)" Content="{Binding Estimated}" Style="{StaticResource StudyReportChannelSection}" />
              <Border Height="1" Background="{DynamicResource TeacherLineBrush}" Margin="0,0,0,8" />
              <TextBlock Style="{StaticResource StudyReportDetailText}">
                <Run Text="削波比例　" Foreground="{DynamicResource TeacherMutedBrush}" /><Run Text="{Binding Clipping, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Style="{StaticResource StudyReportDetailText}">
                <Run Text="时间来源　" Foreground="{DynamicResource TeacherMutedBrush}" /><Run Text="{Binding ClockSource, Mode=OneWay}" />
              </TextBlock>
              <TextBlock x:Name="ReportNotes" Style="{StaticResource StudyReportDetailText}" Margin="0,3,0,0">
                <Run Text="备注　" Foreground="{DynamicResource TeacherMutedBrush}" /><Run Text="{Binding Notes, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </Expander>
        </StackPanel>
      </StackPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasData}" Value="True"><Setter TargetName="ReportData" Property="Visibility" Value="Visible" /></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Complete"><Setter TargetName="ReportStatus" Property="Foreground" Value="{DynamicResource TeacherSuccessBrush}" /></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Partial"><Setter TargetName="ReportStatus" Property="Foreground" Value="{DynamicResource TeacherWarningBrush}" /></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Failed">
        <Setter TargetName="ReportStatus" Property="Foreground" Value="{DynamicResource TeacherErrorBrush}" />
        <Setter TargetName="ReadFailureHint" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Notes}" Value=""><Setter TargetName="ReportNotes" Property="Visibility" Value="Collapsed" /></DataTrigger>
      <DataTrigger Binding="{Binding Notes}" Value="{x:Null}"><Setter TargetName="ReportNotes" Property="Visibility" Value="Collapsed" /></DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
