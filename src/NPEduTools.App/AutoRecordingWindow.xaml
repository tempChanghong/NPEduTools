<Window x:Class="NPEduTools.App.AutoRecordingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="/Assets/npedutools.ico" Title="自动录课 · NPEduTools" Width="1240" Height="880" MinWidth="840" MinHeight="580"
 Background="{DynamicResource TeacherPageBrush}" Foreground="{DynamicResource TeacherTextBrush}" FontFamily="{DynamicResource TeacherFont}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/RecordingControls.xaml" /></ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="RecordingLocationVisibility" />
      <Style TargetType="Button" BasedOn="{StaticResource TeacherButton}" />
      <Style TargetType="TextBox" BasedOn="{StaticResource TeacherInput}" />
      <Style TargetType="ComboBox" BasedOn="{StaticResource RecordingChoice}" />
      <Style TargetType="CheckBox" BasedOn="{StaticResource RecordingCheck}" />
      <Style TargetType="DataGrid" BasedOn="{StaticResource RecordingTable}" />
      <Style TargetType="TabControl" BasedOn="{StaticResource SoftTabs}">
        <Setter Property="BorderBrush" Value="{DynamicResource TeacherLineBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabControl">
              <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <WrapPanel x:Name="Headers" IsItemsHost="True" />
                <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="8,6">
                  <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="Records"><Setter TargetName="Headers" Property="Visibility" Value="Collapsed" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 一、紧凑总览表头：状态徽标、下一节摘要、总开关与靠近摘要的跳过／停止操作 -->
    <Border x:Name="AutoOverview" Style="{DynamicResource SettingsGroupSurface}" Padding="12,8" Margin="0,0,0,8">
      <StackPanel>
        <Grid x:Name="AutoSummaryGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="RealStatus" Text="自动录制未启用" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="AutoRealStatus" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="NextPlanOverview" Text="下一项安排待确认" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}"
                         TextWrapping="Wrap" Margin="0,3,0,4" AutomationProperties.AutomationId="AutoNextOverview" />
            </StackPanel>
            <Button x:Name="RealSkip" Grid.Column="1" Content="跳过下一节" Style="{DynamicResource TeacherPrimary}" Click="RealSkipClicked"
                    AutomationProperties.AutomationId="AutoRealSkip" VerticalAlignment="Center" Margin="12,0,0,2" />
          </Grid>

          <WrapPanel x:Name="AutoPrimaryActions" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
            <Button x:Name="ToggleReal" Content="开启自动录课" Style="{DynamicResource TeacherPrimary}" Click="ToggleRealClicked"
                    AutomationProperties.AutomationId="AutoToggleReal" Margin="0,0,6,2" />
            <Button x:Name="StopCurrent" Content="停止当前录制" Style="{DynamicResource TeacherQuiet}" Click="StopCurrentClicked"
                    AutomationProperties.AutomationId="AutoStopCurrent" Margin="0,0,0,2" />
          </WrapPanel>
        </Grid>

        <!-- 压低视觉层级的次要辅助行 -->
        <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">
          <Button x:Name="RealSkipDay" Content="今天不再录制" ToolTip="今天不再自动录制，并结束正在进行的自动录课。" Style="{DynamicResource TeacherQuiet}" Click="RealSkipDayClicked"
                  AutomationProperties.AutomationId="AutoRealSkipDay" Padding="10,4" Margin="0,0,4,0" />
          <Button Content="录制设置" Style="{DynamicResource TeacherQuiet}" Click="RecordingSettingsClicked"
                  AutomationProperties.AutomationId="AutoRecordingSettings" Padding="10,4" Margin="0,0,4,0" />
          <Button Content="录制余量" Style="{DynamicResource TeacherQuiet}" Click="RecordingMarginsClicked"
                  AutomationProperties.AutomationId="AutoRecordingMargins" Padding="10,4" Margin="0,0,4,0" />
          <Expander x:Name="AutoSourceDetails" Header="课表与时间" Style="{DynamicResource TeacherExpander}" FontSize="13"
                    VerticalAlignment="Center" AutomationProperties.Name="学校课表与时间详情" />
        </WrapPanel>

        <TextBlock x:Name="AutomaticFeedbackText" TextWrapping="Wrap" Foreground="{DynamicResource TeacherErrorBrush}" FontSize="13" Margin="0,4,0,0"
                   Visibility="Collapsed" AutomationProperties.AutomationId="AutoOperationFeedback" AutomationProperties.LiveSetting="Polite" />

        <StackPanel Margin="0,2,0,2" Visibility="{Binding IsExpanded, ElementName=AutoSourceDetails, Converter={StaticResource RecordingLocationVisibility}}">
          <TextBlock x:Name="SourceStatus" Text="正在读取 ClassIsland 课表…" Style="{DynamicResource SettingsHint}" AutomationProperties.AutomationId="AutoSourceStatus" />
          <TextBlock x:Name="ClockStatus" Text="等待学校时间" Style="{DynamicResource SettingsHint}" AutomationProperties.AutomationId="AutoClockStatus" />
          <TextBlock Text="切页和收起界面不会停止录制；关闭后台后需重新开启自动录课。" Style="{DynamicResource SettingsHint}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 二、核心分页区：当天课程优先占主视觉，保留每周／科目／试运行／录制记录原子页 -->
    <TabControl x:Name="AutoSections" Grid.Row="1" AutomationProperties.AutomationId="AutoSections">
      <TabItem Header="当天课程" AutomationProperties.AutomationId="AutoPlanTab">
        <ScrollViewer x:Name="DayScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 宽窗同行排日期与状态，窄窗自然换行不压按钮 -->
            <WrapPanel x:Name="DayToolbar" Margin="0,0,0,6" VerticalAlignment="Center">
              <Button x:Name="TodayButton" Content="今天" CommandParameter="0" Style="{DynamicResource TeacherTab}" Click="RelativeDayClicked" AutomationProperties.AutomationId="AutoToday" Margin="0,0,2,2" />
              <Button x:Name="TomorrowButton" Content="明天" CommandParameter="1" Style="{DynamicResource TeacherTab}" Click="RelativeDayClicked" AutomationProperties.AutomationId="AutoTomorrow" Margin="0,0,2,2" />
              <Button x:Name="AfterTomorrowButton" Content="后天" CommandParameter="2" Style="{DynamicResource TeacherTab}" Click="RelativeDayClicked" AutomationProperties.AutomationId="AutoAfterTomorrow" Margin="0,0,6,2" />
              <DatePicker x:Name="PlanDate" SelectedDateChanged="PlanDateChanged" Width="148" Margin="0,0,10,2" MinHeight="44"
                          AutomationProperties.AutomationId="AutoPlanDate" AutomationProperties.Name="指定其他日期" />
              <Button Content="刷新课表" Style="{DynamicResource TeacherQuiet}" Click="RefreshClicked"
                      AutomationProperties.AutomationId="AutoRefresh" Padding="10,4" Margin="0,0,8,2" />
              <TextBlock x:Name="DateStatus" Text="等待学校日期" TextWrapping="Wrap" MaxWidth="390" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12"
                         VerticalAlignment="Center" Margin="0,0,0,2" AutomationProperties.AutomationId="AutoDateStatus" />
            </WrapPanel>

            <StackPanel Grid.Row="1">
              <Border x:Name="PlanOverlapBanner" Background="{DynamicResource TeacherHoverBrush}" BorderBrush="{DynamicResource TeacherWarningBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6" Visibility="Collapsed">
                <TextBlock x:Name="PlanOverlapStatus" TextWrapping="Wrap" Foreground="{DynamicResource TeacherWarningBrush}" FontSize="12"
                           AutomationProperties.AutomationId="AutoPlanOverlapStatus" />
              </Border>
            </StackPanel>

            <!-- 课程表为主体，840 窄窗默认可见至少三节短课程 -->
            <Border Grid.Row="2" Style="{DynamicResource SettingsGroupSurface}" Padding="4">
              <DataGrid x:Name="Plans" MinHeight="160" MaxHeight="380" SelectionChanged="PlanSelected" AutomationProperties.AutomationId="AutoPlans">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="课程 / 名称" Binding="{Binding Subject}" Width="*" MinWidth="85" ElementStyle="{StaticResource RecordingTableSubject}" />
                  <DataGridTextColumn Header="上课 / 录制" Binding="{Binding TimeSummary}" Width="154" ElementStyle="{StaticResource RecordingTableText}" />
                  <DataGridTextColumn Header="安排说明" Binding="{Binding Status}" Width="2*" MinWidth="100" ElementStyle="{StaticResource RecordingTableText}" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <!-- 紧邻课表的单日三操作与行内反馈（独立于总开关） -->
            <StackPanel Grid.Row="3" Margin="0,6,0,0">
              <WrapPanel x:Name="DayOverrideActions">
                <Button Content="当天录制这节课" Tag="Include" Style="{DynamicResource TeacherButton}" Click="OverrideClicked" Padding="12,5" Margin="0,0,6,4" AutomationProperties.AutomationId="AutoInclude" />
                <Button Content="当天不录这节课" Tag="Exclude" Style="{DynamicResource TeacherButton}" Click="OverrideClicked" Padding="12,5" Margin="0,0,6,4" AutomationProperties.AutomationId="AutoExclude" />
                <Button Content="恢复每周安排" Tag="Inherit" Style="{DynamicResource TeacherQuiet}" Click="OverrideClicked" Padding="10,5" Margin="0,0,0,4" AutomationProperties.AutomationId="AutoInherit" />
              </WrapPanel>
              <TextBlock x:Name="DayOverrideFeedback" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TeacherAccentBrush}" Margin="0,2,0,4"
                         AutomationProperties.AutomationId="AutoDayOverrideFeedback" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <TextBlock Text="选中课程后保存当天安排；采用当前每周规则的课前/课后余量，不会开启自动录课。" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,0,0,6" />
              <CheckBox x:Name="OnlyExplicit" Content="这天只录手动安排的课程和时段（不使用每周安排）" Click="OnlyExplicitClicked"
                        Margin="0,0,0,6" AutomationProperties.AutomationId="AutoOnlyExplicit" />
              <Expander Header="另加一次录课（指定时间段）" Style="{DynamicResource TeacherExpander}" AutomationProperties.AutomationId="AutoDatedEditor" AutomationProperties.Name="另加一次录课（指定时间段）">
                <StackPanel Margin="0,4,0,4">
                  <TextBlock Text="仅在所选日期，按学校时间执行。" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" />
                  <WrapPanel Margin="0,6">
                    <TextBox x:Name="DatedName" Text="单次录课" Width="130" ToolTip="录课名称" AutomationProperties.Name="录课名称" AutomationProperties.AutomationId="AutoDatedName" Margin="0,0,6,4" />
                    <TextBox x:Name="DatedStart" Text="10:00" Width="75" ToolTip="开始时间，格式 HH:mm" AutomationProperties.Name="开始时间" AutomationProperties.AutomationId="AutoDatedStart" Margin="0,0,4,4" />
                    <TextBlock Text="至" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox x:Name="DatedEnd" Text="10:40" Width="75" ToolTip="结束时间，格式 HH:mm" AutomationProperties.Name="结束时间" AutomationProperties.AutomationId="AutoDatedEnd" Margin="0,0,6,4" />
                    <Button Content="新时段" Style="{DynamicResource TeacherButton}" Click="NewDatedClicked" Padding="10,5" Margin="0,0,6,4" />
                    <Button Content="保存时段" Style="{DynamicResource TeacherButton}" Click="SaveDatedClicked" Padding="10,5" Margin="0,0,6,4" AutomationProperties.AutomationId="AutoSaveDated" />
                    <Button Content="删除选中时段" Style="{DynamicResource TeacherQuiet}" Click="DeleteDatedClicked" Padding="10,5" Margin="0,0,0,4" AutomationProperties.AutomationId="AutoDeleteDated" />
                  </WrapPanel>
                  <TextBlock Text="固定时段按输入时间录制，不加课前/课后余量、不按科目排除。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="每周安排">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel Margin="6">
            <TextBlock Text="每周重复执行；保存后还需开启上方总开关。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,0,0,8" />
            <ComboBox x:Name="RuleList" SelectionChanged="RuleSelected" AutomationProperties.AutomationId="AutoRuleList" />
            <Border x:Name="RecordingMargins" Style="{DynamicResource SettingsGroupSurface}" Padding="12,8" Margin="0,10" AutomationProperties.AutomationId="AutoMarginsPanel">
              <Expander x:Name="RecordingMarginsDetails" Header="本机录课时间余量" Style="{DynamicResource TeacherExpander}" AutomationProperties.Name="本机录课时间余量">
                <StackPanel Margin="0,4,0,0">
                  <TextBlock Text="用于上方选中的每周安排，仅保存在本机。0 表示按上课或下课时间录制。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="0,2,0,10" />
                  <WrapPanel>
                    <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="提前几分钟开始录课" Margin="0,0,0,6" /><ComboBox x:Name="LeadMinutes" AutomationProperties.Name="提前录课分钟数" AutomationProperties.AutomationId="AutoLeadMinutes" /></StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="下课后至多录制几分钟" Margin="0,0,0,6" /><ComboBox x:Name="TailMinutes" AutomationProperties.Name="课后至多录课分钟数" AutomationProperties.AutomationId="AutoTailMinutes" /></StackPanel>
                    <Button x:Name="SaveMargins" Content="只保存录制余量" Style="{DynamicResource TeacherButton}" Click="SaveMarginsClicked" VerticalAlignment="Bottom" Margin="0,0,0,8" AutomationProperties.AutomationId="AutoSaveMargins" />
                  </WrapPanel>
                  <TextBlock Text="相邻课程自动缩短余量，下一节优先。固定时段不加余量；单日覆盖使用自己的余量。进行中的录课截止只缩短、不延长。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" />
                </StackPanel>
              </Expander>
            </Border>
            <Border Style="{DynamicResource SettingsGroupSurface}" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="每周规则" Style="{DynamicResource SettingsLabel}" />
                <WrapPanel Margin="0,8">
                  <Button Content="新建" Style="{DynamicResource TeacherButton}" Click="NewRuleClicked" Padding="10,5" Margin="0,0,6,0" AutomationProperties.AutomationId="AutoNewRule" />
                  <Button Content="删除" Style="{DynamicResource TeacherQuiet}" Click="DeleteRuleClicked" Padding="10,5" AutomationProperties.AutomationId="AutoDeleteRule" />
                </WrapPanel>
                <TextBlock Text="规则名称" Margin="0,0,0,4" /><TextBox x:Name="RuleName" AutomationProperties.AutomationId="AutoRuleName" />
                <CheckBox x:Name="RuleEnabled" Content="使用这条每周安排" Margin="0,8" AutomationProperties.AutomationId="AutoRuleEnabled" />
                <ComboBox x:Name="RuleKind" SelectedIndex="0" SelectionChanged="RuleKindChanged" AutomationProperties.AutomationId="AutoRuleKind"><ComboBoxItem Content="跟随课表" /><ComboBoxItem Content="固定时间段" /></ComboBox>
                <TextBlock Text="生效日期 / 结束日期（留空不限）" Margin="0,10,0,4" /><DatePicker x:Name="RuleFrom" /><DatePicker x:Name="RuleUntil" Margin="0,4,0,8" />
                <StackPanel x:Name="FixedRuleFields" Visibility="Collapsed">
                  <TextBlock Text="完整录制时段（学校时间 HH:mm）" Margin="0,0,0,4" />
                  <TextBox x:Name="RuleStart" Text="10:00" AutomationProperties.AutomationId="AutoRuleStart" />
                  <TextBox x:Name="RuleEnd" Text="10:40" Margin="0,4" AutomationProperties.AutomationId="AutoRuleEnd" />
                  <TextBlock Text="按时间执行，不叠加课前课后余量，不使用科目排除。跨午夜请拆为两条。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" />
                </StackPanel>
                <CheckBox x:Name="UseExclusions" Content="使用默认排除名单" IsChecked="True" Margin="0,8" AutomationProperties.AutomationId="AutoUseExclusions" />
                <TextBlock Text="生效星期" Margin="0,10,0,6" />
                <WrapPanel x:Name="Weekdays"><CheckBox Content="一" Tag="1" Margin="0,0,10,6" /><CheckBox Content="二" Tag="2" Margin="0,0,10,6" /><CheckBox Content="三" Tag="3" Margin="0,0,10,6" /><CheckBox Content="四" Tag="4" Margin="0,0,10,6" /><CheckBox Content="五" Tag="5" Margin="0,0,10,6" /><CheckBox Content="六" Tag="6" Margin="0,0,10,6" /><CheckBox Content="日" Tag="0" Margin="0,0,10,6" /></WrapPanel>
                <TextBlock Text="节次（留空为全部）" Margin="0,8,0,4" /><TextBox x:Name="Numbers" ToolTip="例如：1,2,5" AutomationProperties.AutomationId="AutoLessonNumbers" />
                <CheckBox x:Name="AllSubjects" Content="全部科目" Margin="0,10,0,6" Checked="SubjectsChanged" Unchecked="SubjectsChanged" AutomationProperties.AutomationId="AutoAllSubjects" />
                <ListBox x:Name="Subjects" SelectionMode="Multiple" DisplayMemberPath="Name" MinHeight="80" MaxHeight="180" AutomationProperties.AutomationId="AutoSubjects" />
                <TextBlock Text="关闭“全部科目”后，可逐项点击选择。科目来自当前课表。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,6,0,10" />
                <Button x:Name="ApplyRules" Content="保存每周安排" Style="{DynamicResource TeacherPrimary}" Click="ApplyClicked" Margin="0,4,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="AutoApplyRules" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="科目与暂停">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel Margin="6">
            <TextBlock Text="默认不录的科目" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="每行一个完整科目名称。某天手动选择“这天录制”，可以覆盖此名单。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="0,4,0,8" />
            <TextBox x:Name="ExcludedNames" AcceptsReturn="True" Height="200" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="AutoExcludedNames" />
            <Button Content="保存排除名单" Style="{DynamicResource TeacherButton}" Click="ExclusionsClicked" HorizontalAlignment="Left" Margin="0,8" AutomationProperties.AutomationId="AutoSaveExclusions" />
            <TextBlock Text="选中课程后，可以长期允许或排除这个科目（同一课表档案内改名后仍保留）。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="0,8,0,6" />
            <WrapPanel>
              <Button Content="总是允许此科目" Style="{DynamicResource TeacherButton}" Click="AllowSubjectClicked" Margin="0,0,8,6" />
              <Button Content="总是排除此科目" Style="{DynamicResource TeacherButton}" Click="ExcludeSubjectClicked" Margin="0,0,8,6" />
              <Button Content="此科目恢复默认" Style="{DynamicResource TeacherQuiet}" Click="ResetSubjectClicked" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock Text="暂停录课至指定日期（含当天）" Margin="0,12,0,4" />
            <WrapPanel>
              <DatePicker x:Name="PauseThrough" Width="168" MinHeight="44" Margin="0,0,8,4" />
              <Button Content="保存暂停日期（清空后保存可恢复）" Style="{DynamicResource TeacherButton}" Click="PauseThroughClicked" Margin="0,0,0,4" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="试运行（高级）" AutomationProperties.AutomationId="AutoTrialTab">
        <Grid Margin="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
          <Border Style="{DynamicResource SettingsGroupSurface}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="试运行不会生成视频" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="用于检查计划到点后会怎样执行。按当前 ClassIsland 时间模拟，不会加速时间。日常录课无需先试运行；此处的启停和跳过不影响实际录制。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="12" Margin="0,4,0,6" />
              <TextBlock Text="{Binding Text, ElementName=DateStatus}" FontSize="12" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
              <TextBlock x:Name="PreviewStatus" Text="试运行未启动" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="AutoPreviewStatus" />
            </StackPanel>
          </Border>
          <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="TogglePreview" Content="启动试运行" Style="{DynamicResource TeacherButton}" Click="ToggleClicked" AutomationProperties.AutomationId="AutoTogglePreview" Margin="0,0,8,4" />
            <Button x:Name="SkipDay" Content="今天不再试运行" Style="{DynamicResource TeacherButton}" Click="SkipDayClicked" AutomationProperties.AutomationId="AutoSkipDay" Margin="0,0,8,4" />
            <Button x:Name="SkipLesson" Content="仅模拟：跳过 / 结束选中项" Style="{DynamicResource TeacherQuiet}" Click="SkipClicked" AutomationProperties.AutomationId="AutoSkipLesson" Margin="0,0,0,4" />
          </WrapPanel>
          <DataGrid x:Name="PreviewPlans" Grid.Row="2" Margin="0,0,0,8" ItemsSource="{Binding ItemsSource, ElementName=Plans}" SelectedItem="{Binding SelectedItem, ElementName=Plans, Mode=TwoWay}" AutomationProperties.AutomationId="AutoTrialPlans">
            <DataGrid.Columns>
              <DataGridTextColumn Header="课程 / 名称" Binding="{Binding Subject}" Width="160" ElementStyle="{StaticResource RecordingTableSubject}" />
              <DataGridTextColumn Header="模拟录制时间" Binding="{Binding CaptureTime}" Width="130" ElementStyle="{StaticResource RecordingTableTime}" />
              <DataGridTextColumn Header="模拟状态" Binding="{Binding SimulationStatus}" Width="160" ElementStyle="{StaticResource RecordingTableText}" />
              <DataGridTextColumn Header="计划说明" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource RecordingTableText}" />
            </DataGrid.Columns>
          </DataGrid>
          <ListBox x:Name="Events" Grid.Row="3" BorderBrush="{DynamicResource TeacherLineBrush}" AutomationProperties.AutomationId="AutoEvents">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="4,5" /></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="录制记录" AutomationProperties.AutomationId="AutoRecordsTab">
        <Grid Margin="6">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
          <Border Style="{DynamicResource SettingsGroupSurface}" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="最近一次录课结果" Style="{DynamicResource SettingsLabel}" />
              <TextBlock x:Name="LatestRecording" Text="正在确认当前录制状态" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
              <TextBlock x:Name="LatestRecordingPath" Style="{DynamicResource SettingsHint}" />
              <WrapPanel Margin="0,4,0,0">
                <Button x:Name="OpenLatestVideo" Content="打开最近视频" Style="{DynamicResource TeacherButton}" Click="OpenLatestVideoClicked" Margin="0,0,6,0" />
                <Button x:Name="OpenLatestFolder" Content="打开最近保留位置" Style="{DynamicResource TeacherQuiet}" Click="OpenLatestFolderClicked" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <ComboBox DockPanel.Dock="Right" x:Name="RecordFilter" SelectedIndex="0" SelectionChanged="RecordFilterChanged" Width="164" MinHeight="44" AutomationProperties.Name="自动录课记录筛选"><ComboBoxItem Content="全部自动记录" /><ComboBoxItem Content="需要处理" /><ComboBoxItem Content="已保存" /></ComboBox>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="自动录课记录" Style="{DynamicResource SettingsLabel}" />
              <TextBlock x:Name="RecordsError" Foreground="{DynamicResource TeacherErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="2" Style="{DynamicResource SettingsGroupSurface}" Padding="6">
            <Grid>
              <ListBox x:Name="RealEvents" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.PanningMode="VerticalOnly" AutomationProperties.AutomationId="AutoRealEvents">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{DynamicResource SettingsLabel}" />
                        <TextBlock Text="{Binding Reason}" Style="{DynamicResource SettingsHint}" />
                        <TextBlock Text="{Binding Location}" Style="{DynamicResource SettingsHint}" />
                        <WrapPanel>
                          <Button Content="打开视频" Style="{DynamicResource TeacherQuiet}" Click="OpenRecordVideoClicked" Margin="0,0,4,0"
                           Visibility="{Binding HasVideo, Converter={StaticResource RecordingLocationVisibility}}" />
                          <Button Content="{Binding FolderAction}" Style="{DynamicResource TeacherQuiet}" Click="OpenRecordFolderClicked"
                           Visibility="{Binding HasFolder, Converter={StaticResource RecordingLocationVisibility}}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="RealEventsEmpty" Text="暂无自动录课记录。" Style="{DynamicResource SettingsHint}"
               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" IsHitTestVisible="False" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- 三、极简底栏：仅在有全局错误或独立窗返回时占行，不挤占 840 窄窗课表高度 -->
    <DockPanel x:Name="AutoFooter" Grid.Row="2" Margin="0,4,0,0">
      <Button x:Name="AutoHideButton" DockPanel.Dock="Right" Content="返回主页" Style="{DynamicResource TeacherQuiet}" Click="HideClicked"
              Visibility="Collapsed" AutomationProperties.AutomationId="AutoHide" Margin="8,0,0,0" />
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource TeacherErrorBrush}" FontSize="12" VerticalAlignment="Center"
                 AutomationProperties.AutomationId="AutoError" AutomationProperties.LiveSetting="Polite">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </DockPanel>
  </Grid>
</Window>
