<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../images/branding/npedutools.ico</ApplicationIcon>
    <!-- WPF owns DPI initialization; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/legal/*-AGREEMENT.md" LogicalName="NPEduTools.Legal.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="NPEduTools.Legal.GPL-3.0.txt" />
    <Resource Include="../../images/branding/npedutools.ico" Link="Assets/npedutools.ico" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../NPEduTools.Contracts/NPEduTools.Contracts.csproj" />
    <ProjectReference Include="../NPEduTools.Core/NPEduTools.Core.csproj" />
    <ProjectReference Include="../NPEduTools.ClassIsland.Admin/NPEduTools.ClassIsland.Admin.csproj" />
    <!-- Host builds Recorder with its explicit Windows target before either bundle is copied. -->
    <ProjectReference Include="../NPEduTools.Host/NPEduTools.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../NPEduTools.Guard/NPEduTools.Guard.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyHostBundle" AfterTargets="Build">
    <MSBuild Projects="../NPEduTools.Host/NPEduTools.Host.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net10.0">
      <Output TaskParameter="TargetOutputs" ItemName="HostTarget" />
    </MSBuild>
    <ItemGroup>
      <HostBundle Include="$([System.IO.Path]::GetDirectoryName('%(HostTarget.Identity)'))/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(HostBundle)" DestinationFiles="@(HostBundle->'$(OutDir)Host/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyGuardBundle" AfterTargets="Build">
    <MSBuild Projects="../NPEduTools.Guard/NPEduTools.Guard.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows">
      <Output TaskParameter="TargetOutputs" ItemName="GuardTarget" />
    </MSBuild>
    <ItemGroup><GuardBundle Include="$([System.IO.Path]::GetDirectoryName('%(GuardTarget.Identity)'))/**/*" /></ItemGroup>
    <Copy SourceFiles="@(GuardBundle)" DestinationFiles="@(GuardBundle->'$(OutDir)Guard/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyAdminBundle" AfterTargets="Build">
    <ItemGroup><AdminBundle Include="../NPEduTools.ClassIsland.Admin/bin/$(Configuration)/net10.0/**/*" /></ItemGroup>
    <Copy SourceFiles="@(AdminBundle)" DestinationFiles="@(AdminBundle->'$(OutDir)Admin/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyRecorderBundle" AfterTargets="Build">
    <ItemGroup><RecorderBundle Include="../NPEduTools.Recorder/bin/$(Configuration)/net10.0-windows/**/*" /></ItemGroup>
    <Copy SourceFiles="@(RecorderBundle)" DestinationFiles="@(RecorderBundle->'$(OutDir)Recorder/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
