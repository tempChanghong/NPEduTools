<Window x:Class="NPEduTools.App.NoiseReferenceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="外部声级计参考 · NPEduTools" Width="880" Height="680" MinWidth="640" MinHeight="460"
 WindowStartupLocation="CenterOwner" Background="#F6F8F7" Foreground="#202E35" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
 <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer x:Name="ReferencePageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="24,20">
  <WrapPanel><TextBlock x:Name="Heading" Text="外部声级计参考" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/><Button x:Name="RefreshStatus" Content="验证口令 / 刷新" Click="RefreshClicked" Padding="12,7" Margin="12,0,0,6" Style="{StaticResource Quiet}" VerticalAlignment="Center"/></WrapPanel>
  <TextBlock x:Name="DeviceStatus" Text="正在读取本机状态…" Foreground="#61786B" TextWrapping="Wrap" Margin="0,6,0,12"/>
  <TextBlock x:Name="ReferenceHealth" TextWrapping="Wrap" Foreground="#61786B" Margin="0,0,0,10"/>
  <UniformGrid x:Name="StepNavigation" Columns="3" Visibility="Collapsed" Margin="0,0,0,12">
   <Button x:Name="SetupStep" Content="1　设置" Click="SetupClicked" Padding="10,8" Margin="0,0,6,0"/>
   <Button x:Name="SamplingStep" Content="2　采样" Click="SamplingClicked" Padding="10,8" Margin="0,0,6,0"/>
   <Button x:Name="ResultStep" Content="3　结果" Click="ResultClicked" Padding="10,8"/>
  </UniformGrid>
  <TextBlock x:Name="OperationMessage" TextWrapping="Wrap" Foreground="#A55337" Margin="0,0,0,12" AutomationProperties.AutomationId="ReferenceMessage"/>
  <Border x:Name="PreparePanel" Background="White" Padding="18" CornerRadius="12" Margin="0,0,0,12"><StackPanel>
   <TextBlock Text="准备校准" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="仪表拾音头放在麦克风附近。使用 A 加权，关闭 MAX，保持设备位置与输入设置不变。" TextWrapping="Wrap" Foreground="#61786B" Margin="0,6,0,12"/>
   <StackPanel x:Name="ReferenceCredentials"><TextBlock x:Name="ManagementLabel" Text="管理口令"/>
   <WrapPanel Margin="0,6,0,0">
    <PasswordBox x:Name="ManagementSecret" Width="240" MaxLength="128" Margin="0,0,10,6" AutomationProperties.AutomationId="ReferenceSecret"/>
    <Button x:Name="ConfigureManagement" Content="设置管理口令" Click="ManagementClicked" Padding="12,7" Margin="0,0,0,6"/>
   </WrapPanel>
   <TextBlock x:Name="ManagementHint" TextWrapping="Wrap" FontSize="12" Foreground="#61786B" Margin="0,2,0,12"/>
   </StackPanel><TextBlock x:Name="VerifiedCredentialHint" Text="已通过连接验证；采样与保存仍由后台核对权限。" Foreground="#61786B" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
   <WrapPanel>
    <StackPanel x:Name="WorkflowOptions" Visibility="Collapsed" Margin="0,0,16,8"><TextBlock Text="USB 校准流程"/><ComboBox x:Name="WorkflowChoice" Width="260" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,6,0,0" SelectionChanged="WorkflowSelected"/></StackPanel>
    <StackPanel Margin="0,0,0,8"><TextBlock Text="与仪表一致的时间加权"/><ComboBox x:Name="TimeMode" Width="180" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,6,0,0"/></StackPanel>
   </WrapPanel>
   <Expander x:Name="AdvancedSettings" Header="高级参数与检查门槛" HorizontalContentAlignment="Stretch" Margin="0,4,0,8"><StackPanel Margin="0,8,0,0">
    <WrapPanel>
     <StackPanel Margin="0,0,16,8"><TextBlock Text="仪表型号"/><TextBox x:Name="Instrument" Text="DLY-2202" Width="180" MaxLength="80" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Margin="0,0,16,8"><TextBlock Text="允许波动（dB）"/><TextBox x:Name="Stability" Width="135" Margin="0,6,0,0" AutomationProperties.AutomationId="ReferenceStability"/></StackPanel>
     <StackPanel Margin="0,0,0,8"><TextBlock x:Name="ToleranceLabel" Text="复核允许差值（dB）"/><TextBox x:Name="CheckTolerance" Width="145" Margin="0,6,0,0" AutomationProperties.AutomationId="ReferenceTolerance"/></StackPanel>
    </WrapPanel>
    <TextBlock x:Name="LimitInstructions" TextWrapping="Wrap" Foreground="#61786B" FontSize="12"/>
   </StackPanel></Expander>

   <TextBlock x:Name="DraftStatus" TextWrapping="Wrap" Foreground="#61786B" FontSize="12" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <Border x:Name="SamplePanel" Background="White" Padding="18" CornerRadius="12" Margin="0,0,0,12"><StackPanel>
   <TextBlock x:Name="SamplingHeading" Text="采样与填入同期读数" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock x:Name="SamplingInstructions" TextWrapping="Wrap" Foreground="#61786B" Margin="0,6,0,12"/>
   <WrapPanel>
    <ComboBox x:Name="RoleChoice" Width="190" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,10,6"/>


   </WrapPanel>
   <ProgressBar x:Name="Progress" Minimum="0" Maximum="10" Height="6" Foreground="#147D68" Background="#E8EEE9" Margin="0,10,0,0"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" CornerRadius="3"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/></Grid></Border></ControlTemplate></ProgressBar.Template></ProgressBar>
   <TextBlock x:Name="SamplingStatus" TextWrapping="Wrap" Margin="0,10,0,12"/>
   <Expander x:Name="SampleDetails" Header="采样记录与诊断" IsExpanded="True" HorizontalContentAlignment="Stretch">
    <StackPanel Margin="0,8,0,0">
     <TextBlock x:Name="MeterStatus" TextWrapping="Wrap" Foreground="#61786B" Margin="0,0,0,10"/>
     <ListBox x:Name="SampleList" Height="138" SelectionChanged="SampleSelected" AutomationProperties.AutomationId="ReferenceSamples" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel x:Name="ManualReferenceInputs" Margin="0,12,0,0">
      <StackPanel Margin="0,0,16,8"><TextBlock Text="同期稳定 SPL（dB(A)）"/><TextBox x:Name="ReferenceValue" Width="180" Margin="0,6,0,0" AutomationProperties.AutomationId="ReferenceReading"/></StackPanel>
      <StackPanel Margin="0,0,16,8"><TextBlock Text="同期最低读数（可选）"/><TextBox x:Name="ReferenceMinimum" Width="160" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Margin="0,0,0,8"><TextBlock Text="同期最高读数（可选）"/><TextBox x:Name="ReferenceMaximum" Width="160" Margin="0,6,0,0"/></StackPanel>
     </WrapPanel>
     <TextBlock x:Name="ReferenceInstructions" TextWrapping="Wrap" Foreground="#61786B" FontSize="12" Margin="0,8,0,0"/>
     <CheckBox x:Name="SameWindow" Margin="0,12,0,0"><TextBlock Text="我确认读数来自所选采样的同一时段，仪表为 A 加权、草稿时间模式、非 MAX，且声场与读数稳定。" TextWrapping="Wrap"/></CheckBox>
     <WrapPanel Margin="0,10,0,0">
      <Button x:Name="AttachReference" Content="保存所选段的参考读数" Click="ReferenceClicked" Padding="12,7" Margin="0,0,10,6" AutomationProperties.AutomationId="ReferenceAttach"/>
      <Button x:Name="RemoveSample" Content="删除所选段" Click="RemoveClicked" Padding="12,7" Margin="0,0,0,6"/>
     </WrapPanel>
    </StackPanel>
   </Expander>
  </StackPanel></Border>
  <Border x:Name="ResultPanel" Background="White" Padding="18" CornerRadius="12" Margin="0,0,0,12"><StackPanel>
   <TextBlock Text="复核结果" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock x:Name="EvaluationStatus" TextWrapping="Wrap" Margin="0,10,0,12"/>
   <CheckBox x:Name="AcceptReferenceWarning" Visibility="Collapsed" Margin="0,0,0,12" Checked="WarningSelected" Unchecked="WarningSelected" AutomationProperties.AutomationId="ReferenceWarningAcknowledged"><TextBlock Text="我已阅读复核差警告，接受它超过自动通过门槛（但不超过 5 dB）；结果仍为估算，不是精度保证。" TextWrapping="Wrap"/></CheckBox>
   <WrapPanel>


   </WrapPanel>
  </StackPanel></Border>
  <Expander x:Name="SavedReference" Header="已保存参考与使用说明" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
   <StackPanel Margin="0,8,0,0">
    <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <TextBlock x:Name="WorkflowNote" Text="手动输入同期 A 加权读数，计算结果用于估算 dB(A)。设备与输入设置变化后参考失效，须重新校准。" TextWrapping="Wrap" Foreground="#61786B" Margin="0,0,0,10"/>
    <TextBlock Text="DLY-2202：SLOW 为 1 秒平均、每秒更新 2 次；FAST 每秒更新 8 次。选择须与仪表一致。USB 实际到达频率和仪表内部读数时延仍需实物验证。" TextWrapping="Wrap" Foreground="#61786B" FontSize="12" Margin="0,0,0,10"/>
    <TextBlock Text="保持麦克风位置、Windows 输入音量、静音和增强设置不变；移动设备、硬件增益或 AGC／降噪变化后须重采。输入格式须支持 44.1 kHz 或以上。" TextWrapping="Wrap" Foreground="#61786B" FontSize="12" Margin="0,0,0,10"/>
    <Button x:Name="ClearProfile" Content="清除外部参考配置" Click="ClearClicked" HorizontalAlignment="Left" Padding="12,7"/>
   </StackPanel>
  </Expander>
 </StackPanel></ScrollViewer>
 <Border Grid.Row="1" BorderBrush="#DFE7E1" BorderThickness="0,1,0,0" Padding="0,10,0,0"><WrapPanel HorizontalAlignment="Right"><Button x:Name="BeginDraft" Content="新建参考草稿" Click="BeginClicked" Style="{StaticResource Primary}"  Padding="14,8" Margin="0,4,0,0" Visibility="{Binding Visibility, ElementName=PreparePanel}"/><Button x:Name="StartSample" Content="开始本段采样" Click="StartClicked" Style="{StaticResource Primary}" Padding="14,8" Margin="0,0,10,6" AutomationProperties.AutomationId="ReferenceStart" Visibility="{Binding Visibility, ElementName=SamplePanel}"/><Button x:Name="CancelSample" Content="取消本段" Click="CancelClicked" Padding="14,8" Margin="0,0,0,6" Visibility="{Binding Visibility, ElementName=SamplePanel}"/><Button x:Name="ConfirmProfile" Content="确认并保存估算参考" Click="ConfirmClicked" Style="{StaticResource Primary}" Padding="14,8" Margin="0,0,10,6" AutomationProperties.AutomationId="ReferenceConfirm" Visibility="{Binding Visibility, ElementName=ResultPanel}"/><Button x:Name="ReviewSamples" Content="返回采样" Click="SamplingClicked" Padding="14,8" Margin="0,0,0,6"  Visibility="{Binding Visibility, ElementName=ResultPanel}"/></WrapPanel></Border>
 </Grid>
</Window>
