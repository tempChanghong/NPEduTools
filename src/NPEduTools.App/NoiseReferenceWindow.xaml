<Window x:Class="NPEduTools.App.NoiseReferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外部声级计参考 · NPEduTools" Width="880" Height="680" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource TeacherPageBrush}"
        Foreground="{DynamicResource TeacherTextBrush}"
        FontFamily="{DynamicResource TeacherFont}"
        UseLayoutRounding="True">
 <Grid x:Name="ReferenceRoot">
  <Grid.Resources>
   <ControlTemplate x:Key="ManualFlatExpanderTemplate" TargetType="Expander">
    <ContentPresenter Content="{TemplateBinding Content}"/>
   </ControlTemplate>
   <Style x:Key="ManualFlatExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
    <Style.Triggers>
     <DataTrigger Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace">
      <Setter Property="Template" Value="{StaticResource ManualFlatExpanderTemplate}"/>
     </DataTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="CompactOptionalExpander" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource TeacherMutedBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="Expander">
       <StackPanel>
        <ToggleButton x:Name="HeaderSite"
                      Content="{TemplateBinding Header}"
                      Foreground="{TemplateBinding Foreground}"
                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                      Cursor="Hand" MinHeight="30" HorizontalAlignment="Left">
         <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
           <Border Background="Transparent" Padding="0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
             <TextBlock x:Name="Arrow" Text="▸" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center"/>
             <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
             <Setter TargetName="Arrow" Property="Text" Value="▾"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
             <Setter Property="Foreground" Value="{DynamicResource TeacherAccentBrush}"/>
            </Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,4,0,0"/>
       </StackPanel>
       <ControlTemplate.Triggers>
        <Trigger Property="IsExpanded" Value="True">
         <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
        </Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="ReferenceCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsGroupSurface}">
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace">
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
     </DataTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="ReferenceReadingSurface" TargetType="Border">
    <Setter Property="Margin" Value="0,10,0,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace">
      <Setter Property="Background" Value="{DynamicResource TeacherPageBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TeacherLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,12"/>
     </DataTrigger>
     <Trigger Property="Grid.Column" Value="1">
      <Setter Property="Margin" Value="14,0,0,0"/>
      <Setter Property="MinWidth" Value="320"/>
      <Setter Property="MaxWidth" Value="420"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
     </Trigger>
    </Style.Triggers>
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <ScrollViewer x:Name="ReferencePageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" SizeChanged="ReferenceWorkspaceSizeChanged">
   <StackPanel>
    <StackPanel.Style>
     <Style TargetType="StackPanel">
      <Setter Property="Margin" Value="24,20"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace">
        <Setter Property="Margin" Value="16,12"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </StackPanel.Style>
    <DockPanel>
    <WrapPanel x:Name="ReferenceHeadingActions" DockPanel.Dock="Top">
     <TextBlock x:Name="Heading" Text="外部声级计参考" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace">
          <Setter Property="FontSize" Value="22"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <Button x:Name="RefreshStatus" Content="验证口令 / 刷新" Click="RefreshClicked" Padding="12,7" Margin="12,0,0,2" Style="{StaticResource TeacherQuiet}" VerticalAlignment="Center"/>
    </WrapPanel>
    <StackPanel>
    <TextBlock x:Name="DeviceStatus" Text="正在读取本机状态…" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Setter Property="Margin" Value="0,6,0,12"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace">
         <Setter Property="Margin" Value="0,2,0,4"/>
         <Setter Property="FontSize" Value="13"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <TextBlock x:Name="ReferenceHealth" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Setter Property="Margin" Value="0,0,0,10"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace">
         <Setter Property="Margin" Value="0,0,0,6"/>
         <Setter Property="FontSize" Value="13"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    </StackPanel>
    </DockPanel>
    <TextBlock x:Name="ManualCredentialStatus" Text="如需采样或保存，请回「准备」输入管理口令。"
               TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,0,0,6" Visibility="Collapsed"/>
    <UniformGrid x:Name="StepNavigation" Columns="3" Visibility="Collapsed">
     <UniformGrid.Style>
      <Style TargetType="UniformGrid">
       <Setter Property="Margin" Value="0,0,0,12"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace">
         <Setter Property="Margin" Value="0,0,0,8"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </UniformGrid.Style>
     <Button Style="{StaticResource TeacherTab}" x:Name="SetupStep" Content="1　设置" Click="SetupClicked" Padding="10,8" Margin="0,0,6,0"/>
     <Button Style="{StaticResource TeacherTab}" x:Name="SamplingStep" Content="2　采样" Click="SamplingClicked" Padding="10,8" Margin="0,0,6,0"/>
     <Button Style="{StaticResource TeacherTab}" x:Name="ResultStep" Content="3　结果" Click="ResultClicked" Padding="10,8"/>
    </UniformGrid>
    <TextBlock x:Name="OperationMessage" TextWrapping="Wrap" Foreground="{DynamicResource TeacherWarningBrush}" AutomationProperties.AutomationId="ReferenceMessage">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Setter Property="Margin" Value="0,0,0,12"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace">
         <Setter Property="Margin" Value="0,0,0,6"/>
        </DataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Tag, ElementName=ReferenceRoot}" Value="ManualWorkspace"/>
          <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>

    <Border x:Name="PreparePanel" Style="{StaticResource ReferenceCardStyle}">
     <StackPanel>
      <TextBlock Text="准备校准" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="仪表拾音头放在麦克风附近。使用 A 加权，关闭 MAX，保持设备位置与输入设置不变。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,4,0,8" FontSize="13"/>
      <StackPanel x:Name="ReferenceCredentials">
       <TextBlock x:Name="ManagementLabel" Text="管理口令"/>
       <WrapPanel Margin="0,4,0,0">
        <PasswordBox Style="{StaticResource TeacherInput}" x:Name="ManagementSecret" Width="240" MaxLength="128" Margin="0,0,10,4" AutomationProperties.AutomationId="ReferenceSecret"/>
        <Button Style="{StaticResource TeacherButton}" x:Name="ConfigureManagement" Content="设置管理口令" Click="ManagementClicked" Padding="12,7" Margin="0,0,0,4"/>
       </WrapPanel>
       <TextBlock x:Name="ManagementHint" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,2,0,8"/>
      </StackPanel>
      <TextBlock x:Name="VerifiedCredentialHint" Text="已通过连接验证；采样与保存仍由后台核对权限。" Foreground="{DynamicResource TeacherMutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" FontSize="13"/>
      <WrapPanel>
       <StackPanel x:Name="WorkflowOptions" Visibility="Collapsed" Margin="0,0,16,6">
        <TextBlock Text="USB 校准流程"/>
        <ComboBox Style="{DynamicResource SettingsChoice}" x:Name="WorkflowChoice" Width="260" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,0" SelectionChanged="WorkflowSelected"/>
       </StackPanel>
       <StackPanel Margin="0,0,0,6">
        <TextBlock Text="与仪表一致的时间加权"/>
        <ComboBox Style="{DynamicResource SettingsChoice}" x:Name="TimeMode" Width="180" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,0"/>
       </StackPanel>
      </WrapPanel>
      <Expander x:Name="AdvancedSettings" Header="高级参数与检查门槛" HorizontalContentAlignment="Stretch" Style="{StaticResource ManualFlatExpander}" Margin="0,2,0,6">
       <StackPanel Margin="0,6,0,0">
        <WrapPanel>
         <StackPanel Margin="0,0,14,6">
          <TextBlock Text="允许波动（dB）"/>
          <TextBox Style="{StaticResource TeacherInput}" x:Name="Stability" Width="135" Margin="0,4,0,0" AutomationProperties.AutomationId="ReferenceStability"/>
         </StackPanel>
         <StackPanel Margin="0,0,14,6">
          <TextBlock x:Name="ToleranceLabel" Text="复核允许差值（dB）"/>
          <TextBox Style="{StaticResource TeacherInput}" x:Name="CheckTolerance" Width="145" Margin="0,4,0,0" AutomationProperties.AutomationId="ReferenceTolerance"/>
         </StackPanel>
         <StackPanel Margin="0,0,0,6">
          <TextBlock Text="仪表型号"/>
          <TextBox Style="{StaticResource TeacherInput}" x:Name="Instrument" Text="DLY-2202" Width="160" MaxLength="80" Margin="0,4,0,0"/>
         </StackPanel>
        </WrapPanel>
        <TextBlock x:Name="LimitInstructions" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13"/>
       </StackPanel>
      </Expander>
      <TextBlock x:Name="DraftStatus" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>

    <Border x:Name="SamplePanel" Style="{StaticResource ReferenceCardStyle}">
     <StackPanel x:Name="ReferenceSampleStage">
      <TextBlock x:Name="SamplingHeading" Text="采样与填入同期读数" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="SamplingInstructions" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,4,0,10" FontSize="13"/>
      <Grid x:Name="ReferenceSampleLayout">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <StackPanel x:Name="ReferenceSampleProgress" Grid.Row="0" Grid.Column="0">
        <WrapPanel>
         <ComboBox Style="{DynamicResource SettingsChoice}" x:Name="RoleChoice" Width="190" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,10,6"/>
        </WrapPanel>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="10" Height="6" Foreground="{DynamicResource TeacherAccentBrush}" Background="{DynamicResource TeacherPageBrush}" Margin="0,6,0,0">
         <ProgressBar.Template>
          <ControlTemplate TargetType="ProgressBar">
           <Border Background="{TemplateBinding Background}" CornerRadius="3">
            <Grid x:Name="PART_Track">
             <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/>
            </Grid>
           </Border>
          </ControlTemplate>
         </ProgressBar.Template>
        </ProgressBar>
        <TextBlock x:Name="SamplingStatus" TextWrapping="Wrap" Margin="0,8,0,8"/>
        <TextBlock x:Name="ManualSegmentSummary" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Visibility="Collapsed" Margin="0,0,0,8"/>
        <Expander x:Name="SampleDetails" Header="采样记录与诊断" IsExpanded="True" HorizontalContentAlignment="Stretch" Style="{StaticResource ManualFlatExpander}">
         <StackPanel x:Name="LegacySampleDetailsBody" Margin="0,6,0,0">
          <TextBlock x:Name="MeterStatus" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}">
           <TextBlock.Style>
            <Style TargetType="TextBlock">
             <Setter Property="Margin" Value="0,0,0,8"/>
             <Style.Triggers>
              <Trigger Property="Text" Value="">
               <Setter Property="Visibility" Value="Collapsed"/>
              </Trigger>
             </Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
          <ListBox x:Name="SampleList" Height="138" SelectionChanged="SampleSelected" AutomationProperties.AutomationId="ReferenceSamples" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
           <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
             <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
           </ListBox.ItemContainerStyle>
           <ListBox.ItemTemplate>
            <DataTemplate>
             <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
            </DataTemplate>
           </ListBox.ItemTemplate>
          </ListBox>
          <Button Style="{StaticResource TeacherButton}" x:Name="RemoveSample" Content="删除所选段" Click="RemoveClicked" Padding="12,7" Margin="0,8,0,0" HorizontalAlignment="Left"/>
         </StackPanel>
        </Expander>
       </StackPanel>

       <Border x:Name="ReferenceSampleReading" Grid.Row="1" Grid.Column="0" Style="{StaticResource ReferenceReadingSurface}">
        <StackPanel x:Name="ReferenceReadingBody">
         <TextBlock x:Name="ManualSegmentTarget" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TeacherAccentBrush}" Visibility="Collapsed" Margin="0,0,0,8"/>
         <WrapPanel x:Name="ManualReferenceInputs" Orientation="Vertical">
          <StackPanel Margin="0,0,0,6">
           <TextBlock x:Name="ReferenceReadingLabel" Text="同期稳定 SPL（dB(A)）"/>
           <TextBox Style="{StaticResource TeacherInput}" x:Name="ReferenceValue" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0" AutomationProperties.AutomationId="ReferenceReading"/>
          </StackPanel>
          <Expander x:Name="OptionalRangeInputs" Header="可选：同期最低 / 最高读数" IsExpanded="False" Style="{StaticResource CompactOptionalExpander}" Margin="0,2,0,4">
           <WrapPanel>
            <StackPanel Margin="0,0,12,6">
             <TextBlock Text="同期最低读数（可选）" FontSize="13"/>
             <TextBox Style="{StaticResource TeacherInput}" x:Name="ReferenceMinimum" Width="150" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,6">
             <TextBlock Text="同期最高读数（可选）" FontSize="13"/>
             <TextBox Style="{StaticResource TeacherInput}" x:Name="ReferenceMaximum" Width="150" Margin="0,4,0,0"/>
            </StackPanel>
           </WrapPanel>
          </Expander>
         </WrapPanel>
         <TextBlock x:Name="ReferenceInstructions" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,6,0,0"/>
         <CheckBox x:Name="SameWindow" Margin="0,10,0,0">
          <TextBlock Text="我确认读数来自所选采样的同一时段，仪表为 A 加权、草稿时间模式、非 MAX，且声场与读数稳定。" TextWrapping="Wrap"/>
         </CheckBox>
         <WrapPanel x:Name="ReadingActions" Margin="0,10,0,0">
          <Button Style="{StaticResource TeacherButton}" x:Name="AttachReference" Content="保存所选段的参考读数" Click="ReferenceClicked" Padding="12,7" Margin="0,0,0,2" AutomationProperties.AutomationId="ReferenceAttach"/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </Grid>
     </StackPanel>
    </Border>

    <Border x:Name="ResultPanel" Style="{StaticResource ReferenceCardStyle}">
     <StackPanel>
      <TextBlock Text="复核结果" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="EvaluationStatus" TextWrapping="Wrap" Margin="0,10,0,12"/>
      <CheckBox x:Name="AcceptReferenceWarning" Visibility="Collapsed" Margin="0,0,0,12" Checked="WarningSelected" Unchecked="WarningSelected" AutomationProperties.AutomationId="ReferenceWarningAcknowledged">
       <TextBlock Text="我已阅读复核差警告，接受它超过自动通过门槛（但不超过 5 dB）；结果仍为估算，不是精度保证。" TextWrapping="Wrap"/>
      </CheckBox>
     </StackPanel>
    </Border>

    <Expander x:Name="SavedReference" Header="已保存参考与使用说明" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
     <StackPanel Margin="0,8,0,0">
      <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock x:Name="WorkflowNote" Text="手动输入同期 A 加权读数，计算结果用于估算 dB(A)。设备与输入设置变化后参考失效，须重新校准。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" Margin="0,0,0,10"/>
      <TextBlock Text="DLY-2202：SLOW 为 1 秒平均、每秒更新 2 次；FAST 每秒更新 8 次。选择须与仪表一致。USB 实际到达频率和仪表内部读数时延仍需实物验证。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,0,0,10"/>
      <TextBlock Text="保持麦克风位置、Windows 输入音量、静音和增强设置不变；移动设备、硬件增益或 AGC／降噪变化后须重采。输入格式须支持 44.1 kHz 或以上。" TextWrapping="Wrap" Foreground="{DynamicResource TeacherMutedBrush}" FontSize="13" Margin="0,0,0,10"/>
      <Button Style="{StaticResource TeacherButton}" x:Name="ClearProfile" Content="清除外部参考配置" Click="ClearClicked" HorizontalAlignment="Left" Padding="12,7"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" BorderBrush="{DynamicResource TeacherLineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource TeacherSurfaceBrush}" Padding="12,8">
   <WrapPanel x:Name="ReferenceFooterActions" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="BeginDraft" Content="新建参考草稿" Click="BeginClicked" Style="{StaticResource TeacherPrimary}" Padding="14,8" Margin="0,2,10,2" Visibility="{Binding Visibility, ElementName=PreparePanel}"/>
    <Button x:Name="ContinueDraft" Content="继续当前草稿" Click="ContinueDraftClicked" Style="{StaticResource TeacherButton}" Padding="14,8" Margin="0,2,10,2" Visibility="Collapsed"/>
    <Button x:Name="StartSample" Content="开始本段采样" Click="StartClicked" Style="{StaticResource TeacherPrimary}" Padding="14,8" Margin="0,2,10,2" AutomationProperties.AutomationId="ReferenceStart" Visibility="{Binding Visibility, ElementName=SamplePanel}"/>
    <Button Style="{StaticResource TeacherButton}" x:Name="CancelSample" Content="取消本段" Click="CancelClicked" Padding="14,8" Margin="0,2,10,2" Visibility="{Binding Visibility, ElementName=SamplePanel}"/>
    <Button x:Name="ConfirmProfile" Content="确认并保存估算参考" Click="ConfirmClicked" Style="{StaticResource TeacherPrimary}" Padding="14,8" Margin="0,2,10,2" AutomationProperties.AutomationId="ReferenceConfirm" Visibility="{Binding Visibility, ElementName=ResultPanel}"/>
    <Button Style="{StaticResource TeacherButton}" x:Name="ReviewSamples" Content="返回采样" Click="SamplingClicked" Padding="14,8" Margin="0,2,0,2" Visibility="{Binding Visibility, ElementName=ResultPanel}"/>
   </WrapPanel>
  </Border>
 </Grid>
</Window>
