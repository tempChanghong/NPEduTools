<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>../NPEduTools.PowerPoint.Assist/app.manifest</ApplicationManifest>
    <!-- The manifest owns DPI setup; WinForms is used only for physical monitor bounds. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../NPEduTools.Contracts/NPEduTools.Contracts.csproj" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <Target Name="CopyRecordingRuntime" AfterTargets="Build" Condition="'$(ExcludeRecordingTools)' != 'true'">
    <PropertyGroup>
      <RecordingRuntimeDirectory Condition="Exists('../../.tools/recording-bundled/manifest.json')">../../.tools/recording-bundled</RecordingRuntimeDirectory>
      <RecordingRuntimeDirectory Condition="'$(RecordingRuntimeDirectory)' == ''">../../.tools/recording</RecordingRuntimeDirectory>
    </PropertyGroup>
    <ItemGroup><RecordingRuntime Include="$(RecordingRuntimeDirectory)/ffmpeg.exe;$(RecordingRuntimeDirectory)/ffprobe.exe;$(RecordingRuntimeDirectory)/LICENSE;$(RecordingRuntimeDirectory)/README.txt;$(RecordingRuntimeDirectory)/manifest.json" Condition="Exists('$(RecordingRuntimeDirectory)/manifest.json')" /></ItemGroup>
    <Copy SourceFiles="@(RecordingRuntime)" DestinationFolder="$(OutDir)Tools" SkipUnchangedFiles="true" />
  </Target>
</Project>
